ription": "Brief description of the simulation purpose",\n  "simulation_type": "agent_based | system_dynamics | network | etc.",\n  "entities": [\n    {\n      "name": "Entity name",\n      "attributes": ["attribute1", "attribute2", ...],\n      "behaviors": ["behavior1", "behavior2", ...]\n    }\n  ],\n  "interactions": [\n    {\n      "name": "interaction_name",\n      "description": "Description of the interaction",\n      "entities_involved": ["Entity1", "Entity2", ...]\n    }\n  ],\n  "parameters": {\n    "param1": value1,\n    "param2": value2\n  },\n  "metrics": [\n    {\n      "name": "metric_name",\n      "description": "Description of what the metric measures"\n    }\n  ],\n  "validation_criteria": [\n    {\n      "name": "criterion_name",\n      "description": "Description of the validation criterion"\n    }\n  ],\n  "prediction_period": {"start_day": <int>, "end_day": <int>},\n  "evaluation_metrics": ["metric1", "metric2", ...]\n} '}], 'model': 'gpt-4.1', 'max_tokens': 10000, 'temperature': 0.7}}
