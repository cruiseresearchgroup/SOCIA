  "prediction_period": {
    "start_day": 30,
    "end_day": 39
  },
  "evaluation_metrics": [
    "RMSE",
    "MAE",
    "MAPE",
    "R2",
    "AdoptionRateAtT",
    "TimeTo50Percent",
    "PeakAdoption",
    "SubgroupDisparityIndex",
    "RunToRunVariance"
  ]
