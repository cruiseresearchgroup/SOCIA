  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AggregationEngine",
      "formula_or_field": "mean(Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "mean_by_day",
      "target_data_field": "train_data.csv:wearing_mask (mean by day)"
    },
    {
      "id": "observable.info_rate_daily",
      "source_module": "AggregationEngine",
      "formula_or_field": "mean(Person.received_info)",
      "frequency": "daily",
      "aggregation": "mean_by_day",
      "target_data_field": "train_data.csv:received_info (mean by day)"
    },
    {
      "id": "observable.adoption_rate_by_age",
      "source_module": "AggregationEngine",
      "formula_or_field": "mean(Person.mask_adoption_state) by age_group",
      "frequency": "daily",
      "aggregation": "by_group(age_group)",
      "target_data_field": "train_data.csv:wearing_mask joined agent_attributes.csv:age_group (mean by day, group)"
    },
    {
      "id": "observable.adoption_rate_by_occupation",
      "source_module": "AggregationEngine",
      "formula_or_field": "mean(Person.mask_adoption_state) by occupation",
      "frequency": "daily",
      "aggregation": "by_group(occupation)",
      "target_data_field": "train_data.csv:wearing_mask joined agent_attributes.csv:occupation (mean by day, group)"
    }
  ],
  "metrics": [
    {
      "name": "RMSE",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {}
      }
    },
    {
      "name": "MAPE",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MAPE",
        "config": {
          "epsilon": 1e-06
        }
      }
    },
    {
      "name": "R2",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "R2",
        "config": {}
      }
    },
    {
      "name": "AdoptionRateAtT",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "ValueAtT",
        "config": {
          "T": 39
        }
      }
    },
    {
      "name": "TimeTo50Percent",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5
        }
      }
    },
    {
      "name": "PeakAdoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Peak",
        "config": {}
      }
    },
    {
      "name": "SubgroupDisparityIndex",
      "inputs": [
        "observable.adoption_rate_by_age"
      ],
      "definition": {
        "type": "Disparity",
        "config": {
          "method": "max_minus_min"
        }
      }
    },
    {
      "name": "RunToRunVariance",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "VarianceAcrossReplications",
        "config": {
          "T": 39
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "data_folder": "data_fitting/mask_adoption_data/",
    "network_preprocessing": {
      "symmetrize_per_layer": true,
      "remove_self_loops": true,
      "deduplicate_neighbors": true
    },
    "state_seeding": {
      "from_day0": true,
      "mask_adoption_state_day0": "mean from train_data.csv day==0",
      "received_info_day0": "mean from train_data.csv day==0"
    },
    "attribute_fit": {
      "risk_perception_distribution": "fit Beta(a,b) to empirical risk_perception",
      "baseline_propensity": "fit logistic: wearing_day0 ~ risk + age_group + occupation"
    }
  },
  "algorithms": {
    "IndependentCascadeInfo": "Combined-hazard independent cascade with baseline and broadcast contributions.",
    "LogisticHazardAdoption": "Discrete-time logistic hazard with persistence and habit/fatigue modifiers.",
    "PolicySignalComputation": "Time-dependent utility modifier from mandates, enforcement, fines, and campaigns.",
    "EMA_NormSignal": "Exponential moving average of location prevalence to produce stable norm signals."
  },
  "data_sources": [
    {
      "name": "agent_attributes.csv",
      "purpose": "Initialize agents and subgroup labels; risk_perception distribution.",
      "fields_used": [
        "agent_id",
        "age_group",
        "occupation",
        "risk_perception"
      ]
    },
    {
      "name": "social_network.json",
      "purpose": "Build multiplex network layers.",
      "fields_used": [
        "family",
        "work_school",
        "community",
        "all"
      ]
    },
    {
      "name": "train_data.csv",
      "purpose": "Calibrate info and adoption hazards and persistence; evaluate fit on days 0\u201329 and predict 30\u201339.",
      "fields_used": [
        "day",
        "agent_id",
        "wearing_mask",
        "received_info"
      ]
    }
  ],
