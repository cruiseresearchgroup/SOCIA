      },
      {
        "name": "calibration/sbi.py",
        "description": "SBI routines (priors, simulators, summary stats) and optimization loop."
      },
      {
        "name": "metrics.py",
        "description": "Metric computations (RMSE, MAE, MAPE, R2, TimeToThreshold, Peak, Disparity, VarianceAcrossReplications)."
      },
      {
        "name": "utils.py",
        "description": "Helpers: zscore, EMA, random seeds, data joins, group aggregations."
