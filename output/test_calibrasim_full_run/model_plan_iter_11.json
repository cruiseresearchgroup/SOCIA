  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.venue_compliance_by_type_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(venue_type, mean(mask_wearing among attendees))",
      "frequency": "daily",
      "aggregation": "by_group(venue_type)",
      "target_data_field": "train_venues.csv:compliance_by_type"
    },
    {
      "id": "observable.dropout_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "(# masked yesterday and unmasked today) / (# masked yesterday)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:dropout_rate"
    },
    {
      "id": "observable.net_social_influence_R_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "influence_attributed_new_adopters / prior_day_masked_count (EMA-smoothed)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:behavioral_R"
    },
    {
      "id": "observable.infection_prevalence_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.health_status == 'I')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:infection_prevalence"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "PeakAdoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Peak",
        "config": {
          "window": null
        }
      }
    },
    {
      "name": "TimeTo50Percent",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5,
          "direction": "up"
        }
      }
    },
    {
      "name": "ComplianceDurationMean",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Custom",
        "config": {
          "function": "mean_consecutive_masking_streak_length"
        }
      }
    },
    {
      "name": "PolicyEffectUplift",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Difference",
        "config": {
          "baseline_run_id": "no_policy",
          "comparison_run_id": "policy",
          "aggregate": "mean_over_days"
        }
      }
    },
    {
      "name": "CampaignEffectUplift",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Difference",
        "config": {
          "baseline_run_id": "no_campaign",
          "comparison_run_id": "campaign",
          "aggregate": "mean_over_days"
        }
      }
    },
    {
      "name": "AdoptionInequalityIndex",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Gini",
        "config": {
          "group_by": "trust_quantile"
        }
      }
    },
    {
      "name": "VenueComplianceRate",
      "inputs": [
        "observable.venue_compliance_by_type_daily"
      ],
      "definition": {
        "type": "Identity",
        "config": {}
      }
    },
    {
      "name": "DropoutRate",
      "inputs": [
        "observable.dropout_rate_daily"
      ],
      "definition": {
        "type": "Identity",
        "config": {}
      }
    },
    {
      "name": "NetSocialInfluenceR",
      "inputs": [
        "observable.net_social_influence_R_daily"
      ],
      "definition": {
        "type": "Identity",
        "config": {}
      }
    },
    {
      "name": "InfectionPrevalenceRMSE",
      "inputs": [
        "observable.infection_prevalence_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network_generation": "Watts-Strogatz small-world with avg_degree=10, rewiring_prob=0.1; add homophily by age quantiles using assortative rewiring proportional to homophily_strength",
    "households": "Create ceil(population_size/household_size_mean) households; assign persons sequentially with Poisson draws",
    "venues": "Instantiate counts and capacities per parameters; assign households to household venues",
    "health": "If model_disease: sample initial_infected_prevalence to 'I', rest 'S'"
  },
  "algorithms": {
    "NetworkGeneration": "Watts-Strogatz small-world with assortative rewiring by age quantiles per homophily_strength",
    "SocialInfluenceUpdate": "Latent propensity updated via normative + informational components; logistic conversion to adoption probability with noise and fatigue",
    "InformationUpdate": "Bernoulli exposure to official/misinformation; trust and risk updated via bounded linear updates",
    "PolicyEnforcement": "Venue/macro mandate toggles; enforcement increases compliance and reduces perceived non-compliance benefit",
    "VenueAssignment": "Daily stochastic attendance by venue type with capacity constraints; pairwise contacts sampled within venues",
    "MaskAcquisition": "Periodic acquisition attempts influenced by availability and perceived cost; scarcity feedback",
    "DiseaseTransmission": "Chain-binomial per-contact infection with mask effectiveness modifiers",
    "Aggregation": "Compute daily observables and derived metrics; influence-based R via attribution logs"
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibrate and evaluate population-level adoption and infection prevalence.",
      "fields_used": [
        "day",
        "adoption_rate",
        "dropout_rate",
        "behavioral_R",
        "infection_prevalence"
      ]
    },
    {
      "name": "train_venues.csv",
      "purpose": "Calibrate venue-specific compliance rates.",
      "fields_used": [
        "day",
        "venue_type",
        "compliance_by_type"
      ]
    }
  ],
