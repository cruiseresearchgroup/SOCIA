      "frozen": "false"
    },
    {
      "key": "peer_exposure_weight_recent",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "InfluenceExposure",
      "description": "Weight advantage for recently adopted neighbors in social signal.",
      "frozen": "false"
    },
    {
