      "frozen": "false"
    },
    {
      "key": "adoption_threshold_std",
      "dtype": "float",
      "default": 0.15,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "AdoptionDecision",
      "description": "Std-dev of personal adoption thresholds.",
      "frozen": "false"
    },
    {
      "key": "utility_benefit_mean",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.0,
        "high": 5.0
      },
      "owner_module": "AdoptionDecision",
      "description": "Mean perceived utility benefit from adoption.",
      "frozen": "false"
    },
    {
      "key": "utility_cost_mean",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 5.0
      },
      "owner_module": "AdoptionDecision",
      "description": "Mean perceived cost from adoption (pre-shock).",
      "frozen": "false"
    },
    {
      "key": "noise_level_decision",
      "dtype": "float",
      "default": 0.05,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "AdoptionDecision",
      "description": "Std-dev of decision noise in propensity.",
      "frozen": "false"
    },
    {
      "key": "compliance_variability",
      "dtype": "float",
