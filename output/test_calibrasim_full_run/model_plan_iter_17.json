      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "InfluenceExposure",
      "description": "Mean trust parameter toward media across agents.",
      "frozen": "false"
    },
    {
      "key": "social_trust_mean",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "InfluenceExposure",
      "description": "Mean trust parameter toward peers across agents.",
      "frozen": "false"
    },
    {
      "key": "adoption_threshold_base_mean",
      "dtype": "float",
      "default": 0.4,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "AdoptionDecision",
