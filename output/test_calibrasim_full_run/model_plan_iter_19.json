        "high": 0.99
      },
      "owner_module": "ExogenousMediaModule",
      "description": "AR(1) autocorrelation of media process.",
      "frozen": false
    },
    {
      "key": "em.campaign_start_day",
      "dtype": "int",
      "default": 10,
      "bounds": {
