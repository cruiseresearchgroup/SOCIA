        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Fraction age 0-17.",
      "frozen": false
    },
    {
      "key": "gi.age_group_fraction_adult",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Fraction age 18-34.",
      "frozen": false
    },
    {
      "key": "gi.age_group_fraction_middle",
      "dtype": "float",
      "default": 0.35,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Fraction age 35-64.",
      "frozen": false
    },
    {
      "key": "gi.age_group_fraction_senior",
      "dtype": "float",
      "default": 0.15,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
