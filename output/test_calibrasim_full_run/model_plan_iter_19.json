      "frozen": false
    },
    {
      "key": "em.misinformation_fraction",
      "dtype": "float",
      "default": 0.15,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "ExogenousMediaModule",
      "description": "Fractional presence of misinformation sources.",
      "frozen": false
    },
    {
      "key": "em.misinformation_impact",
      "dtype": "float",
      "default": -0.5,
      "bounds": {
        "low": -5.0,
        "high": 0.0
      },
      "owner_module": "ExogenousMediaModule",
      "description": "Net additive effect of misinformation on media signal (negative).",
      "frozen": false
    },
    {
      "key": "pi.phase1_end_day",
      "dtype": "int",
      "default": 9,
      "bounds": {
        "low": 0,
        "high": 365
      },
      "owner_module": "PolicyIntervention",
      "description": "End day of policy phase 1.",
      "frozen": false
    },
    {
      "key": "pi.phase1_level",
      "dtype": "int",
      "default": 0,
      "bounds": {
        "low": 0,
        "high": 3
      },
      "owner_module": "PolicyIntervention",
      "description": "Level during phase 1.",
      "frozen": false
    },
    {
      "key": "pi.phase2_end_day",
      "dtype": "int",
      "default": 19,
      "bounds": {
        "low": 0,
