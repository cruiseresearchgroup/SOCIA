        "high": 2.0
      },
      "owner_module": "ExogenousMediaModule",
      "description": "Innovation variance for AR(1) media process.",
      "frozen": false
    },
    {
      "key": "em.media_auto_corr",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
