  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adopted)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.new_adopters_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(events.adoptions)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:new_adopters"
    },
    {
      "id": "observable.dropouts_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(events.dropouts)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:dropouts"
    },
    {
      "id": "observable.policy_level_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "policy.level",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "policy.csv:level"
    },
    {
      "id": "observable.media_signal_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "media.signal",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "media.csv:signal"
    },
    {
      "id": "observable.avg_contacts_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "contacts.avg_per_agent",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "mobility.csv:avg_contacts"
    },
    {
      "id": "observable.adoption_rate_by_community",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(community_id, mean(Person.adopted))",
      "frequency": "daily",
      "aggregation": "by_group(community_id)",
      "target_data_field": "train_data_by_comm.csv:adoption_rate_by_comm"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_AdoptionRate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE_NewAdopters",
      "inputs": [
        "observable.new_adopters_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "normalize": false
        }
      }
    },
    {
      "name": "PeakTimingError_AdoptionRate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToPeakError",
        "config": {
          "unit": "days"
        }
      }
    },
    {
      "name": "PeakMagnitudeError_NewAdopters",
      "inputs": [
        "observable.new_adopters_daily"
      ],
      "definition": {
        "type": "PeakError",
        "config": {
          "relative": true
        }
      }
    },
    {
      "name": "MeanBias_AdoptionRate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MeanBias",
        "config": {
          "normalize": true
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "simulation_days": 60,
    "initial_adoption_rate": 0.05
  },
  "algorithms": {
    "network_generation": "Stochastic Block Model with degree heterogeneity and homophily bias",
    "contact_sampling": "Activity-weighted Poisson sampling over network neighbors with lognormal interaction weights",
    "media_process": "AR(1) with additive campaign boost and misinformation offset",
    "influence_aggregation": "Weighted norm-based peer influence plus media and policy terms with novelty saturation",
    "adoption_decision": "Noisy logistic choice with individual threshold and cost",
    "compliance_decay": "Bernoulli dropout with base rate, peer stabilization, and media fatigue"
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and evaluation of adoption time series.",
      "fields_used": [
        "adoption_rate",
        "new_adopters",
        "dropouts"
      ]
    },
    {
      "name": "policy.csv",
      "purpose": "Policy level schedule for comparison and conditioning.",
      "fields_used": [
        "level"
      ]
    },
    {
      "name": "media.csv",
      "purpose": "External media signal reference for validation.",
      "fields_used": [
        "signal"
      ]
    },
    {
      "name": "mobility.csv",
      "purpose": "Average contact proxy for validation.",
      "fields_used": [
        "avg_contacts"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point: runs simulation loop, orchestrates modules, handles I/O."
      },
      {
        "name": "entities.py",
        "description": "Definitions for Person and PolicyAuthority entities and initialization routines."
      },
      {
        "name": "modules/network_builder.py",
        "description": "Implementation of NetworkBuilder module."
      },
      {
        "name": "modules/media.py",
        "description": "Implementation of ExogenousMediaModule."
      },
      {
        "name": "modules/policy.py",
        "description": "Implementation of PolicyIntervention."
      },
      {
        "name": "modules/contacts.py",
        "description": "Implementation of ContactScheduler."
      },
      {
        "name": "modules/influence.py",
        "description": "Implementation of InfluencePropagation."
      },
      {
        "name": "modules/adoption.py",
        "description": "Implementation of AdoptionDecision."
      },
      {
        "name": "modules/compliance.py",
        "description": "Implementation of ComplianceDecay."
      },
      {
        "name": "modules/aggregator.py",
        "description": "Implementation of AdoptionAggregator and metrics export."
      },
      {
        "name": "utils/metrics.py",
        "description": "Computes evaluation metrics from observables."
      },
      {
        "name": "utils/random.py",
        "description": "Random number utilities and seeded generators."
      },
      {
        "name": "config/params.yaml",
        "description": "Optional external configuration for parameter overrides."
      }
    ],
    "dependencies": [
      "numpy",
      "scipy",
      "pandas",
      "networkx",
      "numba",
      "pyyaml"
    ]
  },
  "prediction_period": {
    "start_day": 30,
    "end_day": 39
  },
  "evaluation_metrics": [
    "RMSE_AdoptionRate",
    "MAE_NewAdopters",
    "PeakTimingError_AdoptionRate",
    "PeakMagnitudeError_NewAdopters",
    "MeanBias_AdoptionRate"
  ]
}