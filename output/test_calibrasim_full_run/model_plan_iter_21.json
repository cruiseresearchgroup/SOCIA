{
  "model_type": "agent_based",
  "description": "An agent-based, network-embedded simulation of mask-wearing behavior diffusion under social influence, policy mandates and enforcement, communication campaigns, venue rules, and retail supply constraints.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "income",
        "risk_perception",
        "mask_attitude",
        "trust_in_authorities",
        "misinformation_belief",
        "conformity",
        "wear_probability",
        "mask_wearing",
        "ever_masked",
        "has_mask",
        "mask_inventory",
        "network_neighbors",
        "household_id",
        "current_venue_id",
        "last_message_day",
        "norm_perception"
      ],
      "behaviors": [
        "decide_wear_mask",
        "update_attitude_social",
        "observe_and_update_norms",
        "purchase_masks",
        "share_information",
        "attend_venue",
        "comply_with_policy"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": "uniform_18_80",
          "income_distribution": "lognormal(mu=10.5, sigma=0.8) USD/year",
          "risk_perception": "truncated_normal(mean=0.4, std=0.2, bounds=[0,1])",
          "mask_attitude": "truncated_normal(mean=0.3, std=0.15, bounds=[0,1])",
          "trust_in_authorities": "truncated_normal(mean=0.5, std=0.2, bounds=[0,1])",
          "misinformation_belief": "Bernoulli(p=0.05)",
          "conformity": "truncated_normal(mean=0.5, std=0.2, bounds=[0,1])",
          "wear_probability": "set by logistic utility at t=0",
          "mask_wearing": "Bernoulli(initial_mask_adoption_rate)",
          "ever_masked": "mask_wearing at t=0",
          "has_mask": "mask_inventory > 0",
          "mask_inventory": "Poisson(lambda=2) truncated at [0,20]",
          "network_neighbors": "small_world(k=average_degree, beta=0.1)",
          "household_assignment": "random by household_size_mean with constraints",
          "last_message_day": -1,
          "norm_perception": "initialized to neighborhood wearing share at t=0"
        }
      }
    },
    {
      "name": "Household",
      "attributes": [
        "id",
        "member_ids",
        "income",
        "mask_inventory",
        "norm_strength"
      ],
      "behaviors": [
        "share_masks_with_members",
        "influence_member_attitudes"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "size_generation": "Poisson(lambda=household_size_mean), truncated [1,6]",
          "income": "sum of member incomes",
          "mask_inventory": "sum initial member inventory",
          "norm_strength": "truncated_normal(mean=0.6, std=0.2, bounds=[0,1])"
        }
      }
    },
    {
      "name": "Venue",
      "attributes": [
        "id",
        "type",
        "policy_mask_required",
        "enforcement_strength",
        "capacity",
        "daily_visitors",
        "local_prevalence_indicator"
      ],
      "behaviors": [
        "enforce_policy",
        "admit_or_deny_entry",
        "broadcast_local_rules"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "type_mix": {
            "workplace": 0.4,
            "school": 0.2,
            "public_space": 0.4
          },
          "policy_mask_required": "false at t=0 unless mandate_active_initial is true",
          "enforcement_strength": "truncated_normal(mean=0.6, std=0.2, bounds=[0,1])",
          "capacity": "default_venue_capacity",
          "daily_visitors": 0,
          "local_prevalence_indicator": "initial 0.02"
        }
      }
    },
    {
      "name": "PublicHealthAuthority",
      "attributes": [
        "id",
        "mandate_active",
        "mandate_start_day",
        "communication_frequency",
        "message_effectiveness",
        "enforcement_budget",
        "fine_amount"
      ],
      "behaviors": [
        "set_or_update_policy",
        "broadcast_message",
        "inspect_venues",
        "issue_fines"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_active": "mandate_active_initial",
          "mandate_start_day": "mandate_start_day",
          "communication_frequency": "communication_frequency",
          "message_effectiveness": "message_effectiveness",
          "enforcement_budget": "enforcement_budget",
          "fine_amount": "fine_amount"
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "stock",
        "restock_rate",
        "price",
        "rationing_policy"
      ],
      "behaviors": [
        "sell_masks",
        "restock",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "stock": "retailer_initial_stock",
          "restock_rate": "retailer_restock_rate_per_day",
          "price": "mask_price",
          "rationing_policy": "rationing_policy_active"
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialInfluenceAndNorms",
      "description": "Updates person mask_attitude, risk_perception, and norm_perception via peer influence, venue observation, and misinformation, weighted by trust and conformity.",
      "inputs": [
        "Person.network_neighbors",
        "Person.mask_wearing",
        "Person.trust_in_authorities",
        "Venue.broadcast_local_rules",
        "PolicyAndEnforcement.message_signal"
      ],
      "outputs": [
        "Person.mask_attitude",
        "Person.risk_perception",
        "Person.norm_perception"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  peer_wear_share = mean(mask_wearing of neighbors N(i))\n  venue_norm = observed fraction masked across venues visited by i yesterday (if none, use household share)\n  message_impact = authority_message_weight * PolicyAndEnforcement.message_signal * i.trust_in_authorities\n  misinformation_shock = Bernoulli(misinformation_rate) ? -0.1 : 0\n  social_term = peer_influence_weight * peer_wear_share + observation_weight * venue_norm + message_impact + misinformation_shock\n  noise = Normal(0, social_noise_std)\n  if attitude_update_rule == 'weighted_threshold':\n     delta_att = tanh(social_term + noise) * i.conformity\n  else if attitude_update_rule == 'bayesian':\n     delta_att = (social_term - i.mask_attitude) * i.conformity\n  i.mask_attitude = clip(i.mask_attitude + influence_decay_rate * delta_att, 0, 1)\n  i.risk_perception = clip(i.risk_perception + 0.25 * message_impact + 0.15 * (venue_norm - 0.5), 0,1)\n  i.norm_perception = 0.5 * i.norm_perception + 0.5 * (0.5*peer_wear_share + 0.5*venue_norm)",
        "notes": [
          "norm_perception is an exponentially smoothed perceived norm",
          "message_signal is 0 when no broadcast occurs on a day"
        ]
      },
      "requirements": [],
      "module_parameters": [
        "peer_influence_weight",
        "observation_weight",
        "authority_message_weight",
        "misinformation_rate",
        "attitude_update_rule",
        "social_noise_std",
        "influence_decay_rate"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Sets/updates mandates, broadcasts public health messages, inspects venues, and enforces fines and entry denials.",
      "inputs": [
        "day",
        "PublicHealthAuthority.enforcement_budget",
        "Venue.enforcement_strength",
        "Person.mask_wearing",
        "Venue.policy_mask_required"
      ],
      "outputs": [
        "PolicyAndEnforcement.message_signal",
        "enforcement_actions_count_daily",
        "venue_compliance_rate_daily",
        "Venue.policy_mask_required"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "message_signal = 0\nif day == mandate_start_day: set mandate_active = true; for all venues: policy_mask_required = true\nif mandate_active_initial and day == 0: for all venues: policy_mask_required = true\nif day % communication_frequency == 0:\n  message_signal = message_effectiveness\n  broadcast to all persons (sets their last_message_day = day)\n# Enforcement and inspections\nbudget = enforcement_budget\nenforcement_actions_count_daily = 0\nsample a set of venues with probability venue_inspection_probability subject to budget\nfor each selected venue v:\n  # compute compliance among entrants yesterday\n  compliance = fraction of entrants yesterday with mask_wearing == true\n  venue_compliance_rate_daily += compliance (will be averaged later)\n  if random() < enforcement_probability * v.enforcement_strength:\n    # issue warnings/fines to detected noncompliant entrants up to budget\n    expected_fines = (1 - compliance) * v.daily_visitors * 0.1  # 10% detected\n    fines_issued = min(expected_fines, budget / fine_amount)\n    enforcement_actions_count_daily += fines_issued\n    budget -= fines_issued * fine_amount",
        "notes": [
          "venue_compliance_rate_daily is normalized by number of inspected venues",
          "Entry denial can also occur within MobilityAndVenues via entry_denial_rate_if_noncompliant"
        ]
      },
      "requirements": [],
      "module_parameters": [
        "mandate_start_day",
        "mandate_active_initial",
        "enforcement_probability",
        "fine_amount",
        "communication_frequency",
        "message_effectiveness",
        "enforcement_budget",
        "inspection_rate_per_day",
        "venue_inspection_probability"
      ]
    },
    {
      "name": "MobilityAndVenues",
      "description": "Assigns daily trips to venues, applies venue admission rules and enforcement at entry, and records observed mask wearing in venues.",
      "inputs": [
        "Person.id",
        "Person.mask_wearing",
        "Venue.capacity",
        "Venue.policy_mask_required",
        "Venue.enforcement_strength"
      ],
      "outputs": [
        "Person.current_venue_id",
        "Venue.daily_visitors",
        "Venue.broadcast_local_rules",
        "venue_observed_mask_share_daily"
      ],
      "dependencies": [
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "reset per-venue counters\nfor each person i:\n  trips = Poisson(average_daily_trips_per_person)\n  for t in 1..trips:\n    select venue v by type weights (workplace_share, school_share, public_space_share) and capacity availability\n    if v.policy_mask_required and i.mask_wearing == false and random() < entry_denial_rate_if_noncompliant * v.enforcement_strength:\n      deny entry; continue\n    assign i.current_venue_id = v.id\n    v.daily_visitors += 1\n    record i.mask_wearing for venue observation\nfor each venue v:\n  venue_observed_mask_share_daily[v] = mean(mask_wearing among visitors) or 0 if no visitors\n  v.broadcast_local_rules = v.policy_mask_required",
        "notes": [
          "Venue observation is used by SocialInfluenceAndNorms in next tick",
          "Capacity is a soft limit; overflows are discouraged by selection probability"
        ]
      },
      "requirements": [],
      "module_parameters": [
        "average_daily_trips_per_person",
        "venues_count",
        "workplace_share",
        "school_share",
        "public_space_share",
        "default_venue_capacity",
        "venue_assignment_bias_home",
        "observation_weight_venue",
        "entry_denial_rate_if_noncompliant"
      ]
    },
    {
      "name": "RetailMarket",
      "description": "Handles mask demand, sales, restocking, price adjustments, and rationing.",
      "inputs": [
        "Person.mask_inventory",
        "Person.income",
        "Retailer.stock",
        "Retailer.price"
      ],
      "outputs": [
        "Person.mask_inventory",
        "Retailer.stock",
        "Retailer.price",
        "masks_sold_daily",
        "stockout_flag_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "masks_sold_daily = 0; stockout_flag_daily = 0\n# Demand and purchase\nfor each person i:\n  desired = max(0, minimum_inventory_target - i.mask_inventory)\n  # price-sensitive demand scaling\n  scale = (Retailer.price / mask_price) ** price_elasticity_of_demand\n  desired = round(desired * scale)\n  if rationing_policy_active: desired = min(desired, max_purchase_per_visit)\n  allocate desired across retailers until fulfilled or stocks exhausted\n  for retailer r in randomized order:\n    buy = min(desired, r.stock)\n    cost = buy * r.price\n    if buy > 0 and i.income >= cost:\n      r.stock -= buy; i.mask_inventory += buy; i.has_mask = (i.mask_inventory > 0)\n      masks_sold_daily += buy; desired -= buy\n  if any retailer stock == 0: stockout_flag_daily = 1\n# Restock and price adjust\nfor each retailer r:\n  restock_amount = max(0, Normal(retailer_restock_rate_per_day, restock_std))\n  r.stock += round(restock_amount)\n  # simple price adjustment if persistent stockouts\n  if stockout_flag_daily == 1: r.price = r.price * 1.02 else r.price = max(0.5, r.price * 0.999)",
        "notes": [
          "Income is not decremented; cost is a proxy constraint on purchasing ability",
          "Elasticity < 0 means higher prices reduce desired quantity"
        ]
      },
      "requirements": [],
      "module_parameters": [
        "retailer_initial_stock",
        "retailer_restock_rate_per_day",
        "mask_price",
        "price_elasticity_of_demand",
        "rationing_policy_active",
        "retailers_count",
        "max_purchase_per_visit",
        "restock_std"
      ]
    },
    {
      "name": "AdoptionDecision",
      "description": "Computes wearing decision via a logistic utility blending attitude, risk, norms, policy, cost, and supply.",
      "inputs": [
        "Person.mask_attitude",
        "Person.risk_perception",
        "Person.norm_perception",
        "Person.trust_in_authorities",
        "Person.mask_inventory",
        "PolicyAndEnforcement.mandate_active",
        "PolicyAndEnforcement.fine_amount"
      ],
      "outputs": [
        "Person.wear_probability",
        "Person.mask_wearing",
        "Person.ever_masked"
      ],
      "dependencies": [
        "SocialInfluenceAndNorms",
        "PolicyAndEnforcement",
        "RetailMarket"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  supply_term = 1.0 if i.mask_inventory >= supply_wear_threshold else 0.0\n  policy_term = (mandate_active ? 1 : 0) * policy_penalty_weight\n  cost_term = - compliance_cost * (mandate_active ? 0.5 : 1.0)  # mandates can offset perceived cost\n  utility = base_utility_intercept\n  utility += attitude_weight * i.mask_attitude\n  utility += risk_weight * i.risk_perception\n  utility += norm_weight * i.norm_perception\n  utility += policy_term * i.trust_in_authorities\n  utility += cost_term\n  utility += 0.5 * supply_term\n  # habit/fatigue\n  if i.mask_wearing == true: utility += habit_gain_rate else utility -= fatigue_rate\n  wear_prob = 1 / (1 + exp(-utility))\n  i.wear_probability = wear_prob\n  i.mask_wearing = (supply_term == 1.0) and (random() < wear_prob)\n  i.ever_masked = i.ever_masked or i.mask_wearing\n  if i.mask_wearing: i.mask_inventory = max(0, i.mask_inventory - 1); i.has_mask = (i.mask_inventory > 0)",
        "notes": [
          "One mask consumed per day of wearing; can be parameterized further if needed",
          "Trust modulates policy effect positively"
        ]
      },
      "requirements": [],
      "module_parameters": [
        "compliance_cost",
        "base_utility_intercept",
        "risk_weight",
        "attitude_weight",
        "norm_weight",
        "policy_penalty_weight",
        "supply_wear_threshold",
        "minimum_inventory_target",
        "fatigue_rate",
        "habit_gain_rate"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and computes roll-ups needed by metrics.",
      "inputs": [
        "Person.mask_wearing",
        "Person.ever_masked",
        "Person.income",
        "RetailMarket.masks_sold_daily",
        "RetailMarket.stockout_flag_daily",
        "PolicyAndEnforcement.enforcement_actions_count_daily",
        "PolicyAndEnforcement.venue_compliance_rate_daily"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.cumulative_adopters_share",
        "observable.adoption_rate_low_income_daily",
        "observable.adoption_rate_high_income_daily",
        "observable.average_masks_sold_per_day",
        "observable.stockout_days",
        "observable.enforcement_actions_count",
        "observable.venue_compliance_rate",
        "observable.message_reach_rate_daily"
      ],
      "dependencies": [
        "AdoptionDecision",
        "RetailMarket",
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate_daily = mean(Person.mask_wearing)\ncumulative_adopters_share = mean(Person.ever_masked)\n# Income thresholds\nlow_income_group = persons with income <= income_threshold_low\nhigh_income_group = persons with income >= income_threshold_high\nadoption_rate_low_income_daily = mean(mask_wearing over low_income_group) if group not empty else 0\nadoption_rate_high_income_daily = mean(mask_wearing over high_income_group) if group not empty else 0\n# Retail aggregates (rolling)\nupdate running mean of masks_sold_daily -> average_masks_sold_per_day\nif any Retailer stock == 0 today: increment stockout_days\n# Enforcement and venue compliance\nenforcement_actions_count += enforcement_actions_count_daily\nvenue_compliance_rate = venue_compliance_rate_daily  # already averaged within Policy module\n# Message reach (fraction who saw message today)\nmessage_reach_rate_daily = fraction of persons with last_message_day == today",
        "notes": [
          "Maintains cumulative counts in module state for stockout_days and average sold masks"
        ]
      },
      "requirements": [],
      "module_parameters": [
        "income_threshold_low",
        "income_threshold_high",
        "gini_epsilon"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 100,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Number of persons in the population.",
      "frozen": true
    },
    {
      "key": "simulation_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 10,
        "high": 1000
      },
      "owner_module": "global",
      "description": "Total number of days to simulate.",
      "frozen": true
    },
    {
      "key": "time_step_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.5,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Time step in days.",
      "frozen": true
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "global",
