  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.cumulative_adopters_share",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.ever_masked)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.adoption_rate_low_income_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing | income <= income_threshold_low)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.adoption_rate_high_income_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing | income >= income_threshold_high)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.average_masks_sold_per_day",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "running_mean(RetailMarket.masks_sold_daily)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.stockout_days",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative_sum(RetailMarket.stockout_flag_daily)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": null
    },
    {
      "id": "observable.enforcement_actions_count",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative_sum(PolicyAndEnforcement.enforcement_actions_count_daily)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": null
    },
    {
      "id": "observable.venue_compliance_rate",
      "source_module": "PolicyAndEnforcement",
      "formula_or_field": "venue_compliance_rate_daily",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.message_reach_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "fraction(Person.last_message_day == today)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    }
  ],
  "metrics": [
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5,
          "direction": ">=",
          "max_time": 120
        }
      }
    },
    {
      "name": "policy_effect_on_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "DifferenceBeforeAfter",
        "config": {
          "cut_day": 30,
          "pre_window": 7,
          "post_window": 7,
          "stat": "mean"
        }
      }
    },
    {
      "name": "adoption_inequality_by_income",
      "inputs": [
        "observable.adoption_rate_high_income_daily",
        "observable.adoption_rate_low_income_daily"
      ],
      "definition": {
        "type": "HighLowGap",
        "config": {
          "aggregation": "mean_over_period"
        }
      }
    },
    {
      "name": "average_masks_sold_per_day",
      "inputs": [
        "observable.average_masks_sold_per_day"
      ],
      "definition": {
        "type": "Summary",
        "config": {
          "stat": "last"
        }
      }
    },
    {
      "name": "stockout_days",
      "inputs": [
        "observable.stockout_days"
      ],
      "definition": {
        "type": "Summary",
        "config": {
          "stat": "last"
        }
      }
    },
    {
      "name": "enforcement_actions_count",
      "inputs": [
        "observable.enforcement_actions_count"
      ],
      "definition": {
        "type": "Summary",
        "config": {
          "stat": "last"
        }
      }
    },
    {
      "name": "venue_compliance_rate",
      "inputs": [
        "observable.venue_compliance_rate"
      ],
      "definition": {
        "type": "Summary",
        "config": {
          "stat": "mean_over_period"
        }
      }
    },
    {
      "name": "message_reach_rate",
      "inputs": [
        "observable.message_reach_rate_daily"
      ],
      "definition": {
        "type": "Summary",
        "config": {
          "stat": "mean_over_period"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network": {
      "type": "small_world",
      "average_degree": 10,
      "rewire_prob": 0.1
    },
    "households": {
      "method": "poisson",
      "household_size_mean": 2.6,
      "max_size": 6
    },
    "venues": {
      "count": 200,
      "type_mix": {
        "workplace": 0.4,
        "school": 0.2,
        "public_space": 0.4
      },
      "capacity": 200,
      "enforcement_strength_dist": "truncated_normal(mean=0.6,std=0.2,bounds=[0,1])"
    },
    "retailers": {
      "count": 10,
      "initial_stock_per_retailer": 10000,
      "restock_rate_per_day": 1000,
      "price": 1.5
    },
    "policy": {
      "mandate_active_initial": false,
      "mandate_start_day": 30
    }
  },
  "algorithms": {
    "weighted_threshold_attitude_update": "Attitude change is proportional to tanh of weighted social input (peers, observations, messages) times conformity, damped by influence_decay_rate.",
    "logistic_wear_decision": "Wear probability computed via logistic(utility), where utility blends attitude, risk, norm, policy, cost, and supply terms.",
    "price_elastic_demand": "Desired purchase quantity scales by (price/current_price_ref) ** elasticity before rationing and availability constraints.",
    "inspection_enforcement": "Stochastic selection of venues for inspection with enforcement actions proportional to detected noncompliance and constrained by budget."
  },
