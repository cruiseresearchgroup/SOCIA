      },
      "owner_module": "global",
      "description": "Mean household size for Poisson assignment.",
      "frozen": false
    },
    {
      "key": "household_income_lognormal_mu",
      "dtype": "float",
      "default": 10.5,
      "bounds": {
        "low": 8.0,
        "high": 12.0
      },
      "owner_module": "global",
      "description": "Mu parameter for lognormal income (log-space).",
      "frozen": false
    },
    {
      "key": "household_income_lognormal_sigma",
      "dtype": "float",
      "default": 0.8,
      "bounds": {
        "low": 0.2,
        "high": 1.5
      },
      "owner_module": "global",
      "description": "Sigma parameter for lognormal income (log-space).",
      "frozen": false
    },
    {
      "key": "venues_count",
      "dtype": "int",
      "default": 200,
      "bounds": {
        "low": 10,
        "high": 10000
      },
      "owner_module": "MobilityAndVenues",
      "description": "Total number of venues.",
      "frozen": false
    },
    {
      "key": "workplace_share",
      "dtype": "float",
      "default": 0.4,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MobilityAndVenues",
      "description": "Share of venues that are workplaces.",
      "frozen": false
