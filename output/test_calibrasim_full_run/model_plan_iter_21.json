      "dtype": "categorical",
      "default": "lognormal",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "global",
      "description": "Distribution family for household income.",
      "frozen": true
    },
    {
      "key": "household_size_mean",
      "dtype": "float",
      "default": 2.6,
      "bounds": {
        "low": 1.0,
