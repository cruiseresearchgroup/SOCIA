      },
      {
        "name": "aggregation.py",
        "description": "Implements AdoptionAggregator and metrics computation."
      },
      {
        "name": "utils.py",
        "description": "Shared utilities, RNG seeding, distributions, metrics helpers."
      },
      {
        "name": "config.py",
        "description": "Parameter schema, validation, and defaults."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy",
      "pydantic"
    ]
  },
  "prediction_period": {
    "start_day": null,
    "end_day": null
  },
  "evaluation_metrics": [
    "adoption_rate_over_time",
    "time_to_50_percent_adoption",
    "peak_adoption",
    "sustained_adoption_rate_final",
    "mandate_compliance_rate",
    "adoption_inequality_index",
    "incidence_reduction_optional",
    "policy_cost_proxy"
  ]
}