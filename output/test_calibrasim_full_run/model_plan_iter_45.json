{
  "model_type": "agent_based",
  "description": "Agent-based, network-embedded social simulation of mask adoption under peer influence, policy interventions, risk perception, and market constraints, with optional disease transmission dynamics.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age_group",
        "health_risk_level",
        "socioeconomic_status",
        "trust_in_authority",
        "peer_influence_weight",
        "risk_perception",
        "cost_sensitivity",
        "baseline_compliance_propensity",
        "mask_owned",
        "is_wearing_mask",
        "awareness_level",
        "daily_contacts_home",
        "daily_contacts_work",
        "daily_contacts_public",
        "location_id",
        "infection_status_optional",
        "vaccination_status_optional",
        "social_network_neighbors"
      ],
      "behaviors": [
        "decide_mask_use",
        "update_risk_perception",
        "consume_information",
        "interact_with_peers",
        "purchase_masks",
        "move_between_locations",
        "comply_with_mandate",
        "wear_mask_in_interaction"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_group_distribution": {
            "0-17": 0.22,
            "18-34": 0.26,
            "35-64": 0.36,
            "65+": 0.16
          },
          "health_risk_level_probs": {
            "low": 0.6,
            "medium": 0.3,
            "high": 0.1
          },
          "socioeconomic_status_probs": {
            "low": 0.3,
            "middle": 0.5,
            "high": 0.2
          },
          "trust_in_authority_dist": {
            "type": "beta",
            "alpha": 3.0,
            "beta": 2.0
          },
          "peer_influence_weight_dist": {
            "type": "lognormal",
            "mean": -0.2,
            "sigma": 0.5
          },
          "risk_perception_init": {
            "type": "uniform",
            "low": 0.2,
            "high": 0.5
          },
          "cost_sensitivity_dist": {
            "type": "lognormal",
            "mean": -0.3,
            "sigma": 0.6
          },
          "baseline_compliance_dist": {
            "type": "beta",
            "alpha": 2.5,
            "beta": 2.5
          },
          "awareness_level_init": {
            "type": "uniform",
            "low": 0.2,
            "high": 0.5
          },
          "vaccination_status_init": {
            "coverage": 0.0
          },
          "mask_owned_init_prob": 0.25,
          "is_wearing_mask_init_prob": 0.2
        }
      }
    },
    {
      "name": "Household",
      "attributes": [
        "id",
        "member_ids",
        "mask_inventory",
        "budget_constraint"
      ],
      "behaviors": [
        "share_masks",
        "coordinate_purchases"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "household_size_distribution": {
            "1": 0.28,
            "2": 0.34,
            "3": 0.17,
            "4": 0.13,
            "5+": 0.08
          },
          "budget_constraint_dist": {
            "type": "lognormal",
            "mean": 3.0,
            "sigma": 0.6
          },
          "mask_inventory_init": {
            "type": "poisson",
            "lambda": 1.0
          }
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type_home_work_school_public",
        "capacity",
        "mask_enforcement_level",
        "base_contact_rate",
        "local_prevalence_signal_optional"
      ],
      "behaviors": [
        "host_contacts",
        "enforce_policy"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_workplaces": 50,
          "num_public_places": 30,
          "num_schools": 10,
          "capacity_rules": {
            "home": 6,
            "work": 40,
            "school": 200,
            "public": 100
          },
          "mask_enforcement_level_mean": 0.5,
          "base_contact_rate_by_type": {
            "home": 4,
            "work": 6,
            "school": 8,
            "public": 8
          }
        }
      }
    },
    {
      "name": "PublicHealthAuthority",
      "attributes": [
        "mandate_status",
        "enforcement_probability",
        "fine_amount",
        "communication_intensity",
        "messaging_strategy"
      ],
      "behaviors": [
        "issue_or_lift_mandates",
        "conduct_information_campaigns",
        "distribute_masks"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_status": false,
          "enforcement_probability": 0.3,
          "fine_amount": 50.0,
          "communication_intensity": 0.5,
          "messaging_strategy": "risk_emphasis"
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "mask_price",
        "inventory_level",
        "restock_rate",
        "price_elasticity"
      ],
      "behaviors": [
        "adjust_price",
        "sell_masks",
        "replenish_stock"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_retailers": 10,
          "initial_price": 1.0,
          "initial_inventory_per_1000": 1000,
          "restock_rate": 0.5,
          "price_elasticity": 0.2
        }
      }
    }
  ],
  "modules": [
    {
      "name": "NetworkAndLocationBuilder",
      "description": "Builds social network (small-world) and assigns agents to households and locations.",
      "inputs": [],
      "outputs": [
        "graph.social",
        "mapping.person_to_household",
        "mapping.person_to_work",
        "mapping.person_to_school",
        "mapping.person_to_public"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == 0:\n  G = watts_strogatz_graph(population_size, network_avg_degree, p=0.1, seed=seed)\n  assign households using household_size_mean and household_size_distribution\n  create locations with counts num_workplaces, num_public_places, num_schools\n  set location.mask_enforcement_level ~ beta(mean=location_mask_enforcement_mean)\n  assign each Person daily_contacts_* from contact_rate_* with small noise\n  map persons to home/work/school/public locations\n  output graph and mappings",
        "notes": [
          "Runs only at t=0 to initialize structures.",
          "Small random noise can be added to contact rates to reflect heterogeneity."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "network_type",
        "network_avg_degree",
        "num_workplaces",
        "num_public_places",
        "num_schools",
        "household_size_mean",
        "seed"
      ]
    },
    {
      "name": "InformationCampaign",
      "description": "Models public health messaging and its effects on awareness and risk perception with delay and decay.",
      "inputs": [
        "signal.local_prevalence_optional",
        "state.mandate_status"
      ],
      "outputs": [
        "Person.awareness_level",
        "signal.campaign_cost_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each Person i:\n  trust = i.trust_in_authority\n  delayed_msg = rolling_mean(communication_intensity * mandate_status, window=information_delay_days+1)\n  msg_effect = messaging_strategy_coeff(messaging_strategy) * delayed_msg\n  i.awareness_level = (1 - awareness_decay_rate) * i.awareness_level + trust * msg_effect\n  risk_increment = risk_perception_sensitivity * i.awareness_level\n  i.risk_perception = clamp(i.risk_perception + risk_increment, 0, 1)\ncompute campaign_cost = campaign_cost_per_day_per_1000 * population_size / 1000.0\nemit signal.campaign_cost_daily = campaign_cost",
        "notes": [
          "Use a small rolling window to implement information delay.",
          "messaging_strategy_coeff: risk_emphasis=1.0, norms_emphasis=0.8, neutral=0.6."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "communication_intensity",
        "information_delay_days",
        "messaging_strategy",
        "trust_in_authority_mean",
        "trust_in_authority_sd",
        "awareness_decay_rate",
        "campaign_cost_per_day_per_1000",
        "risk_perception_sensitivity"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Handles mandate scheduling, enforcement at locations, fines, denial of entry, and free mask distribution.",
      "inputs": [
        "Location.mask_enforcement_level",
        "Person.is_wearing_mask"
      ],
      "outputs": [
        "state.mandate_status",
        "signal.fines_issued_daily",
        "signal.free_masks_distributed_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "mandate_status = mandate_status_initial\nif mandate_start_day <= t < mandate_end_day: mandate_status = True\nelse: mandate_status = False\nfines = 0; distributed = 0\nif mandate_status:\n  for each contact event or location entry attempt:\n    effective_enforcement = enforcement_probability * location.mask_enforcement_level\n    if person not wearing:\n      if bernoulli(effective_enforcement * deny_entry_probability): deny entry -> person cannot enter, no fine\n      else if bernoulli(effective_enforcement): apply fine_amount; fines += fine_amount\nif free_mask_distribution_per_1000 > 0:\n  quota = int(free_mask_distribution_per_1000 * population_size / 1000)\n  prioritize households with low SES and low inventory; distribute masks up to quota\n  distributed = actual_distributed_count\nemit signals fines_issued_daily=fines, free_masks_distributed_daily=distributed, state.mandate_status=mandate_status",
        "notes": [
          "Enforcement occurs at point of entry or during contact events.",
          "Free masks increase household and person mask_owned counts."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "mandate_effect_strength",
        "enforcement_probability",
        "fine_amount",
        "mandate_status_initial",
        "mandate_start_day",
        "mandate_end_day",
        "deny_entry_probability",
        "free_mask_distribution_per_1000",
        "location_mask_enforcement_mean"
      ]
    },
    {
      "name": "MarketAndSupply",
      "description": "Retail mask market: demand-driven sales, price adjustment, and inventory restocking.",
      "inputs": [
        "signal.total_mask_demand_daily"
      ],
      "outputs": [
        "signal.avg_price_daily",
        "signal.total_masks_sold_daily",
        "signal.inventory_level_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "supply_today = mask_supply_daily_per_1000 * population_size / 1000.0\nfor each Retailer r:\n  r.inventory_level += retailer_restock_rate * supply_today / num_retailers\ncompute demand = signal.total_mask_demand_daily\nexcess_demand = max(demand - total_inventory, 0)\nprice_adjustment_factor = 1 + retailer_price_elasticity * (excess_demand / max(total_inventory,1))\nfor each Retailer r:\n  r.mask_price = max(0.1, mask_cost * price_adjustment_factor)\nfulfill purchases FIFO across retailers until inventory exhausted\nsold = min(demand, total_inventory)\nreduce inventories accordingly\nemit avg_price_daily=mean(r.mask_price), total_masks_sold_daily=sold, inventory_level_daily=sum(r.inventory_level)",
        "notes": [
          "If inventories are low relative to demand, prices rise according to elasticity.",
          "Households coordinate purchases via BehaviorAndAdoption which emits demand."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "mask_cost",
        "retailer_price_elasticity",
        "mask_supply_daily_per_1000",
        "retailer_initial_inventory_per_1000",
        "retailer_restock_rate",
        "household_budget_mean",
        "household_budget_sd",
        "price_sensitivity_income_scaling"
      ]
    },
    {
      "name": "BehaviorAndAdoption",
      "description": "Agents update risk perceptions via peers and decide to wear masks; also initiates purchase demand given stock and budgets.",
      "inputs": [
        "graph.social",
        "state.mandate_status",
        "signal.avg_price_daily"
      ],
      "outputs": [
        "signal.total_mask_demand_daily",
        "Person.is_wearing_mask",
        "Person.mask_owned"
      ],
      "dependencies": [
        "NetworkAndLocationBuilder",
        "PolicyAndEnforcement",
        "MarketAndSupply",
        "InformationCampaign"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "demand = 0\nfor each Person i:\n  peer_mask_frac = mean(is_wearing_mask of neighbors in graph.social)\n  norm_signal = peer_influence_strength * peer_mask_frac\n  perceived_cost = signal.avg_price_daily * (1 + price_sensitivity_income_scaling / SES_factor(i))\n  utility = i.baseline_compliance_propensity\n  utility += norm_signal\n  utility += i.risk_perception\n  if state.mandate_status: utility += mandate_effect_strength\n  utility -= i.cost_sensitivity * perceived_cost\n  utility = utility - adoption_decay_rate_without_stimulus\n  p_wear = sigmoid(utility, k=1/learning_rate_behavior_update)\n  i.is_wearing_mask = (i.mask_owned > 0) and bernoulli(p_wear)\n  if i.is_wearing_mask == False and p_wear > 0.5 and i.mask_owned == 0:\n    # attempt to purchase one mask\n    if household_budget_remaining(i.household) >= signal.avg_price_daily:\n      demand += 1\n# After MarketAndSupply fulfills sales (next module order), increment mask_owned for buyers stochastically matched to sales\nemit signal.total_mask_demand_daily=demand",
        "notes": [
          "SES_factor(i) is higher for high SES so perceived cost weight is lower.",
          "Purchases are coordinated at household level: buyers chosen among households with budget and low inventory."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "peer_influence_strength",
        "risk_perception_sensitivity",
        "learning_rate_behavior_update",
        "adoption_decay_rate_without_stimulus",
        "cost_sensitivity_mean",
        "cost_sensitivity_sd"
      ]
    },
    {
      "name": "MobilityAndContacts",
      "description": "Assigns daily locations and generates contact events across home/work/school/public contexts.",
      "inputs": [
        "Person.daily_contacts_home",
        "Person.daily_contacts_work",
        "Person.daily_contacts_public"
      ],
      "outputs": [
        "events.contact_list_daily"
      ],
      "dependencies": [
        "NetworkAndLocationBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "events = []\nfor each household h:\n  sample pairwise contacts ~ Poisson(contact_rate_home)\n  append to events with context='home'\nfor each workplace/school/public location L:\n  sample attendees based on assignment and capacity\n  generate random pairs according to context-specific contact rates\n  append to events\nemit events.contact_list_daily = events",
        "notes": [
          "Contact sampling uses binomial or Poisson approximations per context.",
          "Location-level enforcement signals are used by PolicyAndEnforcement."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "contact_rate_home",
        "contact_rate_work",
        "contact_rate_public"
      ]
    },
    {
      "name": "DiseaseTransmission",
      "description": "Optional module to simulate infection spread; computes incidence and effects of masks on transmission and acquisition.",
      "inputs": [
        "events.contact_list_daily",
        "Person.is_wearing_mask",
        "Person.vaccination_status_optional"
      ],
      "outputs": [
        "observable.infections_daily",
        "state.prevalence"
      ],
      "dependencies": [
        "MobilityAndContacts"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if not enable_disease: emit zeros and return\nif t == 0: seed infections according to initial_infection_prevalence\nnew_infections = 0\nfor each contact (i, j):\n  if infectious(i) and susceptible(j):\n    p = base_transmission_prob\n    if i.is_wearing_mask: p *= (1 - mask_efficacy_against_transmission)\n    if j.is_wearing_mask: p *= (1 - mask_efficacy_against_acquisition)\n    if vaccinated(j): p *= (1 - vaccination_effectiveness)\n    if bernoulli(p): infect(j); new_infections += 1\nupdate recovery timers; recover agents after recovery_period_days\nemit infections_daily=new_infections, prevalence=current_prevalence",
        "notes": [
          "Well-mixed within generated contacts; no environmental transmission.",
          "Supports evaluating incidence reduction vs a no-mask baseline."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "enable_disease",
        "initial_infection_prevalence",
        "mask_efficacy_against_transmission",
        "mask_efficacy_against_acquisition",
        "base_transmission_prob",
        "recovery_period_days",
        "vaccination_coverage",
        "vaccination_effectiveness"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Computes observables and aggregates metrics daily.",
      "inputs": [
        "Person.is_wearing_mask",
        "Person.socioeconomic_status",
        "events.contact_list_daily",
        "state.mandate_status",
        "observable.infections_daily",
        "signal.fines_issued_daily",
        "signal.free_masks_distributed_daily",
        "signal.campaign_cost_daily"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.mandate_compliance_rate_daily",
        "observable.adoption_by_ses_daily",
        "observable.policy_cost_fines_daily",
        "observable.policy_cost_spending_daily",
        "observable.mask_price_daily",
        "observable.inventory_daily"
      ],
      "dependencies": [
        "BehaviorAndAdoption",
        "PolicyAndEnforcement",
        "MarketAndSupply",
        "DiseaseTransmission"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption = mean(Person.is_wearing_mask)\nif state.mandate_status:\n  contacts = events.contact_list_daily\n  compliance = mean([Person.is_wearing_mask for participants in contacts])\nelse:\n  compliance = NaN\nadoption_by_ses = group_mean(Person.is_wearing_mask by SES)\npolicy_cost_fines = signal.fines_issued_daily\npolicy_cost_spending = signal.free_masks_distributed_daily * observable.mask_price_daily (lagged) + signal.campaign_cost_daily\nemit adoption_rate_daily, mandate_compliance_rate_daily, adoption_by_ses_daily, policy_cost_fines_daily, policy_cost_spending_daily\nalso forward market signals avg_price and inventory from MarketAndSupply as mask_price_daily and inventory_daily",
        "notes": [
          "Compliance rate is computed only when a mandate is active.",
          "Spending includes free mask distribution valued at prevailing price plus campaign cost."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "inequality_index_method",
        "observation_noise_sd"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 1000,
      "bounds": {
        "low": 100,
        "high": 100000
      },
      "owner_module": "global",
      "description": "Total number of Person agents.",
      "frozen": false
    },
    {
      "key": "time_horizon_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Number of simulated days.",
      "frozen": true
    },
    {
      "key": "timestep_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 1.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Length of each time step in days.",
      "frozen": true
    },
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "NetworkAndLocationBuilder",
      "description": "Random seed for reproducibility.",
      "frozen": true
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "NetworkAndLocationBuilder",
      "description": "Type of social network (small_world fixed).",
      "frozen": true
    },
    {
      "key": "network_avg_degree",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "NetworkAndLocationBuilder",
      "description": "Average degree for the social network.",
      "frozen": false
    },
    {
      "key": "initial_mask_adoption_rate",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial probability an individual is wearing a mask at t=0.",
      "frozen": false
    },
    {
      "key": "initial_infection_prevalence",
      "dtype": "float",
      "default": 0.01,
      "bounds": {
        "low": 0.0,
        "high": 0.2
      },
      "owner_module": "DiseaseTransmission",
      "description": "Initial fraction infected.",
      "frozen": false
    },
    {
      "key": "enable_disease",
      "dtype": "bool",
      "default": true,
      "bounds": {
        "low": 0,
        "high": 1
      },
      "owner_module": "DiseaseTransmission",
      "description": "Toggle disease transmission module.",
      "frozen": true
    },
    {
      "key": "contact_rate_home",
      "dtype": "int",
      "default": 4,
      "bounds": {
        "low": 0,
        "high": 20
      },
      "owner_module": "MobilityAndContacts",
      "description": "Expected daily contacts at home per person.",
      "frozen": false
    },
    {
      "key": "contact_rate_work",
      "dtype": "int",
      "default": 6,
      "bounds": {
        "low": 0,
        "high": 30
      },
      "owner_module": "MobilityAndContacts",
      "description": "Expected daily contacts at work per person.",
      "frozen": false
    },
    {
      "key": "contact_rate_public",
      "dtype": "int",
      "default": 8,
      "bounds": {
        "low": 0,
        "high": 50
      },
      "owner_module": "MobilityAndContacts",
      "description": "Expected daily contacts in public per person.",
      "frozen": false
    },
    {
      "key": "peer_influence_strength",
      "dtype": "float",
      "default": 0.4,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "BehaviorAndAdoption",
      "description": "Weight of peer mask-wearing fraction on adoption utility.",
      "frozen": false
    },
    {
      "key": "risk_perception_sensitivity",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "InformationCampaign",
      "description": "How strongly awareness increases risk perception.",
      "frozen": false
    },
    {
      "key": "learning_rate_behavior_update",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.05,
        "high": 1.0
      },
      "owner_module": "BehaviorAndAdoption",
      "description": "Slope parameter for sigmoid response to utility.",
      "frozen": false
    },
    {
      "key": "adoption_decay_rate_without_stimulus",
      "dtype": "float",
      "default": 0.01,
      "bounds": {
        "low": 0.0,
        "high": 0.2
      },
      "owner_module": "BehaviorAndAdoption",
      "description": "Daily decay of adoption propensity in absence of stimuli.",
      "frozen": false
    },
    {
      "key": "trust_in_authority_mean",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "InformationCampaign",
      "description": "Mean trust in authority for population initialization.",
      "frozen": false
    },
    {
