  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.is_wearing_mask)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.mandate_compliance_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.is_wearing_mask | mandate_active)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "policy.csv:compliance_rate"
    },
    {
      "id": "observable.adoption_by_ses_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(Person.is_wearing_mask, Person.socioeconomic_status)",
      "frequency": "daily",
      "aggregation": "by_group(socioeconomic_status)",
      "target_data_field": "train_data.csv:adoption_by_ses"
    },
    {
      "id": "observable.policy_cost_fines_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "sum(fines_issued_daily)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "policy.csv:fines_issued"
    },
    {
      "id": "observable.policy_cost_spending_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "free_masks_distributed_daily * mask_price_daily + campaign_cost_daily",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "policy.csv:spending"
    },
    {
      "id": "observable.infections_daily",
      "source_module": "DiseaseTransmission",
      "formula_or_field": "new_infections",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "cases.csv:new_cases"
    },
    {
      "id": "observable.mask_price_daily",
      "source_module": "MarketAndSupply",
      "formula_or_field": "mean(Retailer.mask_price)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "market.csv:mask_price"
    },
    {
      "id": "observable.inventory_daily",
      "source_module": "MarketAndSupply",
      "formula_or_field": "sum(Retailer.inventory_level)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "market.csv:inventory"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {}
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5
        }
      }
    },
    {
      "name": "peak_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Peak",
        "config": {
          "return_time": true
        }
      }
    },
    {
      "name": "sustained_adoption_rate_final",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "WindowMean",
        "config": {
          "window_days": 14,
          "position": "trailing_end"
        }
      }
    },
    {
      "name": "mandate_compliance_rate",
      "inputs": [
        "observable.mandate_compliance_rate_daily"
      ],
      "definition": {
        "type": "ConditionalMean",
        "config": {
          "ignore_nan": true
        }
      }
    },
    {
      "name": "adoption_inequality_index",
      "inputs": [
        "observable.adoption_by_ses_daily"
      ],
      "definition": {
        "type": "InequalityIndex",
        "config": {
          "method": "gini"
        }
      }
    },
    {
      "name": "incidence_reduction_optional",
      "inputs": [
        "observable.infections_daily"
      ],
      "definition": {
        "type": "PctReductionVsBaseline",
        "config": {
          "baseline_scenario": "no_masks"
        }
      }
    },
    {
      "name": "policy_cost_proxy",
      "inputs": [
        "observable.policy_cost_fines_daily",
        "observable.policy_cost_spending_daily"
      ],
      "definition": {
        "type": "Sum",
        "config": {
          "combine": "sum",
          "cumulative": true
        }
      }
    },
    {
      "name": "RMSE_adoption_vs_data",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "target_field": "train_data.csv:adoption_rate"
        }
      }
    }
  ],
  "environment": {
    "type": "network+locations",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network": {
      "type": "small_world",
      "avg_degree": 10,
      "rewiring_prob": 0.1
    },
    "mask_adoption_rate": 0.2,
    "infection_prevalence": 0.01,
    "retail": {
      "num_retailers": 10,
      "initial_inventory_per_1000": 1000,
      "initial_price": 1.0
    },
    "policy": {
      "mandate_status_initial": false,
      "mandate_start_day": 30,
      "mandate_end_day": 120,
      "enforcement_probability": 0.3,
      "fine_amount": 50.0
    }
  },
  "algorithms": {
    "WattsStrogatz": "Generates small-world social network with given average degree and rewiring probability.",
    "DeGrootUpdate": "Awareness and risk perception updates via weighted averaging of signals (implemented in InformationCampaign).",
    "LogitDecision": "Sigmoid-based conversion of utility to probability of mask wearing.",
    "DemandPricing": "Retail price adjustment proportional to excess demand and elasticity.",
    "ContactSampling": "Poisson/binomial sampling of contacts per location type.",
    "SEIR-lite": "Simple infection transmission and recovery without explicit exposed state."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Empirical series of observed mask adoption to calibrate/validate time series.",
      "fields_used": [
        "adoption_rate",
        "adoption_by_ses"
      ]
    },
    {
      "name": "policy.csv",
      "purpose": "Mandate timing and observed compliance/fines for comparison.",
      "fields_used": [
        "mandate_flag",
        "compliance_rate",
        "fines_issued",
        "spending"
      ]
    },
    {
      "name": "cases.csv",
      "purpose": "Observed infection incidence for optional epidemiological validation.",
      "fields_used": [
        "new_cases"
      ]
    },
    {
      "name": "market.csv",
      "purpose": "Mask prices and inventories for market validation.",
      "fields_used": [
        "mask_price",
        "inventory"
      ]
    }
  ],
  "code_structure": {
