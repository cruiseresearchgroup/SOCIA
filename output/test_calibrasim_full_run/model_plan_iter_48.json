{
  "model_type": "agent_based",
  "description": "An agent-based, network-embedded simulation of mask-wearing behavior diffusion under social influence, public policy, media messaging, and retail supply constraints. Persons are nodes in a small-world contact network, attend locations with varying enforcement, update beliefs and habits from signals, and decide daily mask use based on a weighted propensity and threshold mechanism.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "income",
        "education_level",
        "political_ideology",
        "health_status",
        "risk_perception",
        "trust_in_authorities",
        "trust_in_media",
        "social_norm_sensitivity",
        "conformity_threshold",
        "stubbornness",
        "mask_ownership",
        "mask_inventory",
        "mask_quality",
        "perceived_mask_efficacy",
        "habit_strength",
        "fatigue_level",
        "home_location_id",
        "work_location_id",
        "daily_contacts",
        "network_neighbors",
        "message_exposure_cumulative",
        "mask_wearing"
      ],
      "behaviors": [
        "decide_mask_use",
        "interact_with_people",
        "observe_peers",
        "update_beliefs_and_risk_perception",
        "respond_to_policy_and_enforcement",
        "purchase_masks",
        "attend_locations",
        "share_opinions_word_of_mouth"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": "synthetic (18-85)",
          "income_distribution": "lognormal(mean_log=10.5, sigma=0.6)",
          "education_level_distribution": "categorical{HS:0.3, SomeCollege:0.3, BA:0.25, Grad:0.15}",
          "political_ideology_distribution": "categorical{-1:0.35, 0:0.3, +1:0.35}",
          "health_status_distribution": "categorical{low:0.5, med:0.35, high:0.15}",
          "trust_in_authorities": "beta(2,2)",
          "trust_in_media": "beta(2,2)",
          "social_norm_sensitivity": "normal(0.5, 0.15) clipped [0,1]",
          "conformity_threshold": "normal(0.5, 0.1) clipped [0,1]",
          "stubbornness": "normal(0.3, 0.1) clipped [0,1]",
          "perceived_mask_efficacy": "normal(0.5, 0.15) clipped [0,1]",
          "habit_strength": "0 for non-adopters, normal(0.2,0.05) for adopters",
          "fatigue_level": "0",
          "mask_inventory": "Poisson(lambda=initial_mask_stock_per_capita)",
          "mask_quality": "uniform(0.6,0.9)",
          "daily_contacts": "Poisson(lambda=contact_rate_base)"
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "region_id",
        "foot_traffic",
        "mask_requirement",
        "enforcement_level"
      ],
      "behaviors": [
        "admit_person",
        "enforce_mask_rules",
        "broadcast_local_rules"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "n_locations": 200,
          "types": "categorical{retail:0.4, office:0.3, transit:0.1, leisure:0.2}",
          "capacity_distribution": "normal(50, 15) clipped [10,200]",
          "region_id": "uniform assignment across 5 regions",
          "foot_traffic": "capacity * mobility_level_base",
          "mask_requirement": "false at start, toggled by policy",
          "enforcement_level": "normal(location_enforcement_level_default, 0.1) clipped [0,1]"
        }
      }
    },
    {
      "name": "PolicyMaker",
      "attributes": [
        "id",
        "mandate_active",
        "mandate_start_day",
        "enforcement_probability",
        "fine_amount",
        "communication_frequency",
        "message_content",
        "targeting_strategy",
        "budget"
      ],
      "behaviors": [
        "set_or_adjust_policy",
        "broadcast_public_health_messages",
        "allocate_enforcement_resources"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "id": 1,
          "mandate_active": false,
          "mandate_start_day": 30,
          "communication_frequency": "policy_message_intensity",
          "targeting_strategy": "risk-and-low-compliance targeting",
          "budget": 100000.0
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "stock",
        "price",
        "restock_rate",
        "rationing_policy"
      ],
      "behaviors": [
        "sell_masks",
        "restock_inventory",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "n_retailers": 50,
          "stock": "Poisson(population_size * initial_mask_stock_per_capita / n_retailers)",
          "price": "mask_price",
          "restock_rate": "retailer_restock_rate",
          "rationing_policy": "rationing_policy"
        }
      }
    },
    {
      "name": "MediaOutlet",
      "attributes": [
        "id",
        "reach",
        "bias",
        "credibility",
        "stance",
        "message_schedule"
      ],
      "behaviors": [
        "broadcast_message",
        "target_audiences"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "n_outlets": 8,
          "reach": "Dirichlet(1,...,1) across outlets",
          "bias": "normal(media_bias_center, 0.3) clipped [-1,1]",
          "credibility": "normal(media_credibility_mean, 0.15) clipped [0,1]",
          "stance": "sign of bias; maps to mask supportive/neutral/skeptical",
          "message_schedule": "every message_frequency days"
        }
      }
    },
    {
      "name": "Environment",
      "attributes": [
        "day",
        "disease_prevalence",
        "mobility_level"
      ],
      "behaviors": [
        "update_context_signals"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "day": 0,
          "disease_prevalence": "initial_disease_prevalence",
          "mobility_level": "mobility_level_base"
        }
      }
    }
  ],
  "modules": [
    {
      "name": "Initializer",
      "description": "Creates agents, assigns attributes, seeds initial adoption and inventories.",
      "inputs": [],
      "outputs": [
        "state.persons_initialized",
        "state.locations_initialized",
        "state.retailers_initialized",
        "state.media_initialized"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 0
      },
      "update_rule": {
        "pseudocode": "if day == 0:\n  create N=population_size persons with attributes per distributions\n  assign initial mask_wearing = Bernoulli(initial_adoption_rate)\n  assign mask_inventory ~ Poisson(initial_mask_stock_per_capita)\n  adjust habit_strength for initial adopters\n  initialize locations, retailers, media outlets per parameters\n  mark initialization flags",
        "notes": [
          "Runs once at day 0.",
          "Heterogeneity introduced via specified distributions.",
          "Initial adopters consume one mask if inventory>0 when wearing on day 0."
        ]
      },
      "requirements": [
        "rng",
        "config"
      ],
      "module_parameters": [
        "population_size",
        "time_horizon_days",
        "initial_adoption_rate",
        "heterogeneity_variance",
        "attrition_rate"
      ]
    },
    {
      "name": "NetworkBuilder",
      "description": "Generates a small-world contact network and assigns network neighbors to persons.",
      "inputs": [
        "state.persons_initialized"
      ],
      "outputs": [
        "state.contact_network"
      ],
      "dependencies": [
        "Initializer"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 0
      },
      "update_rule": {
        "pseudocode": "if day == 0:\n  build Watts-Strogatz graph with N=population_size, k=avg_degree, beta=network_rewiring_prob\n  assign neighbors to Person.network_neighbors from graph adjacency",
        "notes": [
          "Rewiring probability chosen to approximate desired clustering_coefficient.",
          "Graph is static for the simulation horizon."
        ]
      },
      "requirements": [
        "networkx"
      ],
      "module_parameters": [
        "network_type",
        "avg_degree",
        "clustering_coefficient",
        "network_rewiring_prob"
      ]
    },
    {
      "name": "EnvironmentContext",
      "description": "Updates disease prevalence and mobility signals exogenously with a wave and noise; applies mandate mobility reduction.",
      "inputs": [
        "policy.mandate_active"
      ],
      "outputs": [
        "env.disease_prevalence",
        "env.mobility_level"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each day t:\n  prevalence = initial_disease_prevalence + wave_amplitude * exp(-((t - wave_peak_day)^2) / (2 * wave_width^2)) + Normal(0, prevalence_noise_std)\n  prevalence = clamp(prevalence, 0, 1)\n  mobility = mobility_level_base * (1 - mobility_reduction_during_mandate if mandate_active else 1)\n  emit env.disease_prevalence = prevalence, env.mobility_level = mobility",
        "notes": [
          "Prevalence drives risk perception updates.",
          "Mobility impacts attendance and contacts."
        ]
      },
      "requirements": [
        "rng"
      ],
      "module_parameters": [
        "initial_disease_prevalence",
        "wave_peak_day",
        "wave_amplitude",
        "wave_width",
        "prevalence_noise_std",
        "mobility_level_base",
        "mobility_reduction_during_mandate"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Activates/deactivates mask mandate, sets enforcement probability, issues fines, and broadcasts policy signals.",
      "inputs": [
        "env.disease_prevalence"
      ],
      "outputs": [
        "policy.mandate_active",
        "policy.enforcement_probability_effective",
        "policy.fines_issued_daily",
        "policy.message_signal"
      ],
      "dependencies": [
        "Initializer"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "mandate_active = (day >= mandate_start_day and day <= mandate_end_day)\nfor each person i:\n  noncompliant = (not person.mask_wearing) and mandate_active\n  fine_event ~ Bernoulli(enforcement_probability) if noncompliant\n  if fine_event:\n    issue fine_amount to i; accumulate fines_issued += 1\npolicy_message = policy_message_intensity * (1 if mandate_active else 0.5)\nemit mandate_active, enforcement_probability_effective=enforcement_probability, fines_issued_daily, message_signal=policy_message",
        "notes": [
          "Policy messages influence perceived enforcement and compliance pressures.",
          "Fines are applied only when mandate is active."
        ]
      },
      "requirements": [
        "rng",
        "person_registry"
      ],
      "module_parameters": [
        "mandate_start_day",
        "mandate_end_day",
        "enforcement_probability",
        "fine_amount",
        "policy_message_intensity",
        "location_enforcement_level_default"
      ]
    },
    {
      "name": "MediaMessaging",
      "description": "Broadcasts media messages with stance, reach, and credibility; updates persons' message exposure.",
      "inputs": [
        "policy.message_signal"
      ],
      "outputs": [
        "media.message_signal"
      ],
      "dependencies": [
        "Initializer"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day % message_frequency == 0:\n  base_signal = policy.message_signal\n  for each outlet:\n    outlet_signal = base_signal * outlet.credibility * (1 + outlet.bias) + Normal(0, media_noise_std)\n  for each person i:\n    exposure = sum_over_outlets(outlet_signal * outlet.reach * match(ideology,bias))\n    person.message_exposure_cumulative += exposure\nemit media.message_signal = population_mean(exposure)",
        "notes": [
          "match(ideology,bias) increases exposure alignment for congruent biases.",
          "Influencer_fraction used in SocialInfluence for peer messaging, not here."
        ]
      },
      "requirements": [
        "rng",
        "media_registry",
        "person_registry"
      ],
      "module_parameters": [
        "message_frequency",
        "media_noise_std",
        "media_credibility_mean",
        "media_bias_center"
      ]
    },
    {
      "name": "RetailMarket",
      "description": "Sells masks to persons, restocks inventory, adjusts price, and tracks stockouts.",
      "inputs": [
        "env.disease_prevalence",
        "policy.mandate_active"
      ],
      "outputs": [
        "retail.stockout_indicator_daily",
        "retail.avg_price_daily"
      ],
      "dependencies": [
        "Initializer"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "demand_multiplier = 1 + 0.8*policy.mandate_active + 0.5*env.disease_prevalence\nprice = mask_price\nfor each retailer:\n  if day % restock_interval_days == 0:\n    retailer.stock += round(retailer_restock_rate * retailer.stock)\nfor each person i with mask_inventory == 0:\n  desired_qty = 1 if rationing_policy=='none' else min(1, max_per_purchase)\n  prob_buy = min(1, (desired_qty^price_elasticity_of_demand) * demand_multiplier)\n  if Bernoulli(prob_buy):\n    choose retailer with highest stock\n    qty = min(desired_qty, retailer.stock)\n    retailer.stock -= qty; person.mask_inventory += qty\nstockout_indicator = 1 if sum(retailer.stock==0 across retailers) > 0 else 0\navg_price = price\nemit retail.stockout_indicator_daily, retail.avg_price_daily=avg_price",
        "notes": [
          "Simple demand model with price elasticity and policy/disease-driven multipliers.",
          "Rationing limits per-customer purchases when active."
        ]
      },
      "requirements": [
        "rng",
        "retailer_registry"
      ],
      "module_parameters": [
        "mask_price",
        "price_elasticity_of_demand",
        "retailer_restock_rate",
        "restock_interval_days",
        "rationing_policy",
        "max_per_purchase",
        "initial_mask_stock_per_capita"
      ]
    },
    {
      "name": "SocialInfluence",
      "description": "Computes peer norm signals from observed neighbors and influencer nodes.",
      "inputs": [
        "state.contact_network"
      ],
      "outputs": [
        "social.norm_signal_by_person"
      ],
      "dependencies": [
        "NetworkBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "identify influencers: top-degree fraction = influencer_fraction\nfor each person i:\n  observed_neighbors = sample(neighbors(i), fraction=neighbor_sample_fraction) with prob observation_probability per neighbor\n  observed_rate = mean(mask_wearing of observed_neighbors)\n  norm_signal_i = observed_rate * person.social_norm_sensitivity\nemit vector social.norm_signal_by_person = {i: norm_signal_i}",
        "notes": [
          "Observation is stochastic to represent imperfect information.",
          "Influencers shape network mask_wearing indirectly via degree but not separate weighting here."
        ]
      },
      "requirements": [
        "rng",
        "graph"
      ],
      "module_parameters": [
        "observation_probability",
        "neighbor_sample_fraction",
        "influencer_fraction"
      ]
    },
    {
      "name": "BeliefAndHabitUpdate",
      "description": "Updates risk perception from environment and messages, adjusts perceived efficacy, habit strength, fatigue, and forgetting.",
      "inputs": [
        "env.disease_prevalence",
        "media.message_signal",
        "policy.message_signal"
      ],
      "outputs": [
        "state.beliefs_updated"
      ],
      "dependencies": [
        "MediaMessaging",
        "EnvironmentContext"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  rp = person.risk_perception\n  rp = (1 - risk_perception_decay) * rp + 0.6*env.disease_prevalence + 0.2*media.message_signal*person.trust_in_media + 0.2*policy.message_signal*person.trust_in_authorities\n  rp = clamp(rp, 0, 1)\n  if person.mask_wearing:\n    person.habit_strength = clamp(person.habit_strength + habit_formation_rate*(1 - person.habit_strength), 0, 1)\n    person.fatigue_level = clamp(person.fatigue_level + fatigue_rate*0.5, 0, 1)\n  else:\n    person.habit_strength = clamp(person.habit_strength * (1 - forgetting_rate), 0, 1)\n    person.fatigue_level = clamp(person.fatigue_level * (1 - forgetting_rate), 0, 1)\n  person.perceived_mask_efficacy = clamp(0.5*person.perceived_mask_efficacy + 0.5*rp, 0, 1)\nemit state.beliefs_updated = true",
        "notes": [
          "Bounded confidence can be applied by limiting incorporation of messages when divergence > epsilon.",
          "Fatigue accumulates when wearing; forgetting reduces both habit and fatigue."
        ]
      },
      "requirements": [
        "rng",
        "person_registry"
      ],
      "module_parameters": [
        "risk_perception_decay",
        "habit_formation_rate",
        "fatigue_rate",
        "forgetting_rate",
        "bounded_confidence_epsilon"
      ]
    },
    {
      "name": "AttendanceAndInteraction",
      "description": "Determines daily attendance based on mobility; applies location-level enforcement; forms daily contacts.",
      "inputs": [
        "env.mobility_level",
        "policy.mandate_active"
      ],
      "outputs": [
        "location.compliance_rate_daily",
        "state.daily_contacts_formed"
      ],
      "dependencies": [
        "EnvironmentContext",
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  intended_contacts ~ max(0, Normal(contact_rate_base * env.mobility_level, sqrt(contacts_variance)))\n  actual_contacts = sample neighbors up to intended_contacts\n  for each visited location L among {work, retail, leisure}:\n    requirement = mandate_active or L.mask_requirement\n    if requirement and not person.mask_wearing:\n      admitted ~ Bernoulli(1 - L.enforcement_level)\n      if not admitted: reduce contacts from this location to 0\ncollect entrants where requirement true and compute compliance_rate = mean(mask_wearing among admitted)\nemit location.compliance_rate_daily = compliance_rate; state.daily_contacts_formed = true",
        "notes": [
          "Location enforcement limits interactions of non-compliant agents.",
          "Contact formation constrained by network neighbors and mobility."
        ]
      },
      "requirements": [
        "rng",
        "graph",
        "location_registry"
      ],
      "module_parameters": [
        "contact_rate_base",
        "contacts_variance",
        "location_capacity_factor"
      ]
    },
    {
      "name": "AdoptionDecision",
      "description": "Computes adoption propensity and decides daily mask use subject to inventory and thresholds.",
      "inputs": [
        "social.norm_signal_by_person",
        "state.beliefs_updated",
        "policy.mandate_active",
        "policy.enforcement_probability_effective"
      ],
      "outputs": [
        "state.person_mask_use_today"
      ],
      "dependencies": [
        "BeliefAndHabitUpdate",
        "SocialInfluence",
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  s = social.norm_signal_by_person[i]\n  rp = person.risk_perception\n  habit = person.habit_strength\n  policy_pressure = (policy_influence_weight * policy.mandate_active) + (policy.mandate_active * policy.enforcement_probability_effective * 0.2)\n  media_term = media_influence_weight * (person.message_exposure_cumulative > 0)\n  raw_propensity = base_adoption_propensity + social_influence_weight*s + risk_perception_weight*rp + policy_pressure + media_term + 0.3*habit - mask_wear_cost_disutility - 0.2*person.fatigue_level\n  propensity = sigmoid(raw_propensity)\n  threshold = compliance_threshold * (1 + 0.5*person.stubbornness)\n  will_wear = (propensity >= threshold) and (person.mask_inventory > inventory_min_to_wear)\n  person.mask_wearing = will_wear\n  if will_wear:\n    person.mask_inventory = max(0, person.mask_inventory - 1)\nemit state.person_mask_use_today = true",
        "notes": [
          "Sigmoid(x) = 1/(1+exp(-x)); inputs normalized to [0,1] where applicable.",
          "Inventory constraint enforces supply-side effects."
        ]
      },
      "requirements": [
        "person_registry"
      ],
      "module_parameters": [
        "base_adoption_propensity",
        "social_influence_weight",
        "policy_influence_weight",
        "media_influence_weight",
        "risk_perception_weight",
        "compliance_threshold",
        "mask_wear_cost_disutility",
        "inventory_min_to_wear"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily adoption metrics and group-wise rates.",
      "inputs": [
        "state.person_mask_use_today",
        "policy.fines_issued_daily",
        "retail.stockout_indicator_daily",
        "location.compliance_rate_daily"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_rate_by_ideology_daily",
        "observable.fines_issued_daily",
        "observable.stockout_indicator_daily",
        "observable.location_compliance_rate_daily"
      ],
      "dependencies": [
        "AdoptionDecision",
        "PolicyAndEnforcement",
        "RetailMarket",
        "AttendanceAndInteraction"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate = mean(person.mask_wearing over population)\nadoption_by_ideology = group_mean(person.mask_wearing by political_ideology)\nfines_daily = policy.fines_issued_daily\nstockout = retail.stockout_indicator_daily\nloc_compliance = location.compliance_rate_daily\nemit all observables",
        "notes": [
          "Observables are time series used by metrics.",
          "Group adoption uses categorical ideology in {-1,0,+1}."
        ]
      },
      "requirements": [
        "person_registry"
      ],
      "module_parameters": []
    },
    {
      "name": "ValidationChecks",
      "description": "Runs validation criteria: adoption bounds, convergence, non-negative inventory, reproducibility tolerance.",
      "inputs": [
        "observable.adoption_rate_daily",
        "retail.stockout_indicator_daily"
      ],
      "outputs": [
        "validation.flags"
      ],
      "dependencies": [
        "AdoptionAggregator",
        "RetailMarket"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "check1: 0 <= adoption_rate_daily <= 1 else flag error\ncheck2: nonnegative_inventory: all retailer.stock >= 0 else flag error\ncheck3: convergence: if last convergence_window_days absolute diff < convergence_threshold -> converged=true\ncheck4: reproducibility handled externally by rerun with same seed and comparing summaries within reproducibility_tolerance\nemit validation.flags",
        "notes": [
          "Stops or warns if violations occur.",
          "Convergence flag can be used to early-stop runs if desired."
        ]
      },
      "requirements": [
        "retailer_registry"
      ],
      "module_parameters": [
        "reproducibility_tolerance",
        "convergence_threshold",
        "convergence_window_days"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 100,
        "high": 100000
      },
      "owner_module": "global",
      "description": "Number of persons in the simulation.",
      "frozen": true
    },
    {
      "key": "time_horizon_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 730
      },
      "owner_module": "global",
      "description": "Total number of simulated days.",
      "frozen": true
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Seed for reproducibility.",
      "frozen": true
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "NetworkBuilder",
      "description": "Type of contact network (fixed to small_world).",
