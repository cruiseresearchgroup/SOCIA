  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "mask_adoption.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_rate_by_ideology_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(Person.mask_wearing, Person.political_ideology)",
      "frequency": "daily",
      "aggregation": "by_group(political_ideology)",
      "target_data_field": "mask_adoption_by_group.csv:adoption_rate_by_ideology"
    },
    {
      "id": "observable.fines_issued_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "sum(policy.fines_issued_daily)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "policy_enforcement.csv:fines_daily"
    },
    {
      "id": "observable.stockout_indicator_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "retail.stockout_indicator_daily",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "retailer_stock.csv:stockout_indicator"
    },
    {
      "id": "observable.location_compliance_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "location.compliance_rate_daily",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "location_compliance.csv:compliance_rate"
    },
    {
      "id": "observable_cf.adoption_rate_daily_no_policy",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing) under no-policy counterfactual run",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeriesIdentity",
        "config": {}
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5,
          "direction": "up"
        }
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "PeakValue",
        "config": {}
      }
    },
    {
      "name": "sustained_adoption_after_policy_end",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "WindowAverage",
        "config": {
          "start_offset_day": 1,
          "window_length_days": 30,
          "anchor": "mandate_end_day"
        }
      }
    },
    {
      "name": "group_adoption_disparity",
      "inputs": [
        "observable.adoption_rate_by_ideology_daily"
      ],
      "definition": {
        "type": "BetweenGroupVariance",
        "config": {
          "group_field": "political_ideology",
          "aggregate": "mean_over_time"
        }
      }
    },
    {
      "name": "policy_lift",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable_cf.adoption_rate_daily_no_policy"
      ],
      "definition": {
        "type": "CounterfactualLift",
        "config": {
          "method": "difference_in_means_over_horizon"
        }
      }
    },
    {
      "name": "stockout_days",
      "inputs": [
        "observable.stockout_indicator_daily"
      ],
      "definition": {
        "type": "CountDaysCondition",
        "config": {
          "condition": "value > 0.5"
        }
      }
    },
    {
      "name": "average_fines_per_capita",
      "inputs": [
        "observable.fines_issued_daily"
      ],
      "definition": {
        "type": "SumOverTimeScaled",
        "config": {
          "scale_by": "population_size"
        }
      }
    },
    {
      "name": "location_compliance_rate",
      "inputs": [
        "observable.location_compliance_rate_daily"
      ],
      "definition": {
        "type": "TimeSeriesAverage",
        "config": {}
      }
    },
    {
      "name": "RMSE_adoption_vs_data",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "target": "mask_adoption.csv:adoption_rate",
          "normalize": true
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network": {
      "type": "small_world",
      "avg_degree": 12,
      "clustering_target": 0.2,
      "rewiring_prob": 0.12
    },
    "initial_adoption_rate": 0.05
  },
  "algorithms": {
    "NetworkGeneration": "Watts-Strogatz small-world graph (N, k=avg_degree, beta=network_rewiring_prob), static over time.",
    "NormComputation": "Stochastic observation of neighbors; norm = mean(observed neighbors' mask_wearing) scaled by social_norm_sensitivity.",
    "BeliefUpdate": "Risk perception AR(1) with exogenous prevalence and message signals, bounded to [0,1].",
    "HabitDynamics": "Reinforcement when wearing (asymptotic to 1) and decay when not wearing.",
    "AdoptionPropensity": "Linear weighted sum of signals (social, risk, policy, media, habit, fatigue, cost) passed through sigmoid; compare to threshold.",
    "RetailDemand": "Purchase probability responds to price elasticity and demand multipliers from policy and prevalence.",
    "Enforcement": "Bernoulli draw for fines among non-compliant during mandate; admission gating at locations by enforcement_level.",
    "ConvergenceCheck": "Absolute change in adoption rate < convergence_threshold for convergence_window_days."
  },
  "data_sources": [
    {
      "name": "mask_adoption.csv",
      "purpose": "Benchmark aggregate adoption rates over time.",
      "fields_used": [
        "date",
        "adoption_rate"
      ]
    },
    {
      "name": "mask_adoption_by_group.csv",
      "purpose": "Benchmark group-disparity (e.g., by ideology).",
      "fields_used": [
        "date",
        "political_ideology",
        "adoption_rate_by_ideology"
      ]
    },
    {
      "name": "retailer_stock.csv",
      "purpose": "Track retail stockouts for validation.",
      "fields_used": [
        "date",
        "stockout_indicator"
      ]
    },
    {
      "name": "policy_enforcement.csv",
      "purpose": "Compare fines issued per day.",
      "fields_used": [
        "date",
        "fines_daily"
      ]
    },
    {
      "name": "location_compliance.csv",
      "purpose": "Compare entrance compliance rates.",
      "fields_used": [
        "date",
        "compliance_rate"
      ]
    }
  ],
  "code_structure": {
