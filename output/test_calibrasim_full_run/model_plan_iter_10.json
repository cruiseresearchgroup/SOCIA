{
  "model_type": "agent_based",
  "description": "Agent-based, networked social adoption model of mask-wearing with supply, policy, media, and location-mediated interactions. Persons decide to adopt based on social influence, information exposure, policy/enforcement, access/cost, and personal traits; supply and media dynamics feed back into decisions.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age_group",
        "household_id",
        "occupation_type",
        "income_level",
        "health_risk_category",
        "adoption_state",
        "mask_type",
        "compliance_probability",
        "risk_perception",
        "trust_in_authority",
        "susceptibility_to_social_influence",
        "perceived_cost",
        "access_to_masks",
        "information_exposure_level",
        "social_network_ids",
        "mobility_profile"
      ],
      "behaviors": [
        "make_adoption_decision",
        "wear_mask_in_locations",
        "interact_with_contacts",
        "update_risk_perception",
        "respond_to_policy_and_enforcement",
        "purchase_masks",
        "share_opinions_with_network"
      ],
      "initialization": {
        "method": "data_driven",
        "parameters": {
          "age_group_shares": {
            "child": 0.2,
            "adult": 0.65,
            "senior": 0.15
          },
          "income_levels": [
            "low",
            "middle",
            "high"
          ],
          "income_shares": [
            0.3,
            0.5,
            0.2
          ],
          "occupation_types": [
            "essential",
            "non_essential",
            "student",
            "unemployed"
          ],
          "occupation_shares": [
            0.2,
            0.45,
            0.25,
            0.1
          ],
          "health_risk_probs": {
            "low": 0.6,
            "medium": 0.3,
            "high": 0.1
          },
          "risk_perception_beta": {
            "alpha": 2.0,
            "beta": 2.0
          },
          "trust_beta": {
            "alpha": 2.0,
            "beta": 2.0
          },
          "susceptibility_normal": {
            "mean": 0.5,
            "std": 0.2,
            "clip": [
              0.0,
              1.0
            ]
          },
          "perceived_cost_base": {
            "low": 0.5,
            "middle": 0.7,
            "high": 0.9
          },
          "initial_adoption_rate": 0.15
        }
      }
    },
    {
      "name": "Household",
      "attributes": [
        "id",
        "size",
        "socioeconomic_status",
        "shared_resources_level",
        "members_ids"
      ],
      "behaviors": [
        "share_masks_and_information",
        "exert_within_household_influence"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "avg_household_size": 2.6,
          "household_size_dispersion": 1.0
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "contact_rate_modifier",
        "mask_policy",
        "enforcement_level"
      ],
      "behaviors": [
        "host_interactions",
        "enforce_policy_on_entry"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "types": [
            "household",
            "workplace",
            "school",
            "retail",
            "transit",
            "recreation"
          ],
          "counts": {
            "household": "derived_from_population",
            "workplace": 1200,
            "school": 200,
            "retail": 800,
            "transit": 150,
            "recreation": 300
          },
          "default_enforcement_level": 0.7
        }
      }
    },
    {
      "name": "PolicyMaker",
      "attributes": [
        "mandate_status",
        "enforcement_probability",
        "fine_amount",
        "campaign_intensity",
        "subsidy_level",
        "monitoring_interval_days"
      ],
      "behaviors": [
        "implement_or_adjust_policy",
        "broadcast_guidelines",
        "allocate_subsidies"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_start_day": 20,
          "campaign_intensity": 0.5,
          "subsidy_level": 0.2
        }
      }
    },
    {
      "name": "Supplier",
      "attributes": [
        "id",
        "inventory",
        "price",
        "replenishment_rate",
        "distribution_priority_rules"
      ],
      "behaviors": [
        "set_prices",
        "replenish_inventory",
        "distribute_masks_to_retailers"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "inventory_initial": 20000,
          "price": 2.0,
          "replenishment_rate_per_day": 3000,
          "distribution_priority_rule": "by_need"
        }
      }
    },
    {
      "name": "Media",
      "attributes": [
        "id",
        "reach",
        "message_bias",
        "misinformation_rate",
        "message_frequency"
      ],
      "behaviors": [
        "broadcast_messages",
        "amplify_or_counter_misinformation"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "reach": 0.8,
          "message_bias": 0.0,
          "misinformation_rate": 0.1,
          "message_frequency": 1.0
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialInfluenceModule",
      "description": "Computes social contagion pressure from peers and households on each person's adoption propensity.",
      "inputs": [
        "network.graph",
        "person.adoption_state",
        "person.susceptibility_to_social_influence",
        "household.influence_signal"
      ],
      "outputs": [
        "signal.social_influence_score[i]"
      ],
      "dependencies": [
        "HouseholdModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  neighbors = graph.neighbors(i)\n  observed = mean(adoption_state[j] for j in neighbors)\n  observed = observed + Normal(0, peer_observation_noise)\n  observed = clamp(observed, 0, 1)\n  hh_signal = household.influence_signal[i]\n  # optional 2-hop influence\n  two_hop = mean(adoption_state[k] for k in graph.two_hop(i)) if available else observed\n  two_hop_adj = two_hop * influence_decay_per_hop\n  peer_level = 0.7*observed + 0.3*two_hop_adj\n  threshold_adj = max(0, peer_level - peer_threshold_for_contagion)\n  sus = person.susceptibility_to_social_influence[i]\n  social_influence_score[i] = social_influence_weight * (0.8*threshold_adj + 0.2*hh_signal) * sus",
        "notes": [
          "Two-hop neighbors can be approximated to save compute.",
          "Household signal is computed in HouseholdModule and accounts for sharing and norms."
        ]
      },
      "requirements": [
        "network.small_world",
        "household.influence_signal"
      ],
      "module_parameters": [
        "social_influence_weight",
        "peer_observation_noise",
        "influence_decay_per_hop",
        "peer_threshold_for_contagion"
      ]
    },
    {
      "name": "InformationDiffusionModule",
      "description": "Updates risk perception and trust based on media messages and peer sharing.",
      "inputs": [
        "media.messages",
        "person.share_opinion_events",
        "policy.campaign_intensity"
      ],
      "outputs": [
        "person.risk_perception",
        "person.trust_in_authority",
        "signal.info_exposure[i]"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  exposure = media_message_frequency_per_day * Media.reach * (1 - misinformation_rate) + 0.2 * mean(peer_shares_in[i])\n  exposure = min(1.0, exposure)\n  delta_trust = message_effect_size * (policy.campaign_intensity - misinformation_rate) - trust_decay_rate_per_day\n  person.trust_in_authority[i] = clamp(person.trust_in_authority[i] + delta_trust, 0, 1)\n  delta_risk = message_effect_size * (exposure * (1 + person.health_risk_modifier))\n  person.risk_perception[i] = clamp(person.risk_perception[i] * (1 - trust_decay_rate_per_day) + delta_risk, 0, 1)\n  signal.info_exposure[i] = exposure",
        "notes": [
          "health_risk_modifier is derived from health_risk_category (e.g., 0.0, 0.3, 0.6).",
          "Peer shares approximated by fraction of neighbors who recently adopted."
        ]
      },
      "requirements": [
        "media.reach",
        "policy.campaign_intensity"
      ],
      "module_parameters": [
        "message_effect_size",
        "misinformation_rate",
        "trust_decay_rate_per_day",
        "media_message_frequency_per_day"
      ]
    },
    {
      "name": "SupplyAndPurchaseModule",
      "description": "Manages mask supply, pricing/subsidies, and individual purchase events impacting access_to_masks.",
      "inputs": [
        "supplier.inventory",
        "supplier.price",
        "policy.subsidy_level",
        "person.purchase_intent"
      ],
      "outputs": [
        "supplier.inventory",
        "person.access_to_masks",
        "metric.daily_purchases",
        "metric.shortage_flag"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "effective_price = max(0.1, mask_price * (1 - subsidy_level))\n  supplier.inventory += replenishment_rate_per_day\n  daily_purchases = 0\n  shortage_flag = 0\n  # Priority ordering\n  buyers = select persons with purchase_intent and (day % purchase_interval_days == (i % purchase_interval_days))\n  if distribution_priority_rule == 'by_need':\n    sort buyers by access_to_masks ascending, then income_level ascending\n  elif distribution_priority_rule == 'by_income':\n    sort buyers by income_level ascending\n  else:\n    shuffle buyers\n  for i in buyers:\n    affordability = sigmoid(price_elasticity * (effective_price - person.perceived_cost[i]))\n    qty = round(max(0, max_masks_per_purchase * affordability))\n    if qty == 0: continue\n    if supplier.inventory >= qty:\n      supplier.inventory -= qty\n      person.access_to_masks[i] += qty\n      daily_purchases += qty\n    else:\n      shortage_flag = 1\n      # partial fill if any\n      if supplier.inventory > 0:\n        person.access_to_masks[i] += supplier.inventory\n        daily_purchases += supplier.inventory\n        supplier.inventory = 0\n      break",
        "notes": [
          "affordability increases as effective price decreases.",
          "purchase_intent determined in AdoptionDecisionModule based on access threshold and desire to adopt."
        ]
      },
      "requirements": [
        "subsidy_budget (implicit via subsidy_level)",
        "inventory_nonnegative"
      ],
      "module_parameters": [
        "mask_price",
        "subsidy_level",
        "inventory_initial",
        "replenishment_rate_per_day",
        "distribution_priority_rule",
        "purchase_interval_days",
        "max_masks_per_purchase",
        "price_elasticity"
      ]
    },
    {
      "name": "PolicyAndEnforcementModule",
      "description": "Activates mandates, sets enforcement probability, handles fines/denials, and provides a compliance boost.",
      "inputs": [
        "time.day",
        "location.mask_policy",
        "location.enforcement_level",
        "person.adoption_state"
      ],
      "outputs": [
        "policy.mandate_active",
        "policy.enforcement_probability",
        "policy.fine_amount",
        "signal.policy_pressure[i]",
        "metric.daily_enforcement_actions",
        "metric.daily_fines_collected"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "mandate_active = (day >= mandate_start_day)\n  enforcement_prob = enforcement_probability\n  enforcement_actions = 0\n  fines_collected = 0\n  for each location L:\n    if mandate_active: L.mask_policy = 'required'\n    else: L.mask_policy = 'recommended'\n    if L.enforcement_level is None: L.enforcement_level = default_location_enforcement_level\n  for each person i visiting locations today:\n    if mandate_active and not person.adoption_state[i]:\n      if rand() < enforcement_prob * mean(L.enforcement_level visited):\n        enforcement_actions += 1\n        if rand() < (1 - exemption_rate):\n          fines_collected += fine_amount\n          signal.policy_pressure[i] = mandate_compliance_boost\n        else:\n          signal.policy_pressure[i] = 0.5 * mandate_compliance_boost\n      else:\n        signal.policy_pressure[i] = 0.0\n    else:\n      signal.policy_pressure[i] = 0.0",
        "notes": [
          "Denied entry can be modeled by deny_entry_probability; if denied, person reduces visits or delays.",
          "policy_pressure is an additive propensity boost consumed by AdoptionDecisionModule."
        ]
      },
      "requirements": [
        "legal_mandate_start_day",
        "fine_processing"
      ],
      "module_parameters": [
        "mandate_start_day",
        "enforcement_probability",
        "fine_amount",
        "monitoring_interval_days",
        "default_location_enforcement_level",
        "deny_entry_probability",
        "exemption_rate",
        "mandate_compliance_boost"
      ]
    },
    {
      "name": "LocationInteractionModule",
      "description": "Generates daily contacts by location type, computes observation opportunities, and emits compliance context per location.",
      "inputs": [
        "person.mobility_profile",
        "location.contact_rate_modifier",
        "person.adoption_state",
        "policy.mandate_active"
      ],
      "outputs": [
        "signal.location_contacts[i]",
        "signal.observation_opportunity[i]"
      ],
      "dependencies": [
        "PolicyAndEnforcementModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  contacts = 0\n  observed_masks = 0\n  for loc_type in ['household','workplace','school','retail','transit','recreation']:\n    base_rate = contact_rate_{loc_type}\n    visited = mobility_matrix_scale * person.mobility_profile[loc_type]\n    c = Poisson(base_rate * visited)\n    contacts += c\n    # visibility of mask wearing\n    local_mask_rate = mean(adoption_state of sampled contacts in loc_type)\n    observed_masks += c * local_mask_rate * mask_visibility_factor\n  signal.location_contacts[i] = contacts\n  signal.observation_opportunity[i] = observed_masks / max(1, contacts)",
        "notes": [
          "Sampling contacts can be approximated without explicit pairing for speed.",
          "Observation_opportunity feeds back into SocialInfluenceModule (optional) or directly to AdoptionDecision."
        ]
      },
      "requirements": [
        "mobility_profiles",
        "location_registry"
      ],
      "module_parameters": [
        "contact_rate_household",
        "contact_rate_workplace",
        "contact_rate_school",
        "contact_rate_retail",
        "contact_rate_transit",
        "contact_rate_recreation",
        "mask_visibility_factor",
        "mobility_matrix_scale",
        "small_world_beta"
      ]
    },
    {
      "name": "HouseholdModule",
      "description": "Constructs households, computes within-household normative pressure, and manages resource sharing.",
      "inputs": [
        "household.members_ids",
        "person.adoption_state",
        "person.access_to_masks"
      ],
      "outputs": [
        "household.influence_signal[i]",
        "person.access_to_masks"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each household H:\n  hh_adopt = mean(person.adoption_state[m] for m in H.members)\n  for m in H.members:\n    household.influence_signal[m] = within_household_influence_weight * hh_adopt\n  # share masks if some members below threshold\n  pool = sum(person.access_to_masks[m] for m in H.members)\n  target_per_person = pool / len(H.members) * household_sharing_efficiency\n  for m in H.members:\n    person.access_to_masks[m] = max(person.access_to_masks[m], target_per_person)",
        "notes": [
          "Simple equalization heuristic with efficiency < 1 to reflect friction in sharing."
        ]
      },
      "requirements": [
        "household_membership",
        "daily_sync"
      ],
      "module_parameters": [
        "within_household_influence_weight",
        "household_sharing_efficiency",
        "household_size_dispersion"
      ]
    },
    {
      "name": "AdoptionDecisionModule",
      "description": "Computes daily probability to wear a mask and updates adoption_state and purchase_intent.",
      "inputs": [
        "signal.social_influence_score[i]",
        "signal.policy_pressure[i]",
        "signal.info_exposure[i]",
        "person.risk_perception",
        "person.trust_in_authority",
        "person.access_to_masks",
        "person.perceived_cost",
        "person.compliance_probability"
      ],
      "outputs": [
        "person.adoption_state",
        "person.mask_type",
        "person.purchase_intent"
      ],
      "dependencies": [
        "SocialInfluenceModule",
        "PolicyAndEnforcementModule",
        "InformationDiffusionModule",
        "SupplyAndPurchaseModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  # utility/propensity components\n  u_social = signal.social_influence_score[i]\n  u_risk = risk_perception_weight * person.risk_perception[i]\n  u_policy = policy_weight * signal.policy_pressure[i]\n  u_trust = trust_influence_weight * (person.trust_in_authority[i] - 0.5)\n  u_cost = - cost_sensitivity * max(0, perceived_cost_to_i - 1.0)\n  u_access = 0 if person.access_to_masks[i] < min_masks_to_feel_access else 0.1\n  # mask type utility (choose best available given access)\n  efficacy = {\n    'none': mask_efficacy_none,\n    'cloth': mask_efficacy_cloth,\n    'surgical': mask_efficacy_surgical,\n    'respirator': mask_efficacy_respirator\n  }\n  # choose mask type with highest efficacy that i can access\n  chosen_type = argmax_over_types_available_to_i(efficacy[type])\n  intercept = base_adoption_bias\n  propensity = intercept + u_social + u_risk + u_policy + u_trust + u_cost + u_access\n  p_wear = sigmoid(propensity)\n  # habit and decay\n  if person.adoption_state[i]:\n    p_wear = clamp(p_wear + habit_formation_rate - adherence_decay_rate_per_day, 0, 1)\n  else:\n    p_wear = clamp(p_wear - forgetfulness_noise, 0, 1)\n  person.adoption_state[i] = (rand() < p_wear)\n  person.mask_type[i] = chosen_type if person.adoption_state[i] else 'none'\n  # purchase intent if access low\n  person.purchase_intent[i] = (person.access_to_masks[i] < min_masks_to_feel_access)",
        "notes": [
          "perceived_cost_to_i can be function of effective market price and income level.",
          "sigmoid(x) = 1/(1+exp(-x))."
        ]
      },
      "requirements": [
        "access_to_masks_nonnegative",
        "mask_type_catalog"
      ],
      "module_parameters": [
        "risk_perception_weight",
        "policy_weight",
        "adherence_decay_rate_per_day",
        "base_adoption_bias",
        "trust_influence_weight",
        "cost_sensitivity",
        "min_masks_to_feel_access",
        "habit_formation_rate",
        "forgetfulness_noise",
        "mask_efficacy_none",
        "mask_efficacy_cloth",
        "mask_efficacy_surgical",
        "mask_efficacy_respirator"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and metrics from person- and module-level signals.",
      "inputs": [
        "person.adoption_state",
        "person.mask_type",
        "person.access_to_masks",
        "person.income_level",
        "signal.location_contacts[i]",
        "policy.mandate_active",
        "metric.daily_purchases",
        "metric.shortage_flag"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_by_age",
        "observable.compliance_under_mandate",
        "observable.mask_availability_rate",
        "observable.purchase_rate",
        "observable.shortage_days",
        "observable.inequality_in_adoption_gini"
      ],
      "dependencies": [
        "AdoptionDecisionModule",
        "SupplyAndPurchaseModule",
        "LocationInteractionModule",
        "PolicyAndEnforcementModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate_daily = mean(person.adoption_state)\n  adoption_by_age = group_mean(person.adoption_state by person.age_group)\n  if policy.mandate_active:\n    compliance_under_mandate = mean(person.adoption_state)\n  else:\n    compliance_under_mandate = null_or_carry_forward\n  mask_availability_rate = mean(person.access_to_masks >= min_masks_to_feel_access)\n  purchase_rate = metric.daily_purchases / population_size\n  shortage_days += 1 if metric.shortage_flag else 0\n  inequality_in_adoption_gini = gini(mean_by_group(person.adoption_state by person.income_level))",
        "notes": [
          "Gini computed over group adoption rates weighted by group sizes.",
          "Carry-forward for compliance_under_mandate can be masked in evaluation."
        ]
      },
      "requirements": [
        "population_size",
        "grouping_functions"
      ],
      "module_parameters": [
        "min_masks_to_feel_access"
      ]
    }
  ],
  "parameters": [
    {
      "key": "time_horizon_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 1,
        "high": 365
      },
      "owner_module": "global",
      "description": "Total simulated days.",
      "frozen": true
    },
    {
      "key": "time_step_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.25,
        "high": 7.0
      },
      "owner_module": "global",
      "description": "Simulation time step in days.",
      "frozen": true
    },
    {
      "key": "population_size",
      "dtype": "int",
      "default": 10000,
      "bounds": {
        "low": 1000,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Number of Person agents.",
      "frozen": true
    },
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 0,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Random seed.",
      "frozen": true
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": null,
      "owner_module": "global",
      "description": "Type of social network.",
      "frozen": true
    },
    {
      "key": "average_degree",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 4,
        "high": 50
      },
      "owner_module": "global",
      "description": "Average number of social ties per person.",
      "frozen": false
    },
    {
      "key": "initial_adoption_rate",
      "dtype": "float",
      "default": 0.15,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial fraction of mask wearers.",
      "frozen": false
    },
    {
      "key": "access_inequality_index",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 0.8
      },
      "owner_module": "global",
      "description": "Inequality in initial mask access across SES groups.",
      "frozen": false
    },
    {
      "key": "avg_household_size",
      "dtype": "float",
      "default": 2.6,
      "bounds": {
        "low": 1.0,
        "high": 6.0
      },
      "owner_module": "global",
      "description": "Average household size used in initialization.",
      "frozen": true
    },
    {
      "key": "num_workplaces",
