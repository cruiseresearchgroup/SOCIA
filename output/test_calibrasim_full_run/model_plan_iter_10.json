  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate_overall"
    },
    {
      "id": "observable.adoption_by_age",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "group_mean(Person.adoption_state by Person.age_group)",
      "frequency": "daily",
      "aggregation": "by_group(age_group)",
      "target_data_field": "train_data.csv:adoption_rate_by_age"
    },
    {
      "id": "observable.compliance_under_mandate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state) when policy.mandate_active",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:compliance_rate"
    },
    {
      "id": "observable.mask_availability_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.access_to_masks >= min_masks_to_feel_access)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:access_rate"
    },
    {
      "id": "observable.purchase_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "metric.daily_purchases / population_size",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:purchase_rate"
    },
    {
      "id": "observable.shortage_days",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative_days(metric.shortage_flag==1)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:shortage_days"
    },
    {
      "id": "observable.inequality_in_adoption_gini",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "gini(group_mean(Person.adoption_state by Person.income_level))",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_gini_by_income"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_overall_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE_group_age",
      "inputs": [
        "observable.adoption_by_age"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "by_group": "age_group"
        }
      }
    },
    {
      "name": "TimeToThresholdError_70",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThresholdError",
        "config": {
          "threshold": 0.7
        }
      }
    },
    {
      "name": "Compliance_RMSE",
      "inputs": [
        "observable.compliance_under_mandate"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "mask_missing": true
        }
      }
    },
    {
      "name": "Access_RMSE",
      "inputs": [
        "observable.mask_availability_rate"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "Inequality_MAE",
      "inputs": [
        "observable.inequality_in_adoption_gini"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "normalize": false
        }
      }
    }
  ],
  "environment": {
    "type": "network_with_locations",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "network_generation": {
      "type": "watts_strogatz",
      "parameters": {
        "n": "population_size",
        "k": "average_degree",
        "beta": "small_world_beta"
      }
    },
    "households": {
      "avg_household_size": 2.6,
      "size_dispersion": 1.0,
      "assignment_method": "sample sizes from lognormal-like discrete, fill population, assign SES from income_level"
    },
    "locations": {
      "counts": {
        "workplace": 1200,
        "school": 200,
        "retail": 800,
        "transit": 150,
        "recreation": 300
      },
      "default_enforcement_level": 0.7,
      "mask_policy": "recommended"
    },
    "persons": {
      "age_groups": [
        "child",
        "adult",
        "senior"
      ],
      "age_group_shares": [
        0.2,
        0.65,
        0.15
      ],
      "income_levels": [
        "low",
        "middle",
        "high"
      ],
      "income_shares": [
        0.3,
        0.5,
        0.2
      ],
      "risk_perception": "Beta(2,2)",
      "trust_in_authority": "Beta(2,2)",
      "susceptibility_to_social_influence": "Normal(0.5,0.2) clipped to [0,1]",
      "perceived_cost": "mapped from income_level with noise",
      "initial_adoption": 0.15,
      "access_to_masks": "proportional to income level with inequality index"
    }
  },
  "algorithms": {
    "network_generation": "Watts-Strogatz small-world graph with parameters (n, k, beta).",
    "adoption_propensity": "Logistic regression-like propensity combining social, risk, policy, trust, cost, and access terms with habit/decay.",
    "supply_allocation": "Priority queue allocation with replenishment and price-elastic purchase probabilities.",
    "household_sharing": "Resource equalization with efficiency factor.",
    "gini_computation": "Standard Gini over group adoption rates weighted by group sizes."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and evaluation of adoption metrics",
      "fields_used": [
        "adoption_rate_overall",
        "adoption_rate_by_age",
        "compliance_rate",
        "access_rate",
        "purchase_rate",
        "shortage_days",
        "adoption_gini_by_income"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point to run simulations, parse configs, orchestrate modules."
      },
      {
        "name": "entities.py",
        "description": "Class definitions for Person, Household, Location, PolicyMaker, Supplier, Media."
      },
      {
        "name": "network.py",
        "description": "Network generation and utilities (Watts-Strogatz, neighbor queries)."
      },
      {
        "name": "modules/social_influence.py",
        "description": "SocialInfluenceModule implementation."
      },
      {
