  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "synthetic:generated_adoption_rate"
    },
    {
      "id": "observable.dropout_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(dropout_events_today)/max(1, adopters_yesterday)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "synthetic:generated_dropout_rate"
    },
    {
      "id": "observable.compliance_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(compliance_outcomes where policy='required')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "synthetic:generated_compliance_rate"
    },
    {
      "id": "observable.adoption_rate_high_risk",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state | risk_group='high')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "synthetic:generated_adoption_rate_high_risk"
    },
    {
      "id": "observable.adoption_rate_low_risk",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state | risk_group='low')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "synthetic:generated_adoption_rate_low_risk"
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "ValueOnDay",
        "config": {
          "day_index": "last"
        }
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5,
          "comparison": ">="
        }
      }
    },
    {
      "name": "sustained_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "AverageOverWindow",
        "config": {
          "window_days": 14,
          "position": "trailing_end"
        }
      }
    },
    {
      "name": "dropout_rate",
      "inputs": [
        "observable.dropout_rate_daily"
      ],
      "definition": {
        "type": "Average",
        "config": {
          "over": "entire_period"
        }
      }
    },
    {
      "name": "compliance_rate",
      "inputs": [
        "observable.compliance_rate_daily"
      ],
      "definition": {
        "type": "Average",
        "config": {
          "over": "entire_period"
        }
      }
    },
    {
      "name": "adoption_disparity_index",
      "inputs": [
        "observable.adoption_rate_high_risk",
        "observable.adoption_rate_low_risk"
      ],
      "definition": {
        "type": "DifferenceOnDay",
        "config": {
          "day_index": "last",
          "order": "high_minus_low"
        }
      }
    },
    {
      "name": "policy_effect_size",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "ScenarioDifference",
        "config": {
          "scenarios": [
            "mandate_on",
            "mandate_off"
          ],
          "statistic": "ValueOnDay",
          "day_index": "last"
        }
      }
    }
  ],
  "environment": {
    "type": "network + locations",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network_generation": "Watts-Strogatz small-world with average_degree and network_rewiring_p",
    "household_assignment": "Group persons into households with mean household_size_mean",
    "workplace_assignment": "Assign to workplaces of mean size workplace_size_mean",
    "public_venues": "Create venues with capacity public_venue_capacity_mean",
    "initial_policies": "mandate_active, enforcement_strictness, fine_amount"
  },
  "algorithms": {
    "WattsStrogatzNetwork": "Generate small-world network using networkx.watts_strogatz_graph(N, k, p).",
    "LocationAssignment": "Sample time in each location type and assign persons to specific locations respecting occupancy limits.",
    "SocialNormComputation": "Compute perceived norms from neighbors and co-presence; produce social pressure.",
    "AdoptionDecision": "Logistic adoption based on utility from risk, social pressure, comfort cost, and price/budget.",
    "HabitDynamics": "Increment/decrement habit strength with formation/decay rates.",
    "EnforcementRealization": "Draw compliance outcomes, fines, and denial of service under mandate/enforcement.",
    "Aggregation": "Daily aggregation of observables and storage of time series for metrics."
  },
  "data_sources": [
    {
      "name": "synthetic_generator",
      "purpose": "Generate synthetic observables for validation and scenario analysis.",
      "fields_used": [
        "none_external"
      ]
    }
  ],
