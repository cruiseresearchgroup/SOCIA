      "frozen": false
    },
    {
      "key": "habit_formation_rate",
      "dtype": "float",
      "default": 0.05,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "DecisionAndBehaviorModule",
      "description": "Daily habit increase when adopting.",
      "frozen": false
    },
    {
      "key": "mask_cost_base",
      "dtype": "float",
      "default": 5.0,
      "bounds": {
        "low": 0.5,
        "high": 20.0
      },
      "owner_module": "DecisionAndBehaviorModule",
      "description": "Base price unit for masks.",
      "frozen": false
    },
    {
      "key": "mask_cost_multiplier_cloth",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.5,
        "high": 1.5
      },
      "owner_module": "DecisionAndBehaviorModule",
      "description": "Relative price for cloth masks.",
      "frozen": false
    },
    {
      "key": "mask_cost_multiplier_surgical",
      "dtype": "float",
      "default": 1.5,
      "bounds": {
        "low": 0.8,
        "high": 3.0
      },
      "owner_module": "DecisionAndBehaviorModule",
