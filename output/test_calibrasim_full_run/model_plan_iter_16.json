      "bounds": {
        "low": 10.0,
        "high": 70.0
      },
      "owner_module": "global",
      "description": "Mean age used for initialization.",
      "frozen": false
    },
    {
      "key": "age_std",
      "dtype": "float",
      "default": 15.0,
      "bounds": {
        "low": 5.0,
        "high": 25.0
      },
