        "low": 0.01,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "Std dev of initial trust in authority.",
      "frozen": false
    },
    {
      "key": "trust_in_media_std",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.01,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "Std dev of initial trust in media.",
      "frozen": false
    },
    {
      "key": "age_mean",
      "dtype": "float",
