{
  "random_seed": 42,
  "n_agents": 200,
  "steps": 100,
  "network": {
    "type": "watts_strogatz",
    "k": 6,
    "rewiring_beta": 0.12
  },
  "opinion_model": {
    "type": "degroot_bounded_confidence",
    "confidence_threshold": 0.6,
    "susceptibility_range": [
      0.2,
      0.8
    ],
    "noise_sigma": 0.01
  },
  "shock": {
    "enabled": true,
    "step": 50,
    "magnitude": 0.15,
    "rule": "sign_of_initial_opinion"
  }
}