{
  "model_type": "agent_based",
  "description": "Agent-based, network-coupled simulation of mask adoption dynamics with peer influence, mandates, media messaging, and supply constraints across locations.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "role",
        "political_orientation",
        "income",
        "risk_perception",
        "trust_in_authorities",
        "social_influence_susceptibility",
        "adoption_state",
        "compliance_threshold",
        "fatigue_level",
        "perceived_cost",
        "perceived_benefit",
        "mask_inventory",
        "neighbors",
        "current_location_id",
        "mobility_pattern"
      ],
      "behaviors": [
        "decide_adoption",
        "unadopt_due_to_fatigue",
        "observe_peers_and_update_beliefs",
        "receive_information_message",
        "purchase_mask",
        "comply_with_enforcement",
        "move_between_locations",
        "wear_mask_if_required_or_chosen"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": "triangular(18, 35, 80)",
          "role_distribution": {
            "student": 0.15,
            "worker": 0.55,
            "retired": 0.2,
            "unemployed": 0.1
          },
          "political_orientation_distribution": {
            "left": 0.4,
            "center": 0.2,
            "right": 0.4
          },
          "income_distribution": "lognormal(mean=10, sigma=0.5)",
          "risk_perception_init": "normal(mean=risk_perception_base, sd=0.1) clipped [0,1]",
          "trust_in_authorities_init": "beta(a=2,b=2)",
          "social_influence_susceptibility_init": "beta(a=2,b=2)",
          "adoption_state_init": "Bernoulli(p=initial_adoption_rate)",
          "compliance_threshold_init": "normal(mean=compliance_threshold_mean, sd=compliance_threshold_std) clipped [0,1]",
          "fatigue_level_init": 0.0,
          "perceived_cost_init": "normal(mean=perceived_cost_base, sd=0.05) clipped [0,1]",
          "perceived_benefit_init": "normal(mean=perceived_benefit_base, sd=0.05) clipped [0,1]",
          "mask_inventory_init": "adoption_state ? 1 : 0",
          "mobility_pattern_init": "Poisson(mean=mobility_daily_trips_mean) with location-type preferences = locations_*_share"
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "region",
        "capacity",
        "enforcement_policy",
        "observability",
        "entry_requirements"
      ],
      "behaviors": [
        "host_interactions",
        "enforce_policy",
        "admit_or_reject_person"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_locations_home": "num_locations_home",
          "num_locations_workplace": "num_locations_workplace",
          "num_locations_store": "num_locations_store",
          "num_locations_transit": "num_locations_transit",
          "capacity_rule": "round(location_capacity_scale * population_size * locations_type_share / num_locations_type)",
          "observability": "observability_in_locations",
          "enforcement_policy_default": {
            "mandate": false,
            "mask_required": false,
            "min_enforcement_level": 0.0
          },
          "entry_requirements_default": {
            "mask_required": false
          }
        }
      }
    },
    {
      "name": "PolicyMaker",
      "attributes": [
        "id",
        "mandate_active",
        "policy_start_day",
        "policy_end_day",
        "enforcement_level",
        "fine_amount",
        "campaign_budget",
        "message_frequency",
        "target_groups"
      ],
      "behaviors": [
        "issue_or_lift_mandate",
        "adjust_enforcement",
        "run_information_campaign",
        "set_location_entry_rules"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "policy_start_day": "policy_start_day",
          "policy_end_day": "policy_end_day",
          "mandate_active": false,
          "enforcement_level": "enforcement_level",
          "fine_amount": "fine_amount",
          "campaign_budget": 10000,
          "message_frequency": "message_frequency_per_day",
          "target_groups": [
            "all"
          ]
        }
      }
    },
    {
      "name": "InformationSource",
      "attributes": [
        "id",
        "channel_type",
        "reach",
        "credibility",
        "bias",
        "misinformation_rate",
        "message_frequency"
      ],
      "behaviors": [
        "broadcast_message",
        "target_audience"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "sources": [
            {
              "id": "gov",
              "channel_type": "official",
              "reach": 0.9,
              "credibility": 0.8,
              "bias": 0.0,
              "misinformation_rate": 0.02,
              "message_frequency": "message_frequency_per_day"
            },
            {
              "id": "news",
              "channel_type": "media",
              "reach": 0.7,
              "credibility": 0.6,
              "bias": 0.1,
              "misinformation_rate": 0.05,
              "message_frequency": "message_frequency_per_day"
            },
            {
              "id": "social",
              "channel_type": "social_media",
              "reach": 0.95,
              "credibility": 0.4,
              "bias": 0.2,
              "misinformation_rate": "misinformation_rate",
              "message_frequency": "message_frequency_per_day"
            }
          ]
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory",
        "price",
        "restock_rate",
        "stockout_probability"
      ],
      "behaviors": [
        "sell_masks",
        "restock_inventory",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "number_of_retailers": "number_of_retailers",
          "inventory": "floor(mask_supply_initial_units / number_of_retailers)",
          "price": "price_initial",
          "restock_rate": "restock_rate_per_day",
          "stockout_probability": "retailer_stockout_probability"
        }
      }
    }
  ],
  "modules": [
    {
      "name": "NetworkBuilder",
      "description": "Build social network with scale-free degree distribution and political homophily.",
      "inputs": [],
      "outputs": [
        "graph.adjacency",
        "Person.neighbors"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 0
      },
      "update_rule": {
        "pseudocode": "if t == 0:\n  set random seed\n  generate base scale-free graph with population_size and average_degree\n  rewire edges to increase assortativity by political_orientation according to homophily_by_political_orientation\n  assign neighbors to each Person",
        "notes": [
          "Runs once at t=0. Use networkx scale-free or Barabasi-Albert then assortative rewiring."
        ]
      },
      "requirements": [
        "networkx"
      ],
      "module_parameters": [
        "population_size",
        "network_type",
        "average_degree",
        "homophily_by_political_orientation",
        "seed"
      ]
    },
    {
      "name": "MobilityAndLocations",
      "description": "Assign persons to locations and move them daily according to mobility patterns and location capacities.",
      "inputs": [
        "Person.mobility_pattern",
        "Location.*"
      ],
      "outputs": [
        "Person.current_location_id",
        "Location.occupancy"
      ],
      "dependencies": [
        "NetworkBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each Person p:\n  trips = sample from mobility_pattern or Poisson(mobility_daily_trips_mean)\n  for trip in 1..trips:\n    draw location type according to locations_*_share and role-specific weights\n    select a location of that type with occupancy < capacity\n    if entry_requirements.mask_required and not p.adoption_state and p.mask_inventory==0:\n      skip (rejected) or trigger purchase attempt signal\n    else:\n      move p to location; update occupancy\n  at end of day: reset temporary occupancies where applicable (except home)",
        "notes": [
          "Home occupancy persists; other locations reset daily.",
          "Observability set by location.observability."
        ]
      },
      "requirements": [
        "random"
      ],
      "module_parameters": [
        "locations_home_share",
        "locations_workplace_share",
        "locations_store_share",
        "locations_transit_share",
        "num_locations_home",
        "num_locations_workplace",
        "num_locations_store",
        "num_locations_transit",
        "observability_in_locations",
        "location_capacity_scale",
        "base_mobility_rate",
        "mobility_daily_trips_mean"
      ]
    },
    {
      "name": "InformationBroadcast",
      "description": "Broadcast messages from information sources and campaigns; update personal beliefs (risk, benefit, cost).",
      "inputs": [
        "InformationSource.*",
        "PolicyMaker.*"
      ],
      "outputs": [
        "Person.risk_perception",
        "Person.perceived_benefit",
        "Person.perceived_cost"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each source s:\n  if rand < s.message_frequency:\n    for each Person p with probability s.reach:\n      signal = (1 - s.misinformation_rate)*s.credibility - s.misinformation_rate*(1 - s.credibility)\n      p.risk_perception = clip((1 - forgetting_rate_per_day)*p.risk_perception + information_campaign_intensity*signal + risk_shock_today, 0, 1)\n      p.perceived_benefit = clip(perceived_benefit_base + 0.5*signal, 0, 1)\n      p.perceived_cost = clip(perceived_cost_base - 0.3*signal, 0, 1)\n  if PolicyMaker.mandate_active:\n    increase benefit perception for all by 0.1*information_campaign_intensity",
        "notes": [
          "risk_shock_today drawn from risk_shock_series[t] if present else 0.",
          "forgetting in belief updates handled here for risk only; separate behavioral forgetting handled in AdoptionDecision."
        ]
      },
      "requirements": [
        "random"
      ],
      "module_parameters": [
        "misinformation_rate",
        "information_campaign_intensity",
        "message_frequency_per_day",
        "risk_perception_base",
        "perceived_benefit_base",
        "perceived_cost_base",
        "risk_shock_series"
      ]
    },
    {
      "name": "SocialObservation",
      "description": "Update perceived norms based on neighbors' and co-located mask usage.",
      "inputs": [
        "graph.adjacency",
        "Person.adoption_state",
        "Location.occupancy"
      ],
      "outputs": [
        "Person.perceived_norm"
      ],
      "dependencies": [
        "NetworkBuilder",
        "MobilityAndLocations"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each Person p:\n  neighbor_mask_share = mean(adoption_state of neighbors)\n  location_mask_share = observed mask share at p.current_location with noise ~(1 - observability_in_locations)\n  p.perceived_norm = clip(social_influence_strength*neighbor_mask_share + observation_influence_strength*location_mask_share, 0, 1)",
        "notes": [
          "If no neighbors or alone at location, fall back to neighbor_mask_share or global mean."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "social_influence_strength",
        "observation_influence_strength"
      ]
    },
    {
      "name": "PolicyMaker",
      "description": "Activate or lift mandate and set entry rules by day.",
      "inputs": [
        "t"
      ],
      "outputs": [
        "PolicyMaker.mandate_active",
        "Location.entry_requirements"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == policy_start_day: mandate_active = True ; set entry_requirements.mask_required=True for workplace, transit, store\nif t == policy_end_day: mandate_active = False ; set entry_requirements.mask_required=False for all",
        "notes": [
          "Enforcement levels are operationalized in PolicyEnforcement."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "policy_start_day",
        "policy_end_day"
      ]
    },
    {
      "name": "PolicyEnforcement",
      "description": "Enforce mandates at locations; apply detection and fines; induce compliance.",
      "inputs": [
        "PolicyMaker.mandate_active",
        "Location.enforcement_policy",
        "Person.adoption_state",
        "Person.mask_inventory"
      ],
      "outputs": [
        "enforcement.actions_today",
        "Person.compliance_override"
      ],
      "dependencies": [
        "PolicyMaker",
        "MobilityAndLocations"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "enforcement.actions_today = 0\nfor each location L where entry_requirements.mask_required:\n  for each Person p present at L:\n    if not p.adoption_state:\n      if rand < detection_probability*enforcement_level:\n        enforcement.actions_today += 1\n        if p.mask_inventory > 0:\n          p.compliance_override = True  # wears mask to comply now\n        else:\n          possibly issue fine with prob=enforcement_level; record fine\n      else:\n        p.compliance_override = False",
        "notes": [
          "Compliance override applies for this tick to wearing decision.",
          "mandate_effect_strength influences AdoptionDecision utility."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "mandate_effect_strength",
        "enforcement_level",
        "fine_amount",
        "detection_probability"
      ]
    },
    {
      "name": "MarketModule",
      "description": "Handle mask purchases, retailer restocking, and price adjustment.",
      "inputs": [
        "Retailer.*",
        "Person.mask_inventory",
        "Person.income",
        "demand_signals"
      ],
      "outputs": [
        "Retailer.inventory",
        "Retailer.price",
        "market.stockouts_today",
        "Person.mask_inventory"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "market.stockouts_today = 0\n# Demand: persons without mask_inventory but positive adoption_intent send demand signal\naggregate demand D\nfor each Retailer r:\n  # Restock\n  if rand > retailer_stockout_probability:\n    r.inventory += round(r.restock_rate * r.inventory + 1)\n  else:\n    market.stockouts_today += 1\n  # Price adjustment (log-linear elasticity)\n  if D > 0:\n    r.price = max(0.1, r.price * (1 + (D / (population_size)) * (-price_elasticity_of_demand)))\n# Sales\nfor each Person p with demand:\n  choose retailer r with prob ~ 1/r.price\n  if r.inventory > 0 and p.income >= r.price:\n    r.inventory -= 1\n    p.mask_inventory += 1\n  else:\n    market.stockouts_today += 1",
        "notes": [
          "Demand signal provided by AdoptionDecision when intent=1 without inventory."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "mask_supply_initial_units",
        "restock_rate_per_day",
        "price_initial",
        "price_elasticity_of_demand",
        "retailer_stockout_probability",
        "number_of_retailers"
      ]
    },
    {
      "name": "AdoptionDecision",
      "description": "Core adoption state update combining beliefs, norms, mandates, costs, and fatigue.",
      "inputs": [
        "Person.perceived_benefit",
        "Person.perceived_cost",
        "Person.risk_perception",
        "Person.perceived_norm",
        "PolicyMaker.mandate_active",
        "PolicyEnforcement.mandate_effect_strength",
        "Person.compliance_threshold",
        "Person.fatigue_level",
        "Person.mask_inventory",
        "PolicyEnforcement.outputs"
      ],
      "outputs": [
        "Person.adoption_state",
        "Person.fatigue_level",
        "adoption_events.attribution",
        "demand_signals"
      ],
      "dependencies": [
        "InformationBroadcast",
        "SocialObservation",
        "PolicyEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each Person p:\n  # Compute utility of adopting\n  U = w_b*p.perceived_benefit + w_r*p.risk_perception + w_n*p.perceived_norm - w_c*p.perceived_cost - w_f*p.fatigue_level\n  if PolicyMaker.mandate_active:\n    U += PolicyEnforcement.mandate_effect_strength\n  # Soft decision with temperature\n  prob_adopt = sigmoid((U - p.compliance_threshold)/max(1e-6, decision_temperature))\n  intent = (rand < prob_adopt)\n  # Market demand signal if intent and no inventory\n  if intent and p.mask_inventory == 0:\n    emit demand_signals for p\n  # Wearing decision today\n  wear_today = p.adoption_state or intent or p.compliance_override\n  # Update adoption_state with fatigue and forgetting\n  if wear_today:\n    p.adoption_state = True\n    p.fatigue_level = max(0, p.fatigue_level - 0.5*fatique_decay)\n  else:\n    if rand < fatigue_rate_per_day:\n      p.fatigue_level = min(1, p.fatigue_level + 0.1)\n    if rand < forgetting_rate_per_day:\n      p.adoption_state = False\n  # Attribution\n  if p.adoption_state changed from False to True:\n    cause = argmax({\"peer\": social_influence_strength*p.perceived_norm, \"mandate\": PolicyEnforcement.mandate_effect_strength*(PolicyMaker.mandate_active), \"info\": information_campaign_intensity, \"market\": 1.0*(p.mask_inventory>0)})\n    record adoption_events.attribution[cause] += 1",
        "notes": [
          "Weights w_b,w_r,w_n,w_c,w_f default to 1.0 except w_f=0.5; implemented internally.",
          "fatigue_decay set to 0.05/day internally.",
          "sigmoid(x)=1/(1+exp(-x))."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "decision_temperature",
        "compliance_threshold_mean",
        "compliance_threshold_std",
        "fatigue_rate_per_day",
        "forgetting_rate_per_day",
        "initial_adoption_rate"
      ]
    },
    {
      "name": "AggregationModule",
      "description": "Aggregate observables and compute metrics each day.",
      "inputs": [
        "Person.*",
        "graph.adjacency",
        "Retailer.*",
        "PolicyMaker.*",
        "PolicyEnforcement.*",
        "MarketModule.*"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.enforcement_actions_daily",
        "observable.stockouts_daily",
        "observable.adoption_by_income_daily",
        "observable.adoption_by_political_orientation_daily",
        "observable.assortativity_daily",
        "metrics.*"
      ],
      "dependencies": [
        "AdoptionDecision",
        "PolicyEnforcement",
        "MarketModule",
        "SocialObservation"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate = mean(Person.adoption_state or Person.compliance_override)\nby_income = group_mean(Person.adoption_state, by=income_quantiles)\nby_politics = group_mean(Person.adoption_state, by=political_orientation)\nassortativity = network_assortativity(graph, attribute=adoption_state)\nstockouts = market.stockouts_today\nenforcement = enforcement.actions_today\nstore all observables\n# Metrics updated online or post-run\nif end of run or daily where applicable:\n  peak_adoption_rate = max(history(adoption_rate))\n  time_to_threshold = first t where adoption_rate >= adoption_time_threshold\n  sustained_post = mean(adoption_rate[t in policy_end_day+1 .. policy_end_day+sustained_window_days])\n  inequality_index = Gini(by_income) or Theil\n  policy_effect_size = mean(adoption_rate[policy_start_day..policy_end_day]) - mean(adoption_rate[0..policy_start_day-1] + adoption_rate[policy_end_day+1..end]) / 2\n  influence_attribution = normalize(counts from AdoptionDecision.adoption_events.attribution)\n  mask_shortage_days = count(stockouts > 0)\n  enforcement_actions_per_day = mean(enforcement)",
        "notes": [
          "Assortativity uses Newman assortativity on binary attribute.",
          "Inequality index default uses Gini across income groups."
        ]
      },
      "requirements": [
        "numpy",
        "networkx"
      ],
      "module_parameters": [
        "sustained_window_days",
        "adoption_time_threshold",
        "inequality_group_field"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 1000,
      "bounds": {
        "low": 100,
        "high": 100000
      },
      "owner_module": "NetworkBuilder",
      "description": "Number of agents (persons).",
      "frozen": true
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "scale_free",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "NetworkBuilder",
      "description": "Type of social network generator.",
      "frozen": true
    },
    {
      "key": "average_degree",
      "dtype": "float",
      "default": 8.0,
      "bounds": {
        "low": 2.0,
        "high": 50.0
      },
      "owner_module": "NetworkBuilder",
      "description": "Target average degree of the social network.",
      "frozen": false
    },
    {
      "key": "homophily_by_political_orientation",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "NetworkBuilder",
      "description": "Assortativity preference by political orientation.",
      "frozen": false
    },
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "NetworkBuilder",
      "description": "Random seed for reproducibility.",
      "frozen": true
    },
    {
      "key": "locations_home_share",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MobilityAndLocations",
      "description": "Share of visits to home-type locations.",
      "frozen": true
    },
    {
      "key": "locations_workplace_share",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MobilityAndLocations",
      "description": "Share of visits to workplace locations.",
      "frozen": true
    },
    {
      "key": "locations_store_share",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MobilityAndLocations",
      "description": "Share of visits to stores.",
      "frozen": true
    },
    {
      "key": "locations_transit_share",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MobilityAndLocations",
      "description": "Share of visits to transit.",
      "frozen": true
    },
    {
      "key": "num_locations_home",
      "dtype": "int",
      "default": 400,
      "bounds": {
        "low": 10,
        "high": 20000
      },
      "owner_module": "MobilityAndLocations",
      "description": "Number of home locations.",
      "frozen": false
    },
    {
      "key": "num_locations_workplace",
      "dtype": "int",
      "default": 100,
      "bounds": {
        "low": 5,
        "high": 10000
      },
      "owner_module": "MobilityAndLocations",
      "description": "Number of workplaces.",
      "frozen": false
    },
    {
      "key": "num_locations_store",
      "dtype": "int",
      "default": 50,
      "bounds": {
        "low": 5,
        "high": 5000
      },
      "owner_module": "MobilityAndLocations",
      "description": "Number of stores.",
      "frozen": false
    },
    {
      "key": "num_locations_transit",
      "dtype": "int",
      "default": 80,
      "bounds": {
        "low": 5,
        "high": 5000
