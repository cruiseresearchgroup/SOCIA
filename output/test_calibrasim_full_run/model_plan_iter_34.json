    "end_day": 120
  },
  "evaluation_metrics": [
    "adoption_rate_over_time",
    "peak_adoption_rate",
    "time_to_50_percent_adoption",
    "sustained_adoption_after_mandate_end",
    "adoption_inequality_index",
    "adoption_clustering",
    "policy_effect_size",
    "influence_attribution",
    "mask_shortage_days",
    "enforcement_actions_per_day"
  ]
}