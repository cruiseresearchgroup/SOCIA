  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AggregationModule",
      "formula_or_field": "mean(Person.adoption_state OR Person.compliance_override)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.enforcement_actions_daily",
      "source_module": "AggregationModule",
      "formula_or_field": "enforcement.actions_today",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:enforcement_actions"
    },
    {
      "id": "observable.stockouts_daily",
      "source_module": "AggregationModule",
      "formula_or_field": "market.stockouts_today",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:stockouts"
    },
    {
      "id": "observable.adoption_by_income_daily",
      "source_module": "AggregationModule",
      "formula_or_field": "group_mean(Person.adoption_state, by=income_quantiles)",
      "frequency": "daily",
      "aggregation": "by_group(income_quantile)",
      "target_data_field": "train_data.csv:adoption_by_income"
    },
    {
      "id": "observable.adoption_by_political_orientation_daily",
      "source_module": "AggregationModule",
      "formula_or_field": "group_mean(Person.adoption_state, by=political_orientation)",
      "frequency": "daily",
      "aggregation": "by_group(political_orientation)",
      "target_data_field": "train_data.csv:adoption_by_political"
    },
    {
      "id": "observable.assortativity_daily",
      "source_module": "AggregationModule",
      "formula_or_field": "network_assortativity(adoption_state)",
      "frequency": "daily",
      "aggregation": "scalar",
      "target_data_field": "train_data.csv:adoption_assortativity"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Timeseries",
        "config": {}
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Max",
        "config": {}
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5
        }
      }
    },
    {
      "name": "sustained_adoption_after_mandate_end",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "WindowMean",
        "config": {
          "start": "policy_end_day+1",
          "length_param": "sustained_window_days"
        }
      }
    },
    {
      "name": "adoption_inequality_index",
      "inputs": [
        "observable.adoption_by_income_daily"
      ],
      "definition": {
        "type": "GiniOverGroups",
        "config": {
          "group_field": "income"
        }
      }
    },
    {
      "name": "adoption_clustering",
      "inputs": [
        "observable.assortativity_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {}
      }
    },
    {
      "name": "policy_effect_size",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "DifferenceInMeans",
        "config": {
          "period_A": [
            "policy_start_day",
            "policy_end_day"
          ],
          "period_B": [
            "0",
            "policy_start_day-1"
          ],
          "period_C": [
            "policy_end_day+1",
            "end"
          ]
        }
      }
    },
    {
      "name": "influence_attribution",
      "inputs": [],
      "definition": {
        "type": "AttributionShare",
        "config": {
          "sources": [
            "peer",
            "mandate",
            "info",
            "market"
          ]
        }
      }
    },
    {
      "name": "mask_shortage_days",
      "inputs": [
        "observable.stockouts_daily"
      ],
      "definition": {
        "type": "CountDays",
        "config": {
          "condition": "stockouts_daily>0"
        }
      }
    },
    {
      "name": "enforcement_actions_per_day",
      "inputs": [
        "observable.enforcement_actions_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {}
      }
    }
  ],
  "environment": {
    "type": "network_with_locations",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network": "scale_free with assortative rewiring",
    "initial_masks_in_retail": 1500,
    "initial_adoption_rate": 0.1
  },
  "algorithms": {
    "scale_free_network_generation": "Barabasi-Albert with target average_degree then assortative rewiring by political orientation.",
    "assortative_rewiring": "Edge swaps to increase assortativity metric until target homophily achieved.",
    "softmax_adoption": "Sigmoid choice on utility difference with temperature.",
    "observed_norm_estimation": "Weighted average of neighbors' adoption and location prevalence with noise ~ (1 - observability).",
    "policy_enforcement_detection": "Bernoulli detection with probability detection_probability*enforcement_level.",
    "market_price_adjustment": "Elastic response: p_new = max(0.1, p_old*(1 + k*(-elasticity))).",
    "gini_over_groups": "Compute Gini coefficient across group adoption means.",
    "assortativity": "Newman assortativity on binary adoption attribute."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and validation of adoption time series and enforcement/stockout observables.",
      "fields_used": [
        "adoption_rate",
        "enforcement_actions",
        "stockouts",
        "adoption_by_income",
        "adoption_by_political",
        "adoption_assortativity"
      ]
    }
  ],
  "code_structure": {
