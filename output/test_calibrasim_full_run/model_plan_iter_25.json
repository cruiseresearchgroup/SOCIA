  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "PeerAdoptionDynamics",
      "formula_or_field": "mean(Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_rate_by_age_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_quantiles(Person.age, Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "by_group(age_quantiles)",
      "target_data_field": null
    },
    {
      "id": "observable.adoption_rate_by_income_quintile_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_quantiles(Person.income, Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "by_group(income_quintiles)",
      "target_data_field": null
    },
    {
      "id": "observable.location_compliance",
      "source_module": "MobilityAndLocationCompliance",
      "formula_or_field": "mean expected compliance across locations",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.enforcement_events_daily",
      "source_module": "PolicyCampaignEnforcement",
      "formula_or_field": "signal.enforcement_events",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": null
    },
    {
      "id": "observable.masks_sold_daily",
      "source_module": "RetailMarketAndAccess",
      "formula_or_field": "signal.masks_sold",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": null
    },
    {
      "id": "observable.infection_incidence_daily",
      "source_module": "OptionalDiseaseTransmission",
      "formula_or_field": "new_infections / population_size",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.time_to_majority",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "first t with adoption_rate_daily >= 0.5",
      "frequency": "once",
      "aggregation": "first_crossing",
      "target_data_field": null
    },
    {
      "id": "observable.sustained_adoption_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(adoption_rate_daily over last sustained_window days)",
      "frequency": "daily",
      "aggregation": "window_mean",
      "target_data_field": null
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": "last"
        }
      }
    },
    {
      "name": "time_to_majority",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "FirstCrossing",
        "config": {
          "threshold": 0.5
        }
      }
    },
    {
      "name": "sustained_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "WindowMean",
        "config": {
          "window": "param:sustained_window"
        }
      }
    },
    {
      "name": "adoption_disparity_index",
      "inputs": [
        "observable.adoption_rate_by_age_daily"
      ],
      "definition": {
        "type": "GiniOnLastDay",
        "config": {
          "group_source": "age_quantiles"
        }
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Max",
        "config": {}
      }
    },
    {
      "name": "average_location_compliance",
      "inputs": [
        "observable.location_compliance"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": "last"
        }
      }
    },
    {
      "name": "masks_sold_total",
      "inputs": [
        "observable.masks_sold_daily"
      ],
      "definition": {
        "type": "Sum",
        "config": {}
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "procedures": [
      "Sample Person attributes per Initialization parameters.",
      "Create Locations according to shares and capacity factor; assign home locations to all persons.",
      "Assign workplaces to a Bernoulli(home_to_work_assignment_rate) subset; map each person to a workplace location.",
      "Initialize Retailers with stock, price, and restock rate.",
      "Build social network via NetworkBuilder.",
      "Set initial mask_access via Bernoulli(mask_availability).",
      "If enable_disease: seed infections with Bernoulli(initial_infected_fraction)."
    ]
  },
  "algorithms": {
    "WattsStrogatz": "Small-world network generator with parameters n, k, p.",
    "ThresholdAdoption": "Adopt if propensity >= threshold and access is True; abandon stochastically when propensity is low.",
    "LogisticCompliance": "Compliance probability = sigmoid(intercept + enforcement + policy pressure + noise).",
    "InventoryPricing": "Retail price adjusts inversely with inventory ratio via price_elasticity.",
    "PoissonRestock": "Restock quantities drawn from Poisson with rate proportional to demand.",
    "GiniIndex": "Compute inequality across group adoption rates on last day.",
    "FirstCrossing": "Find first time adoption_rate >= threshold.",
    "QuantileGrouping": "Split continuous attributes (age or income) into quantile bins for aggregation."
  },
  "data_sources": [
