  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "behavior_adoption_timeseries.csv:adoption_rate"
    },
    {
      "id": "observable.new_adoptions_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(Person.adoption_state changed from 0 to 1 on day t)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "behavior_adoption_timeseries.csv:new_adoptions"
    },
    {
      "id": "observable.adoption_rate_low_income_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state | group == 'low_income')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "behavior_adoption_timeseries.csv:adoption_rate_low_income"
    },
    {
      "id": "observable.adoption_rate_high_income_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state | group == 'high_income')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "behavior_adoption_timeseries.csv:adoption_rate_high_income"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_AdoptionRate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE_NewAdoptions",
      "inputs": [
        "observable.new_adoptions_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "normalize": false
        }
      }
    },
    {
      "name": "PeakError",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "PeakError",
        "config": {
          "abs": true
        }
      }
    },
    {
      "name": "TimeToPeak",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToPeakDiff",
        "config": {
          "unit": "days"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "time_horizon_days": 60
  },
  "algorithms": {
    "watts_strogatz": "Small-world network generator with k-nearest neighbors and rewiring probability p.",
    "barabasi_albert": "Preferential attachment scale-free network generator with m edges per new node.",
    "configuration_model_simple_graph": "Samples degree sequence then constructs a simple graph via stub-matching with rejection of multi-edges/self-loops.",
    "logistic_choice": "Maps latent propensity to probability via p = 1 / (1 + exp(-beta*x)).",
    "ema_memory": "Exponential moving average for temporal smoothing of signals.",
    "edge_swap_assortativity_tuning": "Iteratively swaps edges to approach target assortativity."
  },
  "data_sources": [
    {
      "name": "behavior_adoption_timeseries.csv",
      "purpose": "Calibration and evaluation of model observables against observed adoption.",
      "fields_used": [
        "date",
        "adoption_rate",
        "new_adoptions",
        "adoption_rate_low_income",
        "adoption_rate_high_income"
      ]
    }
  ],
