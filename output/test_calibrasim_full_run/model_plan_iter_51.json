    {
      "key": "media_campaign_start_day",
      "dtype": "int",
      "default": 5,
      "bounds": {
        "low": 0,
        "high": 365
      },
      "owner_module": "MediaInfluence",
      "description": "Day media campaign starts.",
      "frozen": false
    },
    {
      "key": "media_campaign_end_day",
      "dtype": "int",
      "default": 40,
      "bounds": {
        "low": 0,
        "high": 365
      },
      "owner_module": "MediaInfluence",
      "description": "Day media campaign ends.",
      "frozen": false
    },
    {
      "key": "media_campaign_intensity",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.0,
        "high": 3.0
