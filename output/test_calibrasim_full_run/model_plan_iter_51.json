      "bounds": {
        "low": 0.6,
        "high": 1.0
      },
      "owner_module": "AgentInitializer",
      "description": "Upper clip for thresholds.",
      "frozen": true
    },
    {
      "key": "group_share_low_income",
      "dtype": "float",
      "default": 0.4,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "AgentInitializer",
      "description": "Share of low-income group.",
      "frozen": false
    },
    {
      "key": "media_sensitivity_mean",
      "dtype": "float",
      "default": 0.8,
      "bounds": {
        "low": 0.1,
        "high": 2.0
      },
      "owner_module": "AgentInitializer",
      "description": "Mean media sensitivity.",
      "frozen": false
    },
    {
      "key": "policy_sensitivity_mean",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.1,
        "high": 2.5
      },
      "owner_module": "AgentInitializer",
      "description": "Mean policy sensitivity.",
      "frozen": false
    },
    {
      "key": "influenceability_mean",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.1,
        "high": 2.0
      },
      "owner_module": "AgentInitializer",
      "description": "Mean susceptibility to peer influence.",
      "frozen": false
    },
    {
      "key": "attribute_std",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.01,
        "high": 1.0
      },
      "owner_module": "AgentInitializer",
      "description": "Stddev for lognormal attribute draws.",
      "frozen": false
    },
    {
      "key": "initial_propensity_mean",
      "dtype": "float",
      "default": 0.0,
      "bounds": {
        "low": -0.5,
        "high": 0.5
      },
      "owner_module": "AgentInitializer",
      "description": "Initial mean latent propensity.",
      "frozen": false
    },
    {
      "key": "peer_weight",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "PeerInfluence",
      "description": "Weight of peer pressure signal.",
      "frozen": false
    },
    {
      "key": "conformity_exponent",
      "dtype": "float",
      "default": 1.5,
      "bounds": {
        "low": 0.5,
        "high": 3.0
      },
      "owner_module": "PeerInfluence",
      "description": "Exponent shaping nonlinearity of peer effects.",
      "frozen": false
    },
    {
      "key": "neighborhood_memory_decay",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "PeerInfluence",
      "description": "EMA decay for neighborhood adoption memory.",
      "frozen": false
    },
    {
      "key": "social_inertia",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "PeerInfluence",
      "description": "Inertia term subtracted from propensity when already adopted.",
      "frozen": false
    },
    {
      "key": "media_weight",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "MediaInfluence",
      "description": "Weight applied to media broadcast signal.",
      "frozen": false
