  "prediction_period": {
    "start_day": 90,
    "end_day": 120
  },
  "evaluation_metrics": [
    "RMSE_AdoptionRate",
    "MAE_Compliance",
    "SMAPE_Shortage",
    "PoissonNLL_Penalties",
    "MAE_MessageReach",
    "MAE_AttitudeShift",
    "MAE_Churn",
    "AbsError_TimeToTarget"
  ]
}