  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_adoption_state == 'adopted')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/adoption_rate.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_rate_by_age",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "group_mean(Person.mask_adoption_state == 'adopted' by Person.age_group)",
      "frequency": "daily",
      "aggregation": "by_group(age_group)",
      "target_data_field": "observed/adoption_by_age.csv:age_group_rate"
    },
    {
      "id": "observable.compliance_in_mandated_spaces",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "observable.compliance_events.compliant / observable.compliance_events.attempts",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/compliance.csv:compliance_rate"
    },
    {
      "id": "observable.mask_supply_shortage_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "observable.purchase_failures / total_purchase_requests_today",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/supply.csv:shortage_rate"
    },
    {
      "id": "observable.penalties_issued_per_day",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "observable.penalties_issued.count",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "observed/penalties.csv:count"
    },
    {
      "id": "observable.message_reach",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "sum(1 for i if signal.message_exposure[i] > 0) / N",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/messaging.csv:reach"
    },
    {
      "id": "observable.attitude_shift_index",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(risk_perception_today - risk_perception_yesterday)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/attitude_shift.csv:index"
    },
    {
      "id": "observable.adoption_churn_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "observable.adoption_churn_events.discontinue / max(1, prev_day_adopters)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/churn.csv:rate"
    },
    {
      "id": "observable.time_to_target_adoption",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "first day when adoption_rate_daily >= target_adoption_rate",
      "frequency": "once",
      "aggregation": "none",
      "target_data_field": "observed/time_to_target.csv:days"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_AdoptionRate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE_Compliance",
      "inputs": [
        "observable.compliance_in_mandated_spaces"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "ignore_nulls": true
        }
      }
    },
    {
      "name": "SMAPE_Shortage",
      "inputs": [
        "observable.mask_supply_shortage_rate"
      ],
      "definition": {
        "type": "SMAPE",
        "config": {}
      }
    },
    {
      "name": "PoissonNLL_Penalties",
      "inputs": [
        "observable.penalties_issued_per_day"
      ],
      "definition": {
        "type": "PoissonNLL",
        "config": {
          "eps": 1e-06
        }
      }
    },
    {
      "name": "MAE_MessageReach",
      "inputs": [
        "observable.message_reach"
      ],
      "definition": {
        "type": "MAE",
        "config": {}
      }
    },
    {
      "name": "MAE_AttitudeShift",
      "inputs": [
        "observable.attitude_shift_index"
      ],
      "definition": {
        "type": "MAE",
        "config": {}
      }
    },
    {
      "name": "MAE_Churn",
      "inputs": [
        "observable.adoption_churn_rate"
      ],
      "definition": {
        "type": "MAE",
        "config": {}
      }
    },
    {
      "name": "AbsError_TimeToTarget",
      "inputs": [
        "observable.time_to_target_adoption"
      ],
      "definition": {
        "type": "AbsoluteError",
        "config": {}
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network": {
      "type": "small_world",
      "avg_degree": 8,
      "rewiring_prob": 0.1
    },
    "time_horizon_days": 120,
    "initial_mask_adoption_rate": 0.1,
    "mask_availability_initial": 0.7
  },
  "algorithms": {
    "NetworkGeneration": "Watts-Strogatz small-world graph G(N, k=network_avg_degree, beta=network_rewiring_prob)",
    "PeerInfluence": "Threshold plus contagion: EMA of neighbor adoption compared to individual threshold with susceptibility scaling",
    "MessagingUpdate": "Stochastic exposure model; media and authority-induced updates to risk/trust with tone and credibility weights",
    "ComplianceDecision": "Probabilistic compliance under mandates with enforcement checks and penalties",
    "RetailStockDynamics": "Partial restocking towards max with Gaussian noise; FIFO purchase processing",
    "AdoptionDecision": "Logistic adoption based on net utility (benefit - cost + peer delta), with refractory period and fatigue dynamics",
    "Aggregation": "Daily aggregation of adoption, compliance, shortages, penalties, reach, attitudes, and churn"
  },
  "data_sources": [
    {
      "name": "ObservedAdoptionRates",
      "purpose": "Calibration and validation of overall adoption trajectory",
      "fields_used": [
        "date",
        "adoption_rate"
      ]
    },
    {
      "name": "ComplianceSurveys",
      "purpose": "Validation of compliance in mandated spaces",
      "fields_used": [
        "date",
        "location_type",
        "compliance_rate"
      ]
    },
    {
      "name": "RetailSupplyLogs",
      "purpose": "Validation of supply shortages and pricing",
      "fields_used": [
        "date",
        "attempted_purchases",
        "failed_purchases",
        "price"
      ]
    },
    {
      "name": "PenaltyRecords",
      "purpose": "Validation of enforcement outcomes",
      "fields_used": [
        "date",
        "penalties_count",
        "total_penalty_value"
      ]
    },
    {
      "name": "MediaReachData",
      "purpose": "Validation of message reach",
      "fields_used": [
        "date",
        "reach"
      ]
    }
  ],
  "code_structure": {
