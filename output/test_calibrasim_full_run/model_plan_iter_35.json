{
  "model_type": "agent_based",
  "description": "Agent-based, network-embedded simulation of mask adoption dynamics where heterogeneous individuals update masking behavior via peer influence, media/policy messaging, organizational enforcement, and retail supply constraints. The environment is a small-world social network; daily ticks update adoption, purchases, compliance, and messaging.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age_group",
        "income",
        "risk_perception",
        "trust_in_authorities",
        "social_influence_susceptibility",
        "media_consumption_level",
        "organization_id",
        "mask_adoption_state",
        "mask_inventory",
        "compliance_propensity",
        "perceived_cost",
        "adoption_threshold",
        "fatigue_level",
        "last_adopted_day"
      ],
      "behaviors": [
        "evaluate_mask_benefit_cost",
        "adopt_mask",
        "discontinue_mask",
        "purchase_masks",
        "attend_location",
        "observe_peers",
        "receive_message",
        "respond_to_policy",
        "share_opinion"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_group_distribution": {
            "0-17": 0.2,
            "18-34": 0.3,
            "35-49": 0.2,
            "50-64": 0.2,
            "65+": 0.1
          },
          "income_lognorm": {
            "mean_log": 10.5,
            "sigma_log": 0.5
          },
          "risk_perception": {
            "base": 0.3,
            "noise_std": 0.1,
            "clip": [
              0,
              1
            ]
          },
          "trust_in_authorities": {
            "mean": 0.6,
            "std": 0.2,
            "clip": [
              0,
              1
            ]
          },
          "social_influence_susceptibility": {
            "mean": 0.7,
            "std": 0.15,
            "clip": [
              0,
              1
            ]
          },
          "media_consumption_level": {
            "mean": 0.6,
            "std": 0.2,
            "clip": [
              0,
              1
            ]
          },
          "organization_assignment": {
            "types": [
              "work",
              "school",
              "retail",
              "leisure",
              "none"
            ],
            "probs": [
              0.35,
              0.15,
              0.2,
              0.2,
              0.1
            ]
          },
          "mask_adoption_state": {
            "initial_prob": 0.1
          },
          "mask_inventory": {
            "prob_has_mask": 0.7,
            "count_if_has": {
              "low": 2,
              "high": 10
            }
          },
          "compliance_propensity": {
            "mean": 0.6,
            "std": 0.15,
            "clip": [
              0,
              1
            ]
          },
          "perceived_cost": {
            "mean": 0.2,
            "std": 0.1,
            "clip": [
              0,
              1
            ]
          },
          "adoption_threshold": {
            "mean": 0.4,
            "std": 0.1,
            "clip": [
              0,
              1
            ]
          },
          "fatigue_level": {
            "initial": 0.0
          },
          "last_adopted_day": {
            "initial": -1
          }
        }
      }
    },
    {
      "name": "Organization",
      "attributes": [
        "id",
        "type",
        "size",
        "mask_policy",
        "enforcement_level",
        "communication_strength",
        "entry_requirement",
        "fine_amount"
      ],
      "behaviors": [
        "set_policy",
        "enforce_policy",
        "broadcast_policy",
        "check_entry_compliance"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "types": [
            "work",
            "school",
            "retail",
            "leisure",
            "transport"
          ],
          "sizes": {
            "low": 10,
            "high": 1000
          },
          "mask_policy": "recommendation",
          "enforcement_level": 0.6,
          "communication_strength": 0.5,
          "entry_requirement": "none",
          "fine_amount": 50.0,
          "count": 50
        }
      }
    },
    {
      "name": "PolicyAuthority",
      "attributes": [
        "name",
        "policy_state",
        "penalty_amount",
        "campaign_budget",
        "messaging_frequency_days",
        "messaging_strategy",
        "subsidy_amount"
      ],
      "behaviors": [
        "issue_guidance_or_mandate",
        "adjust_penalties",
        "run_public_campaign",
        "allocate_subsidies"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "name": "PublicHealthDept",
          "policy_state": "recommendation",
          "penalty_amount": 50.0,
          "campaign_budget": 100000.0,
          "messaging_frequency_days": 7,
          "messaging_strategy": "risk_focus",
          "subsidy_amount": 0.0
        }
      }
    },
    {
      "name": "MediaSource",
      "attributes": [
        "id",
        "reach",
        "credibility",
        "tone",
        "message_frequency_days"
      ],
      "behaviors": [
        "broadcast_message",
        "amplify_policy_messages"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "count": 5,
          "reach": {
            "mean": 0.7,
            "std": 0.1,
            "clip": [
              0.2,
              1.0
            ]
          },
          "credibility": {
            "mean": 0.6,
            "std": 0.2,
            "clip": [
              0,
              1
            ]
          },
          "tone_choices": [
            "pro_mask",
            "neutral",
            "anti_mask"
          ],
          "tone_probs": [
            0.6,
            0.3,
            0.1
          ],
          "message_frequency_days": 7
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "stock_level",
        "max_stock",
        "restock_rate_per_day",
        "price",
        "rationing_policy"
      ],
      "behaviors": [
        "sell_masks",
        "restock",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "count": 3,
          "max_stock": 10000,
          "stock_level": 7000,
          "restock_rate_per_day": 0.1,
          "price": 2.0,
          "rationing_policy": "none"
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialInfluenceModule",
      "description": "Computes peer influence, social norm pressure, and updates individual perceived benefits/costs of mask adoption via network contagion and threshold dynamics.",
      "inputs": [
        "network.graph",
        "state.person.mask_adoption_state",
        "state.person.adoption_threshold",
        "state.person.social_influence_susceptibility"
      ],
      "outputs": [
        "signal.peer_norm_pressure",
        "signal.adoption_intent_delta",
        "observable.message_reach_from_peers"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  neighbors = network.neighbors(i)\n  f_i = mean(mask_adoption_state[j] for j in neighbors)\n  m_i = EMA_i of f_i over exposure_memory_days\n  norm_pressure_i = social_norm_strength * (m_i - adoption_threshold[i])\n  sanction_cost_i = max(0, adoption_threshold[i] - m_i) * social_sanction_cost_per_violation\n  adoption_intent_delta[i] = peer_influence_weight * social_influence_susceptibility[i] * (m_i - 0.5)\n  emit signal.peer_norm_pressure[i] = norm_pressure_i\n  emit signal.adoption_intent_delta[i] = adoption_intent_delta[i]\n  record observable.message_reach_from_peers as distribution of m_i",
        "notes": [
          "EMA_i initialized with first-day neighbor mean.",
          "Norm pressure can be negative; downstream modules interpret sign.",
          "Sanction cost is provided as part of perceived cost adjustment in BehaviorDecisionModule."
        ]
      },
      "requirements": [
        "network.small_world_graph",
        "Person list"
      ],
      "module_parameters": [
        "peer_influence_weight",
        "adoption_threshold_mean",
        "adoption_threshold_std",
        "dropout_rate_without_norms",
        "social_norm_strength",
        "social_sanction_cost_per_violation",
        "exposure_memory_days"
      ]
    },
    {
      "name": "MessagingPolicyModule",
      "description": "Broadcasts media and authority messages, updates risk perception and trust, and sets organization policy/enforcement and penalties.",
      "inputs": [
        "state.person.media_consumption_level",
        "state.person.trust_in_authorities",
        "state.organization.mask_policy"
      ],
      "outputs": [
        "signal.message_exposure",
        "state.organization.mask_policy",
        "state.organization.enforcement_level",
        "state.policy.enforcement_penalty"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day % messaging_frequency_days == 0:\n  for each media source s:\n    for each person i:\n      exposed = Bernoulli(media_reach * media_consumption_level[i])\n      if exposed:\n        tone_factor = +1 if s.tone == 'pro_mask' else (-1 if s.tone == 'anti_mask' else 0)\n        delta_risk = media_influence_weight * s.credibility * tone_factor * 0.05\n        risk_perception[i] = clip(risk_perception[i] + delta_risk, 0, 1)\n        message_exposure[i] += 1\n  for each person i:\n    exposed_authority = Bernoulli(0.9)  # near-universal reach of official announcements\n    if exposed_authority:\n      delta_trust = policy_influence_weight * (trust_in_authorities_mean - trust_in_authorities[i]) * 0.1\n      trust_in_authorities[i] = clip(trust_in_authorities[i] + delta_trust, 0, 1)\n      delta_risk_auth = policy_influence_weight * (1 if messaging_strategy=='risk_focus' else 0.5) * 0.03\n      risk_perception[i] = clip(risk_perception[i] + delta_risk_auth, 0, 1)\n# apply policy_state_initial to organizations\nfor each organization o:\n  if policy_state_initial == 'mandate':\n    o.mask_policy = 'mandate'\n  else:\n    o.mask_policy = 'recommendation'\n  o.enforcement_level = organization_enforcement_level\nstate.policy.enforcement_penalty = enforcement_penalty\nemit signal.message_exposure (per-person count this tick)",
        "notes": [
          "Message effects are small per campaign burst; cumulative over time.",
          "Authority exposure approximated as widespread; adjust if data available.",
          "Organizations adopt authority policy state each tick (can be extended to lagged adoption)."
        ]
      },
      "requirements": [
        "MediaSource list",
        "PolicyAuthority",
        "Organization list"
      ],
      "module_parameters": [
        "media_influence_weight",
        "policy_influence_weight",
        "media_reach",
        "media_credibility",
        "messaging_frequency_days",
        "policy_state_initial",
        "enforcement_penalty",
        "subsidy_amount",
        "campaign_budget",
        "messaging_strategy",
        "organization_enforcement_level"
      ]
    },
    {
      "name": "RetailMarketModule",
      "description": "Maintains retailer stock dynamics, processes purchase requests, adjusts price (optional), and records shortages.",
      "inputs": [
        "signal.purchase_requests"
      ],
      "outputs": [
        "state.retailer.stock_level",
        "state.retailer.price",
        "observable.purchase_failures",
        "signal.purchase_fills"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each retailer r:\n  restock_amount = retailer_restock_rate_per_day * (r.max_stock - r.stock_level)\n  noise = Normal(0, restock_variance * r.max_stock)\n  r.stock_level = clip(r.stock_level + restock_amount + noise, 0, r.max_stock)\n# process purchases FIFO\nfor request in signal.purchase_requests:\n  choose retailer r with highest stock_level\n  if r.stock_level >= request.quantity:\n    r.stock_level -= request.quantity\n    signal.purchase_fills.append({person_id: request.person_id, qty: request.quantity, price: r.price})\n  else:\n    observable.purchase_failures += 1\n# optional price adjustment based on shortage ratio\nshortage_ratio = observable.purchase_failures / max(1, len(signal.purchase_requests))\nif shortage_ratio > 0.2:\n  for r in retailers: r.price = min(50.0, r.price * (1 + 0.05))",
        "notes": [
          "FIFO purchase processing approximates daily queue.",
          "Price adjustment is conservative; demand elasticity applied in BehaviorDecisionModule purchase intent."
        ]
      },
      "requirements": [
        "Retailer list"
      ],
      "module_parameters": [
        "retailer_max_stock",
        "retailer_restock_rate_per_day",
        "restock_variance",
        "mask_price",
        "price_elasticity_of_demand",
        "mask_availability_initial",
        "rationing_policy"
      ]
    },
    {
      "name": "OrganizationComplianceModule",
      "description": "Simulates visits to organizations, compliance choices given policies, enforcement checks, and penalties issuance. Triggers mask purchases if needed.",
      "inputs": [
        "state.person.mask_adoption_state",
        "state.person.compliance_propensity",
        "state.organization.mask_policy",
        "state.organization.enforcement_level",
        "state.policy.enforcement_penalty"
      ],
      "outputs": [
        "observable.compliance_events",
        "observable.penalties_issued",
        "signal.purchase_requests"
      ],
      "dependencies": [
        "MessagingPolicyModule",
        "RetailMarketModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "observable.compliance_events = {attempts:0, compliant:0}\nobservable.penalties_issued = {count:0, value:0}\nfor each person i:\n  # decide visits\n  visit_work = Bernoulli(work_attendance_rate) if org type is work\n  visit_leisure = Bernoulli(leisure_visit_rate) if org type is leisure/retail\n  for each visited org o:\n    observable.compliance_events.attempts += 1\n    if o.mask_policy == 'mandate':\n      base = compliance_base_prob\n      noise = Normal(0, compliance_noise_std)\n      p_comply = clip(base * compliance_propensity[i] * (1 + o.enforcement_level) + noise, 0, 1)\n      will_comply = Bernoulli(p_comply)\n      if will_comply:\n        if person has mask_inventory > 0 or mask_adoption_state == 'adopted':\n          observable.compliance_events.compliant += 1\n        else:\n          # trigger purchase\n          demand_factor = (mask_price / 2.0) ** price_elasticity_of_demand\n          qty = ceil(2 * demand_factor)\n          signal.purchase_requests.append({person_id:i, quantity:qty})\n      else:\n        # enforcement\n        check = Bernoulli(o.enforcement_level * check_rate_per_day)\n        if check:\n          observable.penalties_issued.count += 1\n          observable.penalties_issued.value += enforcement_penalty\n    else:\n      # recommendation: track voluntary compliance similarly but no penalty\n      pass",
        "notes": [
          "Attendance split by organization type; can be extended with schedules.",
          "Demand_factor uses price elasticity to scale quantities.",
          "Penalty occurrence hinges on enforcement checks."
        ]
      },
      "requirements": [
        "Organization list",
        "Person list"
      ],
      "module_parameters": [
        "compliance_base_prob",
        "compliance_noise_std",
        "check_rate_per_day",
        "avoid_entry_cost",
        "work_attendance_rate",
        "leisure_visit_rate"
      ]
    },
    {
      "name": "BehaviorDecisionModule",
      "description": "Updates adoption and discontinuation decisions based on net utility from risk, policy, peer signals, perceived costs, fatigue, and supply constraints. Generates purchase intents.",
      "inputs": [
        "signal.peer_norm_pressure",
        "signal.adoption_intent_delta",
        "signal.message_exposure",
        "state.person.risk_perception",
        "state.person.perceived_cost",
        "state.person.fatigue_level",
        "state.person.mask_inventory"
      ],
      "outputs": [
        "state.person.mask_adoption_state",
        "state.person.fatigue_level",
        "state.person.last_adopted_day",
        "signal.purchase_requests",
        "observable.adoption_churn_events"
      ],
      "dependencies": [
        "SocialInfluenceModule",
        "MessagingPolicyModule",
        "RetailMarketModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "observable.adoption_churn_events = {adopt:0, discontinue:0}\nfor each person i:\n  benefit = risk_perception[i] * mask_effectiveness_proxy + signal.peer_norm_pressure[i] * 0.5\n  cost = perceived_cost[i] + fatigue_level[i]\n  net_utility = benefit - cost + signal.adoption_intent_delta[i]\n  p_adopt = sigmoid(adoption_sensitivity * net_utility)\n  can_switch = (day - last_adopted_day[i] >= min_days_between_switches)\n  if mask_adoption_state[i] == 'not_adopted':\n    if Bernoulli(p_adopt) and can_switch:\n      if mask_inventory[i] > 0:\n        mask_adoption_state[i] = 'adopted'\n        last_adopted_day[i] = day\n        observable.adoption_churn_events.adopt += 1\n      else:\n        # purchase intent if none available\n        demand_factor = (mask_price / 2.0) ** price_elasticity_of_demand\n        qty = max(1, ceil(2 * demand_factor))\n        signal.purchase_requests.append({person_id:i, quantity:qty})\n  else:\n    # potential discontinuation via fatigue and lack of norms\n    p_drop = clip(fatigue_or_burnout_rate + dropout_rate_without_norms * max(0, 0.5 - signal.peer_norm_pressure[i]), 0, 1)\n    p_drop = p_drop + discontinuation_bias\n    if Bernoulli(p_drop) and can_switch:\n      mask_adoption_state[i] = 'not_adopted'\n      observable.adoption_churn_events.discontinue += 1\n  # fatigue dynamics\n  fatigue_level[i] = clip(fatigue_level[i] + 0.01 * (mask_adoption_state[i] == 'adopted') - 0.02 * (mask_adoption_state[i] == 'not_adopted'), 0, 1)",
        "notes": [
          "Sigmoid slope governed by adoption_sensitivity.",
          "Fatigue increases when adopting and decays otherwise.",
          "Min days between switches prevents rapid oscillations."
        ]
      },
      "requirements": [
        "Person list"
      ],
      "module_parameters": [
        "fatigue_or_burnout_rate",
        "perceived_cost_mean",
        "perceived_cost_std",
        "trust_in_authorities_mean",
        "trust_in_authorities_std",
        "risk_perception_base",
        "adoption_sensitivity",
        "discontinuation_bias",
        "min_days_between_switches",
        "mask_effectiveness_proxy"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and computes time-to-target and group-level adoption metrics.",
      "inputs": [
        "state.person.mask_adoption_state",
        "state.person.age_group",
        "state.person.organization_id",
        "observable.compliance_events",
        "observable.purchase_failures",
        "observable.penalties_issued",
        "signal.message_exposure",
        "observable.adoption_churn_events"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_rate_by_age",
        "observable.compliance_in_mandated_spaces",
        "observable.mask_supply_shortage_rate",
        "observable.penalties_issued_per_day",
        "observable.message_reach",
        "observable.attitude_shift_index",
        "observable.adoption_churn_rate",
        "observable.time_to_target_adoption"
      ],
      "dependencies": [
        "OrganizationComplianceModule",
        "BehaviorDecisionModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "N = number of persons\nadoption_rate_daily = mean(mask_adoption_state == 'adopted')\nadoption_rate_by_age = group_mean(mask_adoption_state == 'adopted' by age_group)\nif observable.compliance_events.attempts > 0:\n  compliance_in_mandated_spaces = observable.compliance_events.compliant / observable.compliance_events.attempts\nelse:\n  compliance_in_mandated_spaces = null\nif total_purchase_requests_today > 0:\n  mask_supply_shortage_rate = observable.purchase_failures / total_purchase_requests_today\nelse:\n  mask_supply_shortage_rate = 0\npenalties_issued_per_day = observable.penalties_issued.count\nmessage_reach = sum(1 for i if signal.message_exposure[i] > 0) / N\nattitude_shift_index = mean(delta_risk_perception_today)  # computed from stored previous risk\nadoption_churn_rate = observable.adoption_churn_events.discontinue / max(1, prev_day_adopters)\nif adoption_rate_daily >= target_adoption_rate and time_to_target not set:\n  time_to_target_adoption = current_day",
        "notes": [
          "Store previous-day risk_perception to compute attitude_shift_index.",
          "Null compliance when no attempts avoids divide-by-zero; downstream metrics should handle nulls."
        ]
      },
      "requirements": [
        "Daily person states",
        "History buffers for risk perception"
      ],
      "module_parameters": [
        "target_adoption_rate"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 1000,
      "bounds": {
        "low": 100,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Number of Person agents.",
      "frozen": false
    },
    {
      "key": "time_horizon_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 1,
        "high": 10000
      },
      "owner_module": "global",
      "description": "Total simulation days.",
      "frozen": true
    },
    {
      "key": "time_step_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.5,
        "high": 7.0
      },
      "owner_module": "global",
      "description": "Time step size in days.",
      "frozen": true
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 0,
        "high": 2147483647
      },
      "owner_module": "global",
      "description": "RNG seed for reproducibility.",
      "frozen": true
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": null,
      "owner_module": "global",
      "description": "Social network type.",
      "frozen": true
    },
    {
      "key": "network_avg_degree",
      "dtype": "int",
      "default": 8,
      "bounds": {
        "low": 1,
        "high": 50
      },
      "owner_module": "global",
      "description": "Average degree in social network.",
      "frozen": false
    },
    {
      "key": "network_rewiring_prob",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "WS small-world rewiring probability.",
      "frozen": false
    },
    {
      "key": "initial_mask_adoption_rate",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial share of adopters.",
      "frozen": false
    },
    {
      "key": "disease_prevalence_index",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Exogenous disease prevalence proxy feeding risk perception baseline.",
      "frozen": false
    },
    {
      "key": "mask_effectiveness_proxy",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "BehaviorDecisionModule",
      "description": "Perceived protective benefit scaling factor.",
      "frozen": false
    },
    {
      "key": "target_adoption_rate",
      "dtype": "float",
      "default": 0.8,
      "bounds": {
        "low": 0.0,
