    },
    {
      "key": "marketing_sensitivity_mean",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.0,
        "high": 5.0
      },
      "owner_module": "InfluenceAndAdoption",
      "description": "Mean response to marketing signals.",
      "frozen": false
    },
    {
      "key": "marketing_sensitivity_sd",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 3.0
      },
      "owner_module": "InfluenceAndAdoption",
      "description": "SD of response to marketing signals.",
      "frozen": false
    },
    {
      "key": "smoothing_window_days",
      "dtype": "int",
      "default": 7,
      "bounds": {
        "low": 1,
        "high": 30
      },
      "owner_module": "AdoptionAggregator",
      "description": "Moving average window for smoothing observables.",
      "frozen": false
    },
    {
      "key": "report_by_group",
      "dtype": "bool",
      "default": true,
      "bounds": {
        "low": 0,
        "high": 1
      },
      "owner_module": "AdoptionAggregator",
      "description": "Whether to compute and emit group-level adoption rates.",
      "frozen": true
    },
    {
      "key": "reporting_lag_days",
      "dtype": "int",
      "default": 0,
      "bounds": {
        "low": 0,
        "high": 7
      },
      "owner_module": "AdoptionAggregator",
      "description": "Reporting delay applied to observable streams.",
      "frozen": false
    }
  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(Person.state == 'Adopter') / population_size",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_adoption.csv:adoption_rate"
    },
    {
      "id": "observable.daily_new_adopters",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "sum(new_adoptions_today)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_adoption.csv:daily_new"
    },
    {
      "id": "observable.cumulative_adopters",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative_sum(daily_new_adopters)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_adoption.csv:cumulative"
    },
    {
      "id": "observable.group_adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(group_id, mean(Person.state == 'Adopter'))",
      "frequency": "daily",
      "aggregation": "by_group(group_id)",
      "target_data_field": "train_adoption_by_group.csv:adoption_rate_by_group"
    },
    {
      "id": "observable.marketing_reach_daily",
      "source_module": "MarketingModule",
      "formula_or_field": "fraction(Person with marketing_signal > 0)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_marketing.csv:reach"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_adoption_rate_daily",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE_daily_new_adopters",
      "inputs": [
        "observable.daily_new_adopters"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "normalize": false
        }
      }
    },
    {
      "name": "PeakError_daily_new",
      "inputs": [
        "observable.daily_new_adopters"
      ],
      "definition": {
        "type": "PeakError",
        "config": {
          "on": "level"
        }
      }
    },
    {
      "name": "TimeToPeak_daily_new",
      "inputs": [
        "observable.daily_new_adopters"
      ],
      "definition": {
        "type": "TimeToPeak",
        "config": {
          "unit": "days"
        }
      }
    },
    {
      "name": "FinalSizeError",
      "inputs": [
        "observable.cumulative_adopters"
      ],
      "definition": {
        "type": "AbsoluteDifference",
        "config": {
          "at_day": 119
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "initial_adopter_fraction": 0.01,
    "group_count": 5,
    "time_horizon_days": 120
  },
  "algorithms": {
    "BarabasiAlbertGraph": "Preferential attachment network generation with parameter m.",
    "WattsStrogatzGraph": "Small-world network generation with mean degree k and rewiring probability p.",
    "AssortativityRewiring": "Degree-preserving edge swaps to reach target assortativity/clustering.",
    "ExponentialDecay": "x_t = x_{t-1} * exp(-ln(2)/half_life).",
    "Sigmoid": "sigma(z) = 1 / (1 + exp(-z)) used for adoption probability.",
    "TargetedAllocation": "Weighted budget allocation across chosen subset respecting max reach."
  },
  "data_sources": [
    {
      "name": "train_adoption.csv",
      "purpose": "Time series of aggregate adoption to calibrate and evaluate.",
      "fields_used": [
        "date",
        "adoption_rate",
        "daily_new",
        "cumulative"
      ]
    },
    {
      "name": "train_adoption_by_group.csv",
      "purpose": "Group-level adoption for validating heterogeneity.",
      "fields_used": [
        "date",
        "group_id",
        "adoption_rate_by_group"
      ]
    },
    {
      "name": "train_marketing.csv",
      "purpose": "Marketing reach series for validating exogenous inputs.",
      "fields_used": [
        "date",
        "reach"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entrypoint; parses config, runs simulation loop, orchestrates modules, computes metrics."
      },
      {
        "name": "modules/network_builder.py",
        "description": "Implements NetworkBuilder with homophily and rewiring routines."
      },
      {
        "name": "modules/marketing.py",
        "description": "Implements MarketingModule and targeting strategies."
      },
      {
        "name": "modules/policy.py",
        "description": "Implements PolicyModule with eligibility assignment."
      },
      {
        "name": "modules/influence.py",
        "description": "Implements InfluenceAndAdoption dynamics and agent state updates."
      },
      {
        "name": "modules/aggregator.py",
        "description": "Computes observables and applies smoothing/lag."
      },
      {
        "name": "entities.py",
        "description": "Data classes for Person, Firm, Policy and utilities."
      },
      {
        "name": "metrics.py",
        "description": "Metric implementations: RMSE, MAE, PeakError, TimeToPeak, AbsoluteDifference."
      },
      {
        "name": "utils/random.py",
        "description": "Random number utilities with seeding."
      },
      {
        "name": "utils/network_ops.py",
        "description": "Graph utilities: assortativity rewiring, clustering adjustment."
      },
      {
        "name": "config/schema.json",
        "description": "JSON schema for configuration and parameters."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy"
    ]
  },
  "prediction_period": {
    "start_day": 30,
    "end_day": 39
  },
  "evaluation_metrics": [
    "RMSE_adoption_rate_daily",
    "MAE_daily_new_adopters",
    "PeakError_daily_new",
    "TimeToPeak_daily_new",
    "FinalSizeError"
  ]
}