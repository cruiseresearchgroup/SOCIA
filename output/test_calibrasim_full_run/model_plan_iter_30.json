      "owner_module": "global",
      "description": "Total number of agents in the population.",
      "frozen": false
    },
    {
      "key": "time_horizon_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Total simulated days.",
      "frozen": false
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
