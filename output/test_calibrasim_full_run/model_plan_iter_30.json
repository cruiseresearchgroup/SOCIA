{
  "model_type": "agent_based",
  "description": "Network diffusion model for technology adoption with heterogeneous agents influenced by peers, marketing, and policy incentives.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "state",
        "adoption_time",
        "threshold",
        "susceptibility",
        "income",
        "price_sensitivity",
        "marketing_sensitivity",
        "peer_weight",
        "intrinsic_utility",
        "fatigue",
        "awareness",
        "group_id",
        "degree"
      ],
      "behaviors": [
        "perceive_peer_influence",
        "perceive_marketing",
        "apply_policy_incentive",
        "adoption_decision"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "threshold_distribution": "truncated_normal(mean=0.3, sd=0.15, bounds=[0,1])",
          "peer_weight_distribution": "truncated_normal(mean=0.6, sd=0.2, bounds=[0,2])",
          "intrinsic_utility_distribution": "normal(mean=0.2, sd=0.4)",
          "income_distribution": "lognormal(mean=log(50000), sd=0.3)",
          "price_sensitivity_distribution": "truncated_normal(mean=0.00002, sd=0.00001, bounds=[0,0.001])",
          "marketing_sensitivity_distribution": "truncated_normal(mean=1.0, sd=0.5, bounds=[0,5])",
          "initial_state_share_adopters": 0.01
        }
      }
    },
    {
      "name": "Firm",
      "attributes": [
        "daily_budget",
        "targeting_strategy",
        "ad_effectiveness",
        "saturation_half_life",
        "max_reach_fraction",
        "retargeting_bias"
      ],
      "behaviors": [
        "allocate_marketing",
        "update_awareness"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "daily_budget": 10000.0,
          "targeting_strategy": "degree_weighted"
        }
      }
    },
    {
      "name": "Policy",
      "attributes": [
        "subsidy_amount",
        "start_day",
        "end_day",
        "eligibility_fraction",
        "targeting_group_bias",
        "awareness_effect"
      ],
      "behaviors": [
        "assign_eligibility",
        "apply_subsidy",
        "boost_awareness"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "subsidy_amount": 50.0,
          "start_day": 20,
          "end_day": 60,
          "eligibility_fraction": 0.5,
          "targeting_group_bias": 0.7
        }
      }
    }
  ],
  "modules": [
    {
      "name": "NetworkBuilder",
      "description": "Constructs the social network and assigns group membership with homophily.",
      "inputs": [],
      "outputs": [
        "signal.graph",
        "signal.agents_with_groups"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "steps",
        "value": 0
      },
      "update_rule": {
        "pseudocode": "if network_type == 'scale_free':\n  G = BarabasiAlbertGraph(N=population_size, m=preferential_attachment_m)\nelse:\n  G = WattsStrogatzGraph(N=population_size, k=round(avg_degree), p=rewiring_prob)\nAssign group_id to each node by sampling group_count groups with probabilities proportional to exp(homophily_strength * attribute_similarity)\nIf degree_assortativity != 0 or clustering_bias > 0:\n  perform degree-preserving rewiring to match target assortativity and clustering\nOutput G and agent group assignments",
        "notes": [
          "Homophily enacted by preferential within-group link rewiring until modularity target approximated.",
          "Assortativity rewiring preserves degree sequence."
        ]
      },
      "requirements": [
        "RNG",
        "networkx"
      ],
      "module_parameters": [
        "network_type",
        "avg_degree",
        "rewiring_prob",
        "preferential_attachment_m",
        "homophily_strength",
        "group_count",
        "clustering_bias",
        "degree_assortativity"
      ]
    },
    {
      "name": "MarketingModule",
      "description": "Allocates daily marketing exposures to agents based on strategy and updates awareness with saturation dynamics.",
      "inputs": [
        "signal.graph",
        "signal.agent_states"
      ],
      "outputs": [
        "signal.marketing_signal_by_agent",
        "signal.marketing_reach_daily"
      ],
      "dependencies": [
        "NetworkBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "budget = marketing_budget_daily\nif targeting_strategy == 'uniform':\n  weight_i = 1 for all non-adopters\nelif targeting_strategy == 'degree_weighted':\n  weight_i = degree(i)\nelif targeting_strategy == 'high_income':\n  weight_i = income(i)\nelif targeting_strategy == 'retarget_nonadopters':\n  weight_i = (1 + retargeting_bias * (1 - adopted(i)))\nNormalize weights over non-adopters; limit targeted count to max_reach_fraction * population_size\nAllocate exposures_i = budget * weight_i / sum(weights) * ad_effectiveness\nUpdate awareness_i = awareness_i * exp(-ln(2)/saturation_half_life) + exposures_i\nmarketing_signal_i = exposures_i\nCompute marketing_reach_daily = fraction of agents with exposures_i > 0",
        "notes": [
          "Exposure measured in effective impressions per day.",
          "Awareness decays with half-life and contributes indirectly via InfluenceAndAdoption through marketing_sensitivity."
        ]
      },
      "requirements": [
        "RNG",
        "numpy"
      ],
      "module_parameters": [
        "marketing_budget_daily",
        "targeting_strategy",
        "ad_effectiveness",
        "saturation_half_life",
        "max_reach_fraction",
        "retargeting_bias"
      ]
    },
    {
      "name": "PolicyModule",
      "description": "Implements time-bounded subsidy and eligibility assignment with group-targeting bias and policy awareness boost.",
      "inputs": [
        "signal.agents_with_groups",
        "signal.day"
      ],
      "outputs": [
        "signal.policy_subsidy_by_agent",
        "signal.policy_indicator_by_agent"
      ],
      "dependencies": [
        "NetworkBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day == 0:\n  For each group g, compute target probability p_g proportional to (targeting_group_bias if g in top-biased groups else 1)\n  Assign eligibility to agents via Bernoulli with group-conditioned p to meet eligibility_fraction overall\nactive = (policy_start_day <= day <= policy_end_day)\nFor each agent i:\n  policy_indicator_i = 1 if active and eligible(i) else 0\n  policy_subsidy_i = subsidy_amount if policy_indicator_i == 1 else 0\n  if policy_indicator_i == 1:\n    awareness_i += policy_awareness_effect",
        "notes": [
          "Eligibility fixed at day 0 to avoid endogeneity.",
          "Group bias steers more eligibility to specified groups while respecting overall fraction."
        ]
      },
      "requirements": [
        "RNG"
      ],
      "module_parameters": [
        "subsidy_amount",
        "policy_start_day",
        "policy_end_day",
        "eligibility_fraction",
        "targeting_group_bias",
        "policy_awareness_effect"
      ]
    },
    {
      "name": "InfluenceAndAdoption",
      "description": "Updates agent states via social influence, marketing, price and policy-modulated utility; records adoption events.",
      "inputs": [
        "signal.graph",
        "signal.marketing_signal_by_agent",
        "signal.policy_subsidy_by_agent",
        "signal.policy_indicator_by_agent",
        "signal.agent_attributes",
        "signal.day"
      ],
      "outputs": [
        "signal.agent_states",
        "signal.daily_new_adopters"
      ],
      "dependencies": [
        "NetworkBuilder",
        "MarketingModule",
        "PolicyModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "decay_factor = exp(-ln(2)/influence_decay_half_life)\nFor each agent i where state == 'NonAdopter':\n  peer_fraction = mean(state_j == 'Adopter' for j in neighbors(i)) if degree(i) > 0 else 0\n  perceived_peer_i = memory_decay * peer_fraction + (1 - memory_decay) * previous_perceived_peer_i\n  previous_perceived_peer_i = perceived_peer_i * decay_factor\n  effective_price_i = max(base_price - policy_subsidy_i, 0)\n  affordability_i = clamp(1.0 - effective_price_i / max(0.1 * income_i, 1.0), 0, 1)\n  utility_i = intrinsic_utility_i + peer_weight_i * perceived_peer_i + marketing_sensitivity_i * marketing_signal_i + policy_indicator_i * policy_awareness_effect\n  threshold_i = threshold_i (fixed per agent)\n  p_logit = 1 / (1 + exp(-(utility_i - threshold_i)/max(temperature, 1e-6)))\n  p_i = p_logit * affordability_i * (1 - fatigue_i)\n  if RNG.uniform() < p_i:\n    state_i = 'Adopter'; adoption_time_i = day; daily_new++\n  else:\n    fatigue_i = min(fatigue_i + fatigue_increment, 1.0)\nApply cap: if daily_new > max_daily_adoption_fraction * population_size, randomly accept only up to the cap and defer the rest\nOutput updated agent states and daily_new_adopters",
        "notes": [
          "Adoption is absorbing; no disadoption.",
          "Fatigue represents diminishing responsiveness after repeated non-adopting exposures.",
          "Affordability ties price to income to avoid unrealistic adoption at low incomes."
        ]
      },
      "requirements": [
        "RNG",
        "numpy"
      ],
      "module_parameters": [
        "base_price",
        "price_elasticity",
        "intrinsic_utility_mean",
        "intrinsic_utility_sd",
        "peer_weight_mean",
        "peer_weight_sd",
        "threshold_mean",
        "threshold_sd",
        "temperature",
        "memory_decay",
        "influence_decay_half_life",
        "fatigue_increment",
        "max_daily_adoption_fraction",
        "income_mean",
        "income_sd",
        "price_sensitivity_mean",
        "price_sensitivity_sd",
        "marketing_sensitivity_mean",
        "marketing_sensitivity_sd"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and applies optional smoothing/lag.",
      "inputs": [
        "signal.agent_states",
        "signal.daily_new_adopters",
        "signal.agents_with_groups",
        "signal.marketing_reach_daily"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.daily_new_adopters",
        "observable.cumulative_adopters",
        "observable.group_adoption_rate_daily",
        "observable.marketing_reach_daily"
      ],
      "dependencies": [
        "InfluenceAndAdoption",
        "MarketingModule",
        "NetworkBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "N = population_size\nadoption_rate_daily = count(state_i == 'Adopter') / N\ncumulative_adopters = count(state_i == 'Adopter')\nby_group = for each g: mean(state_i == 'Adopter' for i in group g)\nif smoothing_window_days > 1:\n  apply moving average to daily_new_adopters and adoption_rate_daily over the window\napply reporting_lag_days by shifting series forward if > 0\nOutput observables",
        "notes": [
          "Smoothing window is centered trailing average.",
          "Reporting lag can emulate data publication delays."
        ]
      },
      "requirements": [
        "numpy"
      ],
      "module_parameters": [
        "smoothing_window_days",
        "report_by_group",
        "reporting_lag_days"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 100,
        "high": 100000
