  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing_today)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "public_health_surveys.csv:adoption_rate_daily"
    },
    {
      "id": "observable.context_compliance_daily.workplace",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "signal.context_compliance['workplace']",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "compliance_monitors.csv:workplace_compliance"
    },
    {
      "id": "observable.context_compliance_daily.retail",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "signal.context_compliance['retail']",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "compliance_monitors.csv:retail_compliance"
    },
    {
      "id": "observable.context_compliance_daily.transit",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "signal.context_compliance['transit']",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "compliance_monitors.csv:transit_compliance"
    },
    {
      "id": "observable.purchase_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "masks_purchased / population_size",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "retail_sales.csv:masks_per_capita"
    },
    {
      "id": "observable.enforcement_events_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(enforcement_events)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "enforcement_admin.csv:events_per_day"
    },
    {
      "id": "observable.adoption_by_group_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing_today) by socioeconomic_status quintile",
      "frequency": "daily",
      "aggregation": "by_group(socioeconomic_status)",
      "target_data_field": "survey_stratified.csv:adoption_by_ses_quintile"
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": 179
        }
      }
    },
    {
      "name": "context_specific_compliance_workplace",
      "inputs": [
        "observable.context_compliance_daily.workplace"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": 179
        }
      }
    },
    {
      "name": "context_specific_compliance_retail",
      "inputs": [
        "observable.context_compliance_daily.retail"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": 179
        }
      }
    },
    {
      "name": "context_specific_compliance_transit",
      "inputs": [
        "observable.context_compliance_daily.transit"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": 179
        }
      }
    },
    {
      "name": "time_to_threshold_70",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.7
        }
      }
    },
    {
      "name": "peak_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Max",
        "config": {}
      }
    },
    {
      "name": "sustained_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MeanOverWindow",
        "config": {
          "window_days": 30,
          "position": "last"
        }
      }
    },
    {
      "name": "policy_impact_delta",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "DifferenceOfMeans",
        "config": {
          "pre_window": {
            "start": 0,
            "end": 29
          },
          "post_window": {
            "start": 30,
            "end": 59
          }
        }
      }
    },
    {
      "name": "equity_gap",
      "inputs": [
        "observable.adoption_by_group_daily"
      ],
      "definition": {
        "type": "GroupGap",
        "config": {
          "group_low": "SES_Q1",
          "group_high": "SES_Q5",
          "window_days": 30,
          "position": "last"
        }
      }
    },
    {
      "name": "purchase_rate",
      "inputs": [
        "observable.purchase_rate_daily"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": 179
        }
      }
    },
    {
      "name": "enforcement_events",
      "inputs": [
        "observable.enforcement_events_daily"
      ],
      "definition": {
        "type": "SumOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": 179
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "network": {
      "type": "scale_free",
      "average_degree": 10.0
    },
    "retailers": {
      "num_retailers": 100,
      "inventory_per_capita": 2.0,
      "price_initial": 1.0
    },
    "policies": {
      "mandate_active": false,
      "mandate_start_day": 30,
      "enforcement_strength": 0.6
    }
  },
  "algorithms": {
    "BarabasiAlbert": "Generates a scale-free network with preferential attachment; m = average_degree/2.",
    "SigmoidUtilityDecision": "Probabilistic mask-use decision p = 1/(1+exp(-utility)), where utility aggregates social, informational, mandate, risk, and fatigue terms.",
    "InventoryPricing": "Price adjusts by inventory ratio: price = base*(1 + alpha*(1 - inv_ratio)).",
    "TimeToThreshold": "Earliest day t where observable >= threshold; if never reached, set to NaN or time_horizon_days+1.",
    "GroupGap": "Difference between mean adoption of specified high vs low group over window."
  },
  "data_sources": [
    {
      "name": "public_health_surveys.csv",
      "purpose": "Calibrate and validate overall daily adoption rates.",
      "fields_used": [
        "date",
        "adoption_rate_daily"
      ]
    },
    {
      "name": "compliance_monitors.csv",
      "purpose": "Validate context-specific compliance (workplace, retail, transit).",
      "fields_used": [
        "date",
        "workplace_compliance",
        "retail_compliance",
        "transit_compliance"
      ]
    },
    {
      "name": "retail_sales.csv",
      "purpose": "Compare simulated mask purchases per capita.",
      "fields_used": [
        "date",
        "masks_per_capita"
      ]
    },
    {
      "name": "enforcement_admin.csv",
      "purpose": "Compare counts of enforcement or denial-of-service events.",
      "fields_used": [
        "date",
        "events_per_day"
      ]
    },
    {
      "name": "survey_stratified.csv",
      "purpose": "Assess equity gap across SES quintiles.",
      "fields_used": [
        "date",
        "SES_Q1",
        "SES_Q5"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point; orchestrates simulation loop, config loading, and outputs."
      },
      {
        "name": "entities.py",
        "description": "Class definitions for Person, Household, Location, Retailer, Government, Media, EpidemiologicalSignal."
      },
      {
        "name": "modules/social_network.py",
        "description": "Implements SocialNetwork module and context assignment."
      },
      {
        "name": "modules/epi_signal.py",
        "description": "Implements EpidemiologySignal module."
      },
      {
        "name": "modules/policy_media.py",
        "description": "Implements GovernmentAndMedia module."
      },
      {
        "name": "modules/retail_market.py",
        "description": "Implements RetailMarket module."
      },
      {
        "name": "modules/enforcement.py",
        "description": "Implements LocationEnforcement module."
      },
      {
        "name": "modules/decision.py",
        "description": "Implements DecisionAndBehavior module."
      },
      {
        "name": "modules/aggregation.py",
        "description": "Implements AdoptionAggregator module and metrics utilities."
      },
      {
        "name": "utils/metrics.py",
        "description": "Metric computations (TimeToThreshold, GroupGap, etc.)."
      },
      {
        "name": "utils/random.py",
        "description": "Random seeds, distributions, reproducibility helpers."
      },
      {
        "name": "config/params.json",
        "description": "Default parameter configuration."
      }
    ],
    "dependencies": [
      "numpy",
      "scipy",
      "networkx",
      "pandas",
      "numba"
    ]
  },
  "prediction_period": {
    "start_day": 150,
    "end_day": 180
  },
  "evaluation_metrics": [
    "overall_adoption_rate",
    "context_specific_compliance",
    "time_to_threshold",
    "peak_adoption",
    "sustained_adoption",
    "policy_impact_delta",
    "equity_gap",
    "purchase_rate",
    "enforcement_events"
  ]
}