{
  "model_type": "agent_based",
  "description": "An agent-based, network-embedded simulation of mask-wearing adoption dynamics driven by social influence, policy mandates and enforcement, media messaging, venue norms, household effects, and retail supply constraints.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "income",
        "household_id",
        "location",
        "social_neighbors",
        "initial_mask_adoption",
        "mask_wearing",
        "belief_pro_mask",
        "risk_perception",
        "trust_in_authority",
        "compliance_propensity",
        "social_influence_susceptibility",
        "habit_strength",
        "mask_inventory",
        "mask_quality_preference",
        "comfort_cost"
      ],
      "behaviors": [
        "decide_wear_mask",
        "update_beliefs_from_contacts",
        "update_beliefs_from_media",
        "respond_to_policy_and_enforcement",
        "purchase_masks",
        "form_or_decay_habit",
        "visit_venues",
        "share_opinion"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "initial_mask_adoption_rate": 0.2,
          "belief_init_mean": 0.3,
          "belief_init_sd": 0.2,
          "trust_init_mean": 0.5,
          "trust_init_sd": 0.2,
          "initial_mask_inventory_mean": 3
        }
      }
    },
    {
      "name": "Household",
      "attributes": [
        "id",
        "member_ids",
        "socioeconomic_status",
        "shared_mask_inventory"
      ],
      "behaviors": [
        "share_resources",
        "influence_members"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "household_size_prob_1": 0.25,
          "household_size_prob_2": 0.35,
          "household_size_prob_3": 0.25,
          "household_size_prob_4plus": 0.15
        }
      }
    },
    {
      "name": "Venue",
      "attributes": [
        "id",
        "type",
        "capacity",
        "mask_policy",
        "enforcement_level",
        "foot_traffic_rate"
      ],
      "behaviors": [
        "enforce_mask_policy",
        "signal_norms_to_visitors"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "venues_count": 50,
          "venue_mix_workplaces": 0.3,
          "venue_mix_schools": 0.2,
          "venue_mix_stores": 0.3,
          "venue_mix_transit": 0.2
        }
      }
    },
    {
      "name": "Authority",
      "attributes": [
        "policy_state",
        "policy_schedule",
        "enforcement_resources",
        "fine_amount",
        "messaging_intensity",
        "message_content_bias"
      ],
      "behaviors": [
        "set_or_update_policy",
        "deploy_enforcement",
        "broadcast_messages"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "policy_initial_state": "none",
          "mandate_start_day": 30,
          "mandate_end_day": 120,
          "fine_amount": 50,
          "enforcement_resources": 100,
          "authority_messaging_intensity": 1.0,
          "authority_message_content_bias": 0.7
        }
      }
    },
    {
      "name": "MediaOutlet",
      "attributes": [
        "id",
        "bias",
        "reach",
        "message_frequency",
        "misinformation_rate"
      ],
      "behaviors": [
        "publish_messages",
        "target_audience_segments"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "media_outlet_count": 5,
          "media_reach_mean": 0.4,
          "media_bias_mean": 0.6,
          "media_bias_sd": 0.3,
          "misinformation_rate": 0.1
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "stock_level",
        "price",
        "restock_delay"
      ],
      "behaviors": [
        "sell_masks",
        "adjust_price",
        "restock"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "retailer_count": 10,
          "retailer_initial_stock": 1000,
          "mask_cost": 1.0,
          "restock_delay_mean_days": 3
        }
      }
    }
  ],
  "modules": [
    {
      "name": "MediaMessaging",
      "description": "Broadcast and exposure of messages from authority and media outlets; updates beliefs, risk perception, trust, and tracks sentiment balance.",
      "inputs": [
        "Authority.policy_state",
        "Authority.messaging_intensity",
        "Authority.message_content_bias",
        "MediaOutlet.*",
        "Person.trust_in_authority",
        "Person.belief_pro_mask"
      ],
      "outputs": [
        "Person.belief_pro_mask",
        "Person.risk_perception",
        "Person.trust_in_authority",
        "observable.message_sentiment_balance_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person p:\n  msg_signal = 0\n  # Authority message\n  if Authority.policy_state in ['recommendation','mandate']:\n    auth_msg = authority_messaging_intensity * (2*authority_message_content_bias - 1)\n    msg_signal += auth_msg\n    # trust-mediated effect\n    p.belief_pro_mask += messaging_effect_size * p.trust_in_authority * auth_msg\n    p.risk_perception += messaging_effect_size * p.trust_in_authority * max(0, auth_msg)\n  # Media exposure\n  exposures = Poisson(media_outlet_count * media_reach_mean)\n  for i in 1..exposures:\n    outlet = sample(MediaOutlets, prob proportional to outlet.reach)\n    bias = outlet.bias + Normal(0, media_bias_sd)\n    misinformation = Bernoulli(misinformation_rate)\n    msg = (2*bias - 1) * (1 if not misinformation else -1)\n    msg_signal += msg\n    p.belief_pro_mask += messaging_effect_size * msg * (0.5 + 0.5 * p.trust_in_authority)\n    p.risk_perception += 0.5*messaging_effect_size * max(0, msg)\n    # trust update (confirmation dynamics)\n    p.trust_in_authority += trust_update_rate * sign(auth_msg if defined else 0) * (p.belief_pro_mask - 0.5)\n  record message_sentiment_balance_person = msg_signal\naggregate observable.message_sentiment_balance_daily = mean(message_sentiment_balance_person)",
        "notes": [
          "Authority message treated as pro-mask if bias > 0.5; negative values possible if messaging is contrarian.",
          "Trust update is a slow drift; clamp all Person state variables to [0,1] after updates."
        ]
      },
      "requirements": [
        "RandomGenerator",
        "PersonStateAccess",
        "AuthorityStateAccess",
        "MediaRegistry"
      ],
      "module_parameters": [
        "messaging_effect_size",
        "misinformation_rate",
        "media_outlet_count",
        "media_reach_mean",
        "media_bias_mean",
        "media_bias_sd",
        "trust_update_rate",
        "authority_messaging_intensity",
        "authority_message_content_bias"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Sets and updates policy state (e.g., mandate period) and enforcement parameters available to venues.",
      "inputs": [
        "day",
        "Authority.enforcement_resources"
      ],
      "outputs": [
        "Authority.policy_state",
        "Authority.fine_amount",
        "Authority.enforcement_resources"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day < mandate_start_day or day > mandate_end_day:\n  Authority.policy_state = policy_initial_state  # 'none' by default\nelse:\n  Authority.policy_state = 'mandate'\nAuthority.fine_amount = fine_amount\nAuthority.enforcement_resources = enforcement_resources\n# policy_effect_size and enforcement_probability are read by DecisionAndHabit and VenueInteractions respectively.",
        "notes": [
          "Simple schedule-based policy. Can be extended with feedback policies.",
          "Resources are daily budgets used implicitly by VenueInteractions (probabilistically via enforcement_probability)."
        ]
      },
      "requirements": [
        "Clock",
        "AuthorityStateAccess"
      ],
      "module_parameters": [
        "policy_initial_state",
        "mandate_start_day",
        "mandate_end_day",
        "policy_effect_size",
        "enforcement_probability",
        "fine_amount",
        "enforcement_resources"
      ]
    },
    {
      "name": "HouseholdInfluence",
      "description": "Households share mask inventory and exert normative influence on members' beliefs.",
      "inputs": [
        "Household.*",
        "Person.*"
      ],
      "outputs": [
        "Household.shared_mask_inventory",
        "Person.belief_pro_mask",
        "Person.mask_inventory"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each household h:\n  # Share masks up to pooling efficiency\n  total_masks = sum(p.mask_inventory for p in h.members)\n  pooled = floor(total_masks * shared_mask_pooling_efficiency)\n  per_capita = floor(pooled / len(h.members))\n  for p in h.members:\n    p.mask_inventory = max(p.mask_inventory, per_capita)\n  h.shared_mask_inventory = pooled\n  # Normative influence (shift beliefs toward household mean)\n  mean_belief = mean(p.belief_pro_mask for p in h.members)\n  for p in h.members:\n    p.belief_pro_mask += household_influence_weight * (mean_belief - p.belief_pro_mask)",
        "notes": [
          "Pooling is lossy to reflect coordination inefficiency; unpooled remainder stays with individuals implicitly via max().",
          "Clamp beliefs to [0,1] after update."
        ]
      },
      "requirements": [
        "HouseholdIndex",
        "PersonStateAccess"
      ],
      "module_parameters": [
        "household_influence_weight",
        "shared_mask_pooling_efficiency"
      ]
    },
    {
      "name": "SocialInfluence",
      "description": "Peer effects from social network interactions update beliefs and perceived norms.",
      "inputs": [
        "Person.social_neighbors",
        "Person.mask_wearing",
        "Person.belief_pro_mask",
        "Person.social_influence_susceptibility"
      ],
      "outputs": [
        "Person.belief_pro_mask"
      ],
      "dependencies": [
        "MediaMessaging"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person p:\n  k = Poisson(daily_interactions_mean)\n  contacts = sample(p.social_neighbors, k)\n  observed_wear = mean(c.mask_wearing for c in contacts) if k>0 else 0\n  mean_belief_contacts = mean(c.belief_pro_mask for c in contacts) if k>0 else 0\n  delta = social_influence_weight * p.social_influence_susceptibility * (mean_belief_contacts - p.belief_pro_mask)\n  # Observational norm: seeing masks increases belief directly\n  delta += social_noise_std * Normal(0,1) + 0.5*social_influence_weight * (observed_wear - p.mask_wearing)\n  p.belief_pro_mask += delta\n  clamp p.belief_pro_mask to [0,1]",
        "notes": [
          "Combines informational (beliefs) and normative (observed behavior) influence.",
          "Social noise adds idiosyncratic variation."
        ]
      },
      "requirements": [
        "NetworkAccess",
        "RandomGenerator"
      ],
      "module_parameters": [
        "daily_interactions_mean",
        "social_influence_weight",
        "social_noise_std"
      ]
    },
    {
      "name": "VenueInteractions",
      "description": "Simulates daily visits to venues, enforces venue mask policies, logs compliance, fines, and norm cues.",
      "inputs": [
        "Venue.*",
        "Authority.policy_state",
        "Authority.fine_amount",
        "Person.mask_wearing"
      ],
      "outputs": [
        "observable.venue_compliance_rate_daily",
        "observable.fines_issued_daily",
        "Person.mask_wearing"
      ],
      "dependencies": [
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "total_checks = 0; total_compliant = 0; fines_issued = 0\nfor each person p:\n  if Bernoulli(foot_traffic_base_rate):\n    v = sample(Venues, prob proportional to v.foot_traffic_rate)\n    required = (v.mask_policy == 'required') or (Authority.policy_state == 'mandate')\n    compliant = p.mask_wearing or (required and Bernoulli(compliance_fallback_wear_probability))\n    if required:\n      total_checks += 1\n      if compliant:\n        total_compliant += 1\n      else:\n        # potential enforcement\n        if Bernoulli(enforcement_probability):\n          fines_issued += 1\n    # Norm cue feedback: if high compliance observed at venue, boost person's next-day propensity via a temporary signal\n    observed_compliance = v.last_compliance_rate  # from previous day\n    p.belief_pro_mask += observation_effect_weight * (observed_compliance - 0.5)\naggregate observable.venue_compliance_rate_daily = (total_compliant / max(1,total_checks))\nobservable.fines_issued_daily = fines_issued\nfor each venue v:\n  v.last_compliance_rate = observable.venue_compliance_rate_daily  # simplistic global rate proxy",
        "notes": [
          "Enforcement consumes no explicit resource here; probability approximates limited resources.",
          "Venue compliance is averaged across all checks; can be refined per-venue."
        ]
      },
      "requirements": [
        "VenueRegistry",
        "RandomGenerator"
      ],
      "module_parameters": [
        "observation_effect_weight",
        "compliance_fallback_wear_probability",
        "enforcement_probability",
        "foot_traffic_base_rate"
      ]
    },
    {
      "name": "RetailMarket",
      "description": "Retailers adjust price, restock; persons purchase masks based on inventory thresholds and price; tracks stockout days.",
      "inputs": [
        "Retailer.*",
        "Person.mask_inventory",
        "Person.income"
      ],
      "outputs": [
        "Retailer.stock_level",
        "Retailer.price",
        "Person.mask_inventory",
        "observable.stockout_any_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "# Retailer pricing and restock\nfor each retailer r:\n  # simple price adjustment toward demand pressure\n  demand_signal = r.yesterday_demand / max(1, r.stock_level + r.yesterday_demand)\n  r.price = max(0.1, mask_cost * (1 + retailer_price_adjustment_rate * (demand_signal - 0.5)))\n  # restock with probability tied to restock delay\n  if Bernoulli(min(1, 1.0 / restock_delay_mean_days)):\n    restock_qty = Poisson(supply_availability * retailer_initial_stock)\n    r.stock_level += restock_qty\n  r.yesterday_demand = 0\n# Person purchases\nfor each person p:\n  if p.mask_inventory < purchase_threshold_inventory:\n    # choose cheapest available retailer\n    r = argmin_price([retailers with stock])\n    if r exists:\n      # affordability via price elasticity and income\n      affordability = min(1, max(0, 1 + price_elasticity_of_demand * (r.price - mask_cost)))\n      qty = Binomial(purchase_quantity_per_attempt, affordability)\n      qty = min(qty, r.stock_level)\n      r.stock_level -= qty\n      p.mask_inventory += qty\n      r.yesterday_demand += qty\n# stockout observable\nobservable.stockout_any_daily = 1 if any(r.stock_level == 0 for r in Retailers) else 0",
        "notes": [
          "Price elasticity adjusts effective purchase quantity.",
          "Restock modeled as Bernoulli per day with average delay."
        ]
      },
      "requirements": [
        "RetailerRegistry",
        "RandomGenerator"
      ],
      "module_parameters": [
        "mask_cost",
        "price_elasticity_of_demand",
        "supply_availability",
        "restock_delay_mean_days",
        "retailer_initial_stock",
        "retailer_price_adjustment_rate",
        "purchase_threshold_inventory",
        "purchase_quantity_per_attempt"
      ]
    },
    {
      "name": "DecisionAndHabit",
      "description": "Determines daily mask-wearing based on beliefs, risk perception, policy, enforcement expectations, inventory, comfort cost, and habit dynamics.",
      "inputs": [
        "Person.belief_pro_mask",
        "Person.risk_perception",
        "Person.trust_in_authority",
        "Person.habit_strength",
        "Person.mask_inventory",
        "Person.compliance_propensity",
        "Authority.policy_state"
      ],
      "outputs": [
        "Person.mask_wearing",
        "Person.habit_strength"
      ],
      "dependencies": [
        "MediaMessaging",
        "PolicyAndEnforcement",
        "HouseholdInfluence",
        "SocialInfluence"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person p:\n  # Utility-style propensity score\n  policy_term = policy_effect_size * (1 if Authority.policy_state == 'mandate' else 0)\n  inventory_term = 0 if p.mask_inventory <= 0 else 1\n  comfort_term = -mask_comfort_penalty * p.comfort_cost\n  habit_term = p.habit_strength\n  risk_term = risk_sensitivity * p.risk_perception\n  belief_term = p.belief_pro_mask\n  propensity = belief_term + risk_term + policy_term + habit_term + comfort_term\n  propensity = propensity * inventory_term\n  prob_wear = sigmoid(propensity - 2.0)  # center to target realistic rates\n  p.mask_wearing = Bernoulli(prob_wear)\n  if p.mask_wearing and p.mask_inventory > 0:\n    p.mask_inventory -= 1\n  # Habit update\n  if p.mask_wearing:\n    p.habit_strength += habit_formation_rate * (1 - p.habit_strength)\n  else:\n    p.habit_strength -= habit_decay_rate * p.habit_strength\n  clamp p.habit_strength to [0,1]",
        "notes": [
          "Sigmoid thresholding turns propensity into probability.",
          "Inventory constraint prevents wearing without masks."
        ]
      },
      "requirements": [
        "RandomGenerator",
        "SigmoidFunction"
      ],
      "module_parameters": [
        "risk_sensitivity",
        "habit_formation_rate",
        "habit_decay_rate",
        "mask_comfort_penalty",
        "policy_effect_size",
        "perceived_risk_baseline"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and timeseries needed for metrics.",
      "inputs": [
        "Person.mask_wearing",
        "Person.income",
        "Person.trust_in_authority",
        "observable.venue_compliance_rate_daily",
        "observable.fines_issued_daily",
        "observable.stockout_any_daily",
        "observable.message_sentiment_balance_daily"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.peak_adoption",
        "observable.time_to_70_percent_adoption",
        "observable.post_mandate_sustained_adoption",
        "observable.venue_compliance_rate_daily",
        "observable.fines_issued_daily",
        "observable.stockout_any_daily",
        "observable.average_trust_in_authority_daily",
        "observable.message_sentiment_balance_daily",
        "observable.adoption_by_income_q1_daily",
        "observable.adoption_by_income_q4_daily"
      ],
      "dependencies": [
        "DecisionAndHabit",
        "VenueInteractions",
        "RetailMarket",
        "MediaMessaging"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption = mean(p.mask_wearing for p in Persons)\nobservable.adoption_rate_daily.append(adoption)\n# trust\nobservable.average_trust_in_authority_daily.append(mean(p.trust_in_authority for p in Persons))\n# income disparity (q1 vs q4)\nincomes = sort(Persons by income)\nq1 = first 25%; q4 = last 25%\nobservable.adoption_by_income_q1_daily.append(mean(p.mask_wearing for p in q1))\nobservable.adoption_by_income_q4_daily.append(mean(p.mask_wearing for p in q4))\n# peak and time-to-70 maintained incrementally\ncurrent_series = observable.adoption_rate_daily\nobservable.peak_adoption = max(current_series)\nif no prior time_to_70 and adoption >= 0.7:\n  observable.time_to_70_percent_adoption = current_day\n# post-mandate sustained adoption calculated after mandate_end_day + 30\nif current_day == mandate_end_day + 30:\n  window = current_series[mandate_end_day+1 : mandate_end_day+31]\n  observable.post_mandate_sustained_adoption = mean(window)",
        "notes": [
          "AdoptionAggregator stores rolling timeseries; some metrics computed at end or when criteria met.",
          "Uses 'mandate_end_day' from global configuration."
        ]
      },
      "requirements": [
        "TimeseriesStore",
        "PersonStateAccess"
      ],
      "module_parameters": []
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 1000,
      "bounds": {
        "low": 100,
        "high": 100000
      },
      "owner_module": "global",
      "description": "Number of persons in the simulation.",
      "frozen": "true"
    },
    {
      "key": "time_horizon_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 3650
      },
      "owner_module": "global",
      "description": "Total simulation length in days.",
      "frozen": "true"
    },
    {
      "key": "time_step_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.1,
        "high": 7.0
      },
      "owner_module": "global",
      "description": "Time step in days.",
      "frozen": "true"
    },
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 2147483647
      },
      "owner_module": "global",
      "description": "Random seed for reproducibility.",
      "frozen": "true"
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": null,
        "high": null
      },
      "owner_module": "global",
      "description": "Type of social network topology.",
      "frozen": "true"
    },
    {
      "key": "average_degree",
      "dtype": "float",
      "default": 8.0,
      "bounds": {
        "low": 2.0,
        "high": 50.0
      },
      "owner_module": "global",
      "description": "Average number of social neighbors per person.",
      "frozen": "false"
    },
    {
      "key": "network_rewiring_prob",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Rewiring probability for Watts\u2013Strogatz small-world network.",
      "frozen": "false"
    },
    {
      "key": "initial_mask_adoption_rate",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial fraction of mask adopters.",
      "frozen": "false"
    },
    {
      "key": "belief_init_mean",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Mean initial pro-mask belief.",
      "frozen": "false"
    },
    {
      "key": "belief_init_sd",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "SD of initial pro-mask belief.",
      "frozen": "false"
    },
    {
      "key": "trust_init_mean",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Mean initial trust in authority.",
      "frozen": "false"
    },
    {
      "key": "trust_init_sd",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "SD of initial trust in authority.",
      "frozen": "false"
    },
