  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_wearing) per day",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.peak_adoption",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "max(observable.adoption_rate_daily)",
      "frequency": "end_of_simulation",
      "aggregation": "max",
      "target_data_field": "train_data.csv:peak_adoption"
    },
    {
      "id": "observable.time_to_70_percent_adoption",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "first day index where adoption_rate_daily >= 0.7",
      "frequency": "event",
      "aggregation": "first_crossing",
      "target_data_field": "train_data.csv:time_to_70"
    },
    {
      "id": "observable.post_mandate_sustained_adoption",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(adoption_rate_daily[mandate_end_day+1 : mandate_end_day+31])",
      "frequency": "once",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:post_mandate_sustained"
    },
    {
      "id": "observable.venue_compliance_rate_daily",
      "source_module": "VenueInteractions",
      "formula_or_field": "compliant_checks/total_checks",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:venue_compliance_rate"
    },
    {
      "id": "observable.adoption_by_income_q1_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(adoption in bottom income quartile)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_q1"
    },
    {
      "id": "observable.adoption_by_income_q4_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(adoption in top income quartile)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_q4"
    },
    {
      "id": "observable.fines_issued_daily",
      "source_module": "VenueInteractions",
      "formula_or_field": "count of fines issued per day",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:fines_issued"
    },
    {
      "id": "observable.stockout_any_daily",
      "source_module": "RetailMarket",
      "formula_or_field": "indicator any retailer stock_level == 0",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:stockout_any"
    },
    {
      "id": "observable.average_trust_in_authority_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.trust_in_authority)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:avg_trust"
    },
    {
      "id": "observable.message_sentiment_balance_daily",
      "source_module": "MediaMessaging",
      "formula_or_field": "mean per-person net message sentiment",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:message_sentiment_balance"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
