  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network": {
      "type": "watts_strogatz",
      "average_degree": 8,
      "rewiring_prob": 0.1
