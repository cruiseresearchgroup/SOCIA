      }
    }
  },
  "algorithms": {
    "NetworkConstruction": "Watts-Strogatz small-world graph construction (networkx.watts_strogatz_graph).",
    "LogitDecision": "Probabilistic mask decision via sigmoid of weighted utility with noise.",
    "InventoryRestock": "Poisson restocking with Gaussian variability multiplier; price adjusts to stock ratio.",
    "MovementSampling": "Sampled location visits proportional to time fractions with capacity constraints.",
    "EnforcementProcess": "Bernoulli process conditional on noncompliance and location strictness; fines applied."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
