  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(signals.person.mask_decision)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_by_location_type_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean_by_group(signals.person.mask_decision, group=location_type)",
      "frequency": "daily",
      "aggregation": "by_group(location_type)",
      "target_data_field": "train_data.csv:adoption_by_location_type"
    },
    {
      "id": "observable.stockout_rate_daily",
      "source_module": "RetailSupplyModule",
      "formula_or_field": "mean(1{retailer.stock==0})",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "retail_data.csv:stockout_rate"
    },
    {
      "id": "observable.enforcement_incidents_rate_per_1k_pd",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "1000 * incidents / population_size",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "enforcement.csv:incidents_per_1k_pd"
    },
    {
      "id": "observable.inequality_index_of_adoption",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "gini_like(mean_adoption_by_income_bin)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "survey.csv:adoption_inequality_index"
    },
    {
      "id": "observable.average_mask_use_days_per_person",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(cumulative_mask_use_days_per_person)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "survey.csv:avg_mask_use_days"
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "stat": "value_series"
        }
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5,
          "first_crossing": true
        }
      }
    },
    {
      "name": "time_to_80_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.8,
          "first_crossing": true
        }
      }
    },
    {
      "name": "stockout_rate",
      "inputs": [
        "observable.stockout_rate_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "window": "full"
        }
      }
    },
    {
      "name": "enforcement_incidents_rate",
      "inputs": [
        "observable.enforcement_incidents_rate_per_1k_pd"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "window": "full"
        }
      }
    },
    {
      "name": "inequality_index_of_adoption",
      "inputs": [
        "observable.inequality_index_of_adoption"
      ],
      "definition": {
        "type": "Mean",
        "config": {
