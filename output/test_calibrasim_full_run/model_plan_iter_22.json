      "definition": {
        "type": "Mean",
        "config": {
          "window": "full"
        }
      }
    },
    {
      "name": "MAE_vs_observed_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "target_field": "train_data.csv:adoption_rate"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
