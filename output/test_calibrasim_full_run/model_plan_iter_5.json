{
  "model_type": "agent_based",
  "description": "An agent-based, network-embedded social contagion and policy-compliance simulation of mask-wearing adoption, integrated with a retail access market and optional disease dynamics that feed back into risk perception.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "health_risk_level",
        "risk_perception",
        "trust_in_authority",
        "conformity_susceptibility",
        "political_identity",
        "income",
        "access_to_masks",
        "home_location_id",
        "workplace_location_id",
        "current_mask_status",
        "adoption_state",
        "adoption_threshold",
        "information_exposure_level",
        "social_degree",
        "disease_status"
      ],
      "behaviors": [
        "decide_mask_use",
        "adopt_or_abandon_mask",
        "interact_with_peers",
        "share_information",
        "acquire_masks",
        "comply_with_location_policy",
        "update_risk_perception",
        "update_trust_and_beliefs",
        "move_between_locations"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": "triangular(min=18, mode=38, max=85)",
          "health_risk_level": "categorical(low=0.6, medium=0.3, high=0.1)",
          "trust_in_authority": "beta(alpha=2.0, beta=2.5)",
          "conformity_susceptibility": "beta(alpha=1.8, beta=2.2)",
          "political_identity": "categorical(pro_mask=0.35, neutral=0.30, anti_mask=0.35)",
          "income": "lognormal(mean_log=10.5, sd_log=0.6) in USD/year",
          "initial_mask_status": "Bernoulli(p=initial_adoption_rate)",
          "adoption_threshold": "Normal(mean=adoption_threshold_mean, sd=adoption_threshold_sd) clipped [0,1]",
          "information_exposure_level": "beta(alpha=2.5, beta=2.0)",
          "disease_status": "Bernoulli(p=initial_infected_rate) => I else S",
          "home_work_assignment": "each person assigned a home and (if employed) a workplace location",
          "access_to_masks": "0 initially; determined by RetailMarket in step 0",
          "social_network": "scale-free or specified network with average_degree"
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "mask_policy",
        "enforcement_strength",
        "local_prevalence"
      ],
      "behaviors": [
        "host_interactions",
        "enforce_policy",
        "broadcast_signage_or_rules"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "types": [
            "home",
            "workplace",
            "retail",
            "transit",
            "public"
          ],
          "counts": {
            "home": "population_size",
            "workplace": "round(population_size*workplace_fraction/10)",
            "retail": "round(num_locations*0.15)",
            "transit": "round(num_locations*0.10)",
            "public": "remaining"
          },
          "capacity_rule": "home=household size; workplace=Poisson(25)+5; retail=Poisson(40)+10; transit=Poisson(80)+20; public=Poisson(60)+15",
          "enforcement_strength": "Normal(mean=enforcement_strength_mean, sd=enforcement_strength_sd) clipped [0,1]",
          "mask_policy": "initially 'recommended' globally unless prevalence exceeds trigger"
        }
      }
    },
    {
      "name": "InformationSource",
      "attributes": [
        "id",
        "source_type",
        "credibility",
        "bias",
        "message_frequency",
        "message_strength",
        "pro_mask_score"
      ],
      "behaviors": [
        "broadcast_message",
        "target_audience_selection"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "count": 6,
          "source_types": [
            "public_health",
            "local_news",
            "social_media_pro_mask",
            "social_media_anti_mask",
            "community_leader",
            "employer"
          ],
          "credibility": {
            "public_health": 0.85,
            "local_news": 0.6,
            "social_media_pro_mask": 0.45,
            "social_media_anti_mask": 0.35,
            "community_leader": 0.55,
            "employer": 0.65
          },
          "bias": {
            "public_health": 0.8,
            "local_news": 0.1,
            "social_media_pro_mask": 0.7,
            "social_media_anti_mask": -0.7,
            "community_leader": 0.2,
            "employer": 0.4
          },
          "message_frequency": {
            "public_health": 1.0,
            "local_news": 0.8,
            "social_media_pro_mask": 1.2,
            "social_media_anti_mask": 1.2,
            "community_leader": 0.5,
            "employer": 0.6
          },
          "message_strength": {
            "public_health": 0.9,
            "local_news": 0.5,
            "social_media_pro_mask": 0.7,
            "social_media_anti_mask": 0.7,
            "community_leader": 0.6,
            "employer": 0.7
          },
          "pro_mask_score": {
            "public_health": 0.9,
            "local_news": 0.4,
            "social_media_pro_mask": 0.8,
            "social_media_anti_mask": 0.2,
            "community_leader": 0.6,
            "employer": 0.7
          }
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "stock_level",
        "price",
        "restock_rate",
        "ration_policy"
      ],
      "behaviors": [
        "sell_masks",
        "restock_inventory",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "count": "round(num_locations*0.08)",
          "stock_level": "initial_mask_stock_per_1000 * population_size/1000 divided across retailers ~ Dirichlet",
          "price": "mask_price",
          "restock_rate": "restock_rate_per_day",
          "ration_policy": "limit per person per day = mask_ration_limit_per_person"
        }
      }
    },
    {
      "name": "PolicyMaker",
      "attributes": [
        "id",
        "policy_state",
        "trigger_thresholds",
        "communication_frequency"
      ],
      "behaviors": [
        "update_policy_based_on_prevalence",
        "issue_guidance",
        "coordinate_enforcement"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "id": 1,
          "policy_state": "recommended",
          "trigger_thresholds": {
            "tighten": "policy_trigger_prevalence",
            "relax": "policy_relaxation_prevalence"
          },
          "communication_frequency": 3
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialInfluence",
      "description": "Computes peer influence on mask adoption through social contagion using neighbors' behavior and individual conformity.",
      "inputs": [
        "network.G(V,E)",
        "Person.current_mask_status",
        "Person.conformity_susceptibility"
      ],
      "outputs": [
        "signal.peer_influence[person_id]"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  neighbors = social_graph.neighbors(i)\n  if len(neighbors)==0: peer_frac = 0 else peer_frac = mean(current_mask_status[j] for j in neighbors)\n  threshold = Person[i].adoption_threshold\n  social_signal = (peer_frac - threshold) * Person[i].conformity_susceptibility\n  signal.peer_influence[i] = social_influence_weight * clip(social_signal, -1, 1)",
        "notes": [
          "adoption_threshold is heterogeneous: initialized from Normal(mean=adoption_threshold_mean, sd=adoption_threshold_sd) clipped to [0,1].",
          "Scale-free networks yield heavy-tailed degrees, aligning with observed influencer effects."
        ]
      },
      "requirements": [
        "networkx_graph_built"
      ],
      "module_parameters": [
        "social_influence_weight",
        "adoption_threshold_mean",
        "adoption_threshold_sd"
      ]
    },
    {
      "name": "InformationBroadcast",
      "description": "Broadcasts messages from information sources to individuals, updating information exposure and producing a pro-mask influence signal modulated by trust and bias alignment.",
      "inputs": [
        "InformationSource.*",
        "Person.trust_in_authority",
        "Person.political_identity",
        "Person.information_exposure_level"
      ],
      "outputs": [
        "signal.info_influence[person_id]",
        "Person.information_exposure_level"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  exposure = Person[i].information_exposure_level\n  total_msg = 0\n  for each source s:\n    align = 1 - abs(Person[i].political_identity_bias - s.bias) * info_bias_alignment_strength\n    reach = s.message_frequency * s.message_strength * s.credibility * align\n    total_msg += reach * (s.pro_mask_score - 0.5)\n  total_msg = total_msg * information_effect_weight\n  signal.info_influence[i] = clip(total_msg, -1, 1)\n  Person[i].information_exposure_level = clip(exposure*(1 - info_decay_rate) + abs(total_msg)*0.2, 0, 1)",
        "notes": [
          "political_identity_bias is mapped from political_identity categorical to [-1,0,1].",
          "info_decay_rate represents forgetting; abs(total_msg) bumps salience."
        ]
      },
      "requirements": [
        "sources_initialized"
      ],
      "module_parameters": [
        "information_effect_weight",
        "info_decay_rate",
        "info_bias_alignment_strength"
      ]
    },
    {
      "name": "PolicyModule",
      "description": "Updates location mask policies based on recent prevalence and communicates guidance.",
      "inputs": [
        "Location.local_prevalence",
        "PolicyMaker.trigger_thresholds"
      ],
      "outputs": [
        "Location.mask_policy",
        "event.policy_change"
      ],
      "dependencies": [
        "DiseaseDynamics"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 3
      },
      "update_rule": {
        "pseudocode": "mean_prev = mean(Location.local_prevalence)\nif mean_prev >= policy_trigger_prevalence: new_state = 'mandate'\nelif mean_prev <= policy_relaxation_prevalence: new_state = 'recommended'\nelse: new_state = previous\nif new_state != previous:\n  event.policy_change.append((t, previous, new_state))\n  for each location L: L.mask_policy = new_state",
        "notes": [
          "Global policy applied uniformly; can be extended to region-specific policies.",
          "Tick every 3 days to reflect communication frequency."
        ]
      },
      "requirements": [
        "rolling_prevalence_available"
      ],
      "module_parameters": [
        "policy_trigger_prevalence",
        "policy_relaxation_prevalence"
      ]
    },
    {
      "name": "PolicyEnforcement",
      "description": "Enforces mask policies at locations and generates compliance pressure signals that impact on-the-spot masking decisions.",
      "inputs": [
        "Location.mask_policy",
        "Location.enforcement_strength",
        "Person.access_to_masks",
        "Person.trust_in_authority"
      ],
      "outputs": [
        "signal.policy_pressure[person_id, location_id]",
        "event.compliance[person_id, location_id]"
      ],
      "dependencies": [
        "PolicyModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each visit (i,L) generated by MovementAndInteraction:\n  if L.mask_policy == 'mandate':\n    base = L.enforcement_strength * policy_effect_weight\n    compliance_prob = sigmoid( 5*( base * Person[i].trust_in_authority - 0.3 ) + compliance_penalty * (Person[i].access_to_masks>0) )\n  else:\n    compliance_prob = 0.2 * policy_effect_weight * L.enforcement_strength\n  signal.policy_pressure[i,L] = compliance_prob\n  event.compliance[i,L] = Bernoulli(compliance_prob)",
        "notes": [
          "policy_pressure represents immediate, situational compliance likelihood.",
          "If person lacks masks, compliance_penalty reduces effect."
        ]
      },
      "requirements": [
        "visit_schedule",
        "location_policies"
      ],
      "module_parameters": [
        "enforcement_strength_mean",
        "enforcement_strength_sd",
        "policy_effect_weight",
        "compliance_penalty"
      ]
    },
    {
      "name": "RetailMarket",
      "description": "Manages mask inventory, pricing, and sales to individuals subject to stock and rationing, updating access_to_masks.",
      "inputs": [
        "Retailer.stock_level",
        "Retailer.price",
        "Person.income",
        "Person.political_identity"
      ],
      "outputs": [
        "Person.access_to_masks",
        "Retailer.stock_level",
        "Retailer.price"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each retailer r:\n  demand_factor = mean(min(1, Person.income/40000) ** access_inequity_income_elasticity over local catchment)\n  expected_demand = demand_factor * 0.1 * population_size/len(retailers)\n  sales = min(r.stock_level, expected_demand)\n  for k in 1..sales:\n    select person i proportional to (Person[i].access_to_masks < mask_ration_limit_per_person) * (1 - (r.price/mask_price)**price_elasticity)\n    Person[i].access_to_masks += 1\n    r.stock_level -= 1\n  r.stock_level += round(r.restock_rate * initial_mask_stock_per_1000 * population_size/1000 / len(retailers))\n  r.price = max(0.2, mask_price * (1 + 0.5*(1 - r.stock_level / (initial_mask_stock_per_1000 * population_size/1000 / len(retailers) + 1))))",
        "notes": [
          "Simple rationing: per-person daily limit; selection prioritizes affordability.",
          "Price increases when stock is tight; restock is proportional to baseline."
        ]
      },
      "requirements": [
        "retailers_initialized"
      ],
      "module_parameters": [
        "mask_price",
        "initial_mask_stock_per_1000",
        "restock_rate_per_day",
        "mask_ration_limit_per_person",
        "price_elasticity",
        "access_inequity_income_elasticity"
      ]
    },
    {
      "name": "MovementAndInteraction",
      "description": "Generates daily movement between home and non-home locations and creates contact events for social interaction and potential disease transmission.",
      "inputs": [
        "Person.home_location_id",
        "Person.workplace_location_id",
        "Location.capacity",
        "network.G(V,E)"
      ],
      "outputs": [
        "event.visits[(person_id, location_id)]",
        "event.contacts[(i,j,location_id)]"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  if Bernoulli(mobility_rate):\n    if Bernoulli(home_to_work_fraction) and Person[i].workplace_location_id != None: L = workplace\n    else: L = sample non-home location weighted by capacity\n    event.visits.add((i, L))\n  # Contacts at locations (well-mixed within location during visit window)\n  for each location L:\n    visitors = {i | (i,L) in event.visits}\n    m = int(group_mixing_parameter * len(visitors))\n    create m random pair contacts among visitors (avoid duplicates)\n    event.contacts.extend(pairs with location L)",
        "notes": [
          "Social network influences influence signal; physical contacts used by DiseaseDynamics.",
          "group_mixing_parameter scales density of contacts."
        ]
      },
      "requirements": [
        "locations_initialized",
        "persons_initialized"
      ],
      "module_parameters": [
        "mobility_rate",
        "home_to_work_fraction",
        "group_mixing_parameter",
        "average_degree"
      ]
    },
    {
      "name": "AdoptionDecision",
      "description": "Combines influences (peer, information, policy), risk perception, and habit persistence to update mask adoption and current wearing status.",
      "inputs": [
        "signal.peer_influence",
        "signal.info_influence",
        "signal.policy_pressure",
        "Person.risk_perception",
        "Person.access_to_masks",
        "Person.current_mask_status"
      ],
      "outputs": [
        "Person.adoption_state",
        "Person.current_mask_status",
        "event.adoption_change[person_id]"
      ],
      "dependencies": [
        "SocialInfluence",
        "InformationBroadcast",
        "PolicyEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  habit = habit_persistence * (1 if Person[i].current_mask_status==1 else -1)\n  risk_signal = risk_perception_weight * (Person[i].risk_perception - 0.5)\n  policy_sig = mean(signal.policy_pressure[i,*]) if any visits else 0\n  total = signal.peer_influence[i] + signal.info_influence[i] + policy_sig + risk_signal + Normal(0, adoption_noise)\n  propensity = sigmoid(total / max(1e-6, decision_temperature))\n  if Person[i].access_to_masks == 0: propensity *= 0.2\n  new_status = Bernoulli(propensity)\n  if new_status != Person[i].current_mask_status:\n    event.adoption_change[i] = (t, Person[i].current_mask_status, new_status)\n  Person[i].current_mask_status = new_status\n  Person[i].adoption_state = 'adopted' if new_status==1 else 'not_adopted'",
        "notes": [
          "Habit persistence biases toward previous state.",
          "Access constraint sharply reduces adoption when zero masks held."
        ]
      },
      "requirements": [
        "signals_available"
      ],
      "module_parameters": [
        "habit_persistence",
        "adoption_noise",
        "risk_perception_weight",
        "decision_temperature"
      ]
    },
    {
      "name": "DiseaseDynamics",
      "description": "Location-aware SIR process with mask effectiveness reducing transmission and prevalence feeding back to risk perception; also computes a counterfactual without masking.",
      "inputs": [
        "event.contacts",
        "Person.current_mask_status",
        "Location.local_prevalence"
      ],
      "outputs": [
        "Person.disease_status",
        "Location.local_prevalence",
        "observable.incidence",
        "observable.counterfactual_incidence",
        "Person.risk_perception"
      ],
      "dependencies": [
        "MovementAndInteraction"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if not disease_module_enabled: return\n# Transmission\nnew_infections = 0; counterf_new_infections = 0\nfor each contact (i,j,L):\n  if (S,I) or (I,S):\n    mask_factor = (1 - mask_effectiveness) ** (Person[i].current_mask_status + Person[j].current_mask_status)\n    p_inf = base_infection_rate * mask_factor\n    if Bernoulli(p_inf): infect susceptible; new_infections += 1\n    # counterfactual no masks\n    if Bernoulli(base_infection_rate): counterf_new_infections += 1\n# Recovery\nfor each infected k: if Bernoulli(recovery_rate): Person[k].disease_status = 'R'\n# Update prevalence by location\nfor each location L: L.local_prevalence = (#I visiting L today + small prior) / (visitors + small prior_mass)\n# Update risk perception\nfor each person i:\n  Person[i].risk_perception = clip(Person[i].risk_perception*(1 - prevalence_feedback_weight) + prevalence_feedback_weight * mean(L.local_prevalence over today's visits), 0, 1)\n# Record observables\nobservable.incidence[t] = new_infections\nobservable.counterfactual_incidence[t] = counterf_new_infections",
        "notes": [
          "Counterfactual incidence uses same contacts but removes mask effect.",
          "Risk perception is a convex combination of prior and observed prevalence."
        ]
      },
      "requirements": [
        "contact_events_today"
      ],
      "module_parameters": [
        "disease_module_enabled",
        "base_infection_rate",
        "prevalence_feedback_weight",
        "mask_effectiveness",
        "recovery_rate",
        "importation_rate",
        "initial_infected_rate"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates person- and event-level states into daily observables and evaluation metrics inputs.",
      "inputs": [
        "Person.current_mask_status",
        "Person.age",
        "Person.political_identity",
        "event.adoption_change",
        "event.compliance",
        "Person.access_to_masks",
        "observable.incidence",
        "observable.counterfactual_incidence"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_rate_by_age_daily",
        "observable.adoption_rate_by_political_identity_daily",
        "observable.compliance_in_policy_locations_daily",
        "observable.abandonment_rate_daily",
        "observable.mask_access_gini_daily",
        "observable.infection_rate_reduction_daily",
        "observable.threshold_adoption_time"
      ],
      "dependencies": [
        "AdoptionDecision",
        "PolicyEnforcement",
        "RetailMarket",
        "DiseaseDynamics"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate = mean(Person.current_mask_status)\nby_age = group_mean(Person.current_mask_status by age_bins)\nby_pol = group_mean(Person.current_mask_status by political_identity)\ncompliance = mean(value for (_,_,value) in event.compliance if value is not None)\nabandonments = count(i for i in event.adoption_change if change from 1 to 0)\nabandonment_rate = abandonments / max(1, count_adopters_prev)\nmask_access_gini = gini({Person.access_to_masks} grouped by income quintile)\nif t>0 and observable.counterfactual_incidence[t]>0:\n  irr = 1 - observable.incidence[t]/observable.counterfactual_incidence[t]\nelse: irr = 0\nif adoption_rate >= threshold_adoption_target and observable.threshold_adoption_time not set:\n  observable.threshold_adoption_time = t\nstore all observables at t",
        "notes": [
          "Gini computed over access_to_masks distribution; can be stratified by income.",
          "threshold_adoption_time is first passage time to threshold_adoption_target."
        ]
      },
      "requirements": [
        "daily_state_available"
      ],
      "module_parameters": [
        "threshold_adoption_target"
      ]
    }
  ],
  "parameters": [
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Random seed for reproducibility.",
      "frozen": "false"
    },
    {
      "key": "simulation_steps",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 730
      },
      "owner_module": "global",
      "description": "Number of days to simulate.",
      "frozen": "false"
    },
    {
      "key": "timestep_length_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.5,
        "high": 2.0
      },
      "owner_module": "global",
      "description": "Duration of a simulation step in days.",
      "frozen": "true"
    },
    {
      "key": "population_size",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 500,
        "high": 200000
      },
      "owner_module": "global",
      "description": "Number of Person agents.",
      "frozen": "false"
    },
    {
      "key": "initial_adoption_rate",
      "dtype": "float",
      "default": 0.15,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial fraction wearing masks.",
      "frozen": "false"
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "scale_free",
      "bounds": {
        "low": null,
        "high": null
      },
      "owner_module": "global",
      "description": "Type of social network (scale_free, small_world, erdos_renyi).",
      "frozen": "true"
    },
    {
      "key": "average_degree",
      "dtype": "float",
      "default": 8.0,
      "bounds": {
        "low": 2.0,
        "high": 25.0
      },
      "owner_module": "MovementAndInteraction",
      "description": "Average degree of the social network and typical contact density.",
      "frozen": "false"
    },
    {
      "key": "num_locations",
      "dtype": "int",
      "default": 800,
      "bounds": {
        "low": 100,
        "high": 5000
      },
