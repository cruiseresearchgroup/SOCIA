  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.current_mask_status)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "adoption_time_series.csv:overall_adoption_rate"
    },
    {
      "id": "observable.adoption_rate_by_age_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.current_mask_status) by age_bins=[18-29,30-44,45-64,65+]",
      "frequency": "daily",
      "aggregation": "by_group(age_bin)",
      "target_data_field": "adoption_by_group.csv:adoption_rate_by_age"
    },
    {
      "id": "observable.adoption_rate_by_political_identity_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.current_mask_status) by political_identity",
      "frequency": "daily",
      "aggregation": "by_group(political_identity)",
      "target_data_field": "adoption_by_group.csv:adoption_rate_by_political_identity"
    },
    {
      "id": "observable.compliance_in_policy_locations_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(event.compliance)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "compliance_series.csv:compliance_in_policy_locations"
    },
    {
      "id": "observable.abandonment_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(adoption_change 1->0)/count(prev adopters)",
      "frequency": "daily",
      "aggregation": "rate",
      "target_data_field": "adoption_flow.csv:abandonment_rate"
    },
    {
      "id": "observable.mask_access_gini_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "gini(Person.access_to_masks)",
      "frequency": "daily",
      "aggregation": "scalar",
      "target_data_field": "equity_series.csv:mask_access_gini"
    },
    {
      "id": "observable.incidence_daily",
      "source_module": "DiseaseDynamics",
      "formula_or_field": "observable.incidence[t]",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "epidemic_series.csv:incidence"
    },
    {
      "id": "observable.counterfactual_incidence_daily",
      "source_module": "DiseaseDynamics",
      "formula_or_field": "observable.counterfactual_incidence[t]",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "epidemic_series.csv:counterfactual_incidence"
    },
    {
      "id": "observable.infection_rate_reduction_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "1 - incidence_daily / counterfactual_incidence_daily",
      "frequency": "daily",
      "aggregation": "scalar",
      "target_data_field": "epidemic_series.csv:infection_rate_reduction"
    },
    {
      "id": "observable.policy_change_events",
      "source_module": "PolicyModule",
      "formula_or_field": "event.policy_change",
      "frequency": "event",
      "aggregation": "list",
      "target_data_field": "policy_log.csv:policy_change_events"
    },
    {
      "id": "observable.threshold_adoption_time",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "first t with adoption_rate_daily >= threshold_adoption_target",
      "frequency": "once",
      "aggregation": "scalar",
      "target_data_field": "milestones.csv:time_to_70pct"
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "summary": "series"
        }
      }
    },
    {
      "name": "time_to_threshold_adoption",
      "inputs": [
        "observable.threshold_adoption_time"
      ],
      "definition": {
        "type": "Scalar",
        "config": {
          "units": "days"
        }
      }
    },
    {
      "name": "adoption_by_group",
      "inputs": [
        "observable.adoption_rate_by_age_daily",
        "observable.adoption_rate_by_political_identity_daily"
      ],
      "definition": {
        "type": "GroupTimeSeries",
        "config": {
          "groups": [
            "age_bin",
            "political_identity"
          ]
        }
      }
    },
    {
      "name": "compliance_in_policy_locations",
      "inputs": [
        "observable.compliance_in_policy_locations_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "summary": "series"
        }
      }
    },
    {
      "name": "abandonment_rate",
      "inputs": [
        "observable.abandonment_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "summary": "series"
        }
      }
    },
    {
      "name": "policy_impact_effect_size",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.policy_change_events"
      ],
      "definition": {
        "type": "DifferenceInDifferences",
        "config": {
          "pre_window_days": 14,
          "post_window_days": 14,
          "treatment": "mandate",
          "control_selector": "locations with enforcement_strength < 0.4"
        }
      }
    },
    {
      "name": "mask_access_inequity_index",
      "inputs": [
        "observable.mask_access_gini_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "summary": "series"
        }
      }
    },
    {
      "name": "infection_rate_reduction",
      "inputs": [
        "observable.infection_rate_reduction_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "summary": "series"
        }
      }
    }
  ],
  "environment": {
    "type": "network + location-layer",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network": {
      "type": "scale_free",
      "average_degree": 8.0,
      "generator": "Barabasi-Albert with m=average_degree/2, attach preferentially"
    },
    "locations": {
      "num_locations": 800,
      "types_fraction": {
        "workplace": 0.35,
        "retail": 0.25,
        "transit": 0.15,
        "public": 0.25
      },
      "capacity_rules": "Poisson by type as specified in Location initialization"
    },
    "disease": {
      "initial_infected_rate": 0.01,
      "importation_rate": 0.0002
    },
    "retail": {
      "retailers_count": "round(num_locations*0.08)",
      "initial_stock": "initial_mask_stock_per_1000 * population_size/1000"
    }
  },
  "algorithms": {
    "NetworkGeneration": "Barab\u00e1si\u2013Albert preferential attachment to create scale-free social graph.",
    "PeerInfluence": "Threshold-linear social contagion with heterogeneous thresholds and conformity weights.",
    "InformationInfluence": "Source-weighted message aggregation with bias alignment and credibility scaling.",
    "PolicyUpdate": "Rule-based thresholding on prevalence with hysteresis via trigger/relax thresholds.",
    "PolicyCompliance": "Logistic compliance model combining enforcement and trust, with access constraint.",
    "RetailMarket": "Inventory flow with rationing and price adjustment responding to stock tightness.",
    "AdoptionDecision": "Logistic choice with habit persistence and additive signals (peer, info, policy, risk).",
    "DiseaseDynamics": "SIR on contact events with mask effectiveness modifying per-contact transmission; counterfactual computed by removing mask effect.",
    "GiniComputation": "Standard Gini coefficient over access_to_masks counts.",
    "DiD": "Difference-in-differences estimator around policy change events using low-enforcement locations as controls."
  },
  "data_sources": [
    {
      "name": "adoption_time_series.csv",
      "purpose": "Calibrate and validate overall adoption rate trends.",
      "fields_used": [
        "date",
        "overall_adoption_rate"
      ]
    },
    {
      "name": "adoption_by_group.csv",
      "purpose": "Validate adoption disparities by age and political identity.",
      "fields_used": [
        "date",
        "age_bin",
        "political_identity",
        "adoption_rate"
      ]
    },
    {
      "name": "compliance_series.csv",
      "purpose": "Validate compliance levels in mandated locations.",
      "fields_used": [
        "date",
        "compliance_in_policy_locations"
      ]
    },
    {
      "name": "epidemic_series.csv",
      "purpose": "Validate infection incidence and estimated mask-related reductions.",
      "fields_used": [
        "date",
        "incidence",
        "counterfactual_incidence",
        "infection_rate_reduction"
      ]
    },
    {
      "name": "policy_log.csv",
      "purpose": "Align simulation policy change timing with observed records.",
      "fields_used": [
        "date",
        "policy_state"
      ]
    },
    {
      "name": "equity_series.csv",
      "purpose": "Assess inequity of mask access over time.",
      "fields_used": [
        "date",
        "mask_access_gini"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point to configure, run, and orchestrate modules; CLI parsing."
      },
      {
        "name": "entities.py",
        "description": "Dataclasses for Person, Location, InformationSource, Retailer, PolicyMaker."
      },
      {
        "name": "network.py",
        "description": "Social network generation and utilities."
      },
      {
        "name": "modules/social_influence.py",
        "description": "SocialInfluence module implementation."
      },
      {
        "name": "modules/information_broadcast.py",
        "description": "InformationBroadcast module implementation."
      },
      {
        "name": "modules/policy.py",
        "description": "PolicyModule and PolicyEnforcement implementations."
      },
      {
        "name": "modules/retail_market.py",
        "description": "RetailMarket module implementation."
      },
      {
        "name": "modules/movement.py",
        "description": "MovementAndInteraction module implementation."
      },
      {
        "name": "modules/adoption_decision.py",
        "description": "AdoptionDecision module implementation."
      },
      {
        "name": "modules/disease.py",
        "description": "DiseaseDynamics module implementation."
      },
      {
        "name": "modules/aggregation.py",
        "description": "AdoptionAggregator and metric calculations."
      },
      {
        "name": "metrics.py",
        "description": "Metric definitions and evaluation framework."
      },
      {
        "name": "config.py",
        "description": "Parameter schema, validation, and defaults."
      },
      {
        "name": "io.py",
        "description": "Data loading/saving for observables and results."
      },
      {
        "name": "utils.py",
        "description": "Utility functions (gini, sigmoid, random seeds, sampling)."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy",
      "numba",
      "pydantic"
    ]
  },
  "prediction_period": {
    "start_day": 150,
    "end_day": 179
  },
  "evaluation_metrics": [
    "overall_adoption_rate_over_time",
    "time_to_threshold_adoption",
    "adoption_by_group",
    "compliance_in_policy_locations",
    "abandonment_rate",
    "policy_impact_effect_size",
    "mask_access_inequity_index",
    "infection_rate_reduction"
  ]
}