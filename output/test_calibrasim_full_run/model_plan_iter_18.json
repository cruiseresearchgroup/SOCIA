      "aggregation": "by_group(community_id)",
      "target_data_field": "community_daily.csv:adoption_rate_by_community"
    },
    {
      "id": "observable.cumulative_adoptions",
      "source_module": "ObservationAggregator",
      "formula_or_field": "cumulative_sum(new_adoptions_daily)",
