{
  "model_type": "agent_based",
  "description": "Agent-based diffusion of a pro-social behavior (e.g., guideline or product adoption) on a social network with media and policy signals, habit decay/relapse, and daily observations for calibration to time series data.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "community_id",
        "degree",
        "neighbors",
        "threshold",
        "susceptibility",
        "media_exposure",
        "adopted",
        "time_since_adoption",
        "fatigue",
        "habit_strength"
      ],
      "behaviors": [
        "evaluate_social_influence",
        "update_adoption_state",
        "receive_media_policy_signal",
        "habit_decay_and_relapse"
      ],
      "initialization": {
        "method": "data_driven",
        "parameters": {
          "population_size": 5000,
          "initial_adoption_fraction": 0.02,
          "threshold_distribution": "Beta(alpha=2.0, beta=3.0)",
          "media_exposure_mean": 0.2
        }
      }
    },
    {
      "name": "Community",
      "attributes": [
        "community_id",
        "size",
        "policy_modifier"
      ],
      "behaviors": [
        "apply_policy_modifier"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "community_count": 10
        }
      }
    },
    {
      "name": "MediaChannel",
      "attributes": [
        "baseline_intensity",
        "reach_fraction",
        "pulse_interval_days",
        "pulse_duration_days",
        "pulse_magnitude"
      ],
      "behaviors": [
        "broadcast_signal"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "baseline_intensity": 0.3,
          "reach_fraction": 0.5
        }
      }
    }
  ],
  "modules": [
    {
      "name": "NetworkBuilder",
      "description": "Constructs the social network and assigns communities with homophily and degree/assortativity targets.",
      "inputs": [
        "init.population_size",
        "data.network_edges_csv",
        "data.communities_csv"
      ],
      "outputs": [
        "graph.G",
        "people.list",
        "communities.list",
        "people.degree",
        "people.community_id"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == 0:\n  if data.network_edges_csv available:\n    G <- load_edges_csv()\n  else:\n    if network_type_code == 0: G <- watts_strogatz(N=population_size, k=round(average_degree), beta=rewiring_prob)\n    if network_type_code == 1: G <- erdos_renyi(N=population_size, p=average_degree/(population_size-1))\n    if network_type_code == 2: G <- barabasi_albert(N=population_size, m=max(1, round(average_degree/2)))\n  assign communities (community_count) to nodes to match homophily_strength and assortativity_target using iterative label swap heuristic\n  adjust clustering toward clustering_target using triad-closure rewiring if feasible\n  create Person agents with degree, neighbors, community_id",
        "notes": [
          "Runs only at t=0; later ticks are no-ops.",
          "Homophily_strength steers within-community edge fraction.",
          "Assortativity_target achieved with constrained degree-preserving swaps."
        ]
      },
      "requirements": [
        "graph_generation",
        "rng",
        "data_loader"
      ],
      "module_parameters": [
        "network_type_code",
        "average_degree",
        "rewiring_prob",
        "homophily_strength",
        "community_count",
        "degree_distribution_code",
        "assortativity_target",
        "clustering_target"
      ]
    },
    {
      "name": "MediaAndPolicy",
      "description": "Generates exogenous influence signals from media and policy interventions; can target high-degree nodes and selected communities.",
      "inputs": [
        "time.t",
        "communities.list",
        "graph.G",
        "people.degree",
        "people.community_id"
      ],
      "outputs": [
        "signals.external_influence_per_person",
        "signals.policy_active"
      ],
      "dependencies": [
        "NetworkBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "policy_active <- (t >= policy_start_day) and (t <= policy_end_day)\nbase_intensity <- baseline_media_intensity\nif policy_active:\n  base_intensity <- base_intensity + enforcement_level * 0.5\npulse_active <- ((t - 1) % media_pulse_interval_days) < media_pulse_duration_days\nif pulse_active:\n  base_intensity <- base_intensity + media_pulse_magnitude\nfor person i in people:\n  reach_mask <- Bernoulli(media_reach_fraction)\n  deg_bias <- (degree[i] / max_degree) ^ targeting_bias_by_degree\n  comm_target <- 1.0\n  if top_n_communities_targeted > 0 and policy_active:\n    comm_targeted <- top_n_communities_by_size(top_n_communities_targeted)\n    if community_id[i] in comm_targeted:\n      comm_target <- 1.0 + community_policy_strength\n  signals.external_influence_per_person[i] <- base_intensity * reach_mask * (0.5 + 0.5*deg_bias) * comm_target",
        "notes": [
          "External influence is per-person daily scalar.",
          "Degree targeting amplifies signals to central individuals.",
          "Community targeting activates only when policy is active."
        ]
      },
      "requirements": [
        "rng",
        "graph_queries"
      ],
      "module_parameters": [
        "baseline_media_intensity",
        "media_reach_fraction",
        "media_pulse_interval_days",
        "media_pulse_duration_days",
        "media_pulse_magnitude",
        "policy_start_day",
        "policy_end_day",
        "enforcement_level",
        "targeting_bias_by_degree",
        "top_n_communities_targeted",
        "community_policy_strength"
      ]
    },
    {
      "name": "InfluencePropagation",
      "description": "Updates agent adoption based on social influence from neighbors combined with external signals using a mixed threshold/cascade mechanism.",
      "inputs": [
        "graph.G",
        "people.list",
        "signals.external_influence_per_person",
        "time.t"
      ],
      "outputs": [
        "people.adopted",
        "people.time_since_adoption",
        "signals.new_adoptions_today",
        "signals.cascades_attribution"
      ],
      "dependencies": [
        "NetworkBuilder",
        "MediaAndPolicy"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "signals.new_adoptions_today <- 0\nif t == 0:\n  initialize thresholds: theta_i ~ Beta(threshold_alpha, threshold_beta)\nfor person i:\n  if adopted[i] == true: continue\n  social_frac <- mean(adopted[neighbors(i)] over neighbor_memory_window_days)  # if window>1, use EMA\n  social_signal <- social_weight * social_frac\n  media_signal <- media_weight * signals.external_influence_per_person[i]\n  total_signal <- social_signal + media_signal + Normal(0, adoption_noise_sigma)\n  if adoption_rule_code == 0:  # linear threshold\n    will_adopt <- (total_signal >= theta_i)\n  else:  # independent cascade hybrid\n    prob <- 1 - exp(-total_signal)\n    will_adopt <- Bernoulli(max(0,min(1, prob)))\n  if will_adopt:\n    adopted[i] <- true\n    time_since_adoption[i] <- 0\n    signals.new_adoptions_today += 1\n    attribute cascade attributions to neighbors proportionally to their influence\nfor person i with adopted[i]==true:\n  time_since_adoption[i] += 1",
        "notes": [
          "Thresholds sampled once per agent.",
          "Asynchronous updates: if async_fraction<1, sample subset to update today.",
          "Influence from 2-hop neighbors can be modeled via influence_decay_lambda if desired by extending social_frac."
        ]
      },
      "requirements": [
        "rng",
        "vector_ops"
      ],
      "module_parameters": [
        "social_weight",
        "media_weight",
        "threshold_alpha",
        "threshold_beta",
        "adoption_noise_sigma",
        "async_fraction",
        "neighbor_memory_window_days",
        "influence_decay_lambda",
        "adoption_rule_code"
      ]
    },
    {
      "name": "BehaviorDecayAndMemory",
      "description": "Models habit reinforcement, fatigue, decay, and possible relapse from adopted to non-adopted states.",
      "inputs": [
        "people.adopted",
        "people.time_since_adoption",
        "people.habit_strength",
        "time.t"
      ],
      "outputs": [
        "people.adopted",
        "people.habit_strength",
        "people.fatigue",
        "signals.relapses_today"
      ],
      "dependencies": [
        "InfluencePropagation"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "signals.relapses_today <- 0\nfor person i:\n  if adopted[i]:\n    habit_strength[i] <- min(1.0, habit_strength[i] + (1 - habit_strength[i]) * 0.1)\n    fatigue[i] <- min(1.0, fatigue[i] + fatigue_accumulation_rate)\n    relapse_prob <- relapse_prob_daily * (1 - habit_strength[i]) * (0.5 + fatigue[i])\n    if Bernoulli(relapse_prob):\n      adopted[i] <- false\n      signals.relapses_today += 1\n  else:\n    fatigue[i] <- max(0.0, fatigue[i] - recovery_rate_daily)\n    habit_strength[i] <- max(0.0, habit_strength[i] - decay_rate_daily)",
        "notes": [
          "Habit_strength grows with continued adoption and decays otherwise.",
          "Fatigue increases while adopted; decreases otherwise.",
          "Relapse probability declines as habits strengthen."
        ]
      },
      "requirements": [
        "rng"
      ],
      "module_parameters": [
        "decay_rate_daily",
        "relapse_prob_daily",
        "habit_strength",
        "fatigue_accumulation_rate",
        "recovery_rate_daily"
      ]
    },
    {
      "name": "ObservationAggregator",
      "description": "Aggregates daily observables and applies smoothing/reporting lag to match data characteristics.",
      "inputs": [
        "people.adopted",
        "people.community_id",
        "signals.new_adoptions_today",
        "time.t"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.new_adoptions_daily",
        "observable.adoption_rate_by_community",
        "observable.cumulative_adoptions"
      ],
      "dependencies": [
        "InfluencePropagation",
        "BehaviorDecayAndMemory"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "raw_adoption_rate <- mean(adopted)\nraw_new_adoptions <- signals.new_adoptions_today\nsmoothed_adoption_rate <- moving_average(raw_adoption_rate, window=smoothing_window_days)\nsmoothed_new_adoptions <- moving_average(raw_new_adoptions, window=smoothing_window_days)\napply report lag by emitting values from t - report_lag_days\nby_comm <- group_mean(adopted by community_id)\ncum_adopt <- cumulative_sum(smoothed_new_adoptions)\npublish observables with lag adjustment",
        "notes": [
          "Smoothing and reporting lag align with noisy/lagged reporting in real data.",
          "Group-level observable supports calibration by community."
        ]
      },
      "requirements": [
        "rolling_windows"
      ],
      "module_parameters": [
        "smoothing_window_days",
        "report_lag_days"
      ]
    }
  ],
  "parameters": [
