      "bounds": {
        "low": 0,
        "high": 2
      },
      "owner_module": "NetworkBuilder",
      "description": "0=Watts-Strogatz, 1=Erdos-Renyi, 2=Barabasi-Albert",
      "frozen": true
    },
    {
      "key": "average_degree",
