  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "Aggregation",
      "formula_or_field": "mean(Person.adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:wearing_mask"
    },
    {
      "id": "observable.received_info_rate_daily",
      "source_module": "Aggregation",
      "formula_or_field": "mean(Person.received_info)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:received_info"
    }
  ],
  "metrics": [
    {
      "name": "RMSE",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "window": {
            "start_day": 0,
            "end_day": 29
          }
        }
      }
    },
    {
      "name": "MAE",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "window": {
            "start_day": 0,
            "end_day": 29
          }
        }
      }
    },
    {
      "name": "FinalAdoptionRate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "AbsoluteDifferenceOnDay",
        "config": {
          "day": 29
        }
      }
    },
    {
      "name": "StabilityLastWindow",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MeanAbsDiff",
        "config": {
          "last_n_days": 7,
          "window": {
            "start_day": 23,
            "end_day": 29
          }
        }
      }
    }
  ],
  "environment": {
    "type": "network_multiplex",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "initial_adoption_rate": 0.2,
    "policy_start_day": 10,
    "policy_end_day": 60,
    "data_folder": "data_fitting/mask_adoption_data/",
    "load_state_from_train_data": true
  },
  "algorithms": {
    "LayerWeightedExposure": "Compute weighted fraction of masked neighbors per agent with homophily multipliers and EWMA smoothing.",
    "InfoContagion": "Hybrid broadcast and neighbor-driven information diffusion with memory decay.",
    "AdoptionHazard": "Discrete-time hazard/logit for mask adoption with persistence and dropout, influenced by exposure, info, policy, and risk perception.",
    "PolicyScheduler": "Time-based ramping of mandate, communication, and enforcement levels.",
    "RMSEEvaluator": "Compute RMSE between simulated and observed adoption rates over calibration window.",
    "SBI_Grid_Or_CMAES": "Simulation-based optimization over non-frozen parameters to minimize RMSE subject to stability and final-day constraints."
  },
  "data_sources": [
    {
      "name": "agent_attributes.csv",
      "purpose": "Initialize agent demographics and traits; compute homophily, risk priors.",
      "fields_used": [
        "agent_id",
        "age_group",
        "occupation",
        "risk_perception"
      ]
    },
    {
      "name": "social_network.json",
      "purpose": "Build multiplex social network layers.",
      "fields_used": [
        "family",
        "work_school",
        "community",
        "all"
      ]
    },
    {
      "name": "train_data.csv",
      "purpose": "Calibrate micro-transitions and aggregate adoption/info rates for days 0-29; initialize day 0 states.",
      "fields_used": [
        "day",
        "agent_id",
        "wearing_mask",
        "received_info"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point; parses config, orchestrates simulation loop, handles calibration and prediction runs."
      },
      {
        "name": "modules/network.py",
        "description": "NetworkPreprocessor and ExposureCalculator implementations; graph utilities."
