      },
      {
        "name": "calibration/sbi.py",
        "description": "SBI/optimization routines (grid search or CMA-ES) and metric-driven objective."
      },
      {
        "name": "io/data_loader.py",
        "description": "Load and validate CSV/JSON data; build agent and network structures."
      },
      {
        "name": "config/schema.py",
        "description": "Parameter schema, bounds, and validation; frozen parameter enforcement."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy",
      "numba",
      "tqdm",
      "jsonschema"
    ]
  },
  "prediction_period": {
    "start_day": 30,
    "end_day": 39
  },
  "evaluation_metrics": [
