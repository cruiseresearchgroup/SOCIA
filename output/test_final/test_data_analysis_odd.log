an mu_fam and dispersion k_fam; estimate mu_fam = mean(family_connections), Var informs k_fam via Var = mu + mu^2/k."\n      },\n      {\n        "name": "Work/School degree distribution",\n        "description": "Occupation- and age-dependent degrees with higher means for students and white-collar.",\n        "parameters": "Negative Binomial by subgroup: NB(mu_ws[group], k_ws[group]). Fit separate parameters for occupation-age strata."\n      },\n      {\n        "name": "Community degree distribution",\n        "description": "Right-skewed with heavier tail than other layers.",\n        "parameters": "Negative Binomial NB(mu_com, k_com) or Zero-Inflated NB if many zeros."\n      },\n      {\n        "name": "Total connections",\n        "description": "Approximately the sum across layers; used as a consistency check.",\n        "parameters": "mu_total \\u2248 mu_fam + mu_ws + mu_com; validate row-wise equality."\n      },\n      {\n        "name": "Risk perception",\n        "description": "Continuous on [0,1], typically skewed.",\n        "parameters": "Beta(alpha, beta); compute alpha = m*(m*(1-m)/v - 1), beta = (1-m)*(m*(1-m)/v - 1) from sample mean m and variance v of risk_perception."\n      },\n      {\n        "name": "Initial mask-wearing by subgroup",\n        "description": "Bernoulli rates stratified by age_group and occupation.",\n        "parameters": "p0[group] = mean(initial_mask_wearing | group)."\n      },\n      {\n        "name": "Information exposure per day",\n        "description": "Probability an agent receives info on a day.",\n        "parameters": "pi_info[day or group] = mean(received_info_t); model as Bernoulli with day fixed effects or Poisson process if counts are available."\n      },\n      {\n        "name": "Adoption and persistence transitions",\n        "description": "First-order Markov transitions with possible conditioning on info exposure.",\n        "parameters": "p11 = P(1\\u21921), p10 = 1 - p11, p01 = P(0\\u21921), p00 =