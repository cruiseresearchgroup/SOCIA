  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "mean(Individual.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/adoption_rate.csv:overall_daily_rate"
    },
    {
      "id": "observable.adoption_rate_by_location_type",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "mean(mask_wearing in contacts by Location.type)",
      "frequency": "daily",
      "aggregation": "by_group(Location.type)",
      "target_data_field": "observed/location_rates.csv:rate_by_type"
    },
    {
      "id": "observable.enforcement_events_daily",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "sum(enforcement events)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "observed/enforcement.csv:events_daily"
    },
    {
      "id": "observable.stockout_frequency_daily",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "mean(retailer_stockout_indicator)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/retail_stock.csv:stockout_fraction"
    },
    {
      "id": "observable.average_price_paid_daily",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "mean(transaction_prices)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/transactions.csv:avg_price"
    },
    {
      "id": "observable.demand_supply_ratio_daily",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "sum(demanded_units)/sum(inventory_available)",
      "frequency": "daily",
      "aggregation": "ratio",
      "target_data_field": "observed/retail_supply.csv:demand_supply_ratio"
    },
    {
      "id": "observable.perceived_risk_mean_daily",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "mean(Individual.perceived_risk)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/surveys.csv:perceived_risk_mean"
    },
    {
      "id": "observable.adoption_by_income_quintile",
      "source_module": "AggregationAndMetrics",
      "formula_or_field": "mean(mask_wearing) by income quintile",
      "frequency": "daily",
      "aggregation": "by_group(Individual.income_quintile)",
      "target_data_field": "observed/adoption_demographics.csv:income_quintiles"
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate_daily",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "smoothing": "moving_average",
          "window": 3
        }
      }
    },
    {
      "name": "overall_adoption_rate_cumulative",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Aggregate",
        "config": {
          "method": "mean_over_period",
          "start_day": 1,
          "end_day": 180
        }
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "FirstPassageTime",
        "config": {
          "threshold": 0.5,
          "direction": "above"
        }
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Max",
        "config": {}
      }
    },
    {
      "name": "location_specific_adoption",
      "inputs": [
        "observable.adoption_rate_by_location_type"
      ],
      "definition": {
        "type": "GroupTimeSeries",
        "config": {
          "groups": [
            "home",
            "work",
            "school",
            "store",
            "transit",
            "public_space"
          ]
        }
      }
    },
    {
      "name": "adoption_disparity_index",
      "inputs": [
        "observable.adoption_by_income_quintile"
      ],
      "definition": {
        "type": "GroupDifference",
        "config": {
          "method": "top_minus_bottom_quintile"
        }
      }
    },
    {
      "name": "enforcement_events",
      "inputs": [
        "observable.enforcement_events_daily"
      ],
      "definition": {
        "type": "Sum",
        "config": {
          "start_day": 1,
          "end_day": 180
        }
      }
    },
    {
      "name": "stockout_frequency",
      "inputs": [
        "observable.stockout_frequency_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "start_day": 1,
          "end_day": 180
        }
      }
    },
    {
      "name": "average_price_paid",
      "inputs": [
        "observable.average_price_paid_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "start_day": 1,
          "end_day": 180
        }
      }
    },
    {
      "name": "mask_demand_supply_ratio",
      "inputs": [
        "observable.demand_supply_ratio_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {}
      }
    },
    {
      "name": "average_perceived_risk",
      "inputs": [
        "observable.perceived_risk_mean_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {}
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network": {
      "type": "watts_strogatz",
      "k": 8,
      "beta": 0.05
    },
    "households": {
      "method": "random_partition",
      "size_distribution": {
        "1": 0.28,
        "2": 0.34,
        "3": 0.16,
        "4": 0.12,
        "5": 0.1
      }
    },
    "locations": {
      "types": [
        "home",
        "work",
        "school",
        "store",
        "transit",
        "public_space"
      ],
      "count_by_type": {
        "home": 2000,
        "work": 800,
        "school": 200,
        "store": 300,
        "transit": 150,
        "public_space": 250
      }
    },
    "retailers": {
      "count": 50,
      "initial_inventory_per_retailer": 1000,
      "base_price": 1.0
    },
    "media_channels": 3,
    "policy": {
      "mandate_status": "scheduled",
      "mandate_start_day": 45,
      "mandate_scope": "indoor_public"
    }
  },
  "algorithms": {
    "WattsStrogatzNetwork": "Generate small-world social network (N, k, beta).",
    "WeightedSocialLearning": "Compute peer influence from neighbor adoption over a rolling window.",
    "NormativeObservation": "Update adoption utility from observed prevalence at visited locations.",
    "LogitThresholdDecision": "Compute net utility and apply threshold to wear and trigger purchases.",
    "ProbabilisticEnforcement": "Observation and enforcement with configurable probabilities and fines.",
    "PeriodicInventoryRestock": "Restock retailers with reliability and optional dynamic pricing."
  },
  "data_sources": [
    {
      "name": "observed/adoption_rate.csv",
      "purpose": "Compare overall adoption rate time series.",
      "fields_used": [
        "date",
        "overall_daily_rate"
      ]
    },
    {
      "name": "observed/location_rates.csv",
