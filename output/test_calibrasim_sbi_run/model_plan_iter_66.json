      "purpose": "Compute disparity by income.",
      "fields_used": [
        "date",
        "income_quintile",
        "adoption_rate"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point, argument parsing, simulation loop orchestration."
      },
      {
        "name": "entities.py",
