{
  "model_type": "agent_based",
  "description": "Agent-based simulation of mask adoption dynamics driven by social networks, policy enforcement, media influence, normative observation in locations, and retail supply constraints. Agents decide to purchase and wear masks based on perceived risk, social influence, costs, and observed norms; policies and media shift perceptions; retailers constrain supply and pricing.",
  "entities": [
    {
      "name": "Individual",
      "attributes": [
        "id",
        "age_group",
        "health_risk_level",
        "perceived_risk",
        "compliance_propensity",
        "social_influence_weight",
        "trust_in_authorities",
        "misinformation_susceptibility",
        "income",
        "cost_sensitivity",
        "comfort_preference",
        "mask_adoption_state",
        "available_mask_stock",
        "network_neighbors",
        "home_location_id",
        "work_location_id",
        "daily_mobility_rate",
        "past_enforcement_events"
      ],
      "behaviors": [
        "update_risk_perception",
        "decide_mask_adoption",
        "wear_mask_in_contacts",
        "purchase_masks",
        "comply_with_mandate",
        "share_opinion_with_peers",
        "visit_locations"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_group_distribution": {
            "child": 0.2,
            "adult": 0.6,
            "senior": 0.2
          },
          "health_risk_distribution": {
            "low": 0.5,
            "medium": 0.3,
            "high": 0.2
          },
          "initial_mask_adoption_rate": 0.1,
          "initial_perceived_risk": 0.3,
          "trust_in_authorities_dist": {
            "type": "truncated_normal",
            "mean": 0.6,
            "sd": 0.15,
            "low": 0.0,
            "high": 1.0
          },
          "misinformation_susceptibility_dist": {
            "type": "beta",
            "alpha": 2.5,
            "beta": 3.5
          },
          "social_influence_weight_dist": {
            "type": "truncated_normal",
            "mean": 0.4,
            "sd": 0.1,
            "low": 0.0,
            "high": 1.0
          },
          "compliance_propensity_dist": {
            "type": "truncated_normal",
            "mean": 0.6,
            "sd": 0.2,
            "low": 0.0,
            "high": 1.0
          },
          "income_budget_dist": {
            "type": "lognormal",
            "mean": 100.0,
            "sigma": 0.5
          },
          "cost_sensitivity_dist": {
            "type": "truncated_normal",
            "mean": 0.5,
            "sd": 0.1,
            "low": 0.0,
            "high": 1.0
          },
          "comfort_preference_dist": {
            "type": "truncated_normal",
            "mean": 0.3,
            "sd": 0.1,
            "low": 0.0,
            "high": 1.0
          },
          "daily_mobility_rate_dist": {
            "type": "truncated_normal",
            "mean": 0.6,
            "sd": 0.15,
            "low": 0.0,
            "high": 1.0
          },
          "initial_mask_stock_per_person": {
            "type": "poisson",
            "lambda": 2
          }
        }
      }
    },
    {
      "name": "Household",
      "attributes": [
        "id",
        "member_ids",
        "shared_resources",
        "norm_strength"
      ],
      "behaviors": [
        "share_masks_among_members",
        "reinforce_household_norms"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "household_size_distribution": {
            "1": 0.28,
            "2": 0.34,
            "3": 0.16,
            "4": 0.12,
            "5": 0.1
          },
          "norm_strength_dist": {
            "type": "truncated_normal",
            "mean": 0.6,
            "sd": 0.15,
            "low": 0.0,
            "high": 1.0
          }
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "baseline_contact_rate",
        "mask_policy",
        "enforcement_level",
        "observability_factor"
      ],
      "behaviors": [
        "enforce_policy",
        "host_contacts",
        "display_norms"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "types": [
            "home",
            "work",
            "school",
            "store",
            "transit",
            "public_space"
          ],
          "count_by_type": {
            "home": 2000,
            "work": 800,
            "school": 200,
            "store": 300,
            "transit": 150,
            "public_space": 250
          },
          "capacity_by_type": {
            "home": 5,
            "work": 50,
            "school": 80,
            "store": 30,
            "transit": 40,
            "public_space": 60
          },
          "baseline_contact_rate_by_type": {
            "home": 4.0,
            "work": 8.0,
            "school": 10.0,
            "store": 3.0,
            "transit": 5.0,
            "public_space": 2.0
          },
          "observability_factor_by_type": {
            "home": 0.2,
            "work": 0.6,
            "school": 0.7,
            "store": 0.8,
            "transit": 0.7,
            "public_space": 0.5
          },
          "initial_mask_policy_by_type": {
            "home": "none",
            "work": "recommended",
            "school": "recommended",
            "store": "recommended",
            "transit": "recommended",
            "public_space": "recommended"
          },
          "initial_enforcement_level_by_type": {
            "home": 0.0,
            "work": 0.2,
            "school": 0.2,
            "store": 0.3,
            "transit": 0.3,
            "public_space": 0.1
          }
        }
      }
    },
    {
      "name": "PolicyAuthority",
      "attributes": [
        "id",
        "mandate_status",
        "mandate_start_day",
        "mandate_scope",
        "enforcement_resources",
        "fine_amount",
        "communication_strategy"
      ],
      "behaviors": [
        "issue_or_lift_mandate",
        "set_enforcement_probability",
        "run_public_campaign",
        "adjust_policy_based_on_metrics"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_status": "scheduled",
          "mandate_start_day": 45,
          "mandate_scope": "indoor_public",
          "enforcement_resources": 1.0,
          "fine_amount": 50.0,
          "communication_strategy": "pro-mask_campaign_from_day_30"
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory",
        "restock_rate",
        "restock_interval",
        "price",
        "supply_reliability"
      ],
      "behaviors": [
        "sell_masks",
        "restock_inventory",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_retailers": 50,
          "initial_inventory": 1000,
          "restock_interval_days": 7,
          "restock_amount": 800,
          "base_price": 1.0,
          "supply_reliability": 0.9
        }
      }
    },
    {
      "name": "MediaChannel",
      "attributes": [
        "id",
        "reach",
        "message_bias",
        "misinformation_rate",
        "campaign_schedule"
      ],
      "behaviors": [
        "broadcast_message",
        "influence_beliefs"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_channels": 3,
          "channels": [
            {
              "id": "public_health",
              "reach": 0.7,
              "message_bias": 0.8,
              "misinformation_rate": 0.02,
              "campaign_schedule": [
                {
                  "start_day": 30,
                  "end_day": 180,
                  "intensity": 1.0
                }
              ]
            },
            {
              "id": "neutral_news",
              "reach": 0.5,
              "message_bias": 0.5,
              "misinformation_rate": 0.05,
              "campaign_schedule": []
            },
            {
              "id": "social_media",
              "reach": 0.8,
              "message_bias": 0.4,
              "misinformation_rate": 0.15,
              "campaign_schedule": []
            }
          ]
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialNetworkInfluence",
      "description": "Builds and maintains the social network; updates individual adoption propensity based on neighbors' observed mask use.",
      "inputs": [
        "state.individual.mask_adoption_state",
        "state.network.social_graph"
      ],
      "outputs": [
        "signal.peer_influence_score"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each individual i:\n  neighbors = social_graph.neighbors(i)\n  window = last peer_memory_window_days of neighbors' mask_adoption_state\n  neighbor_mask_rate = average(mask_adoption_state of neighbors over window)\n  peer_influence = social_influence_weight_i * neighbor_mask_rate\n  signal.peer_influence_score[i] = peer_influence\n",
        "notes": [
          "Uses a Watts\u2013Strogatz small-world graph with parameters N, avg_network_degree, clustering_rewire_prob.",
          "Individual-level social_influence_weight_i can vary around global mean."
        ]
      },
      "requirements": [
        "rng",
        "networkx"
      ],
      "module_parameters": [
        "social_influence_weight",
        "peer_memory_window_days",
        "network_topology",
        "avg_network_degree",
        "clustering_rewire_prob"
      ]
    },
    {
      "name": "RiskAndMedia",
      "description": "Updates perceived risk and trust based on media exposure, misinformation, and campaigns; modifies individual perceived risk.",
      "inputs": [
        "state.individual.perceived_risk",
        "state.individual.trust_in_authorities",
        "state.media.channels"
      ],
      "outputs": [
        "signal.perceived_risk_delta",
        "signal.trust_delta"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each individual i:\n  baseline = initial_perceived_risk\n  exposure = 0\n  trust_shift = 0\n  for each channel c:\n    reach_draw = Bernoulli(c.reach)\n    if reach_draw == 1:\n      misinfo = Bernoulli(misinformation_rate * c.misinformation_rate)\n      bias = c.message_bias if not misinfo else -c.message_bias\n      campaign_effect = 0\n      if day in any c.campaign_schedule:\n        campaign_effect += campaign_effect_size\n      exposure += bias * risk_sensitivity + campaign_effect\n      trust_shift += (bias > 0 ? 1 : -1) * 0.5 * risk_sensitivity\n  noise = Normal(0, media_noise_sd)\n  signal.perceived_risk_delta[i] = clamp(baseline + exposure + noise, 0, 1) - perceived_risk[i]\n  signal.trust_delta[i] = clamp(trust_in_authorities[i] + trust_shift * 0.1, 0, 1) - trust_in_authorities[i]\n",
        "notes": [
          "Campaigns from public_health channel begin at campaign_start_day.",
          "Risk sensitivity scales how much bias alters risk perception."
        ]
      },
      "requirements": [
        "rng"
      ],
      "module_parameters": [
        "initial_perceived_risk",
        "risk_sensitivity",
        "misinformation_rate",
        "trust_in_authorities_mean",
        "campaign_start_day",
        "campaign_effect_size",
        "media_noise_sd"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Implements mask mandates and enforcement at locations; tracks warnings/fines and updates compliance propensity.",
      "inputs": [
        "state.location.mask_policy",
        "state.policy.mandate_status",
        "state.individual.mask_adoption_state",
        "state.individual.past_enforcement_events"
      ],
      "outputs": [
        "event.enforcement_issued",
        "signal.compliance_update"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day == mandate_start_day:\n  policy.mandate_status = 'active'\n  set mask_policy for mandate_scope locations to 'required'\nfor each contact (i at location L):\n  if policy.mandate_status == 'active' and L in mandate_scope:\n    obs = Bernoulli(observability_factor_global * L.observability_factor)\n    if obs == 1 and individual i is not wearing mask:\n      enforce = Bernoulli(enforcement_probability * L.enforcement_level * policy.enforcement_resources)\n      if enforce == 1:\n        issue warning/fine with fine_amount\n        event.enforcement_issued += 1\n        i.past_enforcement_events += 1\n        compliance_boost = min(1.0, 0.1 + enforcement_escalation_factor * i.past_enforcement_events)\n        signal.compliance_update[i] = compliance_boost\n",
        "notes": [
          "Mandate applies to 'indoor_public' = work, school, store, transit; not home or open public_space unless configured.",
          "Enforcement increases compliance propensity for future decisions."
        ]
      },
      "requirements": [
        "rng"
      ],
      "module_parameters": [
        "mandate_start_day",
        "mandate_scope",
        "enforcement_probability",
        "fine_amount",
        "observability_factor_global",
        "enforcement_escalation_factor"
      ]
    },
    {
      "name": "MobilityAndLocations",
      "description": "Assigns daily location visits and hosts contacts; computes normative observation of mask prevalence in locations.",
      "inputs": [
        "state.individual.home_location_id",
        "state.individual.work_location_id",
        "state.individual.daily_mobility_rate",
        "state.location.baseline_contact_rate",
        "state.individual.mask_adoption_state"
      ],
      "outputs": [
        "event.contacts",
        "signal.norm_observation"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each individual i:\n  draw today's location mix by probabilities [mix_home, mix_work, mix_school, mix_store, mix_transit, mix_public_space] scaled by i.daily_mobility_rate\n  assign visits to specific locations of each type\nfor each location L visited:\n  contacts = Poisson(baseline_contact_rate_of_type)\n  sample contacts among present individuals\n  observed_mask_rate = mean(mask_adoption_state among present individuals)\n  for each individual i present:\n    signal.norm_observation[i] += observation_effect * observed_mask_rate\n  record event.contacts\n",
        "notes": [
          "Contact rates are type-specific and configurable.",
          "Norm observation translates observed prevalence into pressure to adopt."
        ]
      },
      "requirements": [
        "rng"
      ],
      "module_parameters": [
        "contact_rate_home",
        "contact_rate_work",
        "contact_rate_school",
        "contact_rate_store",
        "contact_rate_transit",
        "contact_rate_public_space",
        "mix_home",
        "mix_work",
        "mix_school",
        "mix_store",
        "mix_transit",
        "mix_public_space",
        "daily_mobility_rate_mean",
        "observation_effect"
      ]
    },
    {
      "name": "MarketAndSupply",
      "description": "Handles mask inventory, restocking, pricing, and sales to individuals; outputs realized purchases and prices.",
      "inputs": [
        "state.retailer.inventory",
        "state.retailer.price",
        "signal.purchase_intent"
      ],
      "outputs": [
        "event.purchases",
        "signal.transaction_prices",
        "signal.stockout_indicator"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each retailer r:\n  if day % restock_interval_days == 0:\n    restock_success = Bernoulli(supply_reliability)\n    if restock_success: r.inventory += restock_amount\n  if dynamic_pricing_enabled:\n    demand_proxy = previous_day_purchase_intents_for_r\n    price_adjust = price_elasticity_demand * (demand_proxy - r.inventory)\n    r.price = max(0.1, mask_price_base + price_adjust)\nfor each individual i with purchase_intent q_i > 0:\n  choose retailer r uniformly or nearest; if r.inventory >= q_i:\n    execute purchase of q_i at price r.price; r.inventory -= q_i\n    record event.purchases += q_i; signal.transaction_prices append r.price\n  else if r.inventory > 0:\n    buy r.inventory units; record partial purchase; set stockout_indicator[r]=1\n  else:\n    set stockout_indicator[r]=1\n",
        "notes": [
          "Price elasticity controls dynamic pricing slope.",
          "Stockout indicator aggregated to compute stockout frequency metric."
        ]
      },
      "requirements": [
        "rng"
      ],
      "module_parameters": [
        "mask_price_base",
        "initial_inventory_per_retailer",
        "restock_interval_days",
        "restock_amount",
        "supply_reliability",
        "price_elasticity_demand",
        "dynamic_pricing_enabled"
      ]
    },
    {
      "name": "HouseholdDynamics",
      "description": "Aggregates and shares mask stock within households; reinforces norms affecting members' adoption.",
      "inputs": [
        "state.household.member_ids",
        "state.individual.available_mask_stock",
        "state.household.norm_strength"
      ],
      "outputs": [
        "signal.household_norm_push",
        "state.individual.available_mask_stock"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each household H:\n  total_masks = sum(available_mask_stock for members)\n  need = number of members with low stock (<2)\n  redistribute proportionally to need with efficiency household_sharing_efficiency\n  for each member i in H:\n    signal.household_norm_push[i] = household_norm_strength_mean * H.norm_strength\n",
        "notes": [
          "Redistribution reduces stockouts at the individual level.",
          "Norm push increases adoption propensity."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "household_norm_strength_mean",
        "household_sharing_efficiency"
      ]
    },
    {
      "name": "AdoptionAndPurchase",
      "description": "Combines risk, norms, peer influence, costs, and enforcement to decide wearing and purchasing masks.",
      "inputs": [
        "signal.perceived_risk_delta",
        "signal.norm_observation",
        "signal.peer_influence_score",
        "signal.compliance_update",
        "state.individual.cost_sensitivity",
        "state.individual.comfort_preference",
        "state.individual.available_mask_stock",
        "state.individual.trust_in_authorities"
      ],
      "outputs": [
        "state.individual.mask_adoption_state",
        "signal.purchase_intent"
      ],
      "dependencies": [
        "RiskAndMedia",
        "SocialNetworkInfluence",
        "MobilityAndLocations",
        "PolicyAndEnforcement",
        "HouseholdDynamics"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each individual i:\n  perceived_risk[i] += signal.perceived_risk_delta[i]\n  trust[i] += signal.trust_delta[i] if available\n  utility_pro_mask = 0\n  utility_pro_mask += 1.5 * perceived_risk[i]\n  utility_pro_mask += signal.peer_influence_score[i]\n  utility_pro_mask += signal.norm_observation[i]\n  utility_pro_mask += 0.5 * (compliance_propensity[i] + signal.compliance_update[i])\n  cost_term = price_salience * expected_price_today + cost_sensitivity[i] * comfort_cost_parameter\n  net_utility = utility_pro_mask - cost_term + Normal(0, utility_noise_scale)\n  wear_decision = 1 if net_utility >= purchase_threshold else 0\n  if available_mask_stock[i] <= 0 and wear_decision == 1:\n    desired_qty = 5  # e.g., pack size\n    affordable_qty = floor(budget_i / expected_price_today)\n    q_i = min(desired_qty, affordable_qty)\n    signal.purchase_intent[i] = q_i\n  else:\n    signal.purchase_intent[i] = 0\n  state.individual.mask_adoption_state[i] = wear_decision\n  if wear_decision == 1 and available_mask_stock[i] > 0:\n    available_mask_stock[i] -= 1\n",
        "notes": [
          "Logit-like decision with threshold; can be converted to sigmoid probability if desired.",
          "Expected price is current average retailer price."
        ]
      },
      "requirements": [
        "rng"
      ],
      "module_parameters": [
        "purchase_threshold",
        "comfort_cost_parameter",
        "cost_sensitivity_mean",
        "budget_per_agent_mean",
        "price_salience",
        "utility_noise_scale"
      ]
    },
    {
      "name": "AggregationAndMetrics",
      "description": "Aggregates daily observables and computes derived metrics for evaluation.",
      "inputs": [
        "state.individual.mask_adoption_state",
        "state.location.type",
        "event.enforcement_issued",
        "signal.transaction_prices",
        "event.purchases",
        "signal.stockout_indicator",
        "state.individual.perceived_risk",
        "state.individual.income"
      ],
      "outputs": [
        "observable.*",
        "metric.*"
      ],
      "dependencies": [
        "MarketAndSupply",
        "PolicyAndEnforcement",
        "MobilityAndLocations"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "compute adoption_rate_daily = mean(mask_adoption_state)\ncompute adoption_rate_by_location_type = mean(wearing among contacts in each type)\ncompute enforcement_events_daily = sum(event.enforcement_issued)\ncompute stockout_frequency_daily = mean(stockout_indicator over retailers)\ncompute average_price_paid_daily = mean(signal.transaction_prices) if any else last non-null\ncompute demand_supply_ratio_daily = total desired purchases / total available inventory across retailers\ncompute perceived_risk_mean_daily = mean(perceived_risk)\ncompute adoption_by_income_quintile = groupby income quintile mean(wearing)\napply smoothing with window smoothing_window_days where configured for reporting only\n",
        "notes": [
          "All metrics are derived from observables; no direct use in agent decision-making unless specified.",
          "Time-to-50% and peak computed post-run from stored series."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "smoothing_window_days"
      ]
    }
  ],
  "parameters": [
    {
      "key": "num_agents",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 1000,
        "high": 100000
      },
      "owner_module": "global",
      "description": "Number of Individuals.",
      "frozen": true
    },
    {
      "key": "simulation_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Simulation horizon in days.",
      "frozen": true
    },
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Random seed.",
      "frozen": true
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "SocialNetworkInfluence",
      "description": "Type of social network (small_world).",
      "frozen": true
    },
    {
      "key": "avg_network_degree",
      "dtype": "int",
      "default": 8,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "SocialNetworkInfluence",
      "description": "Average degree in the social network.",
      "frozen": false
    },
    {
      "key": "clustering_rewire_prob",
      "dtype": "float",
      "default": 0.05,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "SocialNetworkInfluence",
      "description": "Rewiring probability in Watts\u2013Strogatz model.",
      "frozen": false
    },
    {
      "key": "social_influence_weight",
      "dtype": "float",
      "default": 0.4,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "SocialNetworkInfluence",
      "description": "Weight on peer mask prevalence in adoption utility.",
      "frozen": false
    },
    {
      "key": "peer_memory_window_days",
      "dtype": "int",
      "default": 7,
