  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.wearing_mask)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "adoption_timeseries.csv:adoption_rate"
    },
    {
      "id": "observable.contacts_both_masked_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(both_masked over contacts)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "contacts.csv:both_masked_rate"
    },
    {
      "id": "observable.adoption_by_age_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(age_group, mean(Person.wearing_mask))",
      "frequency": "daily",
      "aggregation": "by_group(age_group)",
      "target_data_field": "adoption_by_age.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_by_ses_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(socioeconomic_status, mean(Person.wearing_mask))",
      "frequency": "daily",
      "aggregation": "by_group(socioeconomic_status)",
      "target_data_field": "adoption_by_ses.csv:adoption_rate"
    },
    {
      "id": "observable.policy_strength_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "signal.policy_state.strength",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "policy.csv:strength"
    },
    {
      "id": "observable.supply_shortage_flag_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "signal.supply_shortage_flag",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "operations_log.csv:supply_shortage_flag"
    },
    {
      "id": "observable.adoption_inequality_gini_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "gini(by_group(socioeconomic_status, mean(Person.wearing_mask)))",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "adoption_inequality.csv:gini"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "emit_series": true
        }
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5,
          "from_day": 0
        }
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Max",
        "config": {
          "window": [
            0,
            120
          ]
        }
      }
    },
    {
      "name": "average_compliance_in_contacts",
      "inputs": [
        "observable.contacts_both_masked_rate_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "window": [
            0,
            120
          ]
        }
      }
    },
    {
      "name": "policy_effect_size",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.policy_strength_daily"
      ],
      "definition": {
        "type": "DiffInDiff",
        "config": {
          "pre_window": [
            0,
            19
          ],
          "post_window": [
            21,
            40
          ],
          "treatment_indicator": "policy_strength>0"
        }
      }
    },
    {
      "name": "supply_shortage_days",
      "inputs": [
        "observable.supply_shortage_flag_daily"
      ],
      "definition": {
        "type": "Sum",
        "config": {
          "window": [
            0,
            120
          ]
        }
      }
    },
    {
      "name": "adoption_inequality_index",
      "inputs": [
        "observable.adoption_inequality_gini_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "window": [
            90,
            120
          ]
        }
      }
    },
    {
      "name": "adoption_by_group",
      "inputs": [
        "observable.adoption_by_age_daily",
        "observable.adoption_by_ses_daily"
      ],
      "definition": {
        "type": "Identity",
        "config": {}
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "network_generation": {
      "type": "watts_strogatz",
      "n": 10000,
      "k": 8,
      "p": 0.1
    },
    "location_setup": {
      "num_locations": {
        "household": 4000,
        "workplace": 500,
        "school": 200,
        "retail": 300,
        "public_transport": 50
      }
    },
    "initial_policy": {
      "mask_mandate": false,
      "strength": 0.7
    },
    "initial_supply": {
      "retailer_count": 200,
      "inventory_per_retailer": 100,
      "price_per_mask": 1.0
    }
  },
  "algorithms": {
    "network_generation": "Watts\u2013Strogatz small-world graph",
    "opinion_update": "DeGroot-like weighted averaging with noise and misinformation bias",
    "adoption_decision": "Logistic utility with social, risk, policy, habit, and enforcement terms",
    "mobility_contacts": "Location-based Poisson contact generation",
    "enforcement": "Stochastic enforcement with resource allocation bias",
    "supply_chain": "Inventory restocking via Binomial draws with disruption",
    "inequality": "Gini coefficient over group means"
  },
  "data_sources": [
    {
      "name": "adoption_timeseries.csv",
      "purpose": "Empirical adoption time series for optional RMSE fit",
      "fields_used": [
        "date",
        "adoption_rate"
      ]
    },
    {
      "name": "adoption_by_age.csv",
      "purpose": "Group-stratified adoption for validation/fit",
      "fields_used": [
        "date",
        "age_group",
        "adoption_rate"
      ]
    },
    {
      "name": "contacts.csv",
      "purpose": "Contact compliance benchmarking if available",
      "fields_used": [
        "date",
        "both_masked_rate"
      ]
    }
  ],
