{
  "model_type": "agent_based",
  "description": "Agent-based, network-embedded simulation of mask adoption dynamics under social influence, information diffusion, policy mandates/enforcement, mobility/contacts, and mask supply constraints.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age_group",
        "household_id",
        "socioeconomic_status",
        "risk_perception",
        "trust_in_authorities",
        "susceptibility_to_influence",
        "exposure_to_misinformation",
        "compliance_propensity",
        "attitude_score",
        "wearing_mask",
        "access_to_masks",
        "network_neighbors",
        "location_schedule",
        "habit_strength"
      ],
      "behaviors": [
        "decide_adopt_or_drop_mask",
        "acquire_masks",
        "interact_socially",
        "update_beliefs_from_peers_and_media",
        "respond_to_policies_and_enforcement",
        "move_between_locations"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "initial_adoption_rate": 0.2,
          "risk_perception_dist": "Beta(2,2)",
          "trust_in_authorities_dist": "Beta(2,2)",
          "susceptibility_to_influence_dist": "Beta(2,5)",
          "exposure_to_misinformation_dist": "Beta(1.5,5)",
          "compliance_propensity_dist": "Beta(2.5,2)",
          "attitude_score_dist": "Normal(0,0.5) clipped [-1,1]",
          "age_group_probs": {
            "0-17": 0.22,
            "18-34": 0.25,
            "35-49": 0.22,
            "50-64": 0.18,
            "65+": 0.13
          },
          "socioeconomic_status_probs": {
            "low": 0.3,
            "mid": 0.5,
            "high": 0.2
          },
          "access_to_masks_initial": "Bernoulli(0.5)",
          "habit_strength_initial": 0.0
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "region_id",
        "mask_requirement",
        "enforcement_level",
        "baseline_contact_rate"
      ],
      "behaviors": [
        "host_visits_and_contacts",
        "enforce_mask_policy",
        "broadcast_local_signals"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_locations_by_type": {
            "household": 4000,
            "workplace": 500,
            "school": 200,
            "retail": 300,
            "public_transport": 50
          },
          "capacity_defaults": {
            "household": 4,
            "workplace": 50,
            "school": 200,
            "retail": 100,
            "public_transport": 80
          },
          "region_id_assignment": "Uniform among 10 regions",
          "mask_requirement_initial": "false for all",
          "enforcement_level_initial": 0.0,
          "baseline_contact_rate_by_type": {
            "household": 4,
            "workplace": 8,
            "school": 10,
            "retail": 6,
            "public_transport": 12
          }
        }
      }
    },
    {
      "name": "PolicyMaker",
      "attributes": [
        "id",
        "policy_state",
        "communication_intensity",
        "enforcement_resources",
        "trigger_thresholds"
      ],
      "behaviors": [
        "set_or_adjust_mask_policies",
        "run_public_campaigns",
        "allocate_enforcement",
        "respond_to_simulation_metrics"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "policy_state_initial": {
            "mask_mandate": false,
            "strength": 0.7
          },
          "communication_intensity_initial": 0.5,
          "enforcement_resources_initial": 1.0,
          "trigger_thresholds": {
            "adoption_low": 0.35,
            "adoption_high": 0.75
          }
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory_level",
        "price_per_mask",
        "restock_rate",
        "supply_disruption_probability"
      ],
      "behaviors": [
        "sell_masks_to_people",
        "update_prices",
        "restock_inventory"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "retailer_count": 200,
          "inventory_level_initial": 100,
          "price_per_mask_initial": 1.0,
          "restock_rate_initial": 0.8,
          "supply_disruption_probability_initial": 0.05
        }
      }
    },
    {
      "name": "InformationSource",
      "attributes": [
        "id",
        "stance",
        "reach",
        "misinformation_rate",
        "message_frequency",
        "target_groups"
      ],
      "behaviors": [
        "broadcast_messages",
        "target_audiences"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "sources": [
            {
              "id": "public_health",
              "stance": "pro-mask",
              "reach": 0.6,
              "misinformation_rate": 0.0,
              "message_frequency": 1.0,
              "target_groups": "all"
            },
            {
              "id": "local_news",
              "stance": "neutral",
              "reach": 0.4,
              "misinformation_rate": 0.05,
              "message_frequency": 0.8,
              "target_groups": "all"
            },
            {
              "id": "misinfo_channel",
              "stance": "anti-mask",
              "reach": 0.25,
              "misinformation_rate": 0.5,
              "message_frequency": 0.9,
              "target_groups": [
                "18-34",
                "35-49"
              ]
            }
          ]
        }
      }
    }
  ],
  "modules": [
    {
      "name": "InformationDiffusionModule",
      "description": "Broadcast media and information signals; update person-specific risk perception, attitudes, and misinformation exposure.",
      "inputs": [
        "signal.policy_comm_intensity",
        "graph.social_network",
        "entity.Person",
        "entity.InformationSource"
      ],
      "outputs": [
        "signal.person_belief_updates"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each InformationSource s:\n  if rand() < s.message_frequency * message_frequency_base:\n    for each Person p in target(s.target_groups):\n      if rand() < s.reach * media_reach_scale:\n        msg = stance_to_numeric(s.stance)  # pro=+1, neutral=0, anti=-1\n        noise = Normal(0, info_noise_std)\n        misinfo = Bernoulli(s.misinformation_rate)\n        trust_wt = 0.5 + 0.5 * p.trust_in_authorities if s.stance=='pro-mask' else 1 - 0.5*p.trust_in_authorities\n        delta_risk = communication_campaign_intensity * trust_wt * msg - misinformation_intensity * misinfo + noise\n        p.risk_perception = clip(p.risk_perception + delta_risk, 0, 1)\n        p.exposure_to_misinformation = clip(p.exposure_to_misinformation + misinfo*0.1 - (1-misinfo)*0.05, 0, 1)\n        p.attitude_score = clip(p.attitude_score + 0.2*msg - 0.1*misinfo, -1, 1)\n# passive decay\nfor each Person p:\n  p.risk_perception = max(0, p.risk_perception * (1 - risk_perception_decay))\nemit signal.person_belief_updates",
        "notes": [
          "stance_to_numeric maps 'pro-mask'->+1, 'neutral'->0, 'anti-mask'->-1",
          "communication_campaign_intensity scales policy-aligned messages; misinformation_intensity scales anti-mask effects"
        ]
      },
      "requirements": [
        "rng.default",
        "scheduler.daily"
      ],
      "module_parameters": [
        "communication_campaign_intensity",
        "misinformation_intensity",
        "message_frequency_base",
        "info_noise_std",
        "risk_perception_decay",
        "communication_targeting_strength",
        "media_reach_scale"
      ]
    },
    {
      "name": "SocialInfluenceModule",
      "description": "Peer influence through social network updates attitudes, habits, and adherence decay/forgetting.",
      "inputs": [
        "graph.social_network",
        "entity.Person",
        "signal.person_belief_updates"
      ],
      "outputs": [
        "signal.peer_influence_effects"
      ],
      "dependencies": [
        "InformationDiffusionModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each Person p:\n  neighbors = G.neighbors(p)\n  peer_mask_rate = mean(n.wearing_mask for n in neighbors)\n  peer_att_mean = mean(n.attitude_score for n in neighbors)\n  # Social update\n  social_push = adoption_social_weight * (peer_influence_beta * (peer_mask_rate - 0.5) + 0.5*peer_att_mean)\n  # Habit formation and decay\n  if p.wearing_mask:\n    p.habit_strength = min(1.0, p.habit_strength + habit_formation_rate)\n  else:\n    p.habit_strength = max(0.0, p.habit_strength - adherence_decay_rate)\n  # Forgetting reduces salience of past pro-mask attitude\n  if Bernoulli(forgetting_probability):\n    p.attitude_score *= 0.9\n  # Aggregate influence into attitude\n  p.attitude_score = clip(p.attitude_score + social_push * p.susceptibility_to_influence, -1, 1)\nemit signal.peer_influence_effects",
        "notes": [
          "Small-world network G is fixed; peer influence combines behavioral and attitudinal signals.",
          "habit_strength acts as persistence in AdoptionDecisionModule."
        ]
      },
      "requirements": [
        "graph.social_network",
        "rng.default"
      ],
      "module_parameters": [
        "adoption_social_weight",
        "peer_influence_beta",
        "habit_formation_rate",
        "adherence_decay_rate",
        "forgetting_probability"
      ]
    },
    {
      "name": "MobilityAndContactsModule",
      "description": "Simulate daily movements to locations, generate contacts, and compute mask status on contacts.",
      "inputs": [
        "entity.Person",
        "entity.Location",
        "graph.social_network",
        "signal.policy_state"
      ],
      "outputs": [
        "signal.daily_contacts"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "contacts = []\nfor each Location L:\n  visitors = sample_visitors(L, schedule_adherence)\n  # Determine contact rate with policy adjustments\n  base_rate = contact_rate_by_type(L.type)\n  rate = base_rate * contact_multiplier\n  # Generate pairwise contacts via Poisson process\n  k = Poisson(rate * len(visitors))\n  for i in 1..k:\n    (a,b) = sample_pair(visitors)\n    contacts.append({\"a\": a.id, \"b\": b.id, \"loc\": L.id, \"type\": L.type, \"a_mask\": a.wearing_mask, \"b_mask\": b.wearing_mask})\nemit signal.daily_contacts = contacts",
        "notes": [
          "sample_visitors uses location_schedule and capacity.",
          "Policy effects on mobility can be added via contact_multiplier modulation by signal.policy_state if needed."
        ]
      },
      "requirements": [
        "rng.default",
        "scheduler.daily"
      ],
      "module_parameters": [
        "contact_rate_household",
        "contact_rate_workplace",
        "contact_rate_school",
        "contact_rate_retail",
        "contact_rate_public_transport",
        "contact_multiplier",
        "schedule_adherence",
        "num_locations_household",
        "num_locations_workplace",
        "num_locations_school",
        "num_locations_retail",
        "num_locations_public_transport"
      ]
    },
    {
      "name": "EnforcementModule",
      "description": "Apply enforcement at locations; issue warnings/penalties and nudge compliance.",
      "inputs": [
        "entity.Person",
        "entity.Location",
        "signal.daily_contacts",
        "signal.policy_state"
      ],
      "outputs": [
        "signal.enforcement_actions"
      ],
      "dependencies": [
        "MobilityAndContactsModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "actions = []\nalloc = allocate_enforcement(signal.policy_state, enforcement_allocation_bias_to_high_traffic)\nfor each contact in signal.daily_contacts:\n  L = get_location(contact.loc)\n  if L.mask_requirement:\n    for p in [contact.a, contact.b]:\n      if not p.wearing_mask and Bernoulli(enforcement_probability * L.enforcement_level * alloc[L.id]):\n        penalty = enforcement_penalty_utility * signal.policy_state.strength\n        p.compliance_propensity = clip(p.compliance_propensity + compliance_boost_in_policy_locations * (1 - p.compliance_propensity), 0, 1)\n        actions.append({\"person\": p.id, \"location\": L.id, \"penalty\": penalty})\nemit signal.enforcement_actions = actions",
        "notes": [
          "allocate_enforcement biases resources toward high-traffic locations.",
          "Penalties and warnings modify compliance_propensity (bounded)."
        ]
      },
      "requirements": [
        "rng.default",
        "scheduler.daily"
      ],
      "module_parameters": [
        "enforcement_probability",
        "enforcement_penalty_utility",
        "enforcement_allocation_bias_to_high_traffic",
        "compliance_boost_in_policy_locations"
      ]
    },
    {
      "name": "RetailSupplyModule",
      "description": "Process mask purchase requests; update inventories, prices, and track shortages.",
      "inputs": [
        "signal.mask_purchase_requests",
        "entity.Retailer"
      ],
      "outputs": [
        "signal.purchase_outcomes",
        "signal.supply_shortage_flag"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "shortage_today = 0\noutcomes = []\n# Price update per retailer\nfor r in Retailers:\n  demand_signal = recent_requests_to(r)\n  r.price_per_mask = max(0.1, mask_price * (1 + price_elasticity * (demand_signal / (r.inventory_level+1))))\n# Fulfill requests\nfor req in signal.mask_purchase_requests:\n  r = select_retailer(req.person_region)\n  effective_price = r.price_per_mask * mask_pack_price_multiplier\n  affordability = req.wtp >= effective_price\n  supply_ok = r.inventory_level >= mask_pack_size\n  disruption = Bernoulli(supply_disruption_probability)\n  success = affordability and supply_ok and not disruption\n  if success:\n    r.inventory_level -= mask_pack_size\n    outcomes.append({\"person\": req.person_id, \"success\": true, \"retailer\": r.id, \"qty\": mask_pack_size})\n  else:\n    outcomes.append({\"person\": req.person_id, \"success\": false, \"retailer\": r.id, \"qty\": 0})\n    if not supply_ok:\n      shortage_today = 1\n# Restock\nfor r in Retailers:\n  restock_qty = Binomial(supply_capacity_daily, restock_rate_per_day)\n  r.inventory_level += restock_qty\nemit signal.purchase_outcomes = outcomes\nemit signal.supply_shortage_flag = shortage_today",
        "notes": [
          "price_elasticity is negative; higher demand raises price, lowering affordability.",
          "select_retailer can weight by region proximity and access_inequality_factor."
        ]
      },
      "requirements": [
        "rng.default",
        "scheduler.daily"
      ],
      "module_parameters": [
        "supply_capacity_daily",
        "restock_rate_per_day",
        "mask_price",
        "supply_disruption_probability",
        "price_elasticity",
        "access_inequality_factor",
        "retailer_count",
        "supply_initial_inventory_per_retailer",
        "mask_pack_size",
        "mask_pack_price_multiplier"
      ]
    },
    {
      "name": "AdoptionDecisionModule",
      "description": "Compute daily mask-wearing decision and purchase intents based on beliefs, social influence, policy, enforcement, access, and habit.",
      "inputs": [
        "entity.Person",
        "signal.peer_influence_effects",
        "signal.enforcement_actions",
        "signal.policy_state",
        "signal.purchase_outcomes"
      ],
      "outputs": [
        "signal.mask_purchase_requests",
        "signal.mask_adoption_updates"
      ],
      "dependencies": [
        "SocialInfluenceModule",
        "EnforcementModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "requests = []\nupdates = []\nfor each Person p:\n  policy_push = adoption_policy_weight * signal.policy_state.strength\n  risk_push = adoption_risk_weight * (p.risk_perception - 0.5)\n  habit_push = 0.5 * p.habit_strength\n  enforcement_push = 0.1 * len([a for a in signal.enforcement_actions if a.person==p.id])\n  utility = sigmoid((risk_push + policy_push + habit_push + enforcement_push + p.attitude_score) - adoption_threshold_base)\n  # Inconvenience and access\n  if not p.access_to_masks:\n    if Bernoulli(drop_probability_if_inconvenience):\n      target = false\n    else:\n      target = (utility > 0.5)\n  else:\n    target = (utility > 0.5)\n  # Purchase intent if target is true but no masks in stock at person-level\n  if target and p.access_to_masks < mask_pack_size/2:\n    wtp = willingness_to_pay_base * (1 + p.socioeconomic_status_scalar)  # SES scalar in {low:0, mid:0.3, high:0.7}\n    requests.append({\"person_id\": p.id, \"wtp\": wtp, \"person_region\": p.household_id % 10})\n  # Apply purchases\n  po = find(signal.purchase_outcomes, p.id)\n  if po and po.success:\n    p.access_to_masks += po.qty\n  # Decide wear and update stock if wearing\n  prev = p.wearing_mask\n  p.wearing_mask = target\n  if p.wearing_mask and p.access_to_masks > 0:\n    p.access_to_masks = max(0, p.access_to_masks - 1)\n  updates.append({\"person\": p.id, \"prev\": prev, \"now\": p.wearing_mask})\nemit signal.mask_purchase_requests = requests\nemit signal.mask_adoption_updates = updates",
        "notes": [
          "sigmoid(x) = 1/(1+exp(-k*x)), use k=5 for steepness.",
          "SES scalar can be precomputed per person: low=0.0, mid=0.3, high=0.7."
        ]
      },
      "requirements": [
        "rng.default",
        "scheduler.daily"
      ],
      "module_parameters": [
        "adoption_threshold_base",
        "adoption_risk_weight",
        "adoption_policy_weight",
        "drop_probability_if_inconvenience",
        "inconvenience_penalty",
        "willingness_to_pay_base",
        "mask_pack_size"
      ]
    },
    {
      "name": "PolicyModule",
      "description": "Set/adjust mask policies and communications; allocate enforcement based on observed adoption and triggers.",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.supply_shortage_flag_daily"
      ],
      "outputs": [
        "signal.policy_state",
        "signal.policy_comm_intensity"
      ],
      "dependencies": [
        "AdoptionAggregator"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "day = current_day()\nstate = current_policy_state()\nif day == policy_mandate_start_day:\n  state.mask_mandate = true\n  state.strength = policy_strength\n# Adaptive adjustments\navg_recent_adoption = mean(last_n(observable.adoption_rate_daily, 7))\nif avg_recent_adoption < trigger_thresholds_low:\n  state.strength = min(policy_max_strength, state.strength + policy_adjustment_trigger_threshold)\nelif avg_recent_adoption > trigger_thresholds_high:\n  state.strength = max(0.0, state.strength - policy_adjustment_trigger_threshold)\n# Communication intensity mirrors strength\ncomm = state.strength * 1.0\nemit signal.policy_state = state\nemit signal.policy_comm_intensity = comm",
        "notes": [
          "trigger_thresholds_low/high map to attributes; set from parameters.",
          "Policy reacts to adoption rate; communication broadcast scales with strength."
        ]
      },
      "requirements": [
        "scheduler.daily"
      ],
      "module_parameters": [
        "policy_strength",
        "policy_mandate_start_day",
        "enforcement_resources",
        "policy_adjustment_trigger_threshold",
        "policy_max_strength",
        "trigger_thresholds_low",
        "trigger_thresholds_high"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregate person and contact states into daily observables and derived indicators.",
      "inputs": [
        "entity.Person",
        "signal.daily_contacts",
        "signal.supply_shortage_flag",
        "signal.policy_state"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.contacts_both_masked_rate_daily",
        "observable.adoption_by_age_daily",
        "observable.adoption_by_ses_daily",
        "observable.policy_strength_daily",
        "observable.supply_shortage_flag_daily",
        "observable.adoption_inequality_gini_daily"
      ],
      "dependencies": [
        "MobilityAndContactsModule",
        "AdoptionDecisionModule",
        "RetailSupplyModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate = mean(p.wearing_mask for p in Persons)\n# Contacts compliance\nif len(signal.daily_contacts) > 0:\n  both_masked = mean(1.0 if (c.a_mask and c.b_mask) else 0.0 for c in signal.daily_contacts)\nelse:\n  both_masked = 0.0\n# By group\nby_age = group_mean(Persons, key=age_group, val=wearing_mask)\nby_ses = group_mean(Persons, key=socioeconomic_status, val=wearing_mask)\n# Gini for inequality across SES groups\nvals = [by_ses[k] for k in sorted(by_ses.keys())]\ngini = gini_coefficient(vals)\n# Emit\nemit observable.adoption_rate_daily = adoption_rate\nemit observable.contacts_both_masked_rate_daily = both_masked\nemit observable.adoption_by_age_daily = by_age\nemit observable.adoption_by_ses_daily = by_ses\nemit observable.policy_strength_daily = signal.policy_state.strength\nemit observable.supply_shortage_flag_daily = signal.supply_shortage_flag\nemit observable.adoption_inequality_gini_daily = gini",
        "notes": [
          "gini_coefficient computed across group means (SES) as inequality of adoption.",
          "All observables are time-stamped per day."
        ]
      },
      "requirements": [
        "scheduler.daily"
      ],
      "module_parameters": []
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 10000,
      "bounds": {
        "low": 1000,
        "high": 200000
      },
      "owner_module": "global",
      "description": "Number of Person agents",
      "frozen": false
    },
    {
      "key": "simulation_duration_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Total length of simulation",
      "frozen": false
    },
    {
      "key": "time_step_days",
      "dtype": "int",
      "default": 1,
      "bounds": {
        "low": 1,
        "high": 1
      },
      "owner_module": "global",
      "description": "Time step in days",
      "frozen": true
    },
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Random seed",
      "frozen": true
    },
    {
      "key": "initial_adoption_rate",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial fraction of mask wearers",
      "frozen": false
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "global",
      "description": "Type of contact network",
      "frozen": true
    },
    {
      "key": "average_degree",
      "dtype": "int",
      "default": 8,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "global",
      "description": "Average degree for small-world generation",
      "frozen": false
    },
