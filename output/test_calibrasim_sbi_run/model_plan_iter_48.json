  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate_daily"
    },
    {
      "id": "observable.adoption_by_context_home",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(mask use among home contacts)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_home_daily"
    },
    {
      "id": "observable.adoption_by_context_work",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(mask use among work contacts)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_work_daily"
    },
    {
      "id": "observable.adoption_by_context_community",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(mask use among community contacts)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_community_daily"
    },
    {
      "id": "observable.inequality_gini_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "Gini(adoption by income_quintile)",
      "frequency": "daily",
      "aggregation": "none",
      "target_data_field": "train_data.csv:adoption_gini_daily"
    },
    {
      "id": "observable.supply_shortage_flag_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "1 if any retailer inventory==0 else 0",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:supply_shortage_flag_daily"
    },
    {
      "id": "observable.policy_effect_estimate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "DiD estimator (high enforcement vs low)",
      "frequency": "daily",
      "aggregation": "none",
      "target_data_field": "train_data.csv:policy_effect_estimate_daily"
    },
    {
      "id": "observable.info_elasticity_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "d log(adoption)/ d log(info_intensity)",
      "frequency": "daily",
      "aggregation": "none",
      "target_data_field": "train_data.csv:info_elasticity_daily"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_overall_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "window": null
        }
      }
    },
    {
      "name": "TimeToThreshold_50",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5
        }
      }
    },
    {
      "name": "TimeToThreshold_70",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.7
        }
      }
    },
    {
      "name": "TimeToThreshold_90",
