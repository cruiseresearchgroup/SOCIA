{
  "model_type": "agent_based",
  "description": "Agent-based, networked diffusion model of mask-wearing adoption and persistence driven by social influence, information exposure, policies/enforcement, and supply/price constraints across home, work, and community contexts.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "gender",
        "household_id",
        "occupation",
        "health_risk_level",
        "trust_in_authorities",
        "susceptibility_to_social_influence",
        "risk_perception",
        "perceived_mask_cost",
        "mask_access",
        "mask_stock",
        "mask_adoption_state",
        "compliance_probability",
        "belief_state",
        "information_exposure_history",
        "social_ties"
      ],
      "behaviors": [
        "evaluate_mask_adoption",
        "update_risk_perception",
        "interact_with_contacts",
        "move_between_locations",
        "purchase_masks",
        "respond_to_policy",
        "share_information",
        "adopt_or_unadopt_mask"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": "triangular(18, 35, 80)",
          "gender_distribution": "Bernoulli(0.5) for female",
          "occupation": "categorical(['essential','non_essential','student','retired'], probs=[0.2,0.5,0.2,0.1])",
          "health_risk_level": "categorical(['low','medium','high'], probs=[0.6,0.3,0.1])",
          "trust_in_authorities": "Beta(2,2)",
          "susceptibility_to_social_influence": "Beta(2,3)",
          "risk_perception": "Uniform(0.1,0.4)",
          "perceived_mask_cost": "Normal(mean=mask_price, sd=0.2*mask_price, clipped >= 0)",
          "mask_access": "Bernoulli(0.8)",
          "mask_stock": "Poisson(2) truncated to >=0",
          "mask_adoption_state": "Bernoulli(initial_adoption_rate)",
          "compliance_probability": "Uniform(0.4,0.8)",
          "belief_state": "Normal(0,1)",
          "information_exposure_history": "empty list",
          "social_ties": "assigned via scale-free social network per network_type, average_degree"
        }
      }
    },
    {
      "name": "Household",
      "attributes": [
        "id",
        "income",
        "norms",
        "member_ids",
        "mask_stock",
        "home_location_id"
      ],
      "behaviors": [
        "share_norms",
        "purchase_masks_in_bulk",
        "allocate_masks_to_members"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "household_size_distribution": "sizes {1,2,3,4,5} with probs {0.25,0.30,0.20,0.15,0.10}",
          "income_distribution": "Lognormal(meanlog=10.2, sdlog=0.5) currency units",
          "norms": "initialized as mean(mask_adoption_state of members) with small noise",
          "mask_stock": "Poisson(3) truncated >=0"
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "risk_level",
        "mask_requirement",
        "enforcement_level",
        "store_inventory",
        "mask_price"
      ],
      "behaviors": [
        "host_interactions",
        "enforce_mask_policy",
        "sell_masks"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "types": "home, workplace, community, store",
          "capacity_rules": "home=household_size; workplace~Normal(20,7); community~Normal(50,20); store~Normal(30,10), clipped >= 1",
          "risk_level": "base on type: home=low, workplace=medium, community=medium-high during peaks",
          "mask_requirement": "false initially, flips true on mandate_start_day for non-home",
          "enforcement_level": "Uniform(0.3,0.9) for non-home, 0 for home",
          "store_inventory": "for type=store: Poisson(100) truncated >=0",
          "mask_price": "initialized to global mask_price"
        }
      }
    },
    {
      "name": "Government",
      "attributes": [
        "policy_status",
        "mandate_start_day",
        "fines",
        "enforcement_resources",
        "campaign_budget",
        "guidance_stringency"
      ],
      "behaviors": [
        "issue_or_update_policy",
        "allocate_enforcement",
        "run_information_campaign"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "policy_status": "no_mandate until mandate_start_day, then mandate_active for workplaces, community, stores",
          "mandate_start_day": "mandate_start_day parameter",
          "fines": "compliance_penalty",
          "enforcement_resources": "scaled to policy_enforcement_intensity",
          "campaign_budget": "proportional to info_campaign_intensity",
          "guidance_stringency": "0.5 initial"
        }
      }
    },
    {
      "name": "MediaSource",
      "attributes": [
        "id",
        "credibility",
        "bias",
        "message_frequency",
        "misinformation_probability"
      ],
      "behaviors": [
        "broadcast_messages",
        "target_audience_segments"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "count": 5,
          "credibility": "Uniform(0.3,0.9)",
          "bias": "Normal(0, media_bias_variance)",
          "message_frequency": "Poisson(3) + 1 per day",
          "misinformation_probability": "misinformation_rate +/- small Normal noise, clipped to [0,1]"
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory",
        "restock_rate",
        "price",
        "rationing_policy"
      ],
      "behaviors": [
        "sell_masks",
        "restock_inventory",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "count": "num_stores",
          "inventory": "Poisson(200) truncated",
          "restock_rate": "supply_capacity_per_day / num_stores",
          "price": "mask_price * (1 + retailer_markup)",
          "rationing_policy": "limit per person rationing_limit_per_person"
        }
      }
    },
    {
      "name": "RiskEnvironment",
      "attributes": [
        "base_risk_index",
        "prevalence_trend"
      ],
      "behaviors": [
        "update_risk_index_over_time",
        "broadcast_risk_signal"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "base_risk_index": 0.2,
          "prevalence_trend": "sinusoidal seasonality + upward trend until day 60, then plateau"
        }
      }
    }
  ],
  "modules": [
    {
      "name": "MobilityAndContacts",
      "description": "Generates daily contacts across home, work, community based on social and location networks and mandates.",
      "inputs": [
        "Person.social_ties",
        "Household.member_ids",
        "Location.capacity",
        "Location.type",
        "Government.policy_status"
      ],
      "outputs": [
        "signal.contacts_daily",
        "signal.context_contact_counts"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  contacts_home = sample from household members up to daily_contacts_home\n  if occupation != 'retired' and has workplace:\n    contacts_work = sample min(daily_contacts_work, workplace capacity-1)\n  else:\n    contacts_work = []\n  contacts_comm = sample from community locations with prob reduced by mobility_reduction_under_mandate if mandate active\n  contacts_i = union(contacts_home, contacts_work, contacts_comm)\ncollect all contacts_i into signal.contacts_daily as undirected pairs with context labels\nupdate signal.context_contact_counts[context] = total contacts per context",
        "notes": [
          "Sampling without replacement within each context",
          "Context labels: 'home','work','community'",
          "If network_type is 'scale_free', community contacts are biased by Person.social_ties"
        ]
      },
      "requirements": [
        "networkx for graph sampling"
      ],
      "module_parameters": [
        "network_type",
        "average_degree",
        "daily_contacts_home",
        "daily_contacts_work",
        "daily_contacts_community",
        "mobility_reduction_under_mandate"
      ]
    },
    {
      "name": "SocialInfluence",
      "description": "Aggregates peer mask usage into perceived local norms for each person with homophily weighting.",
      "inputs": [
        "signal.contacts_daily",
        "Person.mask_adoption_state",
        "Person.susceptibility_to_social_influence"
      ],
      "outputs": [
        "signal.perceived_norm_by_person"
      ],
      "dependencies": [
        "MobilityAndContacts"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  peers = contacts involving i\n  weights = 1 + homophily_strength * similarity(i, peer) over demographics/occupation\n  norm_i = weighted_mean(mask_adoption_state of peers, weights)\n  signal.perceived_norm_by_person[i] = norm_i",
        "notes": [
          "similarity can be 1 if same household or occupation, else 0",
          "If no peers, carry forward previous day's norm"
        ]
      },
      "requirements": [
        "access to last-day adoption states"
      ],
      "module_parameters": [
        "homophily_strength"
      ]
    },
    {
      "name": "InformationAndRisk",
      "description": "Updates risk perceptions, beliefs, and trust based on media, government campaigns, and risk signals; applies forgetting.",
      "inputs": [
        "RiskEnvironment.base_risk_index",
        "RiskEnvironment.prevalence_trend",
        "Government.campaign_budget",
        "MediaSource.credibility",
        "MediaSource.bias",
        "MediaSource.message_frequency",
        "MediaSource.misinformation_probability",
        "Person.trust_in_authorities",
        "Person.information_exposure_history"
      ],
      "outputs": [
        "signal.updated_risk_perception",
        "signal.updated_trust",
        "signal.info_intensity_today"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "risk_signal = base_risk_index * (1 + prevalence_trend[t])\ninfo_intensity = info_campaign_intensity * campaign_targeting_efficiency + sum_over_media(credibility*(1 - misinformation_probability)*message_frequency) - sum_over_media(credibility*misinformation_probability*message_frequency)\nfor each person i:\n  trust_i = trust_i * (1 - trust_decay_rate) + 0.1 * info_intensity\n  perceived_risk_i = (1 - forgetting_rate) * perceived_risk_i + risk_signal_sensitivity * risk_signal + 0.05 * bias_adjustment(i)\n  belief_state_i = belief_state_i + (info_intensity - misinformation_rate) * (trust_i - 0.5)\n  signal.updated_trust[i] = clamp(trust_i,0,1)\n  signal.updated_risk_perception[i] = clamp(perceived_risk_i,0,1)\nsignal.info_intensity_today = info_intensity",
        "notes": [
          "bias_adjustment(i) depends on alignment between person's belief_state and media bias",
          "clamp bounds to [0,1]"
        ]
      },
      "requirements": [
        "time series of prevalence_trend"
      ],
      "module_parameters": [
        "misinformation_rate",
        "info_campaign_intensity",
        "trust_decay_rate",
        "forgetting_rate",
        "risk_signal_sensitivity",
        "campaign_targeting_efficiency",
        "media_bias_variance"
      ]
    },
    {
      "name": "SupplyAndRetail",
      "description": "Manages inventory, rationing, price adjustments, and executes mask purchases for individuals and households.",
      "inputs": [
        "Retailer.inventory",
        "Retailer.restock_rate",
        "Retailer.price",
        "Retailer.rationing_policy",
        "Location.type",
        "Household.income",
        "Person.mask_stock",
        "Person.perceived_mask_cost"
      ],
      "outputs": [
        "signal.transactions",
        "signal.stockouts_today",
        "signal.price_series"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t % restock_interval_days == 0:\n  for each retailer r:\n    restock_amount = max(0, Normal(restock_rate, supply_variability_cv*restock_rate))\n    inventory_r += restock_amount\nfor each household h:\n  demand_h = max(0, target_buffer - mask_stock_h)\n  affordable_qty = floor(income_h * 0.01 / current_price)\n  demand_eff = min(demand_h, rationing_limit_per_person * household_size, affordable_qty)\n  allocate purchases across nearest stores until demand_eff or inventory exhausted\nrecord transactions and decrement inventories\nupdate price: for each retailer r, price_r *= (1 + retailer_markup) * (1 + price_elasticity_of_demand * excess_demand_ratio), clamp >= 0.1\nsignal.stockouts_today = count retailers with inventory == 0\nsignal.price_series[t] = average retailer price",
        "notes": [
          "target_buffer default is 7 masks per household; computed internally",
          "excess_demand_ratio = max(0, (demand - supply)/max(supply,1))"
        ]
      },
      "requirements": [
        "random number generator"
      ],
      "module_parameters": [
        "mask_price",
        "supply_capacity_per_day",
        "restock_interval_days",
        "rationing_limit_per_person",
        "retailer_markup",
        "price_elasticity_of_demand",
        "supply_variability_cv"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Activates mandates, sets enforcement levels, and updates compliance penalties; issues fines through inspections.",
      "inputs": [
        "Government.policy_status",
        "Government.mandate_start_day",
        "Government.enforcement_resources",
        "Location.type",
        "Location.enforcement_level",
        "Person.mask_adoption_state"
      ],
      "outputs": [
        "signal.location_mask_requirements",
        "signal.enforcement_levels",
        "signal.enforcement_actions"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == mandate_start_day:\n  set mask_requirement=true for workplaces, community, stores\nfor each location L of non-home type:\n  enforcement_levels[L] = min(1.0, enforcement_level_L * policy_enforcement_intensity)\nfor each person i at location L:\n  if mask required and noncompliant:\n    if random() < inspection_probability * enforcement_levels[L]:\n      issue fine compliance_penalty; record enforcement action; increase i.compliance_probability by enforcement_effectiveness_scaler * 0.1",
        "notes": [
          "Home locations are never enforced",
          "enforcement_resources can scale inspection_probability globally"
        ]
      },
      "requirements": [
        "calendar day t"
      ],
      "module_parameters": [
        "policy_enforcement_intensity",
        "compliance_penalty",
        "mandate_start_day",
        "enforcement_effectiveness_scaler",
        "inspection_probability"
      ]
    },
    {
      "name": "AdoptionDecision",
      "description": "Combines perceived norms, risk, costs, and enforcement to update adoption and compliance states.",
      "inputs": [
        "signal.perceived_norm_by_person",
        "signal.updated_risk_perception",
        "signal.updated_trust",
        "signal.location_mask_requirements",
        "signal.enforcement_levels",
        "Person.perceived_mask_cost",
        "Person.mask_access",
        "Person.mask_stock",
        "Person.mask_adoption_state",
        "Person.compliance_probability"
      ],
      "outputs": [
        "signal.adoption_state_updated",
        "signal.compliance_probability_updated"
      ],
      "dependencies": [
        "SocialInfluence",
        "InformationAndRisk",
        "PolicyAndEnforcement",
        "SupplyAndRetail"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  norm = signal.perceived_norm_by_person[i]\n  risk = signal.updated_risk_perception[i]\n  trust = signal.updated_trust[i]\n  expected_benefit = mask_efficacy * (risk_perception_weight * risk + 0.1 * trust)\n  expected_cost = perceived_cost_sensitivity * perceived_mask_cost_i + economic_constraint_weight * affordability_penalty(i)\n  social_pressure = social_influence_weight * norm\n  utility = social_pressure + expected_benefit - expected_cost\n  threshold = adoption_threshold - habit_persistence * (1 if previously adopted else -1) + dissonance_penalty * abs(belief_state_i)\n  if utility >= threshold and mask_access and mask_stock_i > 0:\n    adopt = 1\n  else:\n    adopt = 0\n  # Compliance in required contexts\n  if location requires mask:\n    comp = clamp(compliance_probability_i + 0.2 * enforcement_levels[location] - 0.1 * expected_cost, min_compliance_prob, max_compliance_prob)\n  else:\n    comp = compliance_probability_i * (1 - 0.05) + 0.05 * adopt\n  update Person.mask_adoption_state = adopt\n  update Person.compliance_probability = comp\n  signal.adoption_state_updated[i] = adopt\n  signal.compliance_probability_updated[i] = comp",
        "notes": [
          "affordability_penalty(i) increases when retailer prices rise relative to income",
          "habit_persistence introduces hysteresis (stickiness)"
        ]
      },
      "requirements": [
        "access to prior day's adoption"
      ],
      "module_parameters": [
        "social_influence_weight",
        "risk_perception_weight",
        "adoption_threshold",
        "mask_efficacy",
        "perceived_cost_sensitivity",
        "habit_persistence",
        "dissonance_penalty",
        "min_compliance_prob",
        "max_compliance_prob",
        "economic_constraint_weight"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates observables and computes metrics like adoption rates, inequality, shortages, and policy effect estimates.",
      "inputs": [
        "signal.adoption_state_updated",
        "signal.contacts_daily",
        "signal.context_contact_counts",
        "Household.income",
        "Location.mask_requirement",
        "signal.enforcement_levels",
        "signal.price_series",
        "signal.stockouts_today"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_by_context_home",
        "observable.adoption_by_context_work",
        "observable.adoption_by_context_community",
        "observable.inequality_gini_daily",
        "observable.supply_shortage_flag_daily",
        "observable.policy_effect_estimate_daily",
        "observable.info_elasticity_daily"
      ],
      "dependencies": [
        "AdoptionDecision",
        "MobilityAndContacts",
        "SupplyAndRetail",
        "PolicyAndEnforcement",
        "InformationAndRisk"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate_daily[t] = mean(Person.mask_adoption_state)\nby_context: compute share of interactions where both sides wear mask or individual uses mask in that context\ninequality_gini_daily[t] = Gini of groupwise adoption by inequality_group_field\nsupply_shortage_flag_daily[t] = 1 if signal.stockouts_today > 0 else 0\n# Policy effect (DiD-like): compare high vs low enforcement locations\npre = mean(adoption in high_enforcement locations before mandate_start_day) - mean(adoption in low_enforcement locations before)\npost = mean(adoption in high_enforcement after) - mean(adoption in low_enforcement after)\npolicy_effect_estimate_daily[t] = post - pre (updated incrementally)\n# Info elasticity: approx elasticity wrt campaign intensity using log-diff\nif t>0:\n  info_elasticity_daily[t] = (log(adoption_rate_daily[t]) - log(adoption_rate_daily[t-1])) / (log(info_intensity_today[t]) - log(info_intensity_today[t-1]) + 1e-6)",
        "notes": [
          "Gini computed over income quintiles",
          "Context adoption computed from contacts tagged by context"
        ]
      },
      "requirements": [
        "storage for time series",
        "grouping by income quintiles"
      ],
      "module_parameters": [
        "ttt_level_50",
        "ttt_level_70",
        "ttt_level_90",
        "inequality_group_field",
        "high_enforcement_threshold",
        "smoothing_window_days"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 10000,
      "bounds": {
        "low": 1000,
        "high": 200000
      },
      "owner_module": "global",
      "description": "Total number of Person agents",
      "frozen": true
    },
    {
      "key": "simulation_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Total simulation horizon",
      "frozen": true
    },
    {
      "key": "initial_adoption_rate",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial fraction of adopters",
      "frozen": false
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "scale_free",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "MobilityAndContacts",
      "description": "Underlying social network family",
      "frozen": true
    },
    {
      "key": "average_degree",
      "dtype": "int",
      "default": 8,
      "bounds": {
        "low": 2,
        "high": 40
      },
      "owner_module": "MobilityAndContacts",
      "description": "Average degree of social network",
      "frozen": false
    },
    {
      "key": "social_influence_weight",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "AdoptionDecision",
      "description": "Weight of peer norm in utility",
      "frozen": false
    },
    {
      "key": "risk_perception_weight",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "AdoptionDecision",
      "description": "Weight of perceived risk in utility",
      "frozen": false
    },
    {
      "key": "policy_enforcement_intensity",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "PolicyAndEnforcement",
      "description": "Global multiplier for enforcement levels",
      "frozen": false
    },
    {
      "key": "mask_efficacy",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "AdoptionDecision",
      "description": "Perceived protective effect of masks",
      "frozen": false
    },
    {
      "key": "misinformation_rate",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "InformationAndRisk",
      "description": "Base rate of misinformation exposure",
      "frozen": false
    },
    {
      "key": "info_campaign_intensity",
      "dtype": "float",
      "default": 0.4,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "InformationAndRisk",
      "description": "Intensity of information campaigns",
      "frozen": false
    },
    {
      "key": "compliance_penalty",
      "dtype": "float",
      "default": 50.0,
      "bounds": {
        "low": 0.0,
        "high": 500.0
      },
      "owner_module": "PolicyAndEnforcement",
      "description": "Fine or penalty for non-compliance",
      "frozen": false
    },
    {
      "key": "mask_price",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.1,
        "high": 10.0
      },
      "owner_module": "SupplyAndRetail",
      "description": "Initial price per mask",
      "frozen": false
    },
    {
      "key": "supply_capacity_per_day",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 100,
        "high": 50000
      },
      "owner_module": "SupplyAndRetail",
      "description": "System-wide daily mask supply capacity",
      "frozen": false
    },
    {
      "key": "restock_interval_days",
      "dtype": "int",
      "default": 3,
      "bounds": {
        "low": 1,
        "high": 14
