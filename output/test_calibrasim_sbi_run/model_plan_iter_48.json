      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.9
        }
      }
    },
    {
      "name": "PolicyEffectSize_DiD_meanPost",
      "inputs": [
        "observable.policy_effect_estimate_daily"
      ],
      "definition": {
        "type": "MeanOverPeriod",
        "config": {
          "start_day": 30,
          "end_day": 180
        }
      }
    },
    {
      "name": "Inequality_Gini_Peak",
      "inputs": [
        "observable.inequality_gini_daily"
      ],
      "definition": {
        "type": "Peak",
        "config": {
          "direction": "max"
        }
      }
    },
    {
      "name": "SupplyShortageDays_Total",
      "inputs": [
        "observable.supply_shortage_flag_daily"
      ],
      "definition": {
        "type": "Sum",
        "config": {
          "start_day": 0,
          "end_day": 180
        }
      }
    },
    {
      "name": "InformationImpact_Elasticity_Mean",
      "inputs": [
        "observable.info_elasticity_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "start_day": 0,
          "end_day": 180
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days",
    "layers": [
      "social_network (scale_free)",
      "location_graph (homes, workplaces, community sites, stores)"
    ]
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "num_households": 4000,
    "num_workplaces": 500,
    "num_stores": 50,
    "initial_adoption_rate": 0.1,
    "network_generation": "Barabasi-Albert (m parameter chosen to match average_degree)",
    "household_assignment": "sample household sizes then fill with persons",
    "workplace_assignment": "assign working-age persons to workplaces by capacity",
    "store_assignment": "assign nearest store or random for purchase attempts",
    "mandate_start_day": 30
  },
  "algorithms": {
    "network_generation": "Barabasi-Albert scale-free graph with m chosen to hit average_degree",
    "contact_sampling": "Context-conditioned random sampling with capacity and mobility constraints",
    "utility_based_adoption": "Threshold model with social, risk, and cost components; hysteresis via habit_persistence",
    "price_adjustment": "Markup times elasticity-based adjustment using excess demand ratio",
    "Gini": "Compute Gini coefficient from groupwise adoption",
    "DiD_estimator": "Difference-in-differences on high vs low enforcement groups pre/post mandate",
    "elasticity_estimator": "Finite-difference log elasticity wrt info intensity"
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and validation of adoption and related observables",
      "fields_used": [
        "adoption_rate_daily",
