      "key": "num_locations",
      "dtype": "int",
      "default": 200,
      "bounds": {
        "low": 50,
        "high": 1000
      },
      "owner_module": "global",
      "description": "Number of locations.",
      "frozen": false
    },
    {
      "key": "num_retailers",
      "dtype": "int",
      "default": 50,
      "bounds": {
        "low": 5,
        "high": 500
      },
      "owner_module": "PurchaseAndSupply",
      "description": "Number of retailers selling masks.",
      "frozen": false
    },
    {
      "key": "avg_household_size",
      "dtype": "float",
      "default": 2.6,
      "bounds": {
        "low": 1.0,
        "high": 6.0
      },
      "owner_module": "global",
      "description": "Average household size for assignment.",
      "frozen": false
    },
    {
      "key": "avg_workplace_size",
      "dtype": "float",
      "default": 20.0,
      "bounds": {
        "low": 3.0,
        "high": 200.0
      },
      "owner_module": "global",
      "description": "Average workplace size for assignment.",
      "frozen": false
    },
    {
      "key": "trust_in_authorities_mean",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "SocialInfluenceAndAttitudeUpdate",
      "description": "Mean trust in authorities for initialization and effects.",
      "frozen": false
    },
    {
      "key": "trust_in_authorities_std",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "SocialInfluenceAndAttitudeUpdate",
      "description": "Std dev of trust distribution.",
      "frozen": false
    },
    {
      "key": "risk_perception_initial_mean",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Mean initial risk perception.",
      "frozen": false
    },
    {
      "key": "social_influence_susceptibility_mean",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Mean susceptibility to peer influence.",
      "frozen": false
    },
    {
      "key": "media_consumption_variance",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Variance of per-person media consumption distribution.",
      "frozen": false
    },
    {
      "key": "mask_inventory_initial_per_person",
      "dtype": "int",
      "default": 2,
      "bounds": {
        "low": 0,
        "high": 20
      },
      "owner_module": "global",
      "description": "Initial masks held by each person.",
      "frozen": false
    },
    {
