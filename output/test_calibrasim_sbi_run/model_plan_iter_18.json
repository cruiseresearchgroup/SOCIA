  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_adopted)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.location_compliance_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "masked_visits_required / number_of_required_visits",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:location_compliance_rate"
    },
    {
      "id": "observable.stockout_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(1{Retailer.inventory==0})",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:stockout_rate"
    },
    {
      "id": "observable.enforcement_incidents_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "enforcement_incidents_per_1000_visits",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:enforcement_incidents_rate"
    },
    {
      "id": "observable.policy_level_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "policy_level_t",
      "frequency": "daily",
      "aggregation": "none",
      "target_data_field": "train_data.csv:policy_level"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "time_series",
        "config": {
          "stat": "value",
          "window": "all"
        }
      }
    },
    {
      "name": "time_to_threshold",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "threshold_time",
        "config": {
          "threshold": 0.7,
          "direction": "above",
          "max_time": 180
        }
      }
    },
    {
      "name": "location_compliance_rate",
      "inputs": [
        "observable.location_compliance_rate_daily"
      ],
      "definition": {
        "type": "time_series_stat",
        "config": {
          "stat": "mean",
          "window": "all"
        }
      }
    },
    {
      "name": "stockout_rate",
      "inputs": [
        "observable.stockout_rate_daily"
      ],
      "definition": {
        "type": "time_series_stat",
        "config": {
          "stat": "mean",
          "window": "all"
        }
      }
    },
    {
      "name": "enforcement_incidents_rate",
      "inputs": [
        "observable.enforcement_incidents_rate_daily"
      ],
      "definition": {
        "type": "time_series_stat",
        "config": {
          "stat": "mean",
          "window": "all"
        }
      }
    },
    {
      "name": "policy_effect_size",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.policy_level_daily"
      ],
      "definition": {
        "type": "pre_post_diff",
        "config": {
          "change_point": 30,
          "pre_window": 7,
          "post_window": 7,
          "stat": "mean"
        }
      }
    },
    {
      "name": "validation.policy_monotonicity",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.policy_level_daily"
      ],
      "definition": {
        "type": "assertion",
        "config": {
          "rule": "if policy increases, steady-state adoption non-decreasing",
          "check_window": [
            150,
            180
          ],
          "epsilon": 0.005
        }
      }
    },
    {
      "name": "validation.no_influence_stability",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "assertion",
        "config": {
          "rule": "std(adoption_rate) small when peer/policy/media weights zero",
          "std_upper_bound": 0.03,
          "requires_special_run": true
        }
      }
    },
    {
      "name": "validation.convergence_check",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "assertion",
        "config": {
          "rule": "tail variation below epsilon",
          "tail_window": 14,
          "epsilon": 0.005
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "network": {
      "type": "small_world",
      "average_degree": 10,
      "rewiring_prob": 0.05
    },
    "households": {
      "avg_household_size": 2.6
    },
    "workplaces": {
      "avg_workplace_size": 20.0
    },
    "persons": {
      "age": "sample from realistic distribution",
      "income": "lognormal with median around population median",
      "mask_attitude": "beta distribution centered at initial_mask_adoption_rate",
      "risk_perception": "normal clipped [0,1] with mean risk_perception_initial_mean",
      "trust_in_authorities": "normal clipped [0,1] with mean trust_in_authorities_mean and std trust_in_authorities_std",
      "compliance_propensity": "beta distribution mean 0.7",
      "social_influence_susceptibility": "normal clipped [0,1] mean social_influence_susceptibility_mean",
      "media_consumption_profile": "dirichlet over channels with variance media_consumption_variance",
      "mask_inventory": "constant mask_inventory_initial_per_person",
      "mask_adopted": "Bernoulli(initial_mask_adoption_rate)"
    },
    "locations": {
      "num_locations": 200,
      "type_mix": {
        "office": 0.3,
        "store": 0.3,
        "transit": 0.2,
        "other": 0.2
      },
      "capacity": "normal around 100 clipped >= 10",
      "foot_traffic_rate": "set by type using foot_traffic_base_*"
    },
    "retailers": {
      "num_retailers": 50,
      "inventory": 300,
      "mask_price": 5.0,
      "restock_interval_days": 7,
      "supply_capacity_per_day": 3000
    },
    "media_channels": {
      "num_media_channels": 5,
      "reach": "beta distributed around media_reach_mean",
      "message_frequency": "message_frequency_per_week/7 per day",
      "bias": "normal clipped [-1,1] with std media_bias_std",
      "misinformation_probability": "misinformation_rate"
    },
    "government": {
      "policy_level": 0.3,
      "enforcement_resources": 1.0,
      "messaging_strategy": "broadcast",
      "media_reach": 0.6
    }
  },
  "algorithms": {
    "social_network": "Watts-Strogatz small-world network with N=population_size, k=average_degree, beta=network_rewiring_prob.",
    "risk_and_attitude_update": "DeGroot-style averaging with weighted media and policy signals plus noise, clipped to [0,1].",
    "media_broadcast": "Per-channel stochastic message generation with misinformation flipping; aggregate to person-level via consumption profiles and reach.",
    "policy_broadcast": "Step-function policy level; translates to location mask requirements and enforcement scaling.",
    "purchase_decision": "Inventory-threshold-based demand; probabilistic purchase based on intent and affordability; retailer selection weighted by inventory and inverse price.",
    "adoption_decision": "Logistic adoption probability from latent score (attitude, risk, policy, habit, enforcement penalty, cost), constrained by inventory.",
    "location_visits": "Poisson visits per person; location choice by type weights; enforcement checks at required locations; incident counting.",
    "aggregation": "Daily means and rates for adoption, compliance, stockouts, enforcement incidents, and policy level."
  },
  "data_sources": [
