{
  "model_type": "agent_based",
  "description": "An agent-based, networked social simulation of mask-wearing adoption dynamics under peer influence, policy mandates, media messaging, enforcement, and supply constraints. Agents interact over a small-world social network and visit locations with varying mask requirements and enforcement, while acquiring masks from retailers subject to inventory and price dynamics.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "income",
        "household_id",
        "workplace_id",
        "network_neighbors",
        "mask_attitude",
        "mask_adopted",
        "risk_perception",
        "compliance_propensity",
        "social_influence_susceptibility",
        "trust_in_authorities",
        "media_consumption_profile",
        "mask_inventory",
        "mask_wearing_today",
        "adoption_intent_score"
      ],
      "behaviors": [
        "perceive_risk",
        "update_attitude",
        "decide_adoption",
        "wear_mask_in_public",
        "share_opinion_with_neighbors",
        "purchase_masks",
        "respond_to_policy_message",
        "respond_to_enforcement",
        "enter_location"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "risk_perception_initial_mean": 0.3,
          "trust_in_authorities_mean": 0.6,
          "trust_in_authorities_std": 0.2,
          "social_influence_susceptibility_mean": 0.5,
          "mask_inventory_initial_per_person": 2,
          "initial_mask_adoption_rate": 0.2,
          "media_consumption_variance": 0.3
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "mask_requirement",
        "enforcement_level",
        "signage_strength",
        "foot_traffic_rate"
      ],
      "behaviors": [
        "host_visits",
        "enforce_mask_policy",
        "broadcast_signage"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_locations": 200,
          "capacity_mean": 100,
          "type_mix": {
            "office": 0.3,
            "store": 0.3,
            "transit": 0.2,
            "other": 0.2
          }
        }
      }
    },
    {
      "name": "GovernmentAgency",
      "attributes": [
        "policy_level",
        "enforcement_resources",
        "messaging_strategy",
        "media_reach"
      ],
      "behaviors": [
        "set_policy",
        "broadcast_guidance",
        "deploy_enforcement",
        "adjust_policy"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "policy_level_initial": 0.3,
          "enforcement_resources": 1.0,
          "messaging_strategy": "broadcast",
          "media_reach": 0.6
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory",
        "restock_interval_days",
        "supply_capacity_per_day",
        "mask_price"
      ],
      "behaviors": [
        "sell_masks",
        "restock",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_retailers": 50,
          "initial_inventory": 300,
          "restock_interval_days": 7,
          "supply_capacity_per_day": 3000,
          "mask_price_initial": 5.0
        }
      }
    },
    {
      "name": "MediaChannel",
      "attributes": [
        "id",
        "reach",
        "message_frequency",
        "bias",
        "misinformation_probability"
      ],
      "behaviors": [
        "broadcast_message"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "num_media_channels": 5,
          "media_reach_mean": 0.5,
          "message_frequency_per_week": 3,
          "media_bias_std": 0.4,
          "misinformation_rate": 0.05
        }
      }
    }
  ],
  "modules": [
    {
      "name": "MediaChannelBroadcast",
      "description": "Generates media messages by channel and computes per-person media influence signals, considering bias, reach, frequency, and misinformation.",
      "inputs": [],
      "outputs": [
        "signal.media.person_attitude_delta",
        "signal.media.person_risk_delta"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each channel c:\n  msg_val_c = Normal(bias_c, media_message_noise_std)\n  misinformation_flag = Bernoulli(misinformation_rate)\n  if misinformation_flag: msg_val_c *= -1\n  effective_reach_c = reach_c\nfor each person i:\n  exposure = sum_over_c( media_consumption_profile[i,c] * effective_reach_c * (message_frequency_per_week/7) )\n  trust_mod = (trust_in_authorities_i - 0.5)  # can be negative\n  risk_delta_i = media_influence_weight * exposure * (0.5*mean_msg_val + 0.5*trust_mod)\n  attitude_delta_i = media_influence_weight * exposure * mean_msg_val\nemit signal.media.person_risk_delta[i] = risk_delta_i\nemit signal.media.person_attitude_delta[i] = attitude_delta_i",
        "notes": [
          "mean_msg_val is average of msg_val_c weighted by media_consumption_profile and reach.",
          "trust modulates risk interpretation; negative trust may reduce effective risk delta."
        ]
      },
      "requirements": [
        "MediaChannel entities",
        "Person.media_consumption_profile",
        "random_number_generator"
      ],
      "module_parameters": [
        "message_frequency_per_week",
        "misinformation_rate",
        "media_reach_mean",
        "num_media_channels",
        "media_bias_std",
        "media_message_noise_std"
      ]
    },
    {
      "name": "PolicyBroadcastAndEnforcement",
      "description": "Sets and adjusts policy level over time, updates location mask requirements and signage, and sets enforcement levels.",
      "inputs": [],
      "outputs": [
        "signal.policy.policy_level_t",
        "signal.policy.location_requirements",
        "signal.policy.enforcement_probability_t",
        "signal.policy.signage_strength_t"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day < policy_change_day_1:\n  policy_level = policy_level_initial\nelse:\n  policy_level = policy_level_after_change_1\nfor each location L:\n  base_req = {office: mask_requirement_office, store: mask_requirement_store, transit: mask_requirement_transit, other: mask_requirement_other}[L.type]\n  L.mask_requirement = Bernoulli(min(1.0, base_req * policy_level))\n  L.signage_strength = signage_effect * policy_level\n  L.enforcement_level = enforcement_probability * policy_level\nemit signal.policy.policy_level_t = policy_level\nemit signal.policy.enforcement_probability_t = enforcement_probability * policy_level\nemit signal.policy.signage_strength_t = signage_effect * policy_level\nemit signal.policy.location_requirements = {L.id: (L.mask_requirement, L.enforcement_level, L.signage_strength)}",
        "notes": [
          "A single policy change is modeled; extendable to multiple steps.",
          "Enforcement level is proportional to policy level."
        ]
      },
      "requirements": [
        "GovernmentAgency entity",
        "Location entities"
      ],
      "module_parameters": [
        "policy_level_initial",
        "policy_change_day_1",
        "policy_level_after_change_1",
        "num_policy_changes",
        "enforcement_probability",
        "fine_amount",
        "signage_effect",
        "mask_requirement_office",
        "mask_requirement_store",
        "mask_requirement_transit",
        "mask_requirement_other"
      ]
    },
    {
      "name": "SocialInfluenceAndAttitudeUpdate",
      "description": "Updates each person's risk perception and mask attitude using peer influence, policy signals, signage, and media signals.",
      "inputs": [
        "signal.media.person_attitude_delta",
        "signal.media.person_risk_delta",
        "signal.policy.policy_level_t",
        "signal.policy.location_requirements",
        "signal.policy.signage_strength_t"
      ],
      "outputs": [
        "state.person.risk_perception",
        "state.person.mask_attitude",
        "signal.person.adoption_intent_score"
      ],
      "dependencies": [
        "MediaChannelBroadcast",
        "PolicyBroadcastAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  peer_attitude = mean(mask_attitude[j] for j in network_neighbors[i])\n  peer_adoption = mean(mask_adopted[j] for j in network_neighbors[i])\n  peer_signal = 0.5*peer_attitude + 0.5*peer_adoption\n  media_delta_att = signal.media.person_attitude_delta[i]\n  media_delta_risk = signal.media.person_risk_delta[i]\n  policy_level = signal.policy.policy_level_t\n  signage = signal.policy.signage_strength_t\n  # Update risk perception\n  risk_perception[i] = clip( risk_perception[i] + media_delta_risk + policy_influence_weight*policy_level + peer_influence_weight*peer_adoption + Normal(0, adoption_noise_std), 0, 1 )\n  # Update attitude\n  mask_attitude[i] = clip( (1 - peer_influence_weight - policy_influence_weight)*mask_attitude[i] + peer_influence_weight*peer_signal + policy_influence_weight*(policy_level + signage) + media_delta_att, 0, 1 )\n  # Compute intent score used for purchase planning\n  intent_score[i] = clip( 0.5*mask_attitude[i] + 0.5*risk_perception[i], 0, 1 )\nemit state.person.risk_perception, state.person.mask_attitude\nemit signal.person.adoption_intent_score = intent_score",
        "notes": [
          "DeGroot-style averaging blended with exogenous signals.",
          "Noise captures unobserved factors."
        ]
      },
      "requirements": [
        "Person network",
        "random_number_generator"
      ],
      "module_parameters": [
        "peer_influence_weight",
        "policy_influence_weight",
        "media_influence_weight",
        "exogenous_risk_level",
        "trust_in_authorities_mean",
        "trust_in_authorities_std",
        "adoption_noise_std"
      ]
    },
    {
      "name": "PurchaseAndSupply",
      "description": "Retailers restock and adjust prices; people purchase masks based on intent, inventory thresholds, price, and affordability.",
      "inputs": [
        "signal.person.adoption_intent_score"
      ],
      "outputs": [
        "state.retailer.inventory",
        "state.retailer.mask_price",
        "state.person.mask_inventory",
        "signal.supply.stockout_indicator"
      ],
      "dependencies": [
        "SocialInfluenceAndAttitudeUpdate"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "# Retailer side\nfor each retailer r:\n  if day % stock_replenishment_interval_days == 0:\n    restock_amt = max(0, Poisson(supply_capacity_per_day*(1 + Normal(0, restock_noise_std))))\n    r.inventory += restock_amt\n  inv_ratio = r.inventory / max(1, population_size)\n  price_adj = mask_price_adjustment_sensitivity * (0.5 - inv_ratio)\n  r.mask_price = max(0.5, r.mask_price + price_adj)\n# Consumer side\nfor each person i:\n  desired_daily_use = mask_use_per_day * (signal.person.adoption_intent_score[i])\n  min_stock = masks_per_person_min_stock\n  if mask_inventory[i] < min_stock:\n    affordability = 1 / (1 + affordability_sensitivity * r.mask_price)  # r chosen later\n    demand_qty = ceil((min_stock - mask_inventory[i]) + desired_daily_use)\n    choose retailer r with probability proportional to r.inventory * (1 / r.mask_price)\n    purchase_qty = min(demand_qty, r.inventory)\n    purchase_prob = clip(affordability * signal.person.adoption_intent_score[i], 0, 1)\n    if Bernoulli(purchase_prob) and purchase_qty > 0:\n      r.inventory -= purchase_qty\n      mask_inventory[i] += purchase_qty\n# Stockout signal\nstockout_indicator = mean(1{r.inventory==0} for all retailers r)\nemit state.retailer.inventory, state.retailer.mask_price, state.person.mask_inventory, signal.supply.stockout_indicator",
        "notes": [
          "Price adjusts inversely with inventory ratio to represent scarcity pricing.",
          "Consumers buy when intent and affordability are high enough; retailer choice favors available and cheaper stock."
        ]
      },
      "requirements": [
        "Retailer entities",
        "Person entities",
        "random_number_generator"
      ],
      "module_parameters": [
        "mask_cost",
        "mask_price_initial",
        "affordability_sensitivity",
        "supply_capacity_per_day",
        "stock_replenishment_interval_days",
        "num_retailers",
        "masks_per_person_min_stock",
        "mask_use_per_day",
        "mask_price_adjustment_sensitivity",
        "restock_noise_std"
      ]
    },
    {
      "name": "AdoptionDecision",
      "description": "Determines whether persons adopt mask-wearing today, considering attitudes, risk, habit persistence, costs, and expected enforcement.",
      "inputs": [
        "state.person.mask_attitude",
        "state.person.risk_perception",
        "state.person.mask_inventory",
        "signal.policy.enforcement_probability_t",
        "signal.policy.policy_level_t"
      ],
      "outputs": [
        "state.person.mask_adopted"
      ],
      "dependencies": [
        "PolicyBroadcastAndEnforcement",
        "PurchaseAndSupply",
        "SocialInfluenceAndAttitudeUpdate"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  utility_signal = 0.5*mask_attitude[i] + 0.5*risk_perception[i]\n  cost_term = affordability_sensitivity * expected_mask_price  # use population mean price\n  enforcement_term = signal.policy.enforcement_probability_t * fine_amount * (trust_in_authorities_i)\n  habit_term = habit_persistence * 1{mask_adopted[i]}\n  inventory_term = 1{mask_inventory[i] > 0}\n  latent_score = utility_signal + policy_influence_weight*signal.policy.policy_level_t + habit_term + enforcement_term*0.01 - cost_term - compliance_disutility\n  p_adopt = sigmoid(logistic_slope_beta * (latent_score - adoption_threshold_base)) * inventory_term\n  mask_adopted[i] ~ Bernoulli( p_adopt*(1 - adoption_decay_rate) + 1{mask_adopted[i]}*adoption_decay_rate )\nemit state.person.mask_adopted",
        "notes": [
          "Habit persistence smooths adoption over time.",
          "Inventory is a hard constraint on wearing.",
          "Expected price is approximated by current mean retailer price."
        ]
      },
      "requirements": [
        "Person entities",
        "Retailer snapshot for price mean",
        "random_number_generator"
      ],
      "module_parameters": [
        "adoption_threshold_base",
        "habit_persistence",
        "adoption_decay_rate",
        "compliance_disutility",
        "logistic_slope_beta"
      ]
    },
    {
      "name": "LocationVisitsAndEnforcement",
      "description": "Simulates daily visits to locations, mask wearing during visits, compliance checks, and enforcement outcomes.",
      "inputs": [
        "state.person.mask_adopted",
        "signal.policy.location_requirements",
        "signal.policy.enforcement_probability_t"
      ],
      "outputs": [
        "signal.visits.total_visits",
        "signal.visits.masked_visits_required",
        "signal.enforcement.incidents"
      ],
      "dependencies": [
        "AdoptionDecision",
        "PolicyBroadcastAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "total_visits = 0\nmasked_visits_required = 0\nenforcement_incidents = 0\nfor each person i:\n  num_visits = Poisson(avg_visits_per_person_per_day)\n  for v in 1..num_visits:\n    draw location L with probability proportional to foot_traffic_base_type[L.type]\n    total_visits += 1\n    requirement = L.mask_requirement\n    wearing = mask_adopted[i]\n    if requirement:\n      if wearing:\n        masked_visits_required += 1\n      else:\n        # enforcement check\n        if Bernoulli(L.enforcement_level):\n          enforcement_incidents += 1\n          # denial of entry\n          if Bernoulli(denial_of_entry_probability):\n            continue  # visit aborted\n        # if not denied, visit continues unmasked\nemit signal.visits.total_visits = total_visits\nemit signal.visits.masked_visits_required = masked_visits_required\nemit signal.enforcement.incidents = enforcement_incidents",
        "notes": [
          "Compliance at required locations is measured as masked_visits_required / total required visits.",
          "Enforcement incidents occur only on required-visit noncompliance with enforcement check."
        ]
      },
      "requirements": [
        "Location entities",
        "Person entities",
        "random_number_generator"
      ],
      "module_parameters": [
        "avg_visits_per_person_per_day",
        "foot_traffic_base_office",
        "foot_traffic_base_store",
        "foot_traffic_base_transit",
        "foot_traffic_base_other"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and computes metrics inputs.",
      "inputs": [
        "state.person.mask_adopted",
        "signal.visits.total_visits",
        "signal.visits.masked_visits_required",
        "signal.enforcement.incidents",
        "signal.supply.stockout_indicator",
        "signal.policy.policy_level_t"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.location_compliance_rate_daily",
        "observable.stockout_rate_daily",
        "observable.enforcement_incidents_rate_daily",
        "observable.policy_level_daily"
      ],
      "dependencies": [
        "AdoptionDecision",
        "LocationVisitsAndEnforcement",
        "PurchaseAndSupply",
        "PolicyBroadcastAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate_daily = mean(mask_adopted[i])\nrequired_visits = max(1, signal.visits.masked_visits_required + (signal.visits.total_visits - (signal.visits.total_visits - signal.visits.masked_visits_required)))  # simplified safeguard\nlocation_compliance_rate_daily = masked_visits_required / max(1, number_of_required_visits)\nstockout_rate_daily = signal.supply.stockout_indicator\nenforcement_incidents_rate_daily = (signal.enforcement.incidents / max(1, signal.visits.total_visits)) * 1000\npolicy_level_daily = signal.policy.policy_level_t\nemit all observables",
        "notes": [
          "Compliance rate computed over visits with requirements.",
          "Enforcement incident rate per 1000 visits."
        ]
      },
      "requirements": [
        "Access to prior module outputs"
      ],
      "module_parameters": [
        "target_adoption_threshold"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 10000,
      "bounds": {
        "low": 1000,
        "high": 100000
      },
      "owner_module": "global",
      "description": "Number of Person agents.",
      "frozen": true
    },
    {
      "key": "simulation_duration_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 730
      },
      "owner_module": "global",
      "description": "Total days to simulate.",
      "frozen": true
    },
    {
      "key": "time_step_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.5,
        "high": 7.0
      },
      "owner_module": "global",
      "description": "Simulation time step in days.",
      "frozen": true
    },
    {
      "key": "seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 2147483647
      },
      "owner_module": "global",
      "description": "Random seed.",
      "frozen": true
    },
    {
      "key": "initial_mask_adoption_rate",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial share of population adopting masks.",
      "frozen": false
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "global",
      "description": "Interaction network type.",
      "frozen": true
    },
    {
      "key": "average_degree",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "global",
      "description": "Average number of social neighbors.",
      "frozen": false
    },
    {
      "key": "network_rewiring_prob",
      "dtype": "float",
      "default": 0.05,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "Small-world rewiring probability.",
