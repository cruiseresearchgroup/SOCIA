  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.has_mask_on)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.compliance_rate_mandated_visits_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(mask_on at visits where Location.mask_policy == True)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:compliance_rate_mandated"
    },
    {
      "id": "observable.mask_purchases_per_capita_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "sum(sales.daily)/population_size",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "market_data.csv:purchases_per_capita"
    },
    {
      "id": "observable.stockout_indicator_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "1 if market.inventory==0 else 0",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "market_data.csv:stockout_indicator"
    },
    {
      "id": "observable.adoption_by_income_quintile_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.has_mask_on) grouped by income_quintile",
      "frequency": "daily",
      "aggregation": "by_group(income_quintile)",
      "target_data_field": "survey_data.csv:adoption_by_income_quintile"
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "emit": "daily_values"
        }
      }
    },
    {
      "name": "time_to_70_percent",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "FirstPassageTime",
        "config": {
          "threshold": 0.7,
          "direction": "above"
        }
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Max",
        "config": {}
      }
    },
    {
      "name": "sustained_adoption_days",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "SustainedAbove",
        "config": {
          "threshold": 0.7,
          "min_run": 1
        }
      }
    },
    {
      "name": "adoption_inequality_index",
      "inputs": [
        "observable.adoption_by_income_quintile_daily"
      ],
      "definition": {
        "type": "GiniAcrossGroups",
        "config": {
          "weights": "population_share"
        }
      }
    },
    {
      "name": "policy_compliance_rate_in_mandated_locations",
      "inputs": [
        "observable.compliance_rate_mandated_visits_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {}
      }
    },
    {
      "name": "mask_purchase_rate",
      "inputs": [
        "observable.mask_purchases_per_capita_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {}
      }
    },
    {
      "name": "supply_stockouts_days",
      "inputs": [
        "observable.stockout_indicator_daily"
      ],
      "definition": {
        "type": "CountWhereEqual",
        "config": {
          "value": 1
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network_topology": "small_world",
    "average_degree": 10,
    "policy_mask_mandate": true,
    "policy_start_day": 14,
    "messaging_intensity": 0.7,
    "mask_price": 1.5,
    "supply_capacity_per_day": 800,
    "distribution_delay_days": 2,
    "work_travel_fraction": 0.6,
    "public_space_visit_rate": 0.3
  },
  "algorithms": {
    "WattsStrogatz": "Small-world network generator with rewiring probability.",
    "DeGroot-likeUpdate": "Peer influence averaging on attitudes and risk perception.",
    "SigmoidDecisionRule": "Logistic choice comparing utility of wearing vs. not wearing.",
    "InventoryAndPricing": "Inventory replenishment with lag and proportional price adjustment.",
    "FirstPassageTime": "Earliest day when a time series crosses a threshold.",
    "GiniAcrossGroups": "Inequality index computed across grouped adoption rates."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and validation of adoption and compliance time series.",
      "fields_used": [
        "adoption_rate",
        "compliance_rate_mandated"
      ]
    },
    {
      "name": "market_data.csv",
      "purpose": "Validation of purchase rates and stockouts.",
      "fields_used": [
        "purchases_per_capita",
        "stockout_indicator"
      ]
    },
    {
      "name": "survey_data.csv",
      "purpose": "Validation of adoption heterogeneity across income quintiles.",
      "fields_used": [
        "adoption_by_income_quintile"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "model_config.py",
        "description": "Parameter schema, defaults, and validation."
      },
      {
        "name": "entities.py",
        "description": "Agent and environment entity classes."
      },
      {
        "name": "network_builder.py",
        "description": "Implements NetworkBuilder module."
      },
      {
        "name": "mobility.py",
        "description": "Implements MobilityAndContacts module."
      },
      {
        "name": "messaging.py",
        "description": "Implements MessagingAndBeliefs module and media/gov broadcasting."
      },
      {
        "name": "social_influence.py",
        "description": "Implements SocialInfluence module."
      },
      {
        "name": "policy.py",
        "description": "Implements PolicyEnforcement module."
      },
      {
        "name": "market.py",
        "description": "Implements MaskMarket module."
      },
      {
        "name": "decision.py",
        "description": "Implements DecisionAndCompliance module."
      },
      {
        "name": "aggregation.py",
        "description": "Implements AdoptionAggregator and metrics computations."
      },
      {
        "name": "runner.py",
        "description": "Simulation orchestrator, scheduling, and loop."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy"
    ]
  },
  "prediction_period": {
    "start_day": 150,
    "end_day": 179
  },
  "evaluation_metrics": [
    "overall_adoption_rate",
    "time_to_70_percent",
    "peak_adoption_rate",
    "sustained_adoption_days",
    "adoption_inequality_index",
    "policy_compliance_rate_in_mandated_locations",
    "mask_purchase_rate",
    "supply_stockouts_days"
  ]
}