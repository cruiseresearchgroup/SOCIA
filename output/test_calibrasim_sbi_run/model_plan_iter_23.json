  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.wearing_mask)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "yougov_behavior_tracker.csv:mask_use_rate"
    },
    {
      "id": "observable.compliance_in_mandated_locations_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.wearing_mask | Person present in mandated locations)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed_compliance_surveys.csv:mandated_location_compliance"
    },
    {
      "id": "observable.purchases_daily",
      "source_module": "SupplyAndPurchaseModule",
      "formula_or_field": "sum(quantity_purchased_today)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "retailer_sales.csv:masks_sold"
    },
    {
      "id": "observable.masks_purchased_per_capita_cum",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative_purchases / population_size",
      "frequency": "daily",
      "aggregation": "cumulative",
      "target_data_field": "retailer_sales.csv:masks_sold_per_capita"
    },
    {
      "id": "observable.stockout_days_cum",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative sum of (count retailers with stock==0)",
      "frequency": "daily",
      "aggregation": "cumulative",
      "target_data_field": "retailer_inventory.csv:stockout_indicator"
    },
    {
      "id": "observable.enforcement_actions_daily",
      "source_module": "PolicyEnforcementModule",
      "formula_or_field": "count(fines or denials issued today)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "authority_reports.csv:enforcement_actions"
    },
    {
      "id": "observable.policy_cost_cum",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative(policy_cost_daily + campaign_cost_daily - fines_collected_daily)",
      "frequency": "daily",
      "aggregation": "cumulative",
      "target_data_field": "budget_reports.csv:net_policy_cost"
    },
    {
      "id": "observable.adoption_by_income_quintile_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean adoption per income quintile (q1..q5)",
      "frequency": "daily",
      "aggregation": "by_group(income_quintile)",
      "target_data_field": "survey_microdata.csv:mask_use_by_income_quintile"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "timeseries",
        "config": {}
      }
    },
    {
      "name": "average_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "aggregation",
        "config": {
          "window": "full_period",
          "stat": "mean"
        }
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "threshold_time",
        "config": {
          "threshold": 0.5,
          "direction": "up"
        }
      }
    },
    {
      "name": "sustained_adoption_last_14_days",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "aggregation",
        "config": {
          "window_days": 14,
          "stat": "mean",
          "position": "trailing"
        }
      }
    },
    {
      "name": "compliance_in_mandated_locations",
      "inputs": [
        "observable.compliance_in_mandated_locations_daily"
      ],
      "definition": {
        "type": "aggregation",
        "config": {
          "window": "full_period",
          "stat": "mean"
        }
      }
    },
    {
      "name": "subgroup_adoption_gap_income",
      "inputs": [
        "observable.adoption_by_income_quintile_daily"
      ],
      "definition": {
        "type": "custom",
        "config": {
          "function": "mean(q5) - mean(q1)"
        }
      }
    },
    {
      "name": "stockout_days",
      "inputs": [
        "observable.stockout_days_cum"
      ],
      "definition": {
        "type": "final_value",
        "config": {}
      }
    },
    {
      "name": "masks_purchased_per_capita",
      "inputs": [
        "observable.masks_purchased_per_capita_cum"
      ],
      "definition": {
        "type": "final_value",
        "config": {}
      }
    },
    {
      "name": "policy_cost",
      "inputs": [
        "observable.policy_cost_cum"
      ],
      "definition": {
        "type": "final_value",
        "config": {}
      }
    },
    {
      "name": "enforcement_actions_count",
      "inputs": [
        "observable.enforcement_actions_daily"
      ],
      "definition": {
        "type": "aggregation",
        "config": {
          "window": "full_period",
          "stat": "sum"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "network_builder": {
      "type": "watts_strogatz",
      "average_degree": 8,
      "rewiring_prob": 0.1
    },
    "households": {
      "avg_household_size": 2.6,
      "household_links": "fully_connected"
    },
    "work_school_assignment": {
      "employment_rate": 0.55,
      "school_rate": 0.2,
      "workplace_size_dist": "lognormal(mu=3.0, sigma=0.75)",
      "school_size_dist": "lognormal(mu=5.0, sigma=0.8)"
    },
    "retailers": {
      "count": 50,
      "initial_stock_each": 100,
      "daily_restock_each": 20,
      "initial_price": 1.0
    },
    "authorities": {
      "count": 1,
      "mandate_start_day": 30,
      "mandate_end_day": -1
    }
  },
  "algorithms": {
    "social_network_generation": "Watts-Strogatz small-world network (NetworkX: watts_strogatz_graph(N, k=average_degree, p=rewiring_prob)) plus household cliques.",
    "adoption_decision": "Logistic function combining social, policy, and risk signals minus individual threshold; masked by availability.",
    "inventory_management": "Daily restock with stochasticity; price adjustment via proportional control to target stock.",
    "enforcement_sampling": "Bernoulli checks on present persons in mandated locations weighted by location enforcement strength and budget scaling.",
    "risk_update": "AR(1)-like update with exogenous prevalence and campaign/misinformation inputs with decay."
  },
  "data_sources": [
    {
      "name": "YouGov COVID-19 Behaviour Tracker",
      "purpose": "Benchmark adoption_rate_over_time and income subgroup gaps",
      "fields_used": [
        "mask_use_rate",
        "mask_use_by_income_quintile"
      ]
    },
    {
      "name": "Retailer sales and inventory datasets",
      "purpose": "Benchmark purchases and stockouts",
      "fields_used": [
        "masks_sold",
        "stockout_indicator"
      ]
    },
    {
      "name": "Authority compliance reports",
      "purpose": "Benchmark enforcement actions and policy costs",
      "fields_used": [
        "enforcement_actions",
        "net_policy_cost"
      ]
    }
  ],
