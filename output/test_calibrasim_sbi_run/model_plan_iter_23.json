{
  "model_type": "agent_based",
  "description": "Agent-based network simulation of mask-wearing adoption dynamics driven by social influence, policies/enforcement, supply constraints, and information campaigns across heterogeneous individuals and places.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "health_risk_level",
        "income",
        "political_orientation",
        "trust_in_authority",
        "risk_perception",
        "compliance_propensity",
        "susceptibility_to_influence",
        "adoption_threshold",
        "mask_owned_count",
        "wearing_mask",
        "social_neighbors",
        "home_location_id",
        "work_or_school_location_id",
        "mobility_pattern",
        "access_index"
      ],
      "behaviors": [
        "decide_wear_mask",
        "buy_masks",
        "update_risk_perception",
        "communicate_social_signal",
        "respond_to_policy",
        "move_between_locations"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "age_group_shares": [
            0.22,
            0.62,
            0.16
          ],
          "income_lognorm_mu": 3.0,
          "income_lognorm_sigma": 0.7,
          "trust_beta_a": 2.0,
          "trust_beta_b": 5.0,
          "adoption_threshold_mu": 0.5,
          "adoption_threshold_sigma": 0.15,
          "initial_adoption_rate": 0.1,
          "initial_mask_owned_mean": 2.0,
          "access_inequality_index": 0.2,
          "baseline_prevalence": 0.01
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "region",
        "capacity",
        "mask_requirement",
        "enforcement_strength",
        "contact_rate_modifier"
      ],
      "behaviors": [
        "check_entry_compliance",
        "host_contacts"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "num_households": "population_size / avg_household_size",
          "avg_household_size": 2.6,
          "num_workplaces": 1200,
          "num_schools": 200,
          "num_stores": 50,
          "num_public_spaces": 200,
          "default_capacity_by_type": {
            "home": 6,
            "work": 50,
            "school": 300,
            "store": 100,
            "public": 200
          },
          "default_contact_rate_modifier": {
            "home": 1.0,
            "work": 1.2,
            "school": 1.5,
            "store": 0.8,
            "public": 0.6
          }
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "region",
        "stock",
        "price",
        "daily_restock_rate",
        "rationing_policy"
      ],
      "behaviors": [
        "sell_masks",
        "restock",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "spm_num_retailers": 50,
          "spm_retailer_initial_stock": 5000,
          "spm_retailer_daily_restock": 1000,
          "spm_mask_price": 1.0,
          "spm_rationing_limit_per_visit": 10
        }
      }
    },
    {
      "name": "Authority",
      "attributes": [
        "id",
        "region",
        "mandate_active",
        "mandate_start_day",
        "mandate_end_day",
        "enforcement_budget",
        "fine_amount",
        "campaign_intensity",
        "free_mask_distribution_rate"
      ],
      "behaviors": [
        "set_policies",
        "enforce_policies",
        "run_campaigns",
        "distribute_free_masks"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "pem_mandate_start_day": 30,
          "pem_mandate_end_day": -1,
          "pem_enforcement_budget": 100000.0,
          "pem_fine_amount": 50.0,
          "ibm_campaign_intensity": 0.5,
          "fmd_daily_distribution_rate": 200
        }
      }
    },
    {
      "name": "InformationChannel",
      "attributes": [
        "id",
        "reach_fraction",
        "message_type",
        "reliability",
        "misinformation_rate"
      ],
      "behaviors": [
        "broadcast_message"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "ibm_num_channels": 3,
          "ibm_media_reach": 0.6,
          "ibm_message_reliability_mean": 0.9,
          "ibm_misinformation_rate": 0.1,
          "ibm_misinformation_channel_fraction": 0.33
        }
      }
    }
  ],
  "modules": [
    {
      "name": "MovementAndContactsModule",
      "description": "Assigns daily movements of persons across locations and computes contact exposure context for social signaling and compliance checks.",
      "inputs": [
        "network.social_graph",
        "locations",
        "persons"
      ],
      "outputs": [
        "contacts.daily",
        "presence_in_mandated_locations.daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person p:\n  determine today's schedule based on mobility_pattern and module params\n  draw whether p goes to work/school today (Bernoulli with employment/school probs)\n  schedule possible store/public visits per rates\n  for each scheduled location L:\n    record presence_of(p,L)\n    contribute to contact pool weighted by location contact_rate_modifier\nemit contacts.daily as list of (p, L, contact_weight)\nemit presence_in_mandated_locations.daily as set of persons present in mandated L types",
        "notes": [
          "Contact weights used for social exposure signals and enforcement sampling.",
          "Mobility respects capacity; overflow persons redirected to next best location of same type."
        ]
      },
      "requirements": [
        "network_built",
        "location_registry"
      ],
      "module_parameters": [
        "mcm_contact_rate_work",
        "mcm_contact_rate_school",
        "mcm_contact_rate_store",
        "mcm_contact_rate_public",
        "mcm_fraction_employed",
        "mcm_fraction_in_school",
        "mcm_store_visit_rate_per_week",
        "mcm_public_visit_rate_per_day",
        "mcm_average_commute_probability"
      ]
    },
    {
      "name": "InformationBroadcastModule",
      "description": "Broadcasts risk and policy messages from authority and channels; updates person risk perceptions and trust-weighted uptake of messages.",
      "inputs": [
        "Authority",
        "InformationChannel",
        "baseline_prevalence",
        "prevalence_series.optional"
      ],
      "outputs": [
        "risk_signal.person_daily",
        "campaign_cost.daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "compute prevalence_signal = prevalence_series[t] if provided else baseline_prevalence\nfor each person p:\n  effective_reach = ibm_media_reach * p.susceptibility_to_influence\n  info_valence = (1 - misinformation_rate) * Authority.campaign_intensity * avg(channel.reliability) - misinformation_rate * avg_misinformation_intensity\n  delta_risk = sia_risk_perception_sensitivity * (prevalence_signal + info_valence) - sia_risk_perception_decay * p.risk_perception\n  p.risk_perception = clamp(p.risk_perception + delta_risk, 0, 1)\nemit risk_signal.person_daily = {p.id: p.risk_perception}\ncampaign_cost = ibm_campaign_cost_per_unit * Authority.campaign_intensity\necho campaign_cost.daily",
        "notes": [
          "Trust_in_authority multiplies the positive campaign component.",
          "Misinformation channels determined by ibm_misinformation_channel_fraction."
        ]
      },
      "requirements": [
        "authority_initialized",
        "channels_initialized"
      ],
      "module_parameters": [
        "ibm_campaign_intensity",
        "ibm_media_reach",
        "ibm_misinformation_rate",
        "ibm_campaign_cost_per_unit",
        "ibm_num_channels",
        "ibm_misinformation_channel_fraction",
        "ibm_message_reliability_mean",
        "sia_risk_perception_sensitivity",
        "sia_risk_perception_decay"
      ]
    },
    {
      "name": "SupplyAndPurchaseModule",
      "description": "Manages retailer inventory dynamics and consumer purchases.",
      "inputs": [
        "Retailer",
        "persons",
        "price"
      ],
      "outputs": [
        "purchases.daily",
        "stockouts.daily",
        "prices.daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each retailer r:\n  restock_qty = max(0, Normal(spm_retailer_daily_restock / spm_num_retailers, spm_restock_variability*...))\n  r.stock += restock_qty\n  adjust price: r.price += spm_price_adjustment_rate * (target_stock - r.stock)\nfor each person p who desires masks:\n  desired_inventory = max(sia_min_masks_to_feel_secure, 1 + round(7 * p.risk_perception))\n  needed = max(0, desired_inventory - p.mask_owned_count)\n  demand = needed * (r.price / spm_mask_price)^(spm_price_elasticity_of_demand) * p.access_index\n  quantity = min(r.stock, spm_rationing_limit_per_visit, round(demand))\n  r.stock -= quantity; p.mask_owned_count += quantity; record purchases\n  if p.wearing_mask == 1: p.mask_owned_count = max(0, p.mask_owned_count - spm_mask_use_rate_per_day)\nemit purchases.daily by person and aggregate\nemit stockouts.daily = count of retailers with r.stock == 0\nemit prices.daily = avg retailer price",
        "notes": [
          "If multiple retailers exist, choose nearest or random; here assumed uniform random.",
          "price_elasticity_of_demand < 0 reduces demand as price rises."
        ]
      },
      "requirements": [
        "retailers_initialized"
      ],
      "module_parameters": [
        "spm_mask_price",
        "spm_price_elasticity_of_demand",
        "spm_retailer_initial_stock",
        "spm_retailer_daily_restock",
        "spm_restock_variability",
        "spm_num_retailers",
        "spm_rationing_limit_per_visit",
        "spm_price_adjustment_rate",
        "spm_mask_use_rate_per_day",
        "sia_min_masks_to_feel_secure"
      ]
    },
    {
      "name": "PolicyEnforcementModule",
      "description": "Activates mandates, enforces compliance in mandated locations, and tracks enforcement actions and costs.",
      "inputs": [
        "Authority",
        "presence_in_mandated_locations.daily",
        "persons"
      ],
      "outputs": [
        "enforcement_actions.daily",
        "fines_collected.daily",
        "policy_cost.daily",
        "mandate_active.daily"
      ],
      "dependencies": [
        "MovementAndContactsModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "mandate_active = (t >= pem_mandate_start_day) and (pem_mandate_end_day < 0 or t <= pem_mandate_end_day)\nfor each person p present in a mandated location type (per flags):\n  if random() < pem_enforcement_probability * location.enforcement_strength:\n    if p.wearing_mask == 0:\n      if pem_check_entry_deny: deny entry; action += 1\n      fines_collected += pem_fine_amount; action += 1\n      adjust p.compliance_propensity upward (small) by fine effect\npolicy_cost = min(pem_enforcement_budget, pem_enforcement_check_cost * expected_checks)\nemit enforcement_actions.daily, fines_collected.daily, policy_cost.daily, mandate_active.daily",
        "notes": [
          "Authority budget reduces over time; if budget exhausted, enforcement_probability scales down.",
          "Location-specific enforcement_strength multiplies base probability."
        ]
      },
      "requirements": [
        "authority_initialized",
        "location_registry"
      ],
      "module_parameters": [
        "pem_enforcement_probability",
        "pem_fine_amount",
        "pem_check_entry_deny",
        "pem_enforcement_budget",
        "pem_enforcement_check_cost",
        "pem_mandate_start_day",
        "pem_mandate_end_day",
        "pem_mandate_work",
        "pem_mandate_school",
        "pem_mandate_store",
        "pem_mandate_public"
      ]
    },
    {
      "name": "FreeMaskDistributionModule",
      "description": "Distributes free masks prioritizing low-income and low-access individuals.",
      "inputs": [
        "Authority",
        "persons"
      ],
      "outputs": [
        "masks_distributed.daily",
        "distribution_cost.daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "N = fmd_daily_distribution_rate\nscore(p) = (1 - normalized_income(p)) * fmd_targeting_bias_low_income + (1 - p.access_index) * (1 - fmd_targeting_bias_low_income)\nselect top-N by score among persons with mask_owned_count == 0 or low\nfor each selected p: p.mask_owned_count += 1\ncost = N * fmd_distribution_cost_per_mask; emit masks_distributed.daily, distribution_cost.daily",
        "notes": [
          "If fewer eligible persons than N, distribute to all eligible.",
          "Normalization uses current population distribution."
        ]
      },
      "requirements": [
        "authority_initialized"
      ],
      "module_parameters": [
        "fmd_daily_distribution_rate",
        "fmd_targeting_bias_low_income",
        "fmd_distribution_cost_per_mask"
      ]
    },
    {
      "name": "SocialInfluenceAndAdoption",
      "description": "Combines social signals, risk, and policy to decide mask wearing; updates social signals.",
      "inputs": [
        "network.social_graph",
        "risk_signal.person_daily",
        "mandate_active.daily"
      ],
      "outputs": [
        "adoption.person_daily"
      ],
      "dependencies": [
        "InformationBroadcastModule",
        "PolicyEnforcementModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person p:\n  social_signal = mean(wearing_mask of neighbors over last sia_social_memory_days)\n  policy_signal = 1.0 if mandate_active and p.present_in_mandated_today else 0.0\n  linear_score = sia_influence_weight_social*social_signal + sia_influence_weight_policy*policy_signal + sia_influence_weight_risk*p.risk_perception - p.adoption_threshold\n  prob_adopt = sigmoid(linear_score + Normal(0, sia_compliance_noise)) * p.compliance_propensity * p.trust_in_authority\n  if p.mask_owned_count > 0 and random() < prob_adopt: p.wearing_mask = 1 else: with prob sia_adoption_reversion_rate revert to 0\n  emit p.wearing_mask",
        "notes": [
          "Sigmoid(x) = 1 / (1 + exp(-x)).",
          "Neighbors include household plus social network edges."
        ]
      },
      "requirements": [
        "social_network_built",
        "persons_initialized"
      ],
      "module_parameters": [
        "sia_influence_weight_social",
        "sia_influence_weight_policy",
        "sia_influence_weight_risk",
        "sia_risk_perception_sensitivity",
        "sia_risk_perception_decay",
        "sia_social_memory_days",
        "sia_adoption_reversion_rate",
        "sia_compliance_noise",
        "sia_min_masks_to_feel_secure"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and computes KPI time series and costs.",
      "inputs": [
        "adoption.person_daily",
        "presence_in_mandated_locations.daily",
        "purchases.daily",
        "stockouts.daily",
        "campaign_cost.daily",
        "policy_cost.daily",
        "fines_collected.daily",
        "enforcement_actions.daily",
        "persons",
        "Retailer"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.compliance_in_mandated_locations_daily",
        "observable.purchases_daily",
        "observable.masks_purchased_per_capita_cum",
        "observable.stockout_days_cum",
        "observable.enforcement_actions_daily",
        "observable.policy_cost_cum",
        "observable.adoption_by_income_quintile_daily"
      ],
      "dependencies": [
        "SocialInfluenceAndAdoption",
        "MovementAndContactsModule",
        "SupplyAndPurchaseModule",
        "InformationBroadcastModule",
        "PolicyEnforcementModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate = mean(p.wearing_mask)\ncompliance_mandated = mean(p.wearing_mask for p in presence_in_mandated_locations.daily)\npurchases = sum(purchases.daily)\nstockout_indicator = stockouts.daily\nmasks_purchased_per_capita_cum += purchases / population_size\nenforcement_actions = enforcement_actions.daily\npolicy_cost_cum += campaign_cost.daily + policy_cost.daily - fines_collected.daily\ncompute income quintiles and mean adoption per quintile\necho all observables",
        "notes": [
          "Income quintiles recomputed daily for stability.",
          "Handles empty mandated presence by carrying forward last non-missing value."
        ]
      },
      "requirements": [
        "aggregation_buffers"
      ],
      "module_parameters": []
    }
  ],
  "parameters": [
    {
      "key": "time_horizon_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 1,
        "high": 3650
      },
      "owner_module": "global",
      "description": "Total number of simulated days.",
      "frozen": "true"
    },
    {
      "key": "timestep_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.1,
        "high": 7.0
      },
      "owner_module": "global",
      "description": "Length of one step in days.",
      "frozen": "true"
    },
    {
      "key": "population_size",
      "dtype": "int",
      "default": 10000,
      "bounds": {
        "low": 100,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Number of persons.",
      "frozen": "true"
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "global",
      "description": "Social network topology.",
      "frozen": "true"
    },
    {
      "key": "average_degree",
      "dtype": "int",
      "default": 8,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "global",
      "description": "Average number of social neighbors.",
      "frozen": "false"
    },
    {
      "key": "rewiring_prob",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Watts-Strogatz rewiring probability.",
      "frozen": "false"
    },
    {
      "key": "initial_adoption_rate",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial fraction wearing masks.",
      "frozen": "false"
    },
    {
      "key": "initial_mask_owned_mean",
      "dtype": "float",
      "default": 2.0,
      "bounds": {
        "low": 0.0,
        "high": 50.0
      },
      "owner_module": "global",
      "description": "Initial average masks per person.",
      "frozen": "false"
    },
    {
      "key": "access_inequality_index",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Strength of access disparities (higher = more unequal).",
      "frozen": "false"
    },
    {
      "key": "income_lognorm_mu",
      "dtype": "float",
      "default": 3.0,
      "bounds": {
        "low": 0.0,
        "high": 10.0
      },
      "owner_module": "global",
      "description": "Lognormal mu for income.",
      "frozen": "false"
    },
    {
      "key": "income_lognorm_sigma",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.1,
        "high": 2.0
      },
      "owner_module": "global",
      "description": "Lognormal sigma for income.",
      "frozen": "false"
    },
    {
      "key": "trust_beta_a",
      "dtype": "float",
      "default": 2.0,
      "bounds": {
        "low": 0.1,
        "high": 10.0
      },
      "owner_module": "global",
      "description": "Alpha parameter of Beta distribution for trust.",
      "frozen": "false"
    },
    {
      "key": "trust_beta_b",
      "dtype": "float",
      "default": 5.0,
      "bounds": {
        "low": 0.1,
        "high": 10.0
      },
      "owner_module": "global",
      "description": "Beta parameter of Beta distribution for trust.",
      "frozen": "false"
    },
    {
      "key": "adoption_threshold_mu",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Mean individual threshold to adopt wearing.",
      "frozen": "false"
    },
    {
      "key": "adoption_threshold_sigma",
      "dtype": "float",
      "default": 0.15,
      "bounds": {
        "low": 0.01,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "Std. dev. of adoption threshold.",
      "frozen": "false"
    },
    {
      "key": "baseline_prevalence",
      "dtype": "float",
      "default": 0.01,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "Background disease prevalence signal.",
      "frozen": "false"
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 0,
        "high": 1000000000
      },
      "owner_module": "global",
      "description": "Random seed for reproducibility.",
      "frozen": "true"
    },
    {
      "key": "mcm_contact_rate_work",
      "dtype": "float",
      "default": 1.2,
      "bounds": {
        "low": 0.1,
        "high": 5.0
      },
      "owner_module": "MovementAndContactsModule",
      "description": "Relative contact rate at work locations.",
      "frozen": "false"
    },
    {
      "key": "mcm_contact_rate_school",
      "dtype": "float",
      "default": 1.5,
      "bounds": {
        "low": 0.1,
        "high": 5.0
      },
      "owner_module": "MovementAndContactsModule",
      "description": "Relative contact rate at schools.",
      "frozen": "false"
    },
    {
      "key": "mcm_contact_rate_store",
      "dtype": "float",
      "default": 0.8,
      "bounds": {
        "low": 0.1,
        "high": 5.0
      },
      "owner_module": "MovementAndContactsModule",
      "description": "Relative contact rate at stores.",
      "frozen": "false"
    },
    {
      "key": "mcm_contact_rate_public",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.1,
        "high": 5.0
      },
      "owner_module": "MovementAndContactsModule",
      "description": "Relative contact rate at public spaces.",
      "frozen": "false"
    },
    {
      "key": "mcm_fraction_employed",
      "dtype": "float",
      "default": 0.55,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MovementAndContactsModule",
      "description": "Share of adults employed and commuting.",
      "frozen": "false"
    },
    {
      "key": "mcm_fraction_in_school",
      "dtype": "float",
