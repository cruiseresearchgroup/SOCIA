  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/adoption_rate_daily.csv:adoption_rate"
    },
    {
      "id": "observable.final_adoption_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "adoption_rate on last day",
      "frequency": "once",
      "aggregation": "last",
      "target_data_field": "observed/final_adoption_rate.csv:value"
    },
    {
      "id": "observable.switching_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(1 if Person.mask_state(t)!=mask_state(t-1) else 0)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/switching_rate_daily.csv:switching_rate"
    },
    {
      "id": "observable.peer_exposure_index_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean over persons of mean(mask of network neighbors)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "observed/peer_exposure_daily.csv:peer_exposure"
    },
    {
      "id": "observable.compliance_by_location_type_daily",
      "source_module": "MobilityModule",
      "formula_or_field": "mean(mask_state of visitors) by Location.type",
      "frequency": "daily",
      "aggregation": "by_group(Location.type)",
      "target_data_field": "observed/compliance_by_location_type.csv:compliance"
    },
    {
      "id": "observable.inequality_index_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "Gini of adoption across health risk quintiles",
      "frequency": "daily",
      "aggregation": "scalar",
      "target_data_field": "observed/inequality_index_daily.csv:gini"
    },
    {
      "id": "observable.fines_issued_daily",
      "source_module": "PolicyEnforcementModule",
      "formula_or_field": "sum of fines issued per day",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "observed/fines_issued_daily.csv:fines"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_AdoptionRate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAPE_ComplianceByLocation",
      "inputs": [
        "observable.compliance_by_location_type_daily"
      ],
      "definition": {
        "type": "MAPE",
        "config": {
          "by_group": "Location.type"
        }
      }
    },
    {
      "name": "Volatility_SwitchingRate",
      "inputs": [
        "observable.switching_rate_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {
          "window": 7
        }
      }
    },
    {
      "name": "PolicyEffect_PrePost",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "PrePostDiff",
        "config": {
          "pre_window": [
            7,
            1
          ],
          "post_window": [
            14,
            21
          ],
          "policy_start_day_param": "policy_start_day"
        }
      }
    },
    {
      "name": "TimeToReachThreshold",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "FirstPassageTime",
        "config": {
          "threshold_param": "target_adoption_threshold"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1.0,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network_generation": {
      "method": "Watts-Strogatz small-world",
      "parameters": {
        "N": "population_size",
        "k": "average_degree",
        "beta": 0.1
      },
      "homophily": {
        "attribute": "age buckets",
        "strength": "homophily_strength",
        "procedure": "rewiring to increase assortativity while preserving degree"
      }
    },
    "households": {
      "assignment": "Sequential fill according to household_size distribution until all persons assigned",
      "norm_strength": "draw per household as specified",
      "mask_stock": "initialize per household"
    },
    "locations": {
      "counts": "determine per type as specified; homes equal households",
      "capacity": "apply location_capacity_multiplier",
      "policies": "inactive until policy_start_day, then active for non-home"
    },
    "policy_maker": {
      "mandate_status": false,
      "policy_start_day": 14
    },
    "persons": {
      "attributes": "drawn per Person.initialization parameters",
      "daily_schedule": "derived from location_mix and age (school for age<22; work for 22<=age<65 else fewer work visits)"
    }
  },
  "algorithms": {
    "NetworkGeneration": "Watts-Strogatz small-world with homophily-biased rewiring to match average_degree and homophily_strength.",
    "SocialInfluence": "DeGroot-style updating with thresholded pressure and memory decay combining neighbor and co-location signals.",
    "RiskUpdate": "Exponential smoothing toward a trust- and messaging-modulated target risk derived from a synthetic cases wave series.",
    "DecisionUtility": "Logit-like mask wearing decision combining risk, intent, compliance, habit, policy bonus, and costs with Gaussian noise.",
    "PolicyEnforcement": "Stochastic enforcement with daily budget constraint; actions include deny entry or fine.",
    "HouseholdNorms": "Within-household averaging toward mean intent and probabilistic mask sharing.",
    "Aggregation": "Daily computation of adoption, switching, peer exposure, compliance by type, and inequality (Gini)."
  },
  "data_sources": [
    {
      "name": "ObservedAdoptionRates",
      "purpose": "Calibration/validation of daily adoption rate.",
      "fields_used": [
        "date",
        "adoption_rate"
      ]
    },
    {
      "name": "ObservedComplianceByLocation",
      "purpose": "Validation of compliance by location type.",
      "fields_used": [
        "date",
        "location_type",
        "compliance"
      ]
    },
    {
      "name": "ObservedFines",
      "purpose": "Validation of enforcement outcomes.",
      "fields_used": [
        "date",
        "fines"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point; parses config, initializes model, runs simulation loop, orchestrates modules."
      },
