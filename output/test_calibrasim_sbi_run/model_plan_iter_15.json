      },
      {
        "name": "config/default.json",
        "description": "Default parameter values and scenario settings."
      }
    ],
    "dependencies": [
      "numpy",
      "scipy",
      "pandas",
      "networkx",
      "numba",
      "pyyaml",
      "tqdm"
    ]
  },
  "prediction_period": {
    "start_day": 90,
    "end_day": 119
  },
  "evaluation_metrics": [
    "RMSE_AdoptionRate",
    "MAPE_ComplianceByLocation",
    "PolicyEffect_PrePost",
    "TimeToReachThreshold"
  ]
}