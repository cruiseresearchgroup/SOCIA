    "start_day": 90,
    "end_day": 119
  },
  "evaluation_metrics": [
    "adoption_rate_over_time",
    "final_adoption_rate",
    "time_to_threshold",
    "compliance_under_mandate",
    "masks_sold_over_time",
    "shortage_frequency",
