{
  "model_type": "agent_based",
  "description": "Agent-based, networked social simulation of mask-wearing adoption under social influence, policy interventions, and supply constraints with retailers and locations mediating interactions.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age_group",
        "income_level",
        "home_location_id",
        "work_location_id",
        "social_neighbors_ids",
        "risk_perception",
        "trust_in_authority",
        "social_influence_susceptibility",
        "compliance_propensity",
        "mask_owned_count",
        "is_wearing_mask",
        "fatigue_level",
        "daily_contacts"
      ],
      "behaviors": [
        "decide_wear_mask",
        "update_risk_perception",
        "purchase_mask",
        "respond_to_policy",
        "interact_with_peers",
        "replace_mask",
        "move_between_locations",
        "share_opinion"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "age_group_distribution": {
            "0-17": 0.2,
            "18-64": 0.65,
            "65+": 0.15
          },
          "income_level_distribution": {
            "low": 0.3,
            "mid": 0.5,
            "high": 0.2
          },
          "risk_perception_init": {
            "distribution": "beta",
            "alpha": 2.0,
            "beta": 5.0
          },
          "trust_in_authority_init": {
            "distribution": "beta",
            "alpha": 3.0,
            "beta": 2.0
          },
          "social_influence_susceptibility_init": {
            "distribution": "beta",
            "alpha": 2.0,
            "beta": 3.0
          },
          "compliance_propensity_init": {
            "distribution": "beta",
            "alpha": 2.5,
            "beta": 2.5
          },
          "fatigue_level_init": 0.0,
          "daily_contacts_init": {
            "distribution": "poisson",
            "lambda": 12
          },
          "initial_adoption_rate": 0.1,
          "initial_masks_for_adopters": 1,
          "initial_masks_for_non_adopters": 0
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "location_id",
        "inventory",
        "price_per_mask",
        "restock_rate",
        "allocation_policy"
      ],
      "behaviors": [
        "sell_masks",
        "restock_inventory",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "retailer_count": 100,
          "initial_inventory_per_capita": 2.0,
          "allocation_policy": "proportional_to_demand"
        }
      }
    },
    {
      "name": "PolicyAuthority",
      "attributes": [
        "id",
        "mandate_active",
        "mandate_start_day",
        "enforcement_level",
        "fine_amount",
        "campaign_intensity",
        "message_trustworthiness"
      ],
      "behaviors": [
        "implement_mandate",
        "enforce_policy",
        "run_public_campaign",
        "coordinate_supply"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_start_day": 30,
          "enforcement_level": 0.7,
          "fine_amount": 50.0,
          "campaign_intensity": 0.6,
          "message_trustworthiness": 0.85,
          "mandate_duration_days": 90
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "region",
        "capacity",
        "mask_requirement"
      ],
      "behaviors": [
        "host_visitors",
        "check_compliance",
        "display_guidance"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "work_locations_count": 500,
          "store_locations_count": 100,
          "public_space_count": 50,
          "avg_work_capacity": 30,
          "avg_store_capacity": 100,
          "avg_public_capacity": 200,
          "mask_requirement_defaults": {
            "home": false,
            "work": false,
            "store": false,
            "public": false
          }
        }
      }
    }
  ],
  "modules": [
    {
      "name": "NetworkBuilderModule",
      "description": "Constructs the social network among Person agents using the specified topology.",
      "inputs": [],
      "outputs": [
        "network.social_graph"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "steps",
        "value": 0
      },
      "update_rule": {
        "pseudocode": "if t == 0:\n  if network_topology == 'small_world':\n    G = watts_strogatz_graph(population_size, average_degree, rewiring_prob, seed=random_seed)\n  elif network_topology == 'scale_free':\n    G = barabasi_albert_graph(population_size, m=max(1,int(average_degree/2)), seed=random_seed)\n  else:\n    G = erdos_renyi_graph(population_size, p=average_degree/(population_size-1), seed=random_seed)\n  assign social_neighbors_ids to each Person from G",
        "notes": [
          "Runs once at initialization because tick_rate.value=0 denotes initialize-only.",
          "Ensures connectedness if needed by adding edges to isolated nodes."
        ]
      },
      "requirements": [
        "random_seed",
        "population_size"
      ],
      "module_parameters": [
        "network_topology",
        "average_degree",
        "rewiring_prob"
      ]
    },
    {
      "name": "PolicyModule",
      "description": "Implements mandates, enforcement, communication campaigns, and supply subsidies.",
      "inputs": [
        "t",
        "locations",
        "persons",
        "retailers"
      ],
      "outputs": [
        "policy.mandate_active",
        "policy.enforcement_level",
        "policy.fine_amount",
        "policy.campaign_intensity",
        "policy.message_trustworthiness",
        "policy.supply_subsidy_per_mask"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "mandate_active = (mandate_day <= t < mandate_day + mandate_duration_days)\nfor loc in locations:\n  if loc.type in ['work','store','public']:\n    loc.mask_requirement = mandate_active\n# Communication campaign effect: update each person's trust and perceived risk subtly\nfor p in persons:\n  trust_delta = campaign_intensity * message_trustworthiness * 0.01\n  p.trust_in_authority = clamp(p.trust_in_authority + trust_delta, 0, 1)\n  # optional small increase in risk perception due to messaging\n  p.risk_perception = clamp(p.risk_perception + 0.005 * campaign_intensity, 0, 1)\n# Enforcement parameters exposed for other modules\npolicy.enforcement_level = mandate_enforcement_level\npolicy.fine_amount = compliance_penalty\npolicy.supply_subsidy_per_mask = supply_subsidy_per_mask",
        "notes": [
          "Mandate applies to all non-home locations by default.",
          "Trust and risk are gently nudged by campaign each day."
        ]
      },
      "requirements": [
        "locations",
        "persons"
      ],
      "module_parameters": [
        "mandate_day",
        "mandate_enforcement_level",
        "compliance_penalty",
        "campaign_intensity",
        "message_trustworthiness",
        "mandate_duration_days",
        "supply_subsidy_per_mask"
      ]
    },
    {
      "name": "SocialInfluenceModule",
      "description": "Updates social norms perception and personal risk perception based on neighbors and recent observations.",
      "inputs": [
        "network.social_graph",
        "persons"
      ],
      "outputs": [
        "persons.risk_perception",
        "persons.social_norm_estimate"
      ],
      "dependencies": [
        "NetworkBuilderModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for p in persons:\n  neigh = social_neighbors_ids[p]\n  observed = mean(neighbor.is_wearing_mask for neighbor in neigh) + Normal(0, peer_observation_noise)\n  observed = clamp(observed, 0, 1)\n  # Exponential moving average over neighbor_memory_window_days\n  alpha = social_influence_weight\n  p.social_norm_estimate = (1 - alpha) * getattr(p, 'social_norm_estimate', observed) + alpha * observed\n  # Update risk perception toward observed norm as a proxy for perceived community risk/concern\n  p.risk_perception = clamp(p.risk_perception * (1 - alpha) + alpha * observed, 0, 1)",
        "notes": [
          "Keeps a running estimate of social norm to avoid high variance.",
          "peer_observation_noise accounts for misperception."
        ]
      },
      "requirements": [
        "random_seed"
      ],
      "module_parameters": [
        "social_influence_weight",
        "neighbor_memory_window_days",
        "peer_observation_noise"
      ]
    },
    {
      "name": "MovementAndLocationModule",
      "description": "Moves persons through daily schedule across locations and tracks compliance context.",
      "inputs": [
        "persons",
        "locations",
        "t"
      ],
      "outputs": [
        "visits.log",
        "location.attendance",
        "person.current_locations"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for p in persons:\n  current_locations = []\n  # Work\n  if random() < work_attendance_probability and p.work_location_id is not None:\n    current_locations.append(p.work_location_id)\n  # Store\n  if random() < shopping_probability_per_day:\n    store = sample_store_near(p.home_location_id)\n    current_locations.append(store.id)\n  # Public\n  if random() < public_visit_probability_per_day:\n    public_loc = sample_public_space()\n    current_locations.append(public_loc.id)\n  # Always at home at least part of day\n  current_locations.append(p.home_location_id)\n  person.current_locations[p.id] = current_locations\n  for loc_id in current_locations:\n    increment location.attendance[loc_id]\n# Enforce capacity soft limit by capping attendance metrics (no agent removal here, capacity is analytic).",
        "notes": [
          "Location capacity used for analytics; does not block visits in ABM to keep simplicity.",
          "Sampling of stores/public should consider region proximity if regions are defined."
        ]
      },
      "requirements": [
        "locations.index_by_type"
      ],
      "module_parameters": [
        "work_attendance_probability",
        "shopping_probability_per_day",
        "public_visit_probability_per_day",
        "avg_work_capacity",
        "avg_store_capacity",
        "avg_public_capacity",
        "mean_daily_contacts"
      ]
    },
    {
      "name": "AdoptionDecisionModule",
      "description": "Determines mask-wearing decisions given norms, risk, policy, and fatigue; updates fatigue and compliance.",
      "inputs": [
        "persons",
        "policy.mandate_active",
        "policy.enforcement_level",
        "policy.fine_amount",
        "person.current_locations"
      ],
      "outputs": [
        "persons.is_wearing_mask",
        "enforcement.actions"
      ],
      "dependencies": [
        "PolicyModule",
        "SocialInfluenceModule",
        "MovementAndLocationModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for p in persons:\n  mandated_now = any(loc.mask_requirement for loc in person.current_locations[p.id] if lookup_loc(loc).mask_requirement)\n  # Utility components\n  U = base_adoption_bias\n  U += authority_trust_weight * p.trust_in_authority * (1 if mandated_now else 0) * policy.enforcement_level\n  U += risk_perception_weight * p.risk_perception\n  U += p.social_influence_susceptibility * p.social_norm_estimate\n  U -= p.fatigue_level\n  # Convert to probability\n  prob_wear = 1 / (1 + exp(-4 * (U - 0.5)))  # centered logistic\n  # Stock constraint\n  if p.mask_owned_count <= 0:\n    prob_wear *= 0.05\n  p.is_wearing_mask = (random() < prob_wear)\n  # Enforcement if mandated and not wearing\n  if mandated_now and not p.is_wearing_mask:\n    if random() < policy.enforcement_level:\n      p.compliance_propensity = clamp(p.compliance_propensity + 0.05, 0, 1)\n      record enforcement.actions += 1\n  # Fatigue update\n  p.fatigue_level = clamp(p.fatigue_level + fatigue_rate * (1 if p.is_wearing_mask else -0.5), 0, 1)",
        "notes": [
          "Fatigue recovers when not wearing.",
          "Logistic slope scaled to make probabilities responsive yet stable.",
          "Compliance propensity nudged upward if caught violating."
        ]
      },
      "requirements": [
        "persons.mask_owned_count"
      ],
      "module_parameters": [
        "authority_trust_weight",
        "risk_perception_weight",
        "fatigue_rate",
        "base_adoption_bias"
      ]
    },
    {
      "name": "PurchaseAndSupplyModule",
      "description": "Handles mask purchasing by persons, retailer sales/restocking, and price adjustments including subsidies.",
      "inputs": [
        "persons",
        "retailers",
        "policy.supply_subsidy_per_mask"
      ],
      "outputs": [
        "retailer.sales_daily",
        "retailer.stockouts",
        "persons.mask_owned_count",
        "spending.person_daily"
      ],
      "dependencies": [
        "PolicyModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "# Replacement usage\nfor p in persons:\n  if day % mask_replacement_interval_days == 0 and p.mask_owned_count > 0:\n    p.mask_owned_count = max(0, p.mask_owned_count - 1)\n# Purchase decision\nfor p in persons:\n  if p.mask_owned_count <= purchase_threshold:\n    # affordability\n    income = base_daily_income_low if p.income_level=='low' else (base_daily_income_mid if p.income_level=='mid' else base_daily_income_high)\n    effective_price = max(0, price_per_mask - policy.supply_subsidy_per_mask)\n    budget = max_daily_mask_budget_fraction * income\n    max_affordable_qty = int(budget / max(effective_price, 1e-6))\n    desired_qty = min(max_masks_per_purchase, max_affordable_qty)\n    # demand elasticity (if price high, reduce desired)\n    desired_qty = int(max(0, desired_qty * (effective_price ** price_elasticity)))\n    if desired_qty > 0:\n      r = choose_retailer_with_inventory(desired_qty)\n      qty_sold = min(desired_qty, r.inventory)\n      r.inventory -= qty_sold\n      p.mask_owned_count += qty_sold\n      cost = qty_sold * effective_price\n      record spending.person_daily[p.id] = cost\n      record retailer.sales_daily[r.id] += qty_sold\n# Restock\nfor r in retailers:\n  restock_qty = int(restock_rate * population_size * initial_inventory_per_capita / retailer_count)\n  r.inventory += max(0, restock_qty)\n  if r.inventory <= 0:\n    record retailer.stockouts[r.id] = 1\n  else:\n    record retailer.stockouts[r.id] = 0",
        "notes": [
          "Simple restock proportional to population and configured rate.",
          "Subsidy reduces effective price for buyers.",
          "Sales are constrained by inventory to prevent negative stock."
        ]
      },
      "requirements": [
        "non_negative_inventory"
      ],
      "module_parameters": [
        "initial_inventory_per_capita",
        "restock_rate",
        "price_per_mask",
        "mask_replacement_interval_days",
        "purchase_threshold",
        "max_masks_per_purchase",
        "retailer_count",
        "price_elasticity",
        "base_daily_income_low",
        "base_daily_income_mid",
        "base_daily_income_high",
        "max_daily_mask_budget_fraction"
      ]
    },
    {
      "name": "AdoptionAggregatorModule",
      "description": "Aggregates observables and computes metrics daily and at end of simulation.",
      "inputs": [
        "persons",
        "retailer.sales_daily",
        "retailer.stockouts",
        "spending.person_daily",
        "policy.mandate_active"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.compliance_rate_daily",
        "observable.masks_sold_daily",
        "observable.stockouts_daily",
        "observable.group_adoption_income_daily",
        "observable.cumulative_cost_per_person_avg_daily"
      ],
      "dependencies": [
        "AdoptionDecisionModule",
        "PurchaseAndSupplyModule",
        "PolicyModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate = mean(p.is_wearing_mask for p in persons)\ncompliance_rate = mean((p.is_wearing_mask or (not any_required_for(p))) for p in persons) if policy.mandate_active else None\nmasks_sold = sum(retailer.sales_daily.values())\nstockouts_any = 1 if any(v==1 for v in retailer.stockouts.values()) else 0\ngroup_adoption_income = {g: mean(p.is_wearing_mask for p in persons if p.income_level==g) for g in ['low','mid','high']}\navg_cost = mean(spending.person_daily.get(p.id,0.0) for p in persons) + previous_day_avg_cost\nemit observables for day t",
        "notes": [
          "Compliance rate recorded only on mandate-active days.",
          "Cumulative average cost tracked by summing per-person spending over time and dividing by population."
        ]
      },
      "requirements": [
        "population_size"
      ],
      "module_parameters": [
        "target_adoption_threshold",
        "validation_window_days"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 10000,
      "bounds": {
        "low": 1000,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Number of Person agents.",
      "frozen": true
    },
    {
      "key": "simulation_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Number of simulated days.",
      "frozen": true
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Seed for reproducibility.",
      "frozen": true
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "NetworkBuilderModule",
      "description": "Topology: small_world | scale_free | erdos_renyi.",
      "frozen": false
    },
    {
      "key": "average_degree",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 2,
        "high": 100
      },
      "owner_module": "NetworkBuilderModule",
      "description": "Average number of social ties per person.",
      "frozen": false
    },
    {
      "key": "rewiring_prob",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "NetworkBuilderModule",
      "description": "Rewiring probability for small-world network.",
      "frozen": false
    },
    {
      "key": "mandate_day",
      "dtype": "int",
      "default": 30,
      "bounds": {
        "low": 0,
        "high": 364
      },
      "owner_module": "PolicyModule",
      "description": "Day mandate starts.",
      "frozen": true
    },
    {
      "key": "mandate_duration_days",
      "dtype": "int",
      "default": 90,
      "bounds": {
        "low": 1,
        "high": 365
      },
      "owner_module": "PolicyModule",
      "description": "Mandate duration in days.",
      "frozen": false
    },
    {
      "key": "mandate_enforcement_level",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "PolicyModule",
      "description": "Probability of detecting non-compliance when mandate active.",
      "frozen": true
    },
    {
      "key": "compliance_penalty",
      "dtype": "float",
      "default": 50.0,
      "bounds": {
        "low": 0.0,
        "high": 1000.0
      },
      "owner_module": "PolicyModule",
      "description": "Fine amount if caught violating mandate.",
      "frozen": true
    },
    {
      "key": "campaign_intensity",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "PolicyModule",
      "description": "Daily public messaging intensity.",
      "frozen": false
    },
    {
      "key": "message_trustworthiness",
      "dtype": "float",
      "default": 0.85,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "PolicyModule",
      "description": "Perceived credibility of policy messages.",
      "frozen": false
    },
    {
      "key": "supply_subsidy_per_mask",
      "dtype": "float",
      "default": 0.0,
      "bounds": {
        "low": 0.0,
        "high": 5.0
      },
      "owner_module": "PolicyModule",
      "description": "Subsidy amount per mask to reduce effective price.",
      "frozen": false
    },
    {
      "key": "social_influence_weight",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "SocialInfluenceModule",
      "description": "Weight of social observation in updating norms and risk.",
      "frozen": false
    },
    {
      "key": "neighbor_memory_window_days",
      "dtype": "int",
      "default": 7,
      "bounds": {
        "low": 1,
        "high": 30
      },
      "owner_module": "SocialInfluenceModule",
      "description": "Smoothing window for social norm estimate.",
      "frozen": false
    },
    {
      "key": "peer_observation_noise",
      "dtype": "float",
      "default": 0.05,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "SocialInfluenceModule",
      "description": "Noise in perceiving neighbors' mask-wearing.",
      "frozen": false
    },
    {
      "key": "authority_trust_weight",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "AdoptionDecisionModule",
      "description": "Weight of authority trust and mandate on adoption decision.",
      "frozen": false
    },
    {
      "key": "risk_perception_weight",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "AdoptionDecisionModule",
      "description": "Weight of risk perception on adoption decision.",
      "frozen": false
    },
    {
      "key": "fatigue_rate",
      "dtype": "float",
      "default": 0.01,
      "bounds": {
        "low": 0.0,
        "high": 0.1
      },
      "owner_module": "AdoptionDecisionModule",
      "description": "Daily increase in fatigue when wearing; partial recovery when not.",
      "frozen": false
    },
    {
      "key": "base_adoption_bias",
      "dtype": "float",
      "default": 0.0,
      "bounds": {
        "low": -1.0,
        "high": 1.0
      },
      "owner_module": "AdoptionDecisionModule",
      "description": "Baseline bias toward or against wearing.",
      "frozen": false
    },
    {
      "key": "work_attendance_probability",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MovementAndLocationModule",
      "description": "Daily probability of attending work for employed persons.",
      "frozen": false
    },
    {
      "key": "shopping_probability_per_day",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MovementAndLocationModule",
      "description": "Daily probability of visiting a store.",
      "frozen": false
    },
    {
      "key": "public_visit_probability_per_day",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
