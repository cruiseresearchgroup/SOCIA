  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregatorModule",
      "formula_or_field": "mean(Person.is_wearing_mask)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "adoption_timeseries.csv:adoption_rate"
    },
    {
      "id": "observable.compliance_rate_daily",
      "source_module": "AdoptionAggregatorModule",
      "formula_or_field": "mean(Person.is_wearing_mask OR NOT Location.mask_requirement) on mandate days",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "mandate_period.csv:compliance_rate"
    },
    {
      "id": "observable.masks_sold_daily",
      "source_module": "AdoptionAggregatorModule",
      "formula_or_field": "sum(Retailer.sales_daily)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "retail_sales.csv:masks_sold"
    },
    {
      "id": "observable.stockouts_daily",
      "source_module": "AdoptionAggregatorModule",
      "formula_or_field": "any(Retailer.stockouts == 1)",
      "frequency": "daily",
      "aggregation": "boolean_any",
      "target_data_field": "retailer_ops.csv:any_stockout"
    },
    {
      "id": "observable.group_adoption_income_daily",
      "source_module": "AdoptionAggregatorModule",
      "formula_or_field": "by_group(income_level, mean(Person.is_wearing_mask))",
      "frequency": "daily",
      "aggregation": "by_group(income_level)",
      "target_data_field": "adoption_by_income.csv:adoption_rate_by_income"
    },
    {
      "id": "observable.cumulative_cost_per_person_avg_daily",
      "source_module": "AdoptionAggregatorModule",
      "formula_or_field": "mean(cumulative spending per person)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "household_spend.csv:avg_mask_spend"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "emit_full_series": true
        }
      }
    },
    {
      "name": "final_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "LastValue",
        "config": {}
      }
    },
    {
      "name": "time_to_threshold",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.7,
          "not_reached_value": null
        }
      }
    },
    {
      "name": "compliance_under_mandate",
      "inputs": [
        "observable.compliance_rate_daily"
      ],
      "definition": {
        "type": "MeanOverMandateDays",
        "config": {}
      }
    },
    {
      "name": "masks_sold_over_time",
      "inputs": [
        "observable.masks_sold_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "emit_full_series": true
        }
      }
    },
    {
      "name": "shortage_frequency",
      "inputs": [
        "observable.stockouts_daily"
      ],
      "definition": {
        "type": "Frequency",
        "config": {
          "value_of_interest": 1
        }
      }
    },
    {
      "name": "adoption_inequality_gini",
      "inputs": [
        "observable.group_adoption_income_daily"
      ],
      "definition": {
        "type": "GiniAcrossGroups",
        "config": {
          "groups": [
            "low",
            "mid",
            "high"
          ],
          "use_final_day": true
        }
      }
    },
    {
      "name": "policy_effect_lift",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "PrePostDifference",
        "config": {
          "policy_day_param": "mandate_day",
          "window_days": 7,
          "trend_adjust": true
        }
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MaxValue",
        "config": {}
      }
    },
    {
      "name": "average_cost_per_person",
      "inputs": [
        "observable.cumulative_cost_per_person_avg_daily"
      ],
      "definition": {
        "type": "LastValue",
        "config": {}
      }
    }
  ],
  "environment": {
    "type": "network_with_locations",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "network": {
      "topology": "small_world",
      "average_degree": 10,
      "rewiring_prob": 0.1
    },
    "retailers": {
      "count": 100,
      "initial_inventory_per_capita": 2.0,
      "price_per_mask": 1.0,
      "restock_rate": 0.2
    },
    "locations": {
      "work": 500,
      "store": 100,
      "public": 50,
      "avg_capacities": {
        "work": 30,
        "store": 100,
        "public": 200
      }
    },
    "persons": {
      "age_group_distribution": {
        "0-17": 0.2,
        "18-64": 0.65,
        "65+": 0.15
      },
      "income_level_distribution": {
        "low": 0.3,
        "mid": 0.5,
        "high": 0.2
      },
      "initial_adoption_rate": 0.1,
      "mask_endowments": {
        "adopters": 1,
        "non_adopters": 0
      }
    }
  },
  "algorithms": {
    "NetworkGeneration": "Watts-Strogatz small-world or alternative topology.",
    "AdoptionDecisionLogit": "Centered logistic with utility from authority trust, risk, social norms, and fatigue.",
    "SocialNormEMA": "Exponential moving average of neighbor mask-wearing with noise.",
    "PurchaseHeuristic": "Threshold-triggered purchase with affordability and price elasticity; inventory constrained.",
    "RestockRule": "Daily proportional restocking.",
    "PolicyPrePostLift": "Compute average adoption pre- and post-mandate with linear trend adjustment within window."
  },
  "data_sources": [
    {
      "name": "adoption_timeseries.csv",
      "purpose": "Optional calibration/validation of adoption rates.",
      "fields_used": [
        "date",
        "adoption_rate"
      ]
    },
    {
      "name": "retail_sales.csv",
      "purpose": "Optional calibration of mask sales volumes.",
      "fields_used": [
        "date",
        "masks_sold"
      ]
    },
    {
      "name": "household_spend.csv",
      "purpose": "Optional validation of average spending.",
      "fields_used": [
        "date",
        "avg_mask_spend"
      ]
    }
  ],
  "code_structure": {
