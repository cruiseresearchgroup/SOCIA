        "low": 0,
        "high": 100
      },
      "owner_module": "global",
      "description": "Initial mask inventory per person.",
      "frozen": false
    },
    {
      "key": "income_log_mean",
      "dtype": "float",
      "default": 10.5,
      "bounds": {
        "low": 8.0,
        "high": 12.0
      },
      "owner_module": "global",
      "description": "Log-mean for lognormal income distribution.",
      "frozen": false
    },
    {
      "key": "income_log_std",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.1,
        "high": 2.0
      },
      "owner_module": "global",
      "description": "Log-std for lognormal income distribution.",
      "frozen": false
    },
    {
      "key": "age_mean",
      "dtype": "float",
      "default": 40.0,
      "bounds": {
        "low": 10.0,
        "high": 80.0
