  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionDecision",
      "formula_or_field": "mean(Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_by_location_type",
      "source_module": "AdoptionDecision",
      "formula_or_field": "mean(Person.mask_adoption_state) by Location.type",
      "frequency": "daily",
      "aggregation": "by_group(Location.type)",
      "target_data_field": "train_data.csv:adoption_by_location_type"
    },
    {
      "id": "observable.compliance_rate_under_mandate",
      "source_module": "AggregationAndReporting",
      "formula_or_field": "mean(mask_adoption_state among attendances where Location.mask_requirement_policy == 'mandated')",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:compliance_under_mandate"
    },
    {
      "id": "observable.inventory_stockout_flag",
      "source_module": "RetailMarket",
      "formula_or_field": "1 if any(Retailer.inventory == 0) else 0",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "retail_inventory.csv:any_stockout_flag"
    },
    {
      "id": "observable.inventory_stockout_days_cum",
      "source_module": "AggregationAndReporting",
      "formula_or_field": "cumulative sum of observable.inventory_stockout_flag",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "retail_inventory.csv:cum_stockout_days"
    },
    {
      "id": "observable.avg_masks_purchased_per_person",
      "source_module": "RetailMarket",
      "formula_or_field": "cumulative_purchases / population_size",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "retail_sales.csv:avg_masks_per_person"
    },
    {
      "id": "observable.inequality_index_of_adoption",
      "source_module": "AggregationAndReporting",
      "formula_or_field": "Gini index of adoption across income groups",
      "frequency": "daily",
      "aggregation": "scalar",
      "target_data_field": "train_data.csv:adoption_gini"
    },
    {
      "id": "observable.policy_violations_per_day",
      "source_module": "PolicyAndEnforcement",
      "formula_or_field": "count of non-compliant entries to mandated locations",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "policy_logs.csv:violations_per_day"
    },
    {
      "id": "observable.sustained_adoption_stability",
      "source_module": "AggregationAndReporting",
      "formula_or_field": "variance of adoption rate over last 7 days",
      "frequency": "daily",
      "aggregation": "variance",
      "target_data_field": "train_data.csv:adoption_stability_7d_var"
    }
  ],
  "metrics": [
    {
      "name": "overall_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "target_series": "train_data.csv:adoption_rate"
        }
      }
    },
    {
      "name": "compliance_rate_under_mandate",
      "inputs": [
        "observable.compliance_rate_under_mandate"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "target_series": "train_data.csv:compliance_under_mandate"
        }
      }
    },
    {
      "name": "time_to_reach_70_percent",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "DerivedScalarError",
        "config": {
          "transform": "first_day_threshold(0.7)",
          "target_scalar": "train_data.csv:day_to_70pct",
          "loss": "absolute_error"
        }
      }
    },
    {
      "name": "inventory_stockout_days",
      "inputs": [
        "observable.inventory_stockout_days_cum"
      ],
      "definition": {
        "type": "ScalarErrorAtHorizon",
        "config": {
          "target_scalar": "retail_inventory.csv:cum_stockout_days",
          "loss": "absolute_error"
        }
      }
    },
    {
      "name": "inequality_index_of_adoption",
      "inputs": [
        "observable.inequality_index_of_adoption"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": false,
          "target_series": "train_data.csv:adoption_gini"
        }
      }
    },
    {
      "name": "policy_violations_per_day",
      "inputs": [
        "observable.policy_violations_per_day"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "target_series": "policy_logs.csv:violations_per_day"
        }
      }
    },
    {
      "name": "sustained_adoption_stability",
      "inputs": [
        "observable.sustained_adoption_stability"
      ],
      "definition": {
        "type": "ScalarAtHorizon",
        "config": {
          "aggregation": "mean_last_7_days"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network": {
      "type_param": "network_type",
      "avg_degree_param": "avg_degree",
      "rewiring_prob_param": "rewiring_prob"
    },
    "locations": {
      "workplace_param": "num_locations_workplace",
      "transit_param": "num_locations_transit",
      "retail_param": "num_locations_retail",
      "leisure_param": "num_locations_leisure",
      "capacity_param": "location_capacity_mean"
    },
    "retailers": {
      "count_param": "retailer_count",
      "inventory_param": "retailer_initial_inventory"
    }
  },
  "algorithms": {
    "SmallWorldNetwork": "Watts-Strogatz graph generator with N=population_size, k=avg_degree, beta=rewiring_prob.",
    "PeerInfluenceUpdate": "Attitude update using neighbor adoption share and observed norms with individual social influence weights.",
    "LogisticAdoptionDecision": "Wear decision via logistic function of risk, peer norm, attitude, and availability penalty.",
    "PolicyInspectionAndPenalty": "Random inspections; penalty updates compliance with exponential decay (half-life).",
    "RetailRestockAndRationing": "Periodic restock with stochastic variability; rationing via max purchase; demand modulated by price elasticity and affordability.",
    "GiniFromGroups": "Compute Gini over adoption across income groups weighted by group sizes."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and evaluation of adoption and compliance rates.",
      "fields_used": [
        "adoption_rate",
        "adoption_by_location_type",
        "compliance_under_mandate",
        "adoption_gini",
        "adoption_stability_7d_var",
        "day_to_70pct"
      ]
    },
    {
      "name": "retail_inventory.csv",
      "purpose": "Calibration of stockout events and cumulative stockout days.",
      "fields_used": [
        "any_stockout_flag",
        "cum_stockout_days"
      ]
    },
    {
      "name": "retail_sales.csv",
      "purpose": "Validation of average masks purchased per person.",
      "fields_used": [
        "avg_masks_per_person"
      ]
    },
    {
      "name": "policy_logs.csv",
      "purpose": "Validation of daily policy violations and enforcement rates.",
      "fields_used": [
        "violations_per_day"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point; parses config, initializes model, runs simulation loop, orchestrates modules."
      },
