{
  "model_type": "agent_based",
  "description": "Agent-based, network-embedded simulation of mask adoption dynamics under social influence, policy enforcement, information campaigns, and retail supply constraints. Agents interact on a small-world social network, attend locations with policies, observe norms, update beliefs via media and authority messaging, and purchase/consume masks subject to availability and price.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "income",
        "risk_perception",
        "trust_in_authorities",
        "susceptibility_to_messaging",
        "social_influence_weight",
        "mask_attitude",
        "mask_adoption_state",
        "compliance_probability",
        "access_to_masks",
        "inventory_masks",
        "location_id",
        "network_neighbors"
      ],
      "behaviors": [
        "perceive_risk",
        "update_beliefs",
        "receive_message",
        "interact_with_peers",
        "observe_peers_in_locations",
        "decide_to_wear_mask",
        "purchase_masks",
        "attend_location",
        "comply_with_policy",
        "share_opinion"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": {
            "type": "normal",
            "mean_param": "age_mean",
            "std_param": "age_std",
            "min": 0,
            "max": 100
          },
          "income_distribution": {
            "type": "lognormal",
            "log_mean_param": "income_log_mean",
            "log_std_param": "income_log_std"
          },
          "trust_in_authorities": {
            "type": "beta_like",
            "mean_param": "trust_in_authorities_mean",
            "std": 0.15,
            "bounds": [
              0,
              1
            ]
          },
          "susceptibility_to_messaging": {
            "type": "beta_like",
            "mean_param": "susceptibility_to_messaging_mean",
            "std": 0.2,
            "bounds": [
              0,
              1
            ]
          },
          "social_influence_weight": {
            "type": "truncated_normal",
            "mean_param": "social_influence_weight_mean",
            "std_param": "social_influence_weight_std",
            "min": 0,
            "max": 1
          },
          "mask_attitude": {
            "type": "uniform",
            "low": -1,
            "high": 1
          },
          "mask_adoption_state": {
            "type": "bernoulli",
            "p_param": "initial_adoption_rate"
          },
          "compliance_probability": {
            "type": "constant",
            "value_param": "base_compliance_rate"
          },
          "inventory_masks": {
            "type": "constant_int",
            "value_param": "initial_inventory_per_person"
          }
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "mask_requirement_policy",
        "enforcement_strictness",
        "region_id",
        "opening_hours",
        "foot_traffic"
      ],
      "behaviors": [
        "admit_agent",
        "enforce_policy",
        "host_interactions",
        "display_norms"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "counts": {
            "workplace_param": "num_locations_workplace",
            "transit_param": "num_locations_transit",
            "retail_param": "num_locations_retail",
            "leisure_param": "num_locations_leisure"
          },
          "capacity_param": "location_capacity_mean",
          "enforcement_strictness_param": "location_enforcement_strictness_mean",
          "mask_requirement_policy_initial": "none"
        }
      }
    },
    {
      "name": "HealthAuthority",
      "attributes": [
        "id",
        "jurisdiction",
        "policy_state",
        "mandate_start_day",
        "fine_amount",
        "inspection_rate",
        "campaign_intensity",
        "messaging_content",
        "credibility",
        "budget"
      ],
      "behaviors": [
        "set_policy",
        "run_public_campaign",
        "conduct_inspections",
        "adjust_messaging",
        "allocate_enforcement_resources"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_start_day_param": "policy_mandate_day",
          "fine_amount_param": "fine_amount",
          "inspection_rate_param": "inspection_rate_per_day",
          "campaign_intensity_param": "campaign_intensity",
          "credibility_param": "authority_credibility",
          "budget": 100000.0
        }
      }
    },
    {
      "name": "MediaOutlet",
      "attributes": [
        "id",
        "bias",
        "credibility",
        "reach",
        "message_frequency"
      ],
      "behaviors": [
        "broadcast_message",
        "amplify_authority_guidance",
        "frame_mask_use"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "count_param": "media_outlet_count",
          "bias_distribution": {
            "type": "normal",
            "mean_param": "media_bias_mean",
            "std": 0.4,
            "min": -1,
            "max": 1
          },
          "credibility_distribution": {
            "type": "beta_like",
            "mean": 0.6,
            "std": 0.2,
            "bounds": [
              0,
              1
            ]
          },
          "reach_distribution": {
            "type": "pareto_like",
            "shape": 2.5,
            "min": 0.01,
            "max": 0.8
          },
          "message_frequency_param": "media_message_frequency"
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory",
        "reorder_threshold",
        "restock_rate",
        "price",
        "max_purchase_per_customer",
        "supply_variability"
      ],
      "behaviors": [
        "sell_masks",
        "restock",
        "adjust_price",
        "ration_sales"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "count_param": "retailer_count",
          "inventory_param": "retailer_initial_inventory",
          "reorder_threshold": 0.3,
          "restock_interval_days_param": "restock_interval_days",
          "restock_quantity_param": "restock_quantity",
          "price_param": "mask_price",
          "max_purchase_param": "max_purchase_per_customer",
          "supply_variability_param": "supply_variability"
        }
      }
    }
  ],
  "modules": [
    {
      "name": "NetworkAndMobility",
      "description": "Constructs and updates the social network; determines daily attendance at locations; computes observed norms and peer influence on attitudes.",
      "inputs": [
        "Person.mask_adoption_state",
        "Person.social_influence_weight",
        "Location.type",
        "Location.capacity",
        "Location.mask_requirement_policy"
      ],
      "outputs": [
        "Person.location_id",
        "Location.foot_traffic",
        "Person.mask_attitude",
        "observable.norms_by_location_type"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == 0: build_small_world_network(N=population_size, k=avg_degree, beta=rewiring_prob)\n# Attendance\nfor each person p:\n  # sample attendance by location type\n  types = sample_location_types(prob={workplace: attendance_rate_workplace, transit: attendance_rate_transit, retail: attendance_rate_retail, leisure: attendance_rate_leisure})\n  for each type in types:\n    loc = sample_location_of_type_with_capacity(type)\n    assign p to loc (p.location_id = loc.id)\n# Observed norms\nfor each location loc:\n  wearing_share = mean(mask_adoption_state of attendees)\n  loc.foot_traffic = count(attendees)\n  broadcast_norm(loc.type, wearing_share)\n# Peer + observation influence on attitudes\nfor each person p:\n  neighbor_mask_share = mean(mask_adoption_state of network_neighbors(p))\n  observed_share = moving_average_of_recent_norms(p, memory=carryover_norm_memory)\n  delta = peer_influence_weight * (neighbor_mask_share - sigmoid(p.mask_attitude)) + observation_effect_size * (observed_share - sigmoid(p.mask_attitude))\n  p.mask_attitude = clip(p.mask_attitude + p.social_influence_weight * delta, -3, 3)\n",
        "notes": [
          "sigmoid maps attitude to implicit adoption propensity for comparison.",
          "Capacity constraints: if a location is full, either pick another or cap attendance.",
          "Moving average memory implements norm carryover."
        ]
      },
      "requirements": [
        "graph_library",
        "random_number_generator"
      ],
      "module_parameters": [
        "network_type",
        "avg_degree",
        "rewiring_prob",
        "num_locations_workplace",
        "num_locations_transit",
        "num_locations_retail",
        "num_locations_leisure",
        "location_capacity_mean",
        "observation_effect_size",
        "peer_influence_weight",
        "carryover_norm_memory",
        "attendance_rate_workplace",
        "attendance_rate_transit",
        "attendance_rate_retail",
        "attendance_rate_leisure"
      ]
    },
    {
      "name": "InformationDiffusion",
      "description": "Broadcasts messages from health authority and media; updates individual risk perceptions and mask attitudes based on credibility and susceptibility.",
      "inputs": [
        "HealthAuthority.campaign_intensity",
        "HealthAuthority.credibility",
        "MediaOutlet.bias",
        "MediaOutlet.credibility",
        "MediaOutlet.reach",
        "Person.susceptibility_to_messaging",
        "Person.trust_in_authorities"
      ],
      "outputs": [
        "Person.risk_perception",
        "Person.mask_attitude"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t >= campaign_start_day:\n  # Authority message\n  authority_signal = campaign_intensity * authority_credibility\n  for each person p:\n    authority_weight = p.susceptibility_to_messaging * p.trust_in_authorities\n    p.risk_perception = clip(p.risk_perception + risk_perception_sensitivity * message_effect_size * authority_weight * (1 - p.risk_perception), 0, 1)\n    p.mask_attitude = clip(p.mask_attitude + message_effect_size * authority_weight, -3, 3)\n# Media messages\nfor each media m:\n  effective_reach = m.reach\n  for each person p in sample_population_by_reach(effective_reach):\n    media_weight = p.susceptibility_to_messaging * m.credibility\n    framing = sign(m.bias) * abs(m.bias)  # positive encourages, negative discourages\n    p.risk_perception = clip(p.risk_perception + risk_perception_sensitivity * media_weight * framing, 0, 1)\n    p.mask_attitude = clip(p.mask_attitude + message_effect_size * media_weight * framing, -3, 3)\n",
        "notes": [
          "Risk perception increases more when close to 0 due to (1 - rp) term.",
          "Media sampling approximates probabilistic reach. Bias can lower attitude if negative."
        ]
      },
      "requirements": [
        "random_number_generator"
      ],
      "module_parameters": [
        "campaign_start_day",
        "campaign_intensity",
        "message_effect_size",
        "risk_perception_sensitivity",
        "authority_credibility",
        "media_outlet_count",
        "media_bias_mean",
        "media_message_frequency"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Imposes mandates, sets enforcement rules; conducts inspections; updates compliance probabilities and tracks violations.",
      "inputs": [
        "HealthAuthority.policy_state",
        "Location.type",
        "Location.enforcement_strictness",
        "Person.mask_adoption_state"
      ],
      "outputs": [
        "Location.mask_requirement_policy",
        "Person.compliance_probability",
        "observable.policy_violations_per_day"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == policy_mandate_day:\n  for each location loc where loc.type in parse_types(mandate_applies_to_types):\n    loc.mask_requirement_policy = 'mandated'\n# Compliance base\nfor each person p:\n  base = base_compliance_rate\n  # effect of inspections and fines on perceived cost of non-compliance\n  expected_penalty = inspection_rate_per_day * fine_amount * policy_enforcement_strictness\n  p.compliance_probability = clip(base + fine_aversion_weight * expected_penalty, 0, 1)\n# Inspections and violations\nviolations_today = 0\nfor each location loc with loc.mask_requirement_policy == 'mandated':\n  inspected = bernoulli(inspection_rate_per_day)\n  for each attendee p at loc:\n    if p.mask_adoption_state == 0:\n      will_comply = bernoulli(p.compliance_probability * loc.enforcement_strictness)\n      if not will_comply:\n        violations_today += 1\n        if inspected:\n          # penalized; increase future compliance with memory\n          p.compliance_probability = clip(p.compliance_probability + fine_aversion_weight * fine_amount, 0, 1)\n# decay compliance boosts over time (penalty memory)\nfor each person p:\n  p.compliance_probability = base_compliance_rate + (p.compliance_probability - base_compliance_rate) * 0.5**(1/penalty_memory_halflife_days)\nemit observable.policy_violations_per_day = violations_today\n",
        "notes": [
          "Enforcement strictness at location multiplies individual compliance probability.",
          "Penalty effects decay with half-life."
        ]
      },
      "requirements": [
        "random_number_generator"
      ],
      "module_parameters": [
        "policy_mandate_day",
        "policy_enforcement_strictness",
        "fine_amount",
        "inspection_rate_per_day",
        "mandate_applies_to_types",
        "base_compliance_rate",
        "fine_aversion_weight",
        "penalty_memory_halflife_days",
        "location_enforcement_strictness_mean"
      ]
    },
    {
      "name": "RetailMarket",
      "description": "Handles retailer inventory dynamics, pricing, rationing; processes consumer purchase attempts based on demand and affordability.",
      "inputs": [
        "Retailer.inventory",
        "Retailer.price",
        "Person.inventory_masks",
        "Person.income",
        "Person.mask_adoption_state"
      ],
      "outputs": [
        "Retailer.inventory",
        "Retailer.price",
        "Person.inventory_masks",
        "observable.inventory_stockout_flag",
        "observable.avg_masks_purchased_per_person"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "# Restocking schedule\nif t % restock_interval_days == 0:\n  for each retailer r:\n    restock_amount = max(0, Normal(restock_quantity, supply_variability * restock_quantity))\n    r.inventory += int(restock_amount)\n# Price adjustments (optional elasticity-based)\nfor each retailer r:\n  demand_signal = moving_avg(daily_sales(r), window=3)\n  r.price = max(0, mask_price * (1 + 0.1 * (demand_signal > r.inventory)))\n# Purchase decisions\npurchases_today = 0\nfor each person p:\n  desired_stock = 7  # target one-week buffer\n  gap = max(0, desired_stock - p.inventory_masks)\n  if gap > 0:\n    # affordability-adjusted demand\n    affordability = 1 / (1 + exp(affordability_sensitivity * (r.price / max(1, p.income) * 1000)))\n    base_demand = gap * max(0, 1 + price_elasticity * (r.price / mask_price))\n    qty = min(max_purchase_per_customer, int(base_demand * affordability))\n    if qty > 0:\n      r = select_retailer_with_inventory(qty)\n      if r is not None:\n        actual_qty = min(qty, r.inventory)\n        r.inventory -= actual_qty\n        p.inventory_masks += actual_qty\n        purchases_today += actual_qty\n# Observables\nstockout = any(r.inventory == 0 for r in Retailers)\nemit observable.inventory_stockout_flag = 1 if stockout else 0\nupdate running average of masks purchased per person = total_purchased / population_size\n",
        "notes": [
          "Elasticity lowers demand as price rises.",
          "Affordability decreases purchases for low-income agents even at same price.",
          "Rationing enforced by max_purchase_per_customer."
        ]
      },
      "requirements": [
        "random_number_generator"
      ],
      "module_parameters": [
        "retailer_count",
        "retailer_initial_inventory",
        "restock_interval_days",
        "restock_quantity",
        "mask_price",
        "max_purchase_per_customer",
        "price_elasticity",
        "supply_variability",
        "affordability_sensitivity"
      ]
    },
    {
      "name": "AdoptionDecision",
      "description": "Determines whether each person wears a mask today given attitude, risk perception, peer norms, compliance pressure, and mask availability; consumes masks.",
      "inputs": [
        "Person.mask_attitude",
        "Person.risk_perception",
        "Person.compliance_probability",
        "Person.inventory_masks",
        "observable.norms_by_location_type"
      ],
      "outputs": [
        "Person.mask_adoption_state",
        "Person.inventory_masks",
        "observable.adoption_rate_daily",
        "observable.adoption_by_location_type"
      ],
      "dependencies": [
        "NetworkAndMobility",
        "InformationDiffusion",
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person p:\n  peer_norm = recent_norm_for_person(p)\n  # latent utility to wear mask today\n  z = decision_intercept + decision_risk_weight * p.risk_perception + decision_peer_weight * (peer_norm - 0.5) + 0.5 * tanh(p.mask_attitude)\n  # availability penalty\n  if p.inventory_masks <= 0:\n    z -= shortage_penalty_weight\n  prob = sigmoid(z)\n  wear_today = bernoulli(prob)\n  if wear_today and p.inventory_masks > 0:\n    p.mask_adoption_state = 1\n    # consume masks\n    consume = Bernoulli(min(1, masks_consumed_per_day_when_wearing)) or fractional consumption tracked via accumulator\n    p.inventory_masks = max(0, p.inventory_masks - consume)\n  else:\n    p.mask_adoption_state = 0\n# Aggregation\nadoption_rate = mean(Person.mask_adoption_state)\nemit observable.adoption_rate_daily = adoption_rate\nemit observable.adoption_by_location_type = group_mean(Person.mask_adoption_state by Person.location_id.type)\n",
        "notes": [
          "Attitude contributes via tanh to keep bounded.",
          "If no inventory, strong penalty reduces adoption probability.",
          "Mask consumption can be modeled as probabilistic daily use."
        ]
      },
      "requirements": [
        "random_number_generator"
      ],
      "module_parameters": [
        "decision_intercept",
        "decision_risk_weight",
        "decision_peer_weight",
        "shortage_penalty_weight",
        "masks_consumed_per_day_when_wearing"
      ]
    },
    {
      "name": "AggregationAndReporting",
      "description": "Computes and logs observables and derived metrics daily.",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_by_location_type",
        "observable.inventory_stockout_flag",
        "observable.policy_violations_per_day",
        "Person.income",
        "Person.mask_adoption_state"
      ],
      "outputs": [
        "observable.compliance_rate_under_mandate",
        "observable.inventory_stockout_days_cum",
        "observable.avg_masks_purchased_per_person",
        "observable.inequality_index_of_adoption",
        "observable.sustained_adoption_stability"
      ],
      "dependencies": [
        "AdoptionDecision",
        "RetailMarket",
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "# Compliance under mandate\nmandated_attendances = all person-location events where location.mask_requirement_policy == 'mandated'\nif count(mandated_attendances) > 0:\n  compliance_rate = mean(mask_adoption_state among mandated_attendances)\nelse:\n  compliance_rate = NaN\nemit observable.compliance_rate_under_mandate = compliance_rate\n# Inventory stockout days cumulative\ncum_stockout_days += observable.inventory_stockout_flag\nemit observable.inventory_stockout_days_cum = cum_stockout_days\n# Average masks purchased per person maintained by RetailMarket module's running total\nemit observable.avg_masks_purchased_per_person = running_total_purchases / population_size\n# Inequality index of adoption across income quintiles\nassign income_quintile = quantile(Person.income, q=gini_income_groups)\nadopt_rate_by_quantile = mean(mask_adoption_state by income_quintile)\nG = gini_from_group_rates(adopt_rate_by_quantile, group_weights)\nemit observable.inequality_index_of_adoption = G\n# Sustained adoption stability (7-day variance)\nif t >= 6:\n  emit observable.sustained_adoption_stability = variance(last_7(observable.adoption_rate_daily))\nelse:\n  emit observable.sustained_adoption_stability = NaN\n",
        "notes": [
          "Gini computed over group-level adoption incidence weighted by group population shares.",
          "Uses rolling windows for stability."
        ]
      },
      "requirements": [
        "time_series_buffer"
      ],
      "module_parameters": [
        "gini_income_groups"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 100,
        "high": 200000
      },
      "owner_module": "global",
      "description": "Number of Person agents.",
      "frozen": false
    },
    {
      "key": "simulation_horizon_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 30,
        "high": 3650
      },
