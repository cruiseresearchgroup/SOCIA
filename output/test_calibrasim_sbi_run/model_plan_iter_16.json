  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network_topology": "scale_free",
    "average_degree": 8,
    "group_count": 3,
    "num_locations": {
      "work": 10,
      "retail": 6,
      "transit": 4,
      "other": 5
    },
    "num_retailers": 2
  },
  "algorithms": {
    "BarabasiAlbert": "Generates a scale-free graph with preferential attachment (m \u2248 average_degree/2).",
    "Sigmoid": "sigmoid(x) = 1/(1+exp(-x)); used for mapping to probabilities.",
    "GiniCoefficient": "Gini for array x: G = sum_i sum_j |x_i - x_j| / (2 n sum_i x_i).",
    "Clamping": "clamp01(x) ensures values remain in [0,1]."
  },
  "data_sources": [
    {
      "name": "mask_adoption_observed.csv",
