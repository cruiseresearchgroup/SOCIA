  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "mask_adoption_observed.csv:adoption_rate"
    },
    {
      "id": "observable.location_compliance_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(location_compliance_events.will_comply)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "location_checks.csv:compliance_rate"
    },
    {
      "id": "observable.stockout_frequency_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(retailer.stock==0)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "retail_inventory.csv:stockout_flag"
    },
    {
      "id": "observable.penalty_events_per_capita_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "count(penalty_events)/num_agents",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "enforcement_records.csv:penalties_per_capita"
    },
    {
      "id": "observable.message_reach_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.message_exposure_today)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "media_logs.csv:reach_rate"
    },
    {
      "id": "observable.inequality_in_adoption_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "gini(mean_adoption_by_group)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "survey_by_group.csv:adoption_gini"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "time_to_50_percent_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.5
        }
      }
    },
    {
      "name": "sustained_adoption_after_policy",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "MeanOverWindow",
        "config": {
          "start_day": 121,
          "end_day": 134
        }
      }
    },
    {
      "name": "location_compliance_rate",
      "inputs": [
        "observable.location_compliance_rate_daily"
      ],
      "definition": {
        "type": "Mean",
        "config": {}
      }
    },
