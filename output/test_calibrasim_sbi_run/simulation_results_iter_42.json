{
  "simulation": "opinion_dynamics",
  "random_seed": 42,
  "agents": {
    "count": 500,
    "stubborn_fraction": 0.05,
    "initial_opinions": {
      "distribution": "gaussian",
      "mean": 0.0,
      "std": 1.0,
      "clip": [
        -1.0,
        1.0
      ]
    }
  },
  "network": {
    "type": "scale_free",
    "model": "barabasi_albert",
    "m": 3
  },
  "dynamics": {
    "model": "degroot",
    "noise_std": 0.02,
    "stubborn_retention": 0.9
  },
  "timesteps": 150,
  "interventions": [
    {
      "t": 75,
      "type": "broadcast_shift",
      "target": "top_degree_percentile",
      "percentile": 95,
      "shift": 0.3
    }
  ],
  "metrics": [
    "mean",
    "std",
    "polarization"
  ]
}