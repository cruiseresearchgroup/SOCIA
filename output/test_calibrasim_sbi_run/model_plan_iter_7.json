  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "Aggregation",
      "formula_or_field": "mean(Person.adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.new_adopters_daily",
      "source_module": "Aggregation",
      "formula_or_field": "sum(transition(Person.adoption_state, 0->1))",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:new_adopters"
    },
    {
      "id": "observable.adoption_rate_by_group_daily",
      "source_module": "Aggregation",
      "formula_or_field": "by_group(Person.group_id, mean(Person.adoption_state))",
      "frequency": "daily",
      "aggregation": "by_group(group_id)",
      "target_data_field": "train_data.csv:adoption_rate_by_group"
    }
