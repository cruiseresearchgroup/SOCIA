  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_by_location_type_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(location_type, mean(mask_use_while_present))",
      "frequency": "daily",
      "aggregation": "by_group(location_type)",
      "target_data_field": "train_data_by_loc.csv:adoption_rate_by_location_type"
    },
    {
      "id": "observable.attitude_mean_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.attitude_toward_masks)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "survey.csv:attitude_mean"
    },
    {
      "id": "observable.mask_availability_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Retailer.inventory)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "retailer_inventory.csv:avg_inventory"
    },
    {
      "id": "observable.penalties_issued_daily",
      "source_module": "PolicyModule",
      "formula_or_field": "count(enforcement.events)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "enforcement.csv:penalties"
    },
    {
      "id": "observable.misinformation_share_daily",
      "source_module": "InformationExposureModule",
      "formula_or_field": "misinformation_messages / total_messages",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "info_logs.csv:misinformation_share"
    },
    {
      "id": "observable.adoption_rate_daily_counterfactual",
      "source_module": "CounterfactualManager",
      "formula_or_field": "mean(Person.mask_adoption_state) in cf run",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": ""
    }
  ],
  "metrics": [
    {
      "name": "OverallAdoption_RMSE",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "TimeToThreshold70",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.7
        }
      }
    },
    {
      "name": "AdoptionByLocation_MAE",
      "inputs": [
        "observable.adoption_by_location_type_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "by_group": "location_type",
          "normalize": false
        }
      }
    },
    {
      "name": "PolicyEffectiveness_DiffAtEnd",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_rate_daily_counterfactual"
      ],
      "definition": {
        "type": "DifferenceAtEnd",
        "config": {
          "series1": 0,
          "series2": 1
        }
      }
    },
    {
      "name": "AttitudeShift_AvgChange",
      "inputs": [
        "observable.attitude_mean_daily"
      ],
      "definition": {
        "type": "ChangeBetween",
        "config": {
          "start_day": 0,
          "end_day": 119
        }
      }
    },
    {
      "name": "DisparityIndex_GiniByIncome",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "GiniByGroup",
        "config": {
          "grouping": "income_tertiles",
          "day": 119
        }
      }
    },
    {
      "name": "MaskAvailability_RMSE",
      "inputs": [
        "observable.mask_availability_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "PenaltiesIssued_Total",
      "inputs": [
        "observable.penalties_issued_daily"
      ],
      "definition": {
        "type": "SumOverPeriod",
        "config": {
          "start_day": 0,
          "end_day": 119
        }
      }
    },
    {
      "name": "MisinformationExposure_MAE",
      "inputs": [
        "observable.misinformation_share_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "normalize": false
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 10000,
    "random_seed": 42,
    "assign_regions": "uniform across num_regions",
    "create_locations": {
      "homes": "one per person household proxy (not explicitly simulated for capacity)",
      "work_locations_per_1000": 10,
      "public_locations_per_1000": 5,
      "capacity_scale": 1.0
    },
    "create_retailers": {
      "retailers_per_1000": 0.5,
      "initial_inventory_per_capita": 1.0,
      "base_price": 2.0,
      "price_markup": 0.25
    },
    "social_network": {
      "type": "small_world",
      "avg_degree": 8,
      "rewiring_prob": 0.1,
      "homophily_by_attitude": 0.3,
      "edge_weight_mean": 1.0,
      "edge_weight_sd": 0.3
    },
    "initial_adoption": 0.1
  },
  "algorithms": {
    "small_world_generation": "Watts-Strogatz model with homophily-aware rewiring",
    "opinion_dynamics": "Weighted averaging (Friedkin\u2013Johnsen-like) for attitudes and risk",
    "adoption_decision": "Logistic probability integrating attitude, risk, policy, and norms with habit/forgetting",
    "movement_scheduling": "Simple daily schedule (home-work/public-home) with Bernoulli participation",
    "enforcement": "Bernoulli detection with policy/location scaling; penalties aggregated daily",
    "market_supply": "Inventory restock proportional to expected sales; price adjusts with demand pressure and subsidies",
    "counterfactual": "Parallel run with policy toggled off and shared RNG streams for causal contrast"
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Daily overall adoption calibration and evaluation",
      "fields_used": [
        "date",
        "adoption_rate"
      ]
    },
    {
      "name": "train_data_by_loc.csv",
      "purpose": "By-location adoption prevalence calibration",
      "fields_used": [
        "date",
        "location_type",
        "adoption_rate"
      ]
    },
    {
      "name": "retailer_inventory.csv",
      "purpose": "Retail inventory levels by day",
      "fields_used": [
        "date",
        "avg_inventory"
      ]
    },
    {
      "name": "enforcement.csv",
      "purpose": "Penalties issued per day",
      "fields_used": [
        "date",
        "penalties"
      ]
    },
    {
      "name": "info_logs.csv",
      "purpose": "Share of misinformation exposure over time",
      "fields_used": [
        "date",
        "misinformation_share"
      ]
    },
    {
      "name": "survey.csv",
      "purpose": "Population mean mask attitude over time",
      "fields_used": [
        "date",
        "attitude_mean"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point; runs scenarios and orchestrates modules per tick."
      },
      {
        "name": "entities.py",
        "description": "Data classes for Person, Location, Retailer, PolicyMaker, InformationSource."
      },
      {
        "name": "network.py",
        "description": "SocialNetworkBuilder module implementation and network utilities."
      },
      {
        "name": "information.py",
        "description": "InformationExposureModule and message handling/logging."
      },
      {
        "name": "policy.py",
        "description": "PolicyModule logic for mandates, enforcement, allocations."
      },
      {
        "name": "movement.py",
        "description": "MovementAndNormsModule including occupancy and norm calculations."
      },
      {
        "name": "market.py",
        "description": "MarketSupplyModule with inventory, pricing, and purchasing."
      },
      {
        "name": "adoption.py",
        "description": "PeerInfluenceAndAdoptionModule implementation."
      },
      {
        "name": "aggregation.py",
        "description": "AdoptionAggregator and metric preparation."
      },
      {
        "name": "counterfactual.py",
        "description": "CounterfactualManager and state cloning utilities."
      },
      {
        "name": "utils.py",
        "description": "Random streams, math helpers (sigmoid, gini), configuration loader."
      },
      {
        "name": "config.py",
        "description": "Parameter definitions, bounds, and defaults; validation (e.g., pydantic)."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy",
      "numba",
      "pydantic"
    ]
  },
  "prediction_period": {
    "start_day": 30,
    "end_day": 39
  },
  "evaluation_metrics": [
    "overall_adoption_rate",
    "time_to_threshold",
    "adoption_by_location_type",
    "policy_effectiveness",
    "attitude_shift",
    "disparity_index",
    "mask_availability",
    "penalties_issued",
    "misinformation_exposure"
  ]
}