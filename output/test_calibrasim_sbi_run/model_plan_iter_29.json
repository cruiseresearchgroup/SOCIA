{
  "model_type": "agent_based",
  "description": "Agent-based, networked diffusion model of mask-wearing behavior under peer influence, information exposure, market constraints, and policy interventions. Agents interact over a small-world social network and in shared locations with policy enforcement and supply dynamics.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "health_risk_level",
        "attitude_toward_masks",
        "trust_in_authorities",
        "social_influence_susceptibility",
        "conformity_bias",
        "perceived_risk",
        "mask_adoption_state",
        "compliance_propensity",
        "income",
        "access_to_masks",
        "home_location_id",
        "work_location_id",
        "daily_schedule",
        "information_sources",
        "region_id"
      ],
      "behaviors": [
        "decide_adoption",
        "update_perceived_risk",
        "interact_with_peers",
        "move_between_locations",
        "receive_information",
        "purchase_masks",
        "comply_with_policy",
        "share_opinion"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "age_distribution": {
            "under18": 0.22,
            "18to64": 0.63,
            "65plus": 0.15
          },
          "health_risk_probs": {
            "low": 0.6,
            "medium": 0.3,
            "high": 0.1
          },
          "attitude_toward_masks": {
            "distribution": "truncated_normal",
            "mean": 0.0,
            "sd": 0.6,
            "low": -1.0,
            "high": 1.0
          },
          "trust_in_authorities": {
            "distribution": "beta",
            "alpha": 2.0,
            "beta": 2.0
          },
          "social_influence_susceptibility": {
            "distribution": "beta",
            "alpha": 2.5,
            "beta": 2.5
          },
          "conformity_bias": {
            "distribution": "beta",
            "alpha": 3.0,
            "beta": 2.0
          },
          "compliance_propensity": {
            "distribution": "beta",
            "alpha": 3.0,
            "beta": 3.0
          },
          "income": {
            "distribution": "lognormal",
            "mu": 10.3,
            "sigma": 0.7
          },
          "initial_adoption_rate": 0.1,
          "information_sources": {
            "pro_mask_media_prob": 0.6,
            "neutral_media_prob": 0.3,
            "anti_mask_media_prob": 0.1,
            "social_media_follow_prob": 0.7,
            "num_sources_per_person": {
              "distribution": "poisson",
              "lambda": 3.0
            }
          },
          "daily_schedule": {
            "type": "simple",
            "work_participation_rate": 0.7,
            "public_visit_prob": 0.6
          },
          "region_assignment": {
            "num_regions": 5,
            "method": "uniform"
          }
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "region_id",
        "policy_enforcement_level",
        "mask_availability",
        "current_occupancy"
      ],
      "behaviors": [
        "enforce_policy",
        "host_interactions",
        "update_availability"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "types": [
            "home",
            "work",
            "public"
          ],
          "num_work_locations_per_1000": 10,
          "num_public_locations_per_1000": 5,
          "capacity_scale": 1.0,
          "policy_enforcement_level_mean": 0.5
        }
      }
    },
    {
      "name": "PolicyMaker",
      "attributes": [
        "id",
        "policy_state",
        "mandate_start_day",
        "enforcement_strength",
        "fine_amount",
        "campaign_intensity",
        "communication_trustworthiness"
      ],
      "behaviors": [
        "issue_policy",
        "adjust_policy",
        "run_campaign",
        "allocate_masks"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_start_day": 30,
          "enforcement_strength": 0.6,
          "fine_amount": 50.0,
          "campaign_intensity": 0.5,
          "communication_trustworthiness": 0.7,
          "allocation_priority_to_low_inventory": 0.7
        }
      }
    },
    {
      "name": "InformationSource",
      "attributes": [
        "id",
        "type",
        "message_bias",
        "reach",
        "credibility",
        "misinformation_rate",
        "targeting_rules"
      ],
      "behaviors": [
        "broadcast_message",
        "target_audience"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "types": [
            "official",
            "news",
            "social_media",
            "peer"
          ],
          "reach_distribution": "lognormal",
          "credibility_mean": 0.6,
          "misinformation_rate": 0.1,
          "message_bias_variance": 0.4
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory",
        "price",
        "restock_rate",
        "region_id"
      ],
      "behaviors": [
        "supply_masks",
        "adjust_price",
        "fulfill_demand"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "retailers_per_1000": 0.5,
          "initial_inventory_per_capita": 1.0,
          "base_price": 2.0,
          "price_markup": 0.25,
          "restock_rate": 0.1
        }
      }
    },
    {
      "name": "SocialNetwork",
      "attributes": [
        "graph_type",
        "degree_distribution",
        "homophily_params",
        "edge_weight_distribution"
      ],
      "behaviors": [
        "connect_agents",
        "update_ties"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "graph_type": "small_world",
          "avg_degree": 8,
          "rewiring_prob": 0.1,
          "homophily_by_attitude": 0.3,
          "edge_weight_mean": 1.0,
          "edge_weight_sd": 0.3
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialNetworkBuilder",
      "description": "Generates and updates the social network with homophily and edge weights.",
      "inputs": [
        "person.attributes.attitude_toward_masks",
        "person.attributes.region_id"
      ],
      "outputs": [
        "network.graph",
        "network.edge_weights"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == 0:\n  G = watts_strogatz(n=population_size, k=avg_degree, p=rewiring_prob)\n  assign edge weights wij ~ LogNormal(mean=edge_weight_mean, sd=edge_weight_sd)\n  rewire edges to increase homophily: with prob (homophily_by_attitude) connect nodes with similar attitudes\nelse with prob tie_update_rate:\n  update edge weights: wij = wij * (1 - tie_update_rate) + noise\n  optionally rewire a small fraction of edges to maintain degree",
        "notes": [
          "Homophily implemented by triadic closure or rewiring heuristic minimizing attitude distance.",
          "Edge weights scale peer influence in opinion dynamics."
        ]
      },
      "requirements": [
        "networkx",
        "numpy.random"
      ],
      "module_parameters": [
        "network_type",
        "avg_degree",
        "rewiring_prob",
        "homophily_by_attitude",
        "tie_update_rate",
        "edge_weight_mean",
        "edge_weight_sd"
      ]
    },
    {
      "name": "InformationExposureModule",
      "description": "Simulates broadcast and targeted information exposure; updates person attitudes and perceived risk via message integration.",
      "inputs": [
        "policy.campaign_intensity",
        "policy.communication_trustworthiness"
      ],
      "outputs": [
        "info.delta_attitude",
        "info.delta_perceived_risk",
        "observable.misinformation_share_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  msgs = sample_messages_from_sources(i.information_sources)\n  for each msg in msgs:\n    credibility = source.credibility * (1 + authority_trust_weight * i.trust_in_authorities if source.type == 'official' else 1)\n    if source.type == 'official':\n      credibility *= policy.communication_trustworthiness\n      msg.bias += policy.campaign_intensity * sign(pro-mask)\n    misinformation_flag = Bernoulli(misinformation_rate for source.type)\n    effect_weight = information_effect_weight * credibility * i.social_influence_susceptibility\n    delta_att += effect_weight * msg.bias\n    delta_risk += effect_weight * (msg.bias > 0 ? +1 : -1) * trust_elasticity\n  apply decay: i.attitude_toward_masks = clamp(i.attitude_toward_masks * (1 - info_decay_rate) + delta_att, -1, 1)\n  i.perceived_risk = clamp(i.perceived_risk * (1 - info_decay_rate) + delta_risk, 0, 1)\ncollect daily misinformation share = (#misinformation msgs) / (total msgs)",
        "notes": [
          "Message bias positive favors mask-wearing; negative discourages.",
          "Trust elasticity maps credibility and personal trust to risk and attitude shifts."
        ]
      },
      "requirements": [
        "random_stream",
        "per-person source lists"
      ],
      "module_parameters": [
        "information_effect_weight",
        "misinformation_rate",
        "average_source_credibility",
        "media_bias_variance",
        "info_decay_rate",
        "trust_elasticity",
        "authority_trust_weight"
      ]
    },
    {
      "name": "PolicyModule",
      "description": "Issues recommendations/mandates, sets enforcement and campaigns, and allocates masks/subsidies.",
      "inputs": [
        "observable.adoption_rate_daily",
        "market.retailer_inventory_summary"
      ],
      "outputs": [
        "policy.state",
        "policy.enforcement_params",
        "policy.campaign_intensity",
        "policy.communication_trustworthiness",
        "policy.allocations",
        "observable.penalties_issued_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day >= mandate_start_day:\n  policy.state = 'mandate'\nelse:\n  policy.state = 'recommendation'\npolicy.enforcement_params = {strength: enforcement_strength, fine: fine_amount, detection_base: penalty_detection_base, compliance_variance: compliance_variance}\npolicy.campaign_intensity = campaign_intensity\npolicy.communication_trustworthiness = policy_communication_trustworthiness\n# Allocation: prioritize regions/retailers with lowest inventory\npolicy.allocations = allocate_masks(subsidy=subsidy_per_mask, priority_weight=allocation_priority_to_low_inventory)\n# Penalties issued accumulated from MovementAndNormsModule enforcement events (sum per day)",
        "notes": [
          "Mandate start is a fixed day; adjust_policy hooks can be added for adaptive policies.",
          "Allocations return a mapping retailer_id->extra_stock and/or coupon subsidies."
        ]
      },
      "requirements": [
        "access to daily adoption and inventory summaries"
      ],
      "module_parameters": [
        "mandate_start_day",
        "enforcement_strength",
        "fine_amount",
        "policy_effect_weight",
        "campaign_intensity",
        "policy_communication_trustworthiness",
        "penalty_detection_base",
        "subsidy_per_mask",
        "compliance_variance",
        "allocation_priority_to_low_inventory"
      ]
    },
    {
      "name": "MovementAndNormsModule",
      "description": "Moves people across locations per schedules, computes local mask prevalence norms, and executes on-site enforcement.",
      "inputs": [
        "policy.enforcement_params",
        "policy.state",
        "locations.state"
      ],
      "outputs": [
        "locations.occupancy",
        "norms.local_prevalence",
        "enforcement.events"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  # Determine today's itinerary\n  at_work = Bernoulli(work_participation_rate and i.work_location_id exists)\n  visit_public = Bernoulli(public_visit_prob)\n  locs_today = [home] + ([work] if at_work) + ([public] if visit_public)\n  for loc in locs_today:\n    if capacity not exceeded:\n      enter(loc); update occupancy\n      # Observe norm and update immediate compliance intent\n      local_prev = current_mask_prevalence(loc)\n      norm_effect = norm_sensitivity * (local_prev - 0.5) * i.conformity_bias\n      i.perceived_risk += risk_from_local_prevalence_weight * local_prev\n      # Enforcement\n      if policy.state == 'mandate' and i.mask_adoption_state == 0:\n        detect = Bernoulli(policy.enforcement_params.detection_base * loc.policy_enforcement_level * policy.enforcement_params.strength)\n        if detect:\n          add enforcement event (penalty=fine_amount)\n      leave(loc)",
        "notes": [
          "Local prevalence is computed from concurrent occupants' mask states.",
          "Norm effect influences short-term intent that feeds into adoption decision."
        ]
      },
      "requirements": [
        "location capacities",
        "per-location policy levels"
      ],
      "module_parameters": [
        "schedule_type",
        "norm_sensitivity",
        "public_visit_prob",
        "work_participation_rate",
        "location_capacity_scale",
        "location_policy_enforcement_level_mean",
        "risk_from_local_prevalence_weight",
        "num_work_locations_per_1000",
        "num_public_locations_per_1000"
      ]
    },
    {
      "name": "MarketSupplyModule",
      "description": "Manages retailer inventory, pricing, fulfillment, and updates agents' access_to_masks.",
      "inputs": [
        "policy.allocations",
        "person.demand_signals"
      ],
      "outputs": [
        "retailer.inventory",
        "market.prices",
        "person.access_to_masks",
        "market.retailer_inventory_summary"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "# Restock and price adjustments\nfor each retailer r:\n  r.inventory += restock_rate * expected_daily_sales\n  r.price = mask_cost * (1 + price_markup) + max(0, demand_pressure) * 0.1\n  apply policy allocations and subsidies where provided\n# Fulfill demand\nfor each person i with demand:\n  affordability = sigmoid(affordability_weight * (i.income - r.price))\n  purchase = min(available_inventory, Bernoulli(affordability))\n  update i.access_to_masks and r.inventory\naggregate inventory summary by region",
        "notes": [
          "Demand_pressure can be proxied by recent stockouts.",
          "Subsidies reduce effective price for eligible buyers."
        ]
      },
      "requirements": [
        "retailer list by region",
        "person demand signal"
      ],
      "module_parameters": [
        "mask_cost",
        "initial_mask_inventory_per_capita",
        "restock_rate",
        "price_markup",
        "price_elasticity",
        "retailer_per_1000",
        "affordability_weight",
        "num_regions"
      ]
    },
    {
      "name": "PeerInfluenceAndAdoptionModule",
      "description": "Integrates peer influence, risk, policy effects, and access constraints to update adoption states.",
      "inputs": [
        "network.graph",
        "network.edge_weights",
        "info.delta_attitude",
        "info.delta_perceived_risk",
        "norms.local_prevalence",
        "policy.state",
        "policy.enforcement_params",
        "person.access_to_masks"
      ],
      "outputs": [
        "person.mask_adoption_state",
        "person.attitude_toward_masks",
        "person.perceived_risk"
      ],
      "dependencies": [
        "SocialNetworkBuilder",
        "InformationExposureModule",
        "MovementAndNormsModule",
        "PolicyModule",
        "MarketSupplyModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  # Update attitudes and risk already adjusted by info module\n  # Peer influence via weighted neighborhood average adoption and attitudes\n  neigh = neighbors(i)\n  peer_adopt = sum(wij * mask_state[j]) / sum(wij)\n  peer_att = sum(wij * attitude[j]) / sum(wij)\n  i.attitude_toward_masks = clamp(i.attitude_toward_masks + peer_influence_weight * (peer_att - i.attitude_toward_masks), -1, 1)\n  i.perceived_risk = clamp(i.perceived_risk + risk_perception_weight * (peer_adopt - 0.5), 0, 1)\n  # Policy pressure term\n  policy_term = (policy.state == 'mandate') ? policy_effect_weight * (policy.enforcement_params.strength) : 0\n  # Availability constraint\n  has_mask = (i.access_to_masks > 0)\n  # Adoption probability (logit)\n  x = logit(baseline_adoption_probability) + 2.0*i.attitude_toward_masks + 1.5*i.perceived_risk + policy_term + 1.0*(norms.local_prevalence_for_i - 0.5)\n  p_adopt = sigmoid(x)\n  # Habit and forgetting\n  if i.mask_adoption_state == 1:\n    p_stay = min(1.0, 1 - forgetting_rate + habit_formation_rate)\n    new_state = Bernoulli(p_stay)\n  else:\n    new_state = Bernoulli(p_adopt) if has_mask else 0\n  i.mask_adoption_state = new_state\n  if new_state == 1: i.access_to_masks -= 1\n",
        "notes": [
          "Sigmoid/logit scales combine determinants; weights can be calibrated.",
          "Access constraint enforces supply dependence on adoption."
        ]
      },
      "requirements": [
        "adjacency queries",
        "edge weights",
        "local norm lookups"
      ],
      "module_parameters": [
        "baseline_adoption_probability",
        "peer_influence_weight",
        "risk_perception_weight",
        "habit_formation_rate",
        "forgetting_rate"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates observables and prepares series for evaluation.",
      "inputs": [
        "person.mask_adoption_state",
        "person.attitude_toward_masks",
        "retailer.inventory",
        "enforcement.events",
        "InformationExposureModule.msg_log"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_by_location_type_daily",
        "observable.attitude_mean_daily",
        "observable.mask_availability_daily",
        "observable.penalties_issued_daily",
        "observable.misinformation_share_daily"
      ],
      "dependencies": [
        "PeerInfluenceAndAdoptionModule",
        "MarketSupplyModule",
        "MovementAndNormsModule",
        "InformationExposureModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "overall_adoption = mean(i.mask_adoption_state over i)\nby_location = {home: mean(mask in home contexts), work: mean(mask in work contexts), public: mean(mask in public contexts)}\nattitude_mean = mean(i.attitude_toward_masks)\nmask_avail = mean(r.inventory over retailers)\npenalties_daily = count(enforcement.events today)\nmisinfo_share = (misinformation messages today) / (total messages today)\nemit all observables",
        "notes": [
          "By-location adoption computed from time-weighted mask usage during presence at locations.",
          "Misinformation share is taken from the InformationExposureModule's daily message log."
        ]
      },
      "requirements": [
        "access to daily logs and states"
      ],
      "module_parameters": [
        "adoption_threshold_metric",
        "metrics_time_window_days"
      ]
    },
    {
      "name": "CounterfactualManager",
      "description": "Runs a parallel counterfactual scenario with policy disabled to estimate policy effects.",
      "inputs": [
        "initial_state.snapshot"
      ],
      "outputs": [
        "observable.adoption_rate_daily_counterfactual"
      ],
      "dependencies": [
        "SocialNetworkBuilder",
        "InformationExposureModule",
        "MovementAndNormsModule",
        "MarketSupplyModule",
        "PeerInfluenceAndAdoptionModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if enable_counterfactual:\n  clone initial state at t=0\n  set policy_effect_weight=0, mandate_start_day=inf, enforcement_strength=0 in cloned run\n  simulate in lockstep for simulation_days using same random_seed streams\n  record adoption_rate_daily_counterfactual series",
        "notes": [
          "Lockstep simulation with shared random streams isolates policy effect.",
          "Counterfactual uses identical supply and information sequences except policy levers."
        ]
      },
      "requirements": [
        "ability to clone state and control RNG streams"
      ],
      "module_parameters": [
        "enable_counterfactual"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 10000,
      "bounds": {
        "low": 1000,
        "high": 200000
      },
      "owner_module": "global",
      "description": "Number of agents in the simulation.",
      "frozen": "true"
    },
    {
      "key": "simulation_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Number of days to simulate.",
      "frozen": "true"
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "Random seed.",
      "frozen": "true"
    },
    {
      "key": "time_step_days",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.5,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Length of each simulation tick in days.",
      "frozen": "true"
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "SocialNetworkBuilder",
      "description": "Type of social network (small_world).",
      "frozen": "true"
    },
    {
      "key": "avg_degree",
      "dtype": "int",
      "default": 8,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "SocialNetworkBuilder",
      "description": "Average degree in the social network.",
      "frozen": "false"
    },
    {
      "key": "rewiring_prob",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "SocialNetworkBuilder",
      "description": "Watts-Strogatz rewiring probability.",
      "frozen": "false"
    },
    {
      "key": "homophily_by_attitude",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "SocialNetworkBuilder",
      "description": "Homophily strength by mask attitude.",
      "frozen": "false"
    },
    {
      "key": "tie_update_rate",
      "dtype": "float",
      "default": 0.01,
      "bounds": {
        "low": 0.0,
        "high": 0.2
      },
      "owner_module": "SocialNetworkBuilder",
      "description": "Daily probability to update or rewire ties.",
      "frozen": "false"
    },
    {
      "key": "edge_weight_mean",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.1,
        "high": 2.0
      },
      "owner_module": "SocialNetworkBuilder",
      "description": "Mean of edge weight distribution.",
      "frozen": "false"
    },
    {
      "key": "edge_weight_sd",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "SocialNetworkBuilder",
      "description": "Std. dev. of edge weight distribution.",
      "frozen": "false"
    },
    {
      "key": "initial_adoption_rate",
      "dtype": "float",
      "default": 0.1,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "Initial fraction of people wearing masks.",
      "frozen": "false"
    },
    {
      "key": "baseline_adoption_probability",
      "dtype": "float",
      "default": 0.02,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
