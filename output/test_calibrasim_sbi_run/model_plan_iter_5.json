  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_use_state) over all persons",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.policy_compliance_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(mask_use_state for visits where Location.enforces_mask_policy==true)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:policy_compliance_rate"
    },
    {
      "id": "observable.purchase_backlog_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "sum(unmet_purchase_attempts) per day",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:unmet_demand"
    },
    {
      "id": "observable.inventory_avg_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Retailer.inventory_level)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:avg_inventory"
    },
    {
      "id": "observable.access_inequality_index_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "Gini across SES groups of P(has_mask)",
      "frequency": "daily",
      "aggregation": "custom",
      "target_data_field": "train_data.csv:access_inequality_index"
    },
    {
      "id": "observable.sentiment_polarization_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "variance(Person.attitude_toward_masks)",
      "frequency": "daily",
      "aggregation": "variance",
      "target_data_field": "train_data.csv:attitude_polarization"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_Adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "RMSE_Compliance",
      "inputs": [
        "observable.policy_compliance_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAPE_Backlog",
      "inputs": [
        "observable.purchase_backlog_daily"
      ],
      "definition": {
        "type": "MAPE",
        "config": {
          "epsilon": 1e-06
        }
      }
    },
    {
      "name": "TimeTo50PercentAdoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Custom",
        "config": {
          "function": "first_day_ma_ge_threshold",
          "window": 7,
          "threshold": 0.5
        }
      }
    },
    {
      "name": "PeakAdoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Max",
        "config": {}
      }
    },
    {
      "name": "EndlineAdoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "LastValue",
        "config": {}
      }
    },
    {
      "name": "GiniAccessInequality",
      "inputs": [
        "observable.access_inequality_index_daily"
      ],
      "definition": {
        "type": "LastValue",
        "config": {}
      }
    },
    {
      "name": "PolarizationVariance",
      "inputs": [
        "observable.sentiment_polarization_daily"
      ],
      "definition": {
        "type": "LastValue",
        "config": {}
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network": {
      "type": "WattsStrogatz",
      "k": 10,
      "p": 0.05
    },
    "locations": {
      "workplace_count": 300,
      "public_location_count": 200,
      "households_count": 1500,
      "capacity_scale": 30.0
    },
    "retailers": {
      "retailer_count": 25,
      "total_initial_inventory": 2000,
      "restock_rate_per_day": 200,
      "mask_price": 1.0
    },
    "policy": {
      "level": "none",
      "start_day": 15,
      "end_day": 90,
      "enforcement_probability": 0.3,
      "fine_amount": 50.0
    },
    "media": {
      "orientation": "pro_mask",
      "intensity": 0.5,
      "misinformation_rate": 0.1,
      "reach_fraction": 0.7
    }
  },
  "algorithms": {
    "NetworkGeneration": "Watts-Strogatz small-world graph (networkx.watts_strogatz_graph) with k=average_degree, p=small_world_rewire_p.",
    "SocialUpdate": "DeGroot-like weighted averaging with nonlinearity via sigmoid and conformity bias.",
    "PolicyActivation": "Deterministic schedule for policy; stochastic enforcement via Bernoulli trials.",
    "LocationVisits": "Stochastic schedule sampling by fractions and capacities; assign to nearest available locations.",
    "MaskPurchase": "Demand-based Bernoulli purchase with SES multipliers and price elasticity; retailer restocking.",
    "GiniComputation": "Gini coefficient of group-level mask possession probabilities.",
    "MetricComputation": "Rolling window checks for sustained thresholds; extrema and endline extraction."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and evaluation of adoption, compliance, inventory, inequality, and polarization time series.",
      "fields_used": [
        "adoption_rate",
        "policy_compliance_rate",
        "unmet_demand",
        "avg_inventory",
        "access_inequality_index",
        "attitude_polarization"
      ]
    }
  ],
  "code_structure": {
    "files": [
      {
        "name": "main.py",
        "description": "Entry point: parse config, initialize model, run simulation loop, emit outputs."
      },
      {
        "name": "entities.py",
