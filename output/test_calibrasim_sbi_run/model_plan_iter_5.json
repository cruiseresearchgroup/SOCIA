{
  "model_type": "agent_based",
  "description": "Agent-based, network-embedded diffusion model of mask-wearing behavior under social influence, media messaging, retail supply constraints, and government policy enforcement. Persons interact across a small-world social network and visit locations (home, work, public) with possible mandates. Retailers manage inventory and pricing. Government and media shape incentives and attitudes. The model outputs adoption and compliance dynamics plus inequality and polarization indicators.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "household_id",
        "socioeconomic_status",
        "health_risk_level",
        "risk_perception",
        "attitude_toward_masks",
        "trust_in_authorities",
        "susceptibility_to_influence",
        "conformity_bias",
        "political_identity",
        "access_to_masks",
        "has_mask",
        "mask_use_state",
        "compliance_propensity",
        "social_neighbors",
        "workplace_id",
        "last_fined_day",
        "last_enforcement_event_day",
        "opinion_signal"
      ],
      "behaviors": [
        "update_risk_perception",
        "decide_mask_use",
        "communicate_opinion",
        "interact_in_location",
        "obtain_mask",
        "comply_with_policy",
        "learn_from_outcomes"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": "triangular(min=18, mode=35, max=85)",
          "socioeconomic_status_share": {
            "low": 0.35,
            "mid": 0.45,
            "high": 0.2
          },
          "health_risk_level_dist": "beta(a=2, b=5) scaled to [0,1]",
          "risk_perception_baseline": 0.3,
          "attitude_toward_masks": "normal(mean=0.0, std=0.4) clipped to [-1,1]",
          "trust_in_authorities": "beta(a=3, b=3) scaled to [0,1]",
          "susceptibility_to_influence": "beta(a=2.5, b=2.5) scaled to [0,1]",
          "conformity_bias": "normal(mean=0.5, std=0.15) clipped to [0,1]",
          "political_identity": "normal(mean=0.0, std=0.6) clipped to [-1,1]",
          "access_to_masks": "logistic(SES-based multipliers) clipped to [0,1]",
          "has_mask_initial": "Bernoulli(p=initial_adoption_rate)",
          "mask_use_state_initial": "Equal to has_mask_initial",
          "compliance_propensity_initial": "beta(a=2, b=3) scaled to [0,1]",
          "last_fined_day": -1,
          "last_enforcement_event_day": -1,
          "opinion_signal": 0.0
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "enforces_mask_policy",
        "transit_probability",
        "contact_rate_modifier",
        "occupants"
      ],
      "behaviors": [
        "host_interactions",
        "check_compliance",
        "apply_access_rules"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "home_locations_count": "derived from households_count",
          "work_locations_count": "workplace_count",
          "public_locations_count": "public_location_count",
          "capacity_rule": "Poisson(lambda=location_capacity_scale) with min=5",
          "enforces_mask_policy": "true for mandated scope, else false",
          "transit_probability": "transit_probability_public for public; 0 for home/work",
          "contact_rate_modifier": "by type: home/work/public"
        }
      }
    },
    {
      "name": "Government",
      "attributes": [
        "mandate_level",
        "enforcement_probability",
        "fine_amount",
        "policy_start_day",
        "policy_end_day",
        "public_guidance_strength"
      ],
      "behaviors": [
        "issue_or_update_policy",
        "conduct_enforcement",
        "broadcast_guidance"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_level": "policy_mandate_level",
          "enforcement_probability": "enforcement_probability",
          "fine_amount": "fine_amount",
          "policy_start_day": "policy_start_day",
          "policy_end_day": "policy_end_day",
          "public_guidance_strength": "public_guidance_strength"
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory_level",
        "restock_rate_per_day",
        "mask_price"
      ],
      "behaviors": [
        "restock",
        "sell_masks",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "retailer_count": "retailer_count",
          "inventory_level": "retailer_initial_inventory / retailer_count",
          "restock_rate_per_day": "restock_rate_per_day",
          "mask_price": "mask_price"
        }
      }
    },
    {
      "name": "Media",
      "attributes": [
        "message_orientation",
        "message_intensity",
        "misinformation_rate",
        "reach_fraction"
      ],
      "behaviors": [
        "broadcast_message",
        "target_audience"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "message_orientation": "message_orientation",
          "message_intensity": "media_message_intensity",
          "misinformation_rate": "misinformation_rate",
          "reach_fraction": "media_reach_fraction"
        }
      }
    },
    {
      "name": "Policy",
      "attributes": [
        "name",
        "mandate_scope",
        "mandate_level",
        "start_day",
        "end_day",
        "enforcement_probability",
        "penalty"
      ],
      "behaviors": [
        "activate",
        "deactivate",
        "update_parameters"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "name": "Mask Mandate",
          "mandate_scope": "locations: work+public when active",
          "mandate_level": "policy_mandate_level",
          "start_day": "policy_start_day",
          "end_day": "policy_end_day",
          "enforcement_probability": "enforcement_probability",
          "penalty": "fine_amount"
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialInfluenceModule",
      "description": "Updates personal attitudes and risk perceptions from social network observations and conformity effects; outputs mask-use intentions.",
      "inputs": [
        "signal.observed_norms",
        "signal.media_message",
        "signal.policy_state"
      ],
      "outputs": [
        "signal.opinion_updates",
        "signal.mask_use_intentions"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  neighbors = social_neighbors(i)\n  observed_mask_rate = mean(mask_use_state[j] for j in neighbors) with noise ~ Normal(0, observation_noise)\n  perceived_norm = clamp(observed_mask_rate, 0, 1)\n  delta_attitude = influence_strength_social * (perceived_norm - sigmoid(attitude_toward_masks[i])) * conformity_bias[i]\n  if policy_state.active:\n    delta_attitude += compliance_bias_boost = compliance_sensitivity_to_mandate * policy_state.level_scalar\n  if media_message.received[i]:\n    delta_attitude += guidance_effect_on_attitude * media_message.orientation_scalar * media_message.intensity * (trust_in_authorities[i])\n  attitude_toward_masks[i] = clamp(attitude_toward_masks[i] + delta_attitude, -1, 1)\n  risk_perception[i] = clamp(risk_perception[i] + risk_sensitivity * (media_message.risk_signal + perceived_norm*0.1 - 0.05), 0, 1)\n  intention = sigmoid( 1.5*attitude_toward_masks[i] + 0.8*risk_perception[i] + 0.6*compliance_propensity[i] )\n  emit signal.opinion_updates[i] = attitude_toward_masks[i]\n  emit signal.mask_use_intentions[i] = intention",
        "notes": [
          "sigmoid(x) = 1/(1+exp(-x))",
          "policy_state.level_scalar in {0, 0.5, 1.0} for none/partial/full mandates",
          "observation_noise introduces imperfect norm inference"
        ]
      },
      "requirements": [
        "SocialNetwork",
        "PersonState"
      ],
      "module_parameters": [
        "influence_strength_social",
        "conformity_bias_mean",
        "conformity_bias_std",
        "observation_noise"
      ]
    },
    {
      "name": "MediaInfluenceModule",
      "description": "Broadcasts media and government guidance signals; affects risk perception and attitudes through reach and trust.",
      "inputs": [],
      "outputs": [
        "signal.media_message",
        "signal.guidance_broadcast"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "message.orientation_scalar = +1 if message_orientation=='pro_mask' else (-1 if 'anti_mask' else 0)\nmessage.intensity = media_message_intensity\nmessage.misinformation = misinformation_rate\nmessage.risk_signal = message.intensity * message.orientation_scalar * (1 - misinformation_rate)\nfor each person i:\n  reach = Bernoulli(p=media_reach_fraction)\n  received = reach == 1\n  emit signal.media_message[i] = {received, orientation_scalar: message.orientation_scalar, intensity: message.intensity, risk_signal: message.risk_signal}\nemit signal.guidance_broadcast = public_guidance_strength * message.intensity * message.orientation_scalar",
        "notes": [
          "Public guidance is modeled as a multiplier delivered via media",
          "Misinformation dampens effective risk signal"
        ]
      },
      "requirements": [
        "MediaAgent",
        "GovernmentGuidance"
      ],
      "module_parameters": [
        "media_message_intensity",
        "misinformation_rate",
        "media_reach_fraction",
        "message_orientation",
        "public_guidance_strength",
        "guidance_effect_on_attitude"
      ]
    },
    {
      "name": "PolicyEnforcementModule",
      "description": "Activates policy according to schedule; enforces mandates at locations and applies fines/denials; updates compliance propensity.",
      "inputs": [
        "signal.location_visits",
        "signal.mask_use_events"
      ],
      "outputs": [
        "signal.policy_state",
        "signal.enforcement_actions",
        "signal.fines_issued",
        "signal.access_denied_events"
      ],
      "dependencies": [
        "LocationInteractionModule"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "active = (day >= policy_start_day) and (day <= policy_end_day) and (policy_mandate_level!='none')\nlevel_scalar = 1.0 if policy_mandate_level=='full' else (0.5 if policy_mandate_level=='partial' else 0.0)\nemit signal.policy_state = {active, level_scalar}\nfor each visit v in signal.location_visits:\n  if not active or not v.location.enforces_mask_policy: continue\n  noncompliant = (v.person.mask_use_state == 0)\n  if noncompliant:\n    enforce = Bernoulli(p=enforcement_probability * location_enforcement_multiplier)\n    if enforce:\n      fine = Bernoulli(p=0.5)\n      if fine:\n        v.person.compliance_propensity = clamp(v.person.compliance_propensity + fine_deterrence_effect, 0, 1)\n        v.person.last_fined_day = day\n        emit signal.fines_issued += 1\n      denied = Bernoulli(p=denial_probability_when_noncompliant)\n      if denied:\n        emit signal.access_denied_events += 1\n      emit signal.enforcement_actions += 1\nfor each person i:\n  # Compliance memory decay\n  i.compliance_propensity = clamp(i.compliance_propensity * (1 - compliance_decay) + (level_scalar * compliance_sensitivity_to_mandate), 0, 1)",
        "notes": [
          "Denials and fines are stochastic; both raise compliance",
          "Compliance propensity has slow decay, boosted by active mandates"
        ]
      },
      "requirements": [
        "GovernmentAgent",
        "LocationPolicies"
      ],
      "module_parameters": [
        "policy_mandate_level",
        "enforcement_probability",
        "fine_amount",
        "policy_start_day",
        "policy_end_day",
        "compliance_sensitivity_to_mandate",
        "compliance_decay",
        "denial_probability_when_noncompliant",
        "location_enforcement_multiplier",
        "fine_deterrence_effect"
      ]
    },
    {
      "name": "LocationInteractionModule",
      "description": "Generates daily visits to home, work, and public locations; determines on-site mask compliance and perceived norms.",
      "inputs": [
        "signal.mask_use_intentions",
        "signal.policy_state"
      ],
      "outputs": [
        "signal.location_visits",
        "signal.mask_use_events",
        "signal.observed_norms",
        "signal.compliance_events"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "visits = []\nfor each person i:\n  # Assign visits by fractions and capacities\n  schedule = sample_visits(home_fraction, work_fraction, public_fraction)\n  for slot in schedule:\n    loc = assign_location(i, slot.type, capacity_rule)\n    # Decide on-mask behavior when entering location\n    intent = signal.mask_use_intentions[i]\n    policy_bonus = policy_state.level_scalar if loc.enforces_mask_policy else 0\n    has_mask = i.has_mask\n    wear_prob = clamp(0.2 + 0.6*intent + 0.2*i.compliance_propensity + 0.2*policy_bonus, 0, 1)\n    wear = Bernoulli(p=wear_prob) and has_mask\n    i.mask_use_state = 1 if wear else 0\n    record visit and mask_use_event\n    visits.append({person:i, location:loc, wear:wear})\n# Compute observed norms per person from co-located others\nfor each person i:\n  co_located = [v for v in visits if v.location == any location where i visited]\n  norm = mean(v.wear for v in co_located if v.person != i) if co_located else 0\n  emit signal.observed_norms[i] = norm\nemit signal.location_visits = visits\nemit signal.mask_use_events = [ (v.person.id, v.location.id, v.wear) for v in visits ]\nemit signal.compliance_events = fraction of visits with wear==True when location.enforces_mask_policy==True",
        "notes": [
          "Workplace mask policy fraction is applied when building location.enforces_mask_policy flags",
          "Capacity constraints limit assignment; overflow visitors are re-routed or dropped"
        ]
      },
      "requirements": [
        "Locations",
        "VisitScheduler"
      ],
      "module_parameters": [
        "home_fraction",
        "work_fraction",
        "public_fraction",
        "contact_rate_modifier_home",
        "contact_rate_modifier_work",
        "contact_rate_modifier_public",
        "daily_mobility_rate",
        "workplace_policy_fraction",
        "workplace_count",
        "public_location_count",
        "location_capacity_scale",
        "transit_probability_public"
      ]
    },
    {
      "name": "MaskAcquisitionModule",
      "description": "Manages retailer inventory, price adjustment, and person mask purchase attempts; tracks unmet demand.",
      "inputs": [
        "signal.mask_use_intentions",
        "signal.policy_state"
      ],
      "outputs": [
        "signal.purchase_attempts",
        "signal.purchase_backlog",
        "signal.inventory_levels"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "# Retailer restock\nfor each retailer r:\n  r.inventory_level += restock_rate_per_day\n# Person purchase attempts\npurchase_backlog = 0\nfor each person i:\n  if not i.has_mask:\n    demand_score = 0.5*signal.mask_use_intentions[i] + 0.3*i.risk_perception + 0.2*policy_state.level_scalar\n    # SES-based access multiplier\n    m = access_multiplier_ses_low if i.socioeconomic_status=='low' else (access_multiplier_ses_mid if 'mid' else access_multiplier_ses_high)\n    buy_prob = clamp(demand_score * m * max(0.1, 1 - price_adjustment_elasticity*avg_price()), 0, 1)\n    will_buy = Bernoulli(p=buy_prob)\n    if will_buy:\n      r = choose_retailer()\n      if r.inventory_level > 0:\n        r.inventory_level -= 1\n        i.has_mask = True\n      else:\n        purchase_backlog += 1\nemit signal.purchase_backlog = purchase_backlog\nemit signal.inventory_levels = [r.inventory_level for r in Retailers]\n# Price adjustment based on backlog\nif purchase_backlog > 0:\n  for each retailer r:\n    r.mask_price = max(0.2, r.mask_price * (1 + price_adjustment_elasticity*0.1))",
        "notes": [
          "Simple price adjustment responds to same-day backlog",
          "Access multipliers encode inequality by SES",
          "avg_price() is mean of current retailer prices"
        ]
      },
      "requirements": [
        "Retailers",
        "PaymentProcessing"
      ],
      "module_parameters": [
        "retailer_initial_inventory",
        "restock_rate_per_day",
        "mask_price",
        "price_adjustment_elasticity",
        "retailer_count",
        "access_multiplier_ses_low",
        "access_multiplier_ses_mid",
        "access_multiplier_ses_high"
      ]
    },
    {
      "name": "OutcomeFeedbackModule",
      "description": "Applies reinforcement from outcomes (social approval, access, perceived safety) to future attitudes and compliance; includes habit decay.",
      "inputs": [
        "signal.compliance_events",
        "signal.access_denied_events",
        "signal.fines_issued",
        "signal.media_message"
      ],
      "outputs": [
        "signal.feedback_updates"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  approval = signal.compliance_events * approval_feedback_strength\n  access = signal.access_denied_events == 0 ? access_feedback_strength*0.0 : -access_feedback_strength\n  safety = signal.media_message[i].risk_signal * safety_feedback_strength if signal.media_message[i].received else 0\n  i.attitude_toward_masks = clamp(i.attitude_toward_masks + approval + access + safety, -1, 1)\n  # Habit decay if no reinforcement\n  if i.mask_use_state == 0:\n    i.compliance_propensity = clamp(i.compliance_propensity * (1 - mask_wear_decay_without_reinforcement), 0, 1)\nemit signal.feedback_updates = true",
        "notes": [
          "Access denial discourages non-compliance indirectly by lowering attitude",
          "Mask habit decays without practice"
        ]
      },
      "requirements": [
        "PersonState"
      ],
      "module_parameters": [
        "approval_feedback_strength",
        "access_feedback_strength",
        "safety_feedback_strength",
        "mask_wear_decay_without_reinforcement"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily observables and computes metrics from simulation state.",
      "inputs": [
        "signal.mask_use_events",
        "signal.policy_state",
        "signal.inventory_levels",
        "signal.purchase_backlog",
        "signal.opinion_updates"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.policy_compliance_rate_daily",
        "observable.purchase_backlog_daily",
        "observable.inventory_avg_daily",
        "observable.access_inequality_index_daily",
        "observable.sentiment_polarization_daily",
        "metric.time_to_50_percent_adoption",
        "metric.peak_adoption",
        "metric.endline_adoption"
      ],
      "dependencies": [
        "AllModules"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate = mean(v.wear for v in signal.mask_use_events)\ncompliance_rate = mean(v.wear for v in signal.mask_use_events if location_of(v).enforces_mask_policy)\npurchase_backlog = signal.purchase_backlog\ninventory_avg = mean(signal.inventory_levels)\n# Gini of mask possession by SES\nfor SES in {low, mid, high}:\n  p_has_mask[SES] = mean(Person.has_mask where SES)\naccess_inequality_index = gini_over_values([p_has_mask[low], p_has_mask[mid], p_has_mask[high]])\nsentiment_polarization = variance(Person.attitude_toward_masks)\nrecord daily series\n# Rolling metrics\nif not defined time_to_50:\n  if moving_average(adoption_rate, window=sustained_window_for_50pct) >= 0.5:\n    time_to_50 = current_day\npeak_adoption = max(peak_adoption, adoption_rate)\nif current_day == simulation_duration_days:\n  endline_adoption = adoption_rate\nemit all observables and metrics",
        "notes": [
          "Gini computed across group means to capture between-group inequality",
          "Time to 50% requires sustained_window_for_50pct consecutive days"
        ]
      },
      "requirements": [
        "SeriesStore"
      ],
      "module_parameters": [
        "sustained_window_for_50pct"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 5000,
      "bounds": {
        "low": 500,
        "high": 20000
      },
      "owner_module": "global",
      "description": "Number of Person agents.",
      "frozen": true
    },
    {
      "key": "simulation_duration_days",
      "dtype": "int",
      "default": 120,
      "bounds": {
        "low": 30,
        "high": 365
      },
      "owner_module": "global",
      "description": "Total number of days simulated.",
      "frozen": true
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "RNG seed for reproducibility.",
      "frozen": true
    },
    {
      "key": "network_topology",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": null,
      "owner_module": "global",
      "description": "Type of social network (allowed: small_world, scale_free, erdos_renyi).",
      "frozen": true
    },
    {
      "key": "average_degree",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 4,
        "high": 30
      },
      "owner_module": "global",
      "description": "Average number of social ties per person.",
      "frozen": false
    },
    {
      "key": "small_world_rewire_p",
      "dtype": "float",
      "default": 0.05,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "global",
      "description": "Rewiring probability for Watts-Strogatz small-world network.",
      "frozen": false
    },
    {
      "key": "initial_adoption_rate",
      "dtype": "float",
      "default": 0.2,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Initial fraction of persons with masks and wearing them.",
      "frozen": false
    },
    {
      "key": "risk_perception_baseline",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Baseline perceived risk in absence of signals.",
      "frozen": false
    },
    {
      "key": "risk_sensitivity",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "global",
      "description": "Responsiveness of risk perception to signals.",
      "frozen": false
    },
    {
      "key": "trust_in_authorities_mean",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Mean trust in authorities distribution.",
      "frozen": false
    },
    {
      "key": "heterogeneity_strength",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "global",
      "description": "Degree of inter-agent heterogeneity in attitudes and susceptibilities.",
      "frozen": false
    },
    {
      "key": "influence_strength_social",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.0,
        "high": 2.0
      },
      "owner_module": "SocialInfluenceModule",
      "description": "Weight of social norm influence on attitude updates.",
      "frozen": false
    },
    {
      "key": "conformity_bias_mean",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 1.0
