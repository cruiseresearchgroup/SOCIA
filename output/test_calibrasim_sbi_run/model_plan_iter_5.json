      },
      {
        "name": "modules/location_interaction.py",
        "description": "Implements LocationInteractionModule logic."
      },
      {
        "name": "modules/mask_acquisition.py",
        "description": "Implements MaskAcquisitionModule logic."
      },
      {
        "name": "modules/outcome_feedback.py",
        "description": "Implements OutcomeFeedbackModule logic."
      },
      {
        "name": "modules/aggregator.py",
        "description": "Implements AdoptionAggregator, observables, and metrics."
      },
      {
        "name": "utils/math_utils.py",
        "description": "Sigmoid, clipping, Gini, random sampling helpers."
      },
      {
        "name": "config/default_config.yaml",
        "description": "Default parameters and scenario configurations."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy",
      "numba",
      "pyyaml"
    ]
  },
  "prediction_period": {
    "start_day": 91,
    "end_day": 120
  },
  "evaluation_metrics": [
    "adoption_rate_over_time",
    "time_to_50_percent_adoption",
    "peak_adoption",
    "endline_adoption",
    "policy_compliance_rate",
    "access_inequality_index",
    "sentiment_polarization",
    "purchase_backlog"
  ]
}