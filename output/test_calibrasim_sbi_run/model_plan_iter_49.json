  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.adopted_mask)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": null
    },
    {
      "id": "observable.group_adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(demographic_group, mean(Person.adopted_mask))",
      "frequency": "daily",
      "aggregation": "by_group(demographic_group)",
      "target_data_field": null
    },
    {
      "id": "observable.mandate_active_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "policy.mandate_active",
      "frequency": "daily",
      "aggregation": "none",
      "target_data_field": null
    },
    {
      "id": "observable.noncompliance_under_mandate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "if mandate_active then 1 - mean(Person.adopted_mask) else null",
      "frequency": "daily",
      "aggregation": "conditional_mean",
      "target_data_field": null
    },
    {
      "id": "observable.adoption_rate_auc",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cumulative_sum(mean(Person.adopted_mask)) normalized",
      "frequency": "daily",
      "aggregation": "cumulative",
      "target_data_field": null
    }
  ],
  "metrics": [
    {
      "name": "final_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "FinalValue",
        "config": {
          "day": "last"
        }
      }
    },
    {
      "name": "time_to_reach_70_percent",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.7,
          "first_passage": true
        }
      }
    },
    {
      "name": "area_under_adoption_curve",
      "inputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_rate_auc"
      ],
      "definition": {
        "type": "AUC",
        "config": {
          "normalized": true
        }
      }
    },
    {
      "name": "adoption_inequality_index",
      "inputs": [
        "observable.group_adoption_rate_daily"
      ],
      "definition": {
        "type": "InequalityIndex",
        "config": {
          "method": "cv",
          "day": "last"
        }
      }
    },
    {
      "name": "noncompliance_under_mandate",
      "inputs": [
        "observable.noncompliance_under_mandate_daily",
        "observable.mandate_active_daily"
      ],
      "definition": {
        "type": "ConditionalMean",
        "config": {
          "condition_input": "observable.mandate_active_daily",
          "condition_value": 1
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network_type": "small_world",
    "average_degree": 8,
    "rewiring_probability": 0.05,
    "homophily_level": 0.2,
    "initial_adoption_rate": 0.1,
    "demographic_groups": [
      "young",
      "adult",
      "senior"
    ],
    "demographic_group_probs": [
      0.35,
      0.5,
      0.15
    ]
  },
  "algorithms": {
    "Watts-Strogatz": "Generate small-world network with given average degree and rewiring probability.",
    "HomophilyRewiring": "Rewire cross-group edges with probability proportional to homophily to favor same-group connections while keeping degree distribution roughly constant.",
    "LogisticDecision": "Compute adoption probability via sigmoid((U - threshold)/temperature) from linear utility in social/policy/risk/trust/fatigue.",
    "AdaptivePolicy": "Periodic adjustment of policy strength based on observed adoption under mandate.",
    "AUCComputation": "Cumulative trapezoidal (here simple sum due to unit time step) of adoption rate, optionally normalized by days.",
    "InequalityCV": "Coefficient of variation across group adoption rates at a given day."
  },
