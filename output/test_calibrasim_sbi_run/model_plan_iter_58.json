{
  "model_type": "agent_based",
  "description": "Agent-based, network-embedded simulation of mask adoption and usage dynamics under social influence, information diffusion, policy enforcement, market availability, and optional epidemic risk.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age",
        "household_id",
        "workplace_id",
        "health_state",
        "risk_perception",
        "baseline_compliance_propensity",
        "social_influence_susceptibility",
        "trust_in_authorities",
        "income",
        "mask_owned",
        "mask_quality",
        "is_wearing_mask",
        "vaccination_status",
        "fatigue_discomfort",
        "network_neighbors",
        "last_compliance_start_day",
        "cumulative_compliance_days"
      ],
      "behaviors": [
        "decide_mask_use",
        "interact_with_others",
        "update_beliefs_from_contacts",
        "update_beliefs_from_media_policy",
        "purchase_masks",
        "comply_with_or_evade_policy",
        "move_between_locations",
        "health_progression"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_distribution": {
            "bins": [
              0,
              18,
              35,
              50,
              65,
              100
            ],
            "probabilities": [
              0.22,
              0.26,
              0.22,
              0.18,
              0.12
            ]
          },
          "income_lognormal_mu": 10.5,
          "income_lognormal_sigma": 0.7,
          "baseline_compliance_beta": {
            "alpha": 2.0,
            "beta": 2.0
          },
          "social_influence_susceptibility_beta": {
            "alpha": 2.0,
            "beta": 5.0
          },
          "trust_in_authorities_beta": {
            "alpha": 2.5,
            "beta": 2.0
          },
          "vaccination_coverage_initial": 0.6,
          "initial_mask_adoption_rate": 0.2,
          "initial_infected_fraction": 0.01
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "transmission_modifier",
        "mask_policy",
        "enforcement_level",
        "entry_refusal_if_unmasked"
      ],
      "behaviors": [
        "host_contacts",
        "enforce_policy",
        "check_entry_requirements"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "counts_by_type": {
            "home": 280,
            "work": 120,
            "school": 20,
            "retail": 80,
            "transit": 20,
            "outdoor": 50
          },
          "capacity_by_type": {
            "home": 6,
            "work": 50,
            "school": 200,
            "retail": 30,
            "transit": 100,
            "outdoor": 200
          },
          "entry_refusal_if_unmasked_default": 0.5,
          "enforcement_level_default": 0.5,
          "mask_policy_initial": "none"
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "price_per_mask",
        "stock_level",
        "restock_rate",
        "quality_mix"
      ],
      "behaviors": [
        "sell_masks",
        "restock",
        "adjust_price"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "count": 10,
          "initial_price": 1.0,
          "initial_stock": 5000,
          "restock_rate": 500,
          "quality_mix": {
            "low": 0.3,
            "medium": 0.5,
            "high": 0.2
          }
        }
      }
    },
    {
      "name": "PolicyMaker",
      "attributes": [
        "mandate_active",
        "mandate_strictness",
        "enforcement_probability",
        "fine_amount",
        "information_campaign_intensity",
        "trigger_threshold_cases_per_100k",
        "subsidy_amount",
        "budget"
      ],
      "behaviors": [
        "issue_or_lift_mandate",
        "launch_information_campaign",
        "adjust_enforcement",
        "allocate_subsidies"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_active": false,
          "mandate_strictness": 0.8,
          "enforcement_probability": 0.5,
          "fine_amount": 50.0,
          "information_campaign_intensity": 0.6,
          "trigger_threshold_cases_per_100k": 25.0,
          "subsidy_amount": 0.5,
          "budget": 100000.0
        }
      }
    },
    {
      "name": "MediaChannel",
      "attributes": [
        "reach",
        "message_intensity",
        "bias",
        "frequency"
      ],
      "behaviors": [
        "broadcast_messages"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "channels": [
            {
              "reach": 0.5,
              "message_intensity": 0.6,
              "bias": 0.0,
              "frequency": 1
            },
            {
              "reach": 0.3,
              "message_intensity": 0.4,
              "bias": -0.2,
              "frequency": 3
            },
            {
              "reach": 0.2,
              "message_intensity": 0.8,
              "bias": 0.2,
              "frequency": 2
            }
          ]
        }
      }
    }
  ],
  "modules": [
    {
      "name": "SocialContactAndObservation",
      "description": "Generates daily contacts based on network and locations; applies mask-modified transmission; records observed mask usage among contacts.",
      "inputs": [
        "state.people",
        "state.locations",
        "state.network",
        "state.day"
      ],
      "outputs": [
        "events.contacts",
        "events.infections",
        "signals.observed_mask_fraction_per_agent"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  determine today's locations visited based on schedule and travel_between_locations_prob\n  sample n_contacts ~ Poisson(contact_rate_per_day * location_multiplier)\n  choose contacts from (household, workplace/school, network_neighbors) with weights\n  for each contact (i,j) at location L:\n    record whether i and j wear masks; update i.observed_masks_count, i.observed_contacts_count\n    if HealthProgression enabled:\n      compute effective_beta = base_transmission_rate * tx_mod_L\n      apply mask reduction: if infectious->susceptible:\n        beta *= (1 - mask_effectiveness_source if source masked) * (1 - mask_effectiveness_receiver if receiver masked)\n      draw infection event with probability beta\n      if infection occurs: queue infection event for HealthProgression\n  for each i:\n    signals.observed_mask_fraction_per_agent[i] = smoothed ratio of observed_masks_count / observed_contacts_count using observation_weight_recent_contacts",
        "notes": [
          "Household contacts scaled by household_contact_multiplier.",
          "Contact selection prioritizes co-located agents to reflect location effects.",
          "Observation smoothing uses exponential moving average with weight observation_weight_recent_contacts."
        ]
      },
      "requirements": [
        "state.network",
        "random_stream",
        "scheduler"
      ],
      "module_parameters": [
        "contact_rate_per_day",
        "base_transmission_rate",
        "mask_effectiveness_source",
        "mask_effectiveness_receiver",
        "tx_mod_home",
        "tx_mod_work",
        "tx_mod_school",
        "tx_mod_retail",
        "tx_mod_transit",
        "tx_mod_outdoor",
        "household_contact_multiplier",
        "observation_weight_recent_contacts",
        "travel_between_locations_prob"
      ]
    },
    {
      "name": "MaskAdoptionDecision",
      "description": "Computes daily mask-wearing decision using a discrete-choice model integrating risk perception, social influence, policy pressure, fatigue, trust, and costs.",
      "inputs": [
        "signals.observed_mask_fraction_per_agent",
        "state.policy",
        "signals.info_campaign_effect",
        "state.people",
        "state.day"
      ],
      "outputs": [
        "state.people.is_wearing_mask",
        "events.mask_demand",
        "signals.policy_compliance_flag_per_agent"
      ],
      "dependencies": [
        "InformationDiffusion",
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  social_term = social_influence_weight * (signals.observed_mask_fraction_per_agent[i] - 0.5)\n  risk_term = risk_perception_weight * (i.risk_perception - 0.5)\n  policy_term = policy_weight * (state.policy.mandate_active * state.policy.mandate_strictness)\n  trust_term = 0.5 * (i.trust_in_authorities - 0.5) * state.policy.mandate_active\n  fatigue_term = - i.fatigue_discomfort\n  denial_term = denial_of_entry_weight_in_decision * expected_denial_prob_for_i\n  utility = i.baseline_compliance_propensity + social_term + risk_term + policy_term + trust_term + fatigue_term + denial_term\n  p_adopt = sigmoid(utility)\n  decide wear_mask ~ Bernoulli(p_adopt)\n  if wear_mask and i.mask_owned == 0: add to events.mask_demand\n  update i.is_wearing_mask\n  update compliance streak counters and i.fatigue_discomfort += fatigue_increase_per_day if wearing else max(i.fatigue_discomfort - trust_decay_rate, 0)\n  update risk_perception: i.risk_perception = clamp(i.risk_perception + signals.info_campaign_effect[i] - vaccination_risk_reduction * (i.vaccination_status==1?1:0), 0, 1)\n  signals.policy_compliance_flag_per_agent[i] = 1 if state.policy.mandate_active and i.is_wearing_mask else 0",
        "notes": [
          "Expected denial probability is derived from location entry_refusal_if_unmasked weighted by person i's planned visits.",
          "Sigmoid(x) = 1 / (1 + exp(-x)). Utility is centered around 0 by zero-mean terms.",
          "Fatigue recovers slowly when not wearing (using trust_decay_rate as recovery rate)."
        ]
      },
      "requirements": [
        "random_stream",
        "events.queue"
      ],
      "module_parameters": [
        "risk_perception_weight",
        "social_influence_weight",
        "policy_weight",
        "fatigue_increase_per_day",
        "trust_decay_rate",
        "vaccination_risk_reduction",
        "denial_of_entry_weight_in_decision",
        "initial_mask_adoption_rate"
      ]
    },
    {
      "name": "InformationDiffusion",
      "description": "Updates individuals' risk perception and trust via media messages and policy announcements.",
      "inputs": [
        "state.media",
        "state.policy",
        "state.people",
        "state.day"
      ],
      "outputs": [
        "signals.info_campaign_effect"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each person i:\n  aggregate media signal M = sum_over_channels( reach * message_intensity * (1 + media_bias) * (day % frequency == 0 ? 1 : 0) )\n  policy_signal P = state.policy.information_campaign_intensity * (state.policy.mandate_active ? 1.0 : 0.5)\n  base_effect = media_reach * (M + P)\n  personalized_effect = base_effect * (i.trust_in_authorities)\n  signals.info_campaign_effect[i] = clamp(personalized_effect, -0.2, 0.2)",
        "notes": [
          "Media bias >0 increases pro-mask messaging; <0 decreases it.",
          "Effect is bounded to avoid unrealistic daily swings."
        ]
      },
      "requirements": [
        "state.media"
      ],
      "module_parameters": [
        "information_campaign_intensity",
        "media_reach",
        "media_bias"
      ]
    },
    {
      "name": "PolicyAndEnforcement",
      "description": "Turns mandates on/off by schedule and/or case thresholds; applies enforcement via fines or entry denial; allocates subsidies.",
      "inputs": [
        "state.day",
        "observable.cases_per_100k",
        "state.policy",
        "state.locations",
        "state.people"
      ],
      "outputs": [
        "state.policy",
        "events.enforcement_actions",
        "signals.subsidy_per_purchase"
      ],
      "dependencies": [
        "HealthProgression"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if day == mandate_start_day or observable.cases_per_100k > state.policy.trigger_threshold_cases_per_100k:\n  state.policy.mandate_active = true\nelse if observable.cases_per_100k < 5:\n  state.policy.mandate_active = false\nstate.policy.mandate_strictness = mandate_strictness\nstate.policy.enforcement_probability = enforcement_probability\nstate.policy.fine_amount = fine_amount\nsignals.subsidy_per_purchase = min(subsidy_amount, state.policy.budget > 0 ? subsidy_amount : 0)\nremaining_capacity = enforcement_capacity_per_day\nfor each location L:\n  for each person i present at L:\n    if state.policy.mandate_active and !i.is_wearing_mask and remaining_capacity > 0:\n      with probability enforcement_probability:\n        draw action: with prob L.entry_refusal_if_unmasked deny entry else issue fine\n        record in events.enforcement_actions; decrement remaining_capacity",
        "notes": [
          "Mandate logic can use both scheduled start and case thresholds.",
          "Entry refusal probability is location-specific; fines reduce disposable income conceptually (not explicitly modeled unless linked).",
          "Subsidy bounded by budget; budget is decremented in Market module on each sale with subsidy."
        ]
      },
      "requirements": [
        "events.queue",
        "scheduler"
      ],
      "module_parameters": [
        "mandate_start_day",
        "mandate_strictness",
        "enforcement_probability",
        "fine_amount",
        "subsidy_amount",
        "subsidy_budget",
        "enforcement_capacity_per_day"
      ]
    },
    {
      "name": "MarketModule",
      "description": "Fulfills mask demand, adjusts prices based on stock and demand, and restocks.",
      "inputs": [
        "events.mask_demand",
        "signals.subsidy_per_purchase",
        "state.retailers",
        "state.day",
        "state.policy"
      ],
      "outputs": [
        "state.people.mask_owned",
        "state.retailers.price_per_mask",
        "observable.masks_purchased_daily",
        "state.policy.budget"
      ],
      "dependencies": [
        "PolicyAndEnforcement"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "demand = count(events.mask_demand)\nfor each retailer r:\n  r.stock_level += r.restock_rate\n  if demand > 0 and r.stock_level > 0:\n    alloc = min(r.stock_level, floor(demand / number_of_retailers))\n    effective_price = max(0.1, mask_cost - signals.subsidy_per_purchase)\n    sales = min(alloc, round( alloc * (1 + price_elasticity_of_demand * (1 - effective_price/mask_cost)) ))\n    distribute sales to first 'sales' demanders: increment their mask_owned; set mask_quality based on average_mask_quality\n    r.stock_level -= sales\n    observable.masks_purchased_daily += sales\n    if signals.subsidy_per_purchase > 0:\n      state.policy.budget = max(0, state.policy.budget - sales * signals.subsidy_per_purchase)\n  adjust price: r.price_per_mask = clamp(mask_cost * (1 + 0.5 * (1 - r.stock_level / (retailer_restock_rate_per_day*7))), 0.2, 5.0)",
        "notes": [
          "Simplified allocation across retailers; could be improved to match proximity or price differences.",
          "Price adjustment is stock-to-target heuristic; maintains reasonable bounds."
        ]
      },
      "requirements": [
        "events.queue"
      ],
      "module_parameters": [
        "mask_cost",
        "retailer_initial_stock",
        "retailer_restock_rate_per_day",
        "price_elasticity_of_demand",
        "average_mask_quality",
        "mask_purchase_interval_days"
      ]
    },
    {
      "name": "HealthProgression",
      "description": "SEIR-like disease progression; consumes infection events and updates health states; computes incidence and cases per 100k.",
      "inputs": [
        "events.infections",
        "state.people",
        "state.day"
      ],
      "outputs": [
        "observable.incidence_rate_daily",
        "observable.cases_per_100k",
        "state.people.health_state",
        "signals.infectious_agents"
      ],
      "dependencies": [
        "SocialContactAndObservation"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for infection in events.infections:\n  if target.health_state == 'S': set to 'E'\nprogress E->I with prob sigma; I->R with prob gamma\napply vaccination_transmission_reduction to infectiousness for vaccinated\ncompute daily incidence = new I entries; update observables",
        "notes": [
          "sigma ~ 1/incubation_period, gamma ~ 1/infectious_period; set internally (e.g., 1/4 and 1/7).",
          "Module can be disabled by setting base_transmission_rate=0."
        ]
      },
      "requirements": [
        "random_stream"
      ],
      "module_parameters": [
        "initial_infected_fraction",
        "vaccination_transmission_reduction"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Aggregates daily adoption, compliance, durations, enforcement actions, infections averted.",
      "inputs": [
        "state.people",
        "events.enforcement_actions",
        "observable.incidence_rate_daily",
        "state.day"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.adoption_rate_by_age",
        "observable.adoption_rate_by_income_tertile",
        "observable.policy_compliance_rate_daily",
        "observable.average_compliance_duration",
        "observable.enforcement_actions_daily",
        "observable.infections_averted_cumulative"
      ],
      "dependencies": [
        "MaskAdoptionDecision",
        "PolicyAndEnforcement",
        "HealthProgression"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "adoption_rate_daily = mean(i.is_wearing_mask)\npolicy_compliance_rate_daily = mean( i.is_wearing_mask where mandate_active )\nupdate compliance durations per agent using last_compliance_start_day and streaks; compute average\naggregate by age bins and income tertiles\nenforcement_actions_daily = count(events.enforcement_actions)\nif HealthProgression enabled:\n  compute counterfactual infections today using recorded contacts and base_transmission_rate without mask reductions; accumulate infections_averted_cumulative += (counterfactual_today - actual_incidence_today)",
        "notes": [
          "Counterfactual uses same contact structure for the day but sets mask_effectiveness to zero.",
          "Income tertiles computed from population income distribution at initialization."
        ]
      },
      "requirements": [
        "events.store",
        "history.store"
      ],
      "module_parameters": []
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 1000,
      "bounds": {
        "low": 100,
        "high": 100000
      },
      "owner_module": "global",
      "description": "Number of agents in the simulation.",
      "frozen": false
    },
    {
      "key": "simulation_days",
      "dtype": "int",
      "default": 180,
      "bounds": {
        "low": 30,
        "high": 3650
      },
      "owner_module": "global",
      "description": "Number of days to simulate.",
      "frozen": true
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 0,
        "high": 1000000
      },
      "owner_module": "global",
      "description": "PRNG seed for reproducibility.",
      "frozen": true
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "global",
      "description": "Network generator type (fixed to small_world).",
      "frozen": true
    },
    {
      "key": "network_mean_degree",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "global",
      "description": "Mean degree for network generation.",
      "frozen": false
    },
    {
      "key": "contact_rate_per_day",
      "dtype": "float",
      "default": 12.0,
      "bounds": {
        "low": 1.0,
        "high": 40.0
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Average contacts per person per day.",
      "frozen": false
    },
    {
      "key": "base_transmission_rate",
      "dtype": "float",
      "default": 0.08,
      "bounds": {
        "low": 0.0,
        "high": 0.3
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Per-contact transmission probability baseline.",
      "frozen": false
    },
    {
      "key": "mask_effectiveness_source",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.0,
        "high": 0.9
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Reduction when infectious (source) is masked.",
      "frozen": false
    },
    {
      "key": "mask_effectiveness_receiver",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 0.9
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Reduction when susceptible (receiver) is masked.",
      "frozen": false
    },
    {
      "key": "tx_mod_home",
      "dtype": "float",
      "default": 1.0,
      "bounds": {
        "low": 0.2,
        "high": 2.0
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Transmission modifier at home.",
      "frozen": false
    },
    {
      "key": "tx_mod_work",
      "dtype": "float",
      "default": 1.2,
      "bounds": {
        "low": 0.2,
        "high": 2.5
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Transmission modifier at work.",
      "frozen": false
    },
    {
      "key": "tx_mod_school",
      "dtype": "float",
      "default": 1.3,
      "bounds": {
        "low": 0.2,
        "high": 2.5
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Transmission modifier at school.",
      "frozen": false
    },
    {
      "key": "tx_mod_retail",
      "dtype": "float",
      "default": 1.1,
      "bounds": {
        "low": 0.2,
        "high": 2.5
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Transmission modifier at retail.",
      "frozen": false
    },
    {
      "key": "tx_mod_transit",
      "dtype": "float",
      "default": 1.4,
      "bounds": {
        "low": 0.2,
        "high": 3.0
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Transmission modifier on transit.",
      "frozen": false
    },
    {
      "key": "tx_mod_outdoor",
      "dtype": "float",
      "default": 0.5,
      "bounds": {
        "low": 0.1,
        "high": 1.0
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Transmission modifier outdoor.",
      "frozen": false
    },
    {
      "key": "household_contact_multiplier",
      "dtype": "float",
      "default": 2.0,
      "bounds": {
        "low": 1.0,
        "high": 5.0
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Multiplier for household contact rate.",
      "frozen": false
    },
    {
      "key": "observation_weight_recent_contacts",
      "dtype": "float",
      "default": 0.6,
      "bounds": {
        "low": 0.1,
        "high": 0.9
      },
      "owner_module": "SocialContactAndObservation",
      "description": "EMA weight for recent observations of mask use.",
      "frozen": false
    },
    {
      "key": "travel_between_locations_prob",
      "dtype": "float",
      "default": 0.7,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "SocialContactAndObservation",
      "description": "Daily probability of visiting non-home locations.",
      "frozen": false
    },
    {
      "key": "risk_perception_weight",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
