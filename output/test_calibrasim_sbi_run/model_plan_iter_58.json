  ],
  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.is_wearing_mask)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:adoption_rate"
    },
    {
      "id": "observable.adoption_rate_by_age",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(Person.is_wearing_mask, Person.age_bin)",
      "frequency": "daily",
      "aggregation": "by_group(age_bin)",
      "target_data_field": "train_data.csv:adoption_rate_by_age"
    },
    {
      "id": "observable.adoption_rate_by_income_tertile",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "by_group(Person.is_wearing_mask, Person.income_tertile)",
      "frequency": "daily",
      "aggregation": "by_group(income_tertile)",
      "target_data_field": "train_data.csv:adoption_rate_by_income_tertile"
    },
    {
      "id": "observable.policy_compliance_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.is_wearing_mask where Policy.mandate_active)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:policy_compliance_rate"
    },
    {
      "id": "observable.average_compliance_duration",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.cumulative_compliance_days_per_streak)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_data.csv:average_compliance_duration"
    },
    {
      "id": "observable.masks_purchased_daily",
      "source_module": "MarketModule",
      "formula_or_field": "count(sales)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:masks_purchased_daily"
    },
    {
      "id": "observable.enforcement_actions_daily",
      "source_module": "PolicyAndEnforcement",
      "formula_or_field": "count(events.enforcement_actions)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:enforcement_actions_daily"
    },
    {
      "id": "observable.incidence_rate_daily",
      "source_module": "HealthProgression",
      "formula_or_field": "new_infections_per_day",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:incidence_rate_daily"
    },
    {
      "id": "observable.cases_per_100k",
      "source_module": "HealthProgression",
      "formula_or_field": "incidence_rate_daily/population_size*100000",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:cases_per_100k"
    },
    {
      "id": "observable.infections_averted_cumulative",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "cum_sum(counterfactual_infections_no_masks - actual_infections)",
      "frequency": "daily",
      "aggregation": "sum",
      "target_data_field": "train_data.csv:infections_averted_cumulative"
    }
  ],
  "metrics": [
    {
      "name": "RMSE_Adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true
        }
      }
    },
    {
      "name": "MAE_Incidence",
      "inputs": [
        "observable.incidence_rate_daily"
      ],
      "definition": {
        "type": "MAE",
        "config": {
          "normalize": false
        }
      }
    },
    {
      "name": "MAPE_MaskSales",
      "inputs": [
        "observable.masks_purchased_daily"
      ],
      "definition": {
        "type": "MAPE",
        "config": {
          "epsilon": 1e-06
        }
      }
    },
    {
      "name": "TimeTo70Pct_Adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeToThreshold",
        "config": {
          "threshold": 0.7,
          "direction": "up"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network": {
      "generator": "Watts-Strogatz small-world",
      "mean_degree": 10,
      "rewire_prob": 0.05
    },
    "health": {
      "initial_infected_fraction": 0.01,
      "states": [
        "S",
        "E",
        "I",
        "R"
      ],
      "sigma": 0.25,
      "gamma": 0.142857
    },
    "policy": {
      "mandate_active": false,
      "mandate_start_day": 30
    },
    "retailers": {
      "count": 10,
      "initial_stock": 5000,
      "restock_rate_per_day": 500
    },
    "locations": {
      "types": [
        "home",
        "work",
        "school",
        "retail",
        "transit",
        "outdoor"
      ]
    }
  },
  "algorithms": {
    "NetworkGeneration": "Watts-Strogatz small-world generator with mean_degree and rewire_prob.",
    "AdoptionDecision": "Logistic discrete-choice model combining social, risk, policy, trust, fatigue, and denial terms.",
    "InformationUpdate": "Media/policy-based DeGroot-like additive update with bounded daily effect.",
    "Transmission": "Per-contact Bernoulli with location modifiers and multiplicative mask effectiveness.",
    "SEIRProgression": "Daily E->I (sigma), I->R (gamma) transitions.",
    "RetailPricing": "Stock-target heuristic price adjustment and elasticity-based realized sales.",
    "EnforcementSampling": "Capacity-constrained binomial enforcement on noncompliant encounters.",
    "CounterfactualInfections": "Replay contacts without mask effects to estimate infections averted."
  },
  "data_sources": [
    {
      "name": "train_data.csv",
      "purpose": "Calibration and evaluation of adoption, compliance, sales, enforcement, incidence.",
      "fields_used": [
        "adoption_rate",
        "adoption_rate_by_age",
        "adoption_rate_by_income_tertile",
        "policy_compliance_rate",
        "average_compliance_duration",
        "masks_purchased_daily",
        "enforcement_actions_daily",
        "incidence_rate_daily",
        "cases_per_100k",
        "infections_averted_cumulative"
      ]
    }
  ],
