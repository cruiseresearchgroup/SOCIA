        "stockout_rate"
      ]
    },
    {
      "name": "price_series",
      "purpose": "Optional validation of retail price dynamics",
      "fields_used": [
        "date",
        "avg_price"
      ]
    },
    {
      "name": "adoption_by_income",
      "purpose": "Optional validation of inequality in adoption",
      "fields_used": [
        "date",
        "low_income_adoption",
        "high_income_adoption"
      ]
    }
  ],
