      },
      {
        "name": "metrics.py",
        "description": "Metric calculators for series and scalar outputs; optional comparison with data."
      },
      {
        "name": "config.py",
        "description": "Parameter schema, validation, and defaults."
      },
      {
        "name": "utils.py",
        "description": "Random helpers, distributions, queuing for supply delays, clipping, sigmoid, quantile."
      }
    ],
    "dependencies": [
      "numpy",
      "pandas",
      "networkx",
      "scipy",
      "numba"
    ]
  },
  "prediction_period": {
    "start_day": 150,
    "end_day": 179
  },
  "evaluation_metrics": [
    "adoption_rate_over_time",
    "time_to_50pct_adoption",
    "policy_compliance_rate",
    "mask_availability",
    "price_level",
    "adoption_inequality_by_income"
  ]
