  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Person.mask_adoption_state)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "data/observed_adoption.csv:adoption_rate"
    },
    {
      "id": "observable.time_to_50pct_adoption",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "first_day(adoption_rate_daily >= 0.5)",
      "frequency": "run_end",
      "aggregation": "scalar",
      "target_data_field": "data/observed_adoption.csv:time_to_50pct"
    },
    {
      "id": "observable.policy_compliance_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "compliant_visits/required_visits",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "data/location_compliance.csv:compliance_rate"
    },
    {
      "id": "observable.mask_availability_avg_inventory",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Retailer.inventory)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "data/retailer_inventory.csv:avg_inventory"
    },
    {
      "id": "observable.mask_availability_stockout_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "frac(Retailer.inventory == 0)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "data/retailer_inventory.csv:stockout_rate"
    },
    {
      "id": "observable.price_level_avg",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(Retailer.price)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "data/price_series.csv:avg_price"
    },
    {
      "id": "observable.adoption_inequality_by_income",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean(adoption_high_income) - mean(adoption_low_income)",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "data/adoption_by_income.csv:inequality"
    }
  ],
  "metrics": [
    {
      "name": "SeriesExporter.adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "Series",
        "config": {
          "output": "adoption_rate_over_time",
          "normalize": false
        }
      }
    },
    {
      "name": "Scalar.time_to_50pct_adoption",
      "inputs": [
        "observable.time_to_50pct_adoption"
      ],
      "definition": {
        "type": "Identity",
        "config": {}
      }
    },
    {
      "name": "Series.policy_compliance_rate",
      "inputs": [
        "observable.policy_compliance_rate"
      ],
      "definition": {
        "type": "Series",
        "config": {
          "output": "policy_compliance_rate"
        }
      }
    },
    {
      "name": "Series.mask_availability",
      "inputs": [
        "observable.mask_availability_avg_inventory",
        "observable.mask_availability_stockout_rate"
      ],
      "definition": {
        "type": "Composite",
        "config": {
          "fields": [
            "avg_inventory",
            "stockout_rate"
          ]
        }
      }
    },
    {
      "name": "Series.price_level",
      "inputs": [
        "observable.price_level_avg"
      ],
      "definition": {
        "type": "Series",
        "config": {
          "output": "price_level"
        }
      }
    },
    {
      "name": "Series.adoption_inequality_by_income",
      "inputs": [
        "observable.adoption_inequality_by_income"
      ],
      "definition": {
        "type": "Series",
        "config": {
          "output": "adoption_inequality_by_income"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 1000,
    "random_seed": 42,
    "network": {
      "type": "small_world",
      "avg_degree": 10,
      "rewiring_prob": 0.05,
      "homophily": 0.3
    },
    "adoption": {
      "initial_adoption_rate": 0.1
    },
    "locations": {
      "counts": {
        "workplace": 50,
        "school": 20,
        "retail": 40,
        "transit": 5,
        "leisure": 30
      }
    },
    "retailers": {
      "count": 10,
      "inventory": 200,
      "price": 2.0
    },
    "government": {
      "mandate_active": false,
      "fine_amount": 50.0,
      "enforcement_probability": 0.5,
      "campaign_intensity": 0.5,
      "campaign_frequency_days": 7
    }
  },
  "algorithms": {
    "WattsStrogatzHomophily": "Start with ring lattice (k=avg_degree), rewire edges with probability p and accept rewiring based on homophily-biased acceptance rule.",
    "LogisticAdoptionDecision": "Adoption probability p = sigmoid(beta*(utility)) blended with noise; utility combines peer, risk, authority, and cost terms.",
    "InventoryBasedPricing": "Adjust price proportional to deviation of inventory from baseline capacity; clip within bounds.",
    "PoissonContactGeneration": "Sample per-visit contacts from Poisson; pair visitors randomly within capacity constraints.",
    "CampaignTrustUpdate": "At campaign events, increase trust_in_authority proportional to campaign intensity and individual susceptibility."
  },
  "data_sources": [
    {
      "name": "observed_adoption",
      "purpose": "Optional calibration/validation of adoption rate over time",
      "fields_used": [
        "date",
        "adoption_rate"
      ]
    },
    {
      "name": "location_compliance",
      "purpose": "Optional validation of compliance rates",
      "fields_used": [
        "date",
