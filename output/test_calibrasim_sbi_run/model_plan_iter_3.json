{
  "model_type": "agent_based",
  "description": "Agent-based, network-embedded simulation of mask adoption dynamics driven by peer influence, perceived risk, authority campaigns/mandates, enforcement, and retail availability/price. Agents interact on a small-world social network and at scheduled locations with policy enforcement; mask purchases occur from retailers with inventory and dynamic pricing.",
  "entities": [
    {
      "name": "Person",
      "attributes": [
        "id",
        "age_group",
        "income",
        "risk_perception",
        "trust_in_authority",
        "social_influence_susceptibility",
        "compliance_threshold",
        "mask_adoption_state",
        "mask_inventory",
        "network_neighbors",
        "daily_contacts",
        "location_schedule"
      ],
      "behaviors": [
        "observe_peers",
        "update_risk_perception",
        "update_attitude_from_authority",
        "decide_to_adopt_or_drop_mask",
        "purchase_masks",
        "wear_mask_in_location",
        "share_opinion_with_neighbors"
      ],
      "initialization": {
        "method": "random",
        "parameters": {
          "age_group_distribution": {
            "child": 0.15,
            "young_adult": 0.25,
            "adult": 0.45,
            "senior": 0.15
          },
          "income_distribution": "lognormal_fitted_to_mean_sd",
          "initial_adoption_rate": 0.1,
          "initial_trust_in_authority_beta_params": [
            2.0,
            2.0
          ],
          "initial_social_influence_susceptibility_beta_params": [
            2.0,
            3.0
          ],
          "initial_compliance_threshold_normal": {
            "mean": 0.0,
            "sd": 0.5
          },
          "initial_mask_inventory_if_adopted": {
            "min": 1,
            "max": 5
          }
        }
      }
    },
    {
      "name": "Location",
      "attributes": [
        "id",
        "type",
        "capacity",
        "mask_requirement",
        "enforcement_level",
        "foot_traffic"
      ],
      "behaviors": [
        "host_contacts",
        "enforce_mask_policy",
        "restrict_entry_if_noncompliant"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "types": [
            "workplace",
            "school",
            "retail",
            "transit",
            "leisure"
          ],
          "counts": {
            "workplace": 50,
            "school": 20,
            "retail": 40,
            "transit": 5,
            "leisure": 30
          },
          "capacity_by_type": {
            "workplace": 50,
            "school": 200,
            "retail": 30,
            "transit": 200,
            "leisure": 80
          },
          "default_mask_requirement": "recommended",
          "default_enforcement_level": 0.4
        }
      }
    },
    {
      "name": "Government",
      "attributes": [
        "mandate_active",
        "mandate_start_day",
        "fine_amount",
        "enforcement_probability",
        "campaign_intensity",
        "campaign_frequency_days"
      ],
      "behaviors": [
        "launch_public_campaign",
        "toggle_mandate",
        "adjust_enforcement"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "mandate_active_initial": false,
          "mandate_start_day": null,
          "fine_amount": 50.0,
          "enforcement_probability": 0.5,
          "campaign_intensity": 0.5,
          "campaign_frequency_days": 7
        }
      }
    },
    {
      "name": "Retailer",
      "attributes": [
        "id",
        "inventory",
        "price",
        "restock_rate",
        "restock_period_days",
        "supply_delay_days"
      ],
      "behaviors": [
        "sell_masks",
        "restock",
        "adjust_price_based_on_inventory"
      ],
      "initialization": {
        "method": "specified",
        "parameters": {
          "count": 10,
          "initial_inventory": 200,
          "initial_price": 2.0,
          "restock_rate": 150,
          "restock_period_days": 7,
          "supply_delay_days": 2
        }
      }
    }
  ],
  "modules": [
    {
      "name": "NetworkBuilder",
      "description": "Constructs the social network (small-world with homophily) and assigns neighbors to each Person.",
      "inputs": [],
      "outputs": [
        "graph.social_network",
        "Person.network_neighbors"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 0
      },
      "update_rule": {
        "pseudocode": "if t == 0:\n  create N = population_size persons (IDs)\n  build base Watts-Strogatz ring lattice with avg_degree and rewiring prob = network_rewiring_prob\n  apply homophily: for each rewired edge(u,v), accept with prob 1 - |trait(u)-trait(v)|*homophily where trait could be age_group/income_quantile\n  assign neighbors to Person.network_neighbors from graph adjacency\n",
        "notes": [
          "Runs only at initialization (t == 0).",
          "Homophily implemented via biased rewiring acceptance; trait can be a composite score normalized to [0,1]."
        ]
      },
      "requirements": [
        "random_seed"
      ],
      "module_parameters": [
        "population_size",
        "network_type",
        "avg_degree",
        "homophily",
        "network_rewiring_prob",
        "random_seed"
      ]
    },
    {
      "name": "MobilityAndLocations",
      "description": "Generates and executes daily location schedules, hosts contacts, and logs compliance opportunities at visited locations.",
      "inputs": [
        "graph.social_network",
        "Government.mandate_active",
        "Government.enforcement_probability"
      ],
      "outputs": [
        "events.contacts",
        "events.enforcement_checks",
        "Location.foot_traffic"
      ],
      "dependencies": [
        "NetworkBuilder"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each day t:\n  for each Location L: reset L.foot_traffic = 0\n  for each Person i:\n    sample number of locations to visit based on baseline_daily_contacts and schedule\n    for each visit (i, L):\n      L.foot_traffic += 1\n      determine mask_required = (Government.mandate_active or L.mask_requirement == 'required')\n      if mask_required:\n        draw enforcement_event ~ Bernoulli(Government.enforcement_probability * L.enforcement_level)\n        record events.enforcement_checks with tuple (i, L, enforcement_event)\n      generate contacts: choose k ~ Poisson(baseline_daily_contacts/number_of_visits) among co-visitors bounded by L.capacity\n      record events.contacts as pairs (i, j, L)\n      if i is noncompliant and mask_required and enforcement_event and rand < noncompliance_entry_restriction_prob:\n        prevent entry for i (reduce contacts generated for i at L to 0 for this visit)\n",
        "notes": [
          "Contact generation can be approximated by binomial thinning among present agents per location.",
          "When entry is restricted, mark a noncompliance access denial event for metrics."
        ]
      },
      "requirements": [
        "Location list",
        "Person list"
      ],
      "module_parameters": [
        "location_count_workplace",
        "location_count_school",
        "location_count_retail",
        "location_count_transit",
        "location_count_leisure",
        "capacity_workplace",
        "capacity_school",
        "capacity_retail",
        "capacity_transit",
        "capacity_leisure",
        "location_mask_requirement_default",
        "location_enforcement_level_default",
        "baseline_daily_contacts",
        "noncompliance_entry_restriction_prob"
      ]
    },
    {
      "name": "GovernmentPolicy",
      "description": "Controls mandates, enforcement intensity, and launches public information campaigns.",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "outputs": [
        "Government.mandate_active",
        "Government.enforcement_probability",
        "events.campaigns"
      ],
      "dependencies": [
        "AdoptionAggregator"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "if t == 0:\n  Government.mandate_active = mandate_active_initial\n  Government.enforcement_probability = enforcement_probability\nfor each day t:\n  if observable.adoption_rate_daily[t-1] < mandate_trigger_threshold_adoption and not Government.mandate_active:\n    Government.mandate_active = True; Government.mandate_start_day = t\n  if t % campaign_frequency_days == 0:\n    emit events.campaigns with intensity = campaign_intensity\n  Government.enforcement_probability = enforcement_probability  # can be adapted by policy logic if desired\n  apply trust decay to persons since last campaign: each Person.trust_in_authority -= trust_decay_without_campaign\n",
        "notes": [
          "Mandate toggle is threshold-based for demonstration; can be replaced with scenario scripting.",
          "Trust decay is clipped to [0,1]. Campaign events will boost trust via SocialAdoption module."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "mandate_active_initial",
        "enforcement_probability",
        "fine_amount",
        "campaign_intensity",
        "campaign_frequency_days",
        "mandate_trigger_threshold_adoption",
        "trust_decay_without_campaign"
      ]
    },
    {
      "name": "RiskSignal",
      "description": "Generates an exogenous daily risk signal and updates person-level perceived risk baseline.",
      "inputs": [],
      "outputs": [
        "signals.risk_daily"
      ],
      "dependencies": [],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each day t:\n  signals.risk_daily[t] = max(0, min(1, Normal(risk_signal_level, risk_signal_sd)))\n",
        "notes": [
          "Signals are bounded to [0,1].",
          "Can be replaced by data-driven risk inputs if available."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "risk_signal_level",
        "risk_signal_sd"
      ]
    },
    {
      "name": "SocialAdoption",
      "description": "Implements peer observation, campaign impacts, risk-perception update, and adoption/drop decisions; also records mask wearing at locations.",
      "inputs": [
        "events.contacts",
        "events.campaigns",
        "signals.risk_daily",
        "events.enforcement_checks",
        "Government.fine_amount",
        "Government.mandate_active"
      ],
      "outputs": [
        "Person.mask_adoption_state",
        "Person.risk_perception",
        "Person.trust_in_authority",
        "events.mask_wearing_instances",
        "events.noncompliance_penalties"
      ],
      "dependencies": [
        "RiskSignal",
        "GovernmentPolicy",
        "MobilityAndLocations"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each day t:\n  # Update risk perception with smoothing\n  for each Person i:\n    i.risk_perception = (1 - risk_perception_update_rate) * i.risk_perception + risk_perception_update_rate * signals.risk_daily[t]\n  # Apply campaigns to trust\n  if events.campaigns at day t:\n    for each Person i:\n      i.trust_in_authority = clip01(i.trust_in_authority + authority_trust_weight * events.campaigns.intensity * i.social_influence_susceptibility)\n  # Peer observation: compute fraction of neighbors wearing masks in last peer_observation_window_days or today\n  compute observed_mask_frac[i] from events.mask_wearing_instances over window for each i (if no history use neighbor adoption states)\n  # Decision utility\n  for each Person i:\n    peer_term = social_influence_weight * (observed_mask_frac[i] - adoption_threshold_observed_fraction) * i.social_influence_susceptibility\n    risk_term = i.risk_perception - 0.5  # centered risk\n    authority_term = authority_trust_weight * (Government.mandate_active ? 1 : 0) * (i.trust_in_authority - 0.5)\n    cost_term = -cost_of_discomfort\n    penalty_expectation = 0\n    if Government.mandate_active:\n      penalty_expectation = expected_enforcement_prob_for_i * Government.fine_amount / income_scale(i)  # affordability adjustment\n    utility = peer_term + risk_term + authority_term + cost_term + social_penalty_if_noncompliant_when_most_wear * max(0, observed_mask_frac[i]-0.5) - penalty_expectation\n    p_adopt = sigmoid(beta_decision_slope * utility) * (1 - decision_noise) + decision_noise * 0.5\n    if i.mask_adoption_state == 0:\n      adopt ~ Bernoulli(p_adopt)\n      if adopt and i.mask_inventory == 0: flag need_to_purchase\n      if adopt: i.mask_adoption_state = 1\n    else:\n      # dropout without enforcement pressure\n      drop ~ Bernoulli(dropout_probability_without_enforcement * (Government.mandate_active ? 0.25 : 1.0))\n      if drop: i.mask_adoption_state = 0\n  # Wearing at locations and enforcement penalties\n  for each enforcement check e = (i, L, enforcement_event):\n    wear_today = (i.mask_adoption_state == 1 and rand < mask_wear_probability_when_adopted)\n    if not wear_today and enforcement_event:\n      record events.noncompliance_penalties with cost = Government.fine_amount\n    record events.mask_wearing_instances for i at L with wear_today\n",
        "notes": [
          "expected_enforcement_prob_for_i can be approximated by average enforcement probability across visited locations that day.",
          "income_scale(i) could be income/(income_mean) to normalize fine burden.",
          "observed_mask_frac[i] can be computed from neighbor wearing events; if none, fallback to neighbor adoption states."
        ]
      },
      "requirements": [
        "Person list",
        "events buffer"
      ],
      "module_parameters": [
        "social_influence_weight",
        "authority_trust_weight",
        "adoption_threshold_observed_fraction",
        "decision_noise",
        "risk_perception_update_rate",
        "opinion_sharing_probability",
        "peer_observation_window_days",
        "beta_decision_slope",
        "cost_of_discomfort",
        "social_penalty_if_noncompliant_when_most_wear",
        "mask_wear_probability_when_adopted",
        "dropout_probability_without_enforcement"
      ]
    },
    {
      "name": "MarketAndRetail",
      "description": "Handles mask purchasing, retailer sales, inventory dynamics, and price adjustments.",
      "inputs": [
        "Person mask demand flags",
        "Retailer inventories and prices"
      ],
      "outputs": [
        "Retailer.inventory",
        "Retailer.price",
        "events.purchases",
        "Person.mask_inventory"
      ],
      "dependencies": [
        "SocialAdoption"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each day t:\n  # Retailer restock if restock day\n  if t % restock_period_days == 0:\n    for each Retailer r:\n      r.inventory += restock_rate after supply_delay_days queued\n  # Price adjustment based on inventory ratio\n  for each Retailer r:\n    inv_ratio = r.inventory / max(1, inventory_per_retailer)\n    target_delta = -price_adjustment_sensitivity * (inv_ratio - 1.0)\n    r.price = clip(r.price * (1 + target_delta), min_price, max_price)\n  # Person purchases\n  for each Person i needing masks (need_to_purchase or inventory low <= 1):\n    affordability = i.income / income_mean\n    willingness = 1.0 - purchase_threshold_price_sensitivity * (min_r.price / (affordability + 1e-6))\n    if willingness > 0.5 and chosen_retailer.inventory > 0:\n      quantity = min(10, chosen_retailer.inventory)\n      chosen_retailer.inventory -= quantity\n      i.mask_inventory += quantity\n      record events.purchases (i, retailer_id, quantity, price)\n",
        "notes": [
          "Retailer selection can be random or nearest; if spatial data absent, choose uniformly at random among retailers with inventory.",
          "Supply delay implemented via a queue that adds inventory after supply_delay_days."
        ]
      },
      "requirements": [
        "Retailer list"
      ],
      "module_parameters": [
        "retailer_count",
        "inventory_per_retailer",
        "mask_cost_initial",
        "restock_rate",
        "restock_period_days",
        "supply_delay_days",
        "price_adjustment_sensitivity",
        "min_price",
        "max_price",
        "purchase_threshold_price_sensitivity"
      ]
    },
    {
      "name": "AdoptionAggregator",
      "description": "Computes daily observables and aggregates needed for evaluation metrics.",
      "inputs": [
        "Person.mask_adoption_state",
        "events.mask_wearing_instances",
        "events.enforcement_checks",
        "Retailer.inventory",
        "Retailer.price",
        "Person.income"
      ],
      "outputs": [
        "observable.adoption_rate_daily",
        "observable.time_to_50pct_adoption",
        "observable.policy_compliance_rate",
        "observable.mask_availability_avg_inventory",
        "observable.mask_availability_stockout_rate",
        "observable.price_level_avg",
        "observable.adoption_inequality_by_income"
      ],
      "dependencies": [
        "SocialAdoption",
        "MarketAndRetail",
        "MobilityAndLocations"
      ],
      "tick_rate": {
        "unit": "days",
        "value": 1
      },
      "update_rule": {
        "pseudocode": "for each day t:\n  adoption_rate = mean_i(Person.mask_adoption_state_i)\n  emit observable.adoption_rate_daily[t] = adoption_rate\n  if adoption_rate >= 0.5 and observable.time_to_50pct_adoption not set:\n    set observable.time_to_50pct_adoption = t\n  # Compliance: ratio of visits where mask was required and person wore mask\n  required_visits = count of events.enforcement_checks\n  compliant_visits = count of events.mask_wearing_instances corresponding to required_visits with wear=True\n  policy_compliance_rate = (compliant_visits / max(1, required_visits))\n  emit observable.policy_compliance_rate[t] = policy_compliance_rate\n  # Mask availability and price\n  avg_inventory = mean_r(Retailer.inventory_r)\n  stockout_rate = fraction of retailers with inventory == 0\n  avg_price = mean_r(Retailer.price_r)\n  emit observable.mask_availability_avg_inventory[t] = avg_inventory\n  emit observable.mask_availability_stockout_rate[t] = stockout_rate\n  emit observable.price_level_avg[t] = avg_price\n  # Inequality: diff between top and bottom income quantiles\n  incomes = Person.income\n  q_low_val = quantile(incomes, q_low)\n  q_high_val = quantile(incomes, q_high)\n  low_group = {i: Person.income_i <= q_low_val}\n  high_group = {i: Person.income_i >= q_high_val}\n  adopt_low = mean(Person.mask_adoption_state over low_group)\n  adopt_high = mean(Person.mask_adoption_state over high_group)\n  emit observable.adoption_inequality_by_income[t] = adopt_high - adopt_low\n",
        "notes": [
          "time_to_50pct_adoption is reported as the first day threshold is reached; if never reached by horizon, set to null.",
          "Smoothing window can be applied if smoothing_window_days > 1."
        ]
      },
      "requirements": [],
      "module_parameters": [
        "q_low",
        "q_high",
        "smoothing_window_days"
      ]
    }
  ],
  "parameters": [
    {
      "key": "population_size",
      "dtype": "int",
      "default": 1000,
      "bounds": {
        "low": 100,
        "high": 100000
      },
      "owner_module": "NetworkBuilder",
      "description": "Number of Person agents",
      "frozen": true
    },
    {
      "key": "network_type",
      "dtype": "categorical",
      "default": "small_world",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "NetworkBuilder",
      "description": "Type of social network",
      "frozen": true
    },
    {
      "key": "avg_degree",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 2,
        "high": 50
      },
      "owner_module": "NetworkBuilder",
      "description": "Average number of neighbors per person",
      "frozen": false
    },
    {
      "key": "homophily",
      "dtype": "float",
      "default": 0.3,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "NetworkBuilder",
      "description": "Strength of homophily in network rewiring",
      "frozen": false
    },
    {
      "key": "network_rewiring_prob",
      "dtype": "float",
      "default": 0.05,
      "bounds": {
        "low": 0.0,
        "high": 0.5
      },
      "owner_module": "NetworkBuilder",
      "description": "Watts-Strogatz rewiring probability",
      "frozen": false
    },
    {
      "key": "random_seed",
      "dtype": "int",
      "default": 42,
      "bounds": {
        "low": 1,
        "high": 1000000
      },
      "owner_module": "NetworkBuilder",
      "description": "Random seed for reproducibility",
      "frozen": true
    },
    {
      "key": "location_count_workplace",
      "dtype": "int",
      "default": 50,
      "bounds": {
        "low": 1,
        "high": 1000
      },
      "owner_module": "MobilityAndLocations",
      "description": "Number of workplace locations",
