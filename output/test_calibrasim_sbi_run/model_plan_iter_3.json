      "bounds": {
        "low": 20,
        "high": 5000
      },
      "owner_module": "MobilityAndLocations",
      "description": "Capacity per school",
      "frozen": false
    },
    {
      "key": "capacity_retail",
      "dtype": "int",
      "default": 30,
      "bounds": {
        "low": 5,
        "high": 500
      },
      "owner_module": "MobilityAndLocations",
      "description": "Capacity per retail location",
      "frozen": false
    },
    {
      "key": "capacity_transit",
      "dtype": "int",
      "default": 200,
      "bounds": {
        "low": 20,
        "high": 2000
      },
      "owner_module": "MobilityAndLocations",
      "description": "Capacity per transit vehicle/station unit",
      "frozen": false
    },
    {
      "key": "capacity_leisure",
      "dtype": "int",
      "default": 80,
      "bounds": {
        "low": 10,
        "high": 1000
      },
      "owner_module": "MobilityAndLocations",
      "description": "Capacity per leisure venue",
      "frozen": false
    },
    {
      "key": "location_mask_requirement_default",
      "dtype": "categorical",
      "default": "recommended",
      "bounds": {
        "low": 0,
        "high": 0
      },
      "owner_module": "MobilityAndLocations",
      "description": "Default mask rule at locations (recommended/required/none)",
      "frozen": true
    },
    {
      "key": "location_enforcement_level_default",
      "dtype": "float",
      "default": 0.4,
      "bounds": {
        "low": 0.0,
        "high": 1.0
      },
      "owner_module": "MobilityAndLocations",
      "description": "Baseline enforcement level at locations",
      "frozen": false
    },
    {
      "key": "baseline_daily_contacts",
      "dtype": "int",
      "default": 10,
      "bounds": {
        "low": 1,
        "high": 50
      },
      "owner_module": "MobilityAndLocations",
      "description": "Expected number of daily contacts per person",
      "frozen": false
