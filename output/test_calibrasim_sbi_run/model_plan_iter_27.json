      },
      {
        "name": "modules/aggregator.py",
        "description": "AdoptionAggregator implementation and observables/metering."
      },
      {
        "name": "utils/metrics.py",
        "description": "Metric computations: RMSE, threshold time, peak, Gini, group aggregations."
      },
      {
        "name": "utils/random.py",
        "description": "PRNG helpers and seeded distributions."
      },
      {
        "name": "config/schema.json",
        "description": "JSON schema for parameters and validation."
      }
    ],
    "dependencies": [
      "numpy",
      "scipy",
      "networkx",
      "pandas",
      "numba"
    ]
  },
  "prediction_period": {
    "start_day": 150,
    "end_day": 179
  },
  "evaluation_metrics": [
    "RMSE_adoption",
    "time_to_reach_50_percent",
    "peak_adoption_rate",
    "policy_compliance_rate",
    "context_specific_adoption",
    "purchase_conversion_rate",
    "adoption_inequality"
  ]
}