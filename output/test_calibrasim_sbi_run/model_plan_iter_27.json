  "observables": [
    {
      "id": "observable.adoption_rate_daily",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "mean_over_agents(mean_c(used_mask_today_by_context[c]))",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_adoption.csv:adoption_rate_overall"
    },
    {
      "id": "observable.context_adoption",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "adoption by context type",
      "frequency": "daily",
      "aggregation": "by_group(context)",
      "target_data_field": "train_adoption_context.csv:adoption_by_context"
    },
    {
      "id": "observable.policy_compliance_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "share wearing masks when policy_level>0 in applicable contexts",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_policy.csv:compliance_rate"
    },
    {
      "id": "observable.purchase_conversion_rate",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "len(purchase_successes)/max(1,len(purchase_attempts))",
      "frequency": "daily",
      "aggregation": "mean",
      "target_data_field": "train_supply.csv:purchase_conversion"
    },
    {
      "id": "observable.adoption_inequality",
      "source_module": "AdoptionAggregator",
      "formula_or_field": "Gini(adoption_by_ses)",
      "frequency": "daily",
      "aggregation": "scalar",
      "target_data_field": "train_inequality.csv:adoption_gini"
    }
  ],
  "metrics": [
    {
      "name": "adoption_rate_over_time",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {
          "transform": "identity"
        }
      }
    },
    {
      "name": "time_to_reach_50_percent",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "ThresholdCrossingTime",
        "config": {
          "threshold": 0.5,
          "direction": "up"
        }
      }
    },
    {
      "name": "peak_adoption_rate",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "PeakValue",
        "config": {}
      }
    },
    {
      "name": "policy_compliance_rate",
      "inputs": [
        "observable.policy_compliance_rate"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {}
      }
    },
    {
      "name": "context_specific_adoption",
      "inputs": [
        "observable.context_adoption"
      ],
      "definition": {
        "type": "ByGroupSeries",
        "config": {
          "groups": [
            "household",
            "work",
            "public"
          ]
        }
      }
    },
    {
      "name": "purchase_conversion_rate",
      "inputs": [
        "observable.purchase_conversion_rate"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {}
      }
    },
    {
      "name": "adoption_inequality",
      "inputs": [
        "observable.adoption_inequality"
      ],
      "definition": {
        "type": "TimeSeries",
        "config": {}
      }
    },
    {
      "name": "RMSE_adoption",
      "inputs": [
        "observable.adoption_rate_daily"
      ],
      "definition": {
        "type": "RMSE",
        "config": {
          "normalize": true,
          "target_field": "train_adoption.csv:adoption_rate_overall"
        }
      }
    }
  ],
  "environment": {
    "type": "network",
    "dimensions": null,
    "time_step": 1,
    "time_unit": "days"
  },
  "initialization": {
    "population_size": 5000,
    "random_seed": 42,
    "network": {
      "type": "Watts-Strogatz",
      "n": 5000,
      "k": 10,
      "p": 0.05
    },
    "households": {
      "generation": "stochastic partition using size ~ Poisson(3)+1 truncated at 7"
    },
    "workplaces": {
      "count": "ceil(population_size*0.4/20)",
      "assignment": "random among working-age agents (18-65)"
    },
    "public_venues": {
      "count": "ceil(population_size/50)"
    },
    "initial_mask_ownership": "Bernoulli(initial_adoption_rate) with up to 1 mask; others 0",
    "initial_usage_day0": "Agents with mask_owned>0 use with prob=initial_adoption_rate in public/work; record last_day_mask_used_by_context"
  },
  "algorithms": {
    "sigmoid": "s(x) = 1/(1+exp(-x))",
    "Gini": "Gini(y) = sum_i sum_j |y_i - y_j| / (2 n sum_i y_i + eps)",
    "WattsStrogatz": "NetworkX watts_strogatz_graph(n, k, p)",
    "ContactSampling": "Poisson edges per location constrained by occupants using random pairing",
    "PiecewiseRateLookup": "Map day to value via piecewise segments for exogenous cases"
  },
  "data_sources": [
    {
      "name": "train_adoption.csv",
      "purpose": "Calibration/validation of overall adoption trajectory",
      "fields_used": [
        "day",
        "adoption_rate_overall"
      ]
    },
    {
      "name": "train_adoption_context.csv",
      "purpose": "Context-specific adoption comparison",
      "fields_used": [
        "day",
        "context",
        "adoption_rate"
      ]
    },
    {
      "name": "train_policy.csv",
      "purpose": "Compliance rate validation under mandates",
      "fields_used": [
        "day",
        "compliance_rate"
      ]
    },
    {
      "name": "train_supply.csv",
      "purpose": "Supply-purchase dynamics validation",
      "fields_used": [
        "day",
        "purchase_conversion"
      ]
    },
    {
      "name": "train_inequality.csv",
      "purpose": "Inequality comparison across SES",
      "fields_used": [
        "day",
        "adoption_gini"
      ]
    }
  ],
  "code_structure": {
    "files": [
